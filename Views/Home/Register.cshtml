@model ServiceGo.Models.Register
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    // This page is a complete HTML document (own <html>/<head>), so it must not
    // be wrapped by _Layout. Otherwise the browser keeps the layout's <head>
    // (title "- ServiceGo", no logo) and ignores this page's title and icon.
    Layout = null;

    bool isReRegistration = ViewBag.IsReRegistration == true;

    string registrationPendingUrl =
        Url.Action("RegistrationPending", "Home") ?? "/";

    string savedShopAddress = Model.ShopAddressInput ?? "";
    string savedHomeAddress = Model.HomeAddressInput ?? "";

    string savedShopLat =
        Model.ShopLat?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";

    string savedShopLng =
        Model.ShopLng?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";

    string savedHomeLat =
        Model.HomeLat?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";

    string savedHomeLng =
        Model.HomeLng?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";

    // Keep the registration form tied to the logged-in/signup provider.
    // The controller remains the source of truth for the generated ID.
    string providerIdValue = Model.ProviderId ?? "";
    if (!string.IsNullOrWhiteSpace(providerIdValue) &&
        !providerIdValue.StartsWith("PRO-", StringComparison.OrdinalIgnoreCase))
    {
        providerIdValue = "PRO-" + providerIdValue;
    }
    else if (string.IsNullOrWhiteSpace(providerIdValue) && Model.Id > 0)
    {
        providerIdValue = "PRO-" + Model.Id;
    }

    string registrationEmail =
        !string.IsNullOrWhiteSpace(Model.Email)
            ? Model.Email
            : (ViewBag.Email?.ToString() ?? "");
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(isReRegistration ? "Re-Register as Provider" : "Register as Provider")</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" href="@Url.Content("~/images/Logo.png")?v=2" type="image/png">
    <link rel="shortcut icon" href="@Url.Content("~/images/Logo.png")?v=2" type="image/png">

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            caret-color: transparent;
        }

        /* Caret is allowed only where the user can type */
        input,
        textarea,
        select {
            caret-color: auto !important;
        }


        .register-card {
            width: calc(100% - 24px);
            max-width: 800px;
            margin: 40px auto;
            background: #ffffff;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }

        .logo {
            display: block;
            max-width: 120px;
            margin: 0 auto 20px auto;
            cursor: pointer;
            caret-color: transparent;
            user-select: none;
        }

        .form-label {
            font-weight: 700;
            color: #343a40;
            caret-color: transparent;
            user-select: none;
        }

        /* Prevent caret from appearing on non-typing elements */
        button,
        label,
        span,
        .category-btn,
        .file-upload-btn,
        .badge,
        .support-option,
        .support-help-btn,
        .modal-title,
        .section-title,
        .alert,
        .form-label,
        .map-note,
        .preview-wrapper,
        .btn-register,
        #mapShop,
        #mapHome {
            caret-color: transparent !important;
            user-select: none;
        }

        /* Registration page: hide shared site header */
        .navbar {
            display: none !important;
        }

        /* Keep the registration form clear of the footer */
        .register-card {
            margin-bottom: 70px;
        }

        /* Center footer and prevent it from overlapping the form */
        .footer {
            position: static !important;
            width: 100% !important;
            text-align: center !important;
            white-space: normal !important;
            line-height: normal !important;
            clear: both;
            margin-top: 20px !important;
            padding: 20px 0 !important;
        }

            .footer .container {
                text-align: center !important;
            }

        /* Registration Help */
        .support-help-btn {
            display: none !important;
            position: fixed;
            right: 22px;
            bottom: 22px;
            z-index: 1050;
            border: none;
            border-radius: 50px;
            padding: 12px 18px;
            background: #ff9800;
            color: #fff;
            font-weight: 700;
            box-shadow: 0 5px 18px rgba(0,0,0,0.18);
            cursor: pointer;
        }

            .support-help-btn:hover {
                background: #e68900;
            }

        .support-modal .modal-header {
            background: #ff9800;
            color: #fff;
        }

        .support-option {
            border: 1px solid #e9ecef;
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 10px;
            background: #fff;
        }

            .support-option strong {
                display: block;
                margin-bottom: 4px;
            }

            .support-option small {
                color: #6c757d;
            }

        .support-faq {
            display: none;
            margin-top: 8px;
            padding: 10px 12px;
            border-radius: 8px;
            background: #f8f9fa;
            color: #495057;
            font-size: 0.9rem;
            line-height: 1.5;
        }

        .support-email {
            display: inline-block;
            color: #0d6efd;
            font-weight: 600;
            text-decoration: none;
            caret-color: transparent;
        }

            .support-email:hover {
                text-decoration: underline;
            }

        /* Address Not Found Modal */
        .address-help-modal .modal-dialog {
            max-width: 470px;
        }

        .address-help-modal .modal-content {
            border: none;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 15px 45px rgba(0,0,0,0.20);
        }

        .address-help-header {
            background: linear-gradient(135deg, #ff9800, #f57c00);
            color: #fff;
            padding: 18px 20px;
        }

        .address-help-title {
            font-weight: 800;
            margin-bottom: 5px;
        }

        .address-help-subtitle {
            font-size: 0.9rem;
            opacity: 0.95;
            margin: 0;
        }

        .address-help-body {
            padding: 20px;
        }

        .address-help-footer {
            padding: 0 20px 20px 20px;
        }

        .map-note {
            margin-bottom: 8px;
        }

        .agreement-box label {
            font-weight: 600;
        }

        .client-error {
            margin-top: 6px;
            font-size: 0.9rem;
            font-weight: 500;
            text-align: left;
        }

        .sg-field-invalid {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.12) !important;
        }

        .file-upload {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            border: 1px dashed #f0ad4e;
            border-radius: 14px;
            background: linear-gradient(135deg, #fffaf3, #ffffff);
            transition: all 0.2s ease;
        }

            .file-upload:hover {
                border-color: #ff9800;
                box-shadow: 0 4px 12px rgba(240, 173, 78, 0.12);
            }

            .file-upload input[type="file"] {
                position: absolute;
                width: 1px;
                height: 1px;
                padding: 0;
                margin: -1px;
                overflow: hidden;
                clip: rect(0, 0, 0, 0);
                white-space: nowrap;
                border: 0;
            }

        .file-upload-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-width: 145px;
            padding: 10px 16px;
            border-radius: 10px;
            background: #ff9800;
            color: #fff;
            font-weight: 700;
            cursor: pointer;
            margin: 0;
            white-space: nowrap;
            box-shadow: 0 3px 8px rgba(240, 173, 78, 0.22);
            transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        }

            .file-upload-btn:hover {
                background: #e68900;
                transform: translateY(-1px);
                box-shadow: 0 5px 12px rgba(240, 173, 78, 0.28);
            }

            .file-upload-btn:active {
                transform: translateY(0);
            }

        .file-name {
            flex: 1;
            min-width: 0;
            color: #6c757d;
            font-size: 0.9rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            caret-color: transparent;
        }

            .file-name.selected {
                color: #343a40;
                font-weight: 600;
            }

        .section-title {
            font-weight: 700;
            color: #333;
            border-bottom: 2px solid #f0ad4e;
            padding-bottom: 5px;
            margin-top: 25px;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }

        .category-btn {
            background: #f1f3f5;
            border: 1px solid #ced4da;
            padding: 6px 14px;
            border-radius: 20px;
            margin: 3px;
            cursor: pointer;
            font-size: 0.9rem;
            transition: all 0.2s;
            position: relative;
            z-index: 20;
            pointer-events: auto !important;
            user-select: none;
        }

            .category-btn:focus,
            .category-btn:active {
                outline: none;
            }

            .category-btn:hover {
                background: #e2e6ea;
            }

        .upload-box {
            border: 2px dashed #ced4da;
            padding: 15px;
            border-radius: 10px;
            text-align: center;
            background: #fafafa;
            margin-bottom: 10px;
        }

        .btn-register {
            background: #ff9800;
            border: none;
            color: white;
            width: 100%;
            padding: 12px;
            font-weight: 700;
            border-radius: 8px;
            margin-top: 20px;
            transition: background 0.2s;
        }

            .btn-register:hover {
                background: #e68900;
            }

            .btn-register:disabled {
                background: #cccccc;
                cursor: not-allowed;
            }

        .agreement-box {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 20px;
            font-size: 0.95rem;
        }

        /* Google Maps container */
        #mapShop,
        #mapHome {
            height: 250px;
            min-height: 250px;
            overflow: hidden;
            background: #e9ecef;
            caret-color: transparent;
        }

        .gm-style,
        .gm-style * {
            caret-color: transparent !important;
        }

        .pac-container {
            z-index: 10000 !important;
        }

        @@media (max-width: 576px) {
            .register-card {
                margin: 12px auto;
                padding: 18px 14px;
                border-radius: 12px;
            }

            .file-upload {
                flex-wrap: wrap;
            }

            .file-upload-btn {
                min-width: 120px;
            }

            .input-group {
                flex-wrap: wrap;
            }

                .input-group .form-control {
                    width: 100%;
                    border-radius: 8px !important;
                }

                .input-group .btn {
                    width: 100%;
                    margin-top: 6px;
                    border-radius: 8px !important;
                }

            .agreement-box {
                align-items: flex-start;
            }

            .support-help-btn {
                right: 12px;
                bottom: 12px;
                padding: 10px 14px;
            }
        }
    </style>
    <style>
        /* Pretty ServiceGo message popup (replaces the browser's "localhost says" alert) */
        .sg-alert-overlay {
            position: fixed;
            inset: 0;
            z-index: 100000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(40, 24, 4, 0.5);
            backdrop-filter: blur(3px);
            animation: sgFade .18s ease-out;
        }

        .sg-alert-box {
            width: 100%;
            max-width: 380px;
            padding: 30px 26px 24px;
            text-align: center;
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(180deg, #fffaf2 0%, #ffffff 55%);
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(217, 118, 0, 0.25);
            animation: sgPop .22s ease-out;
        }

        .sg-alert-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 70px;
            height: 70px;
            margin-bottom: 14px;
            border-radius: 50%;
            font-size: 1.9rem;
            background: #fff4e3;
            box-shadow: 0 6px 16px rgba(217, 118, 0, 0.18);
        }

        .sg-alert-box.success .sg-alert-icon {
            background: #e8f8ee;
            box-shadow: 0 6px 16px rgba(25, 135, 84, 0.2);
        }

        .sg-alert-box.error .sg-alert-icon {
            background: #fdecec;
            box-shadow: 0 6px 16px rgba(220, 53, 69, 0.2);
        }

        .sg-alert-title {
            margin: 0 0 8px;
            font-size: 1.2rem;
            font-weight: 700;
            color: #8a4b00;
        }

        .sg-alert-text {
            margin: 0 0 20px;
            font-size: .93rem;
            line-height: 1.55;
            color: #5f564a;
            white-space: pre-line;
            word-break: break-word;
        }

        .sg-alert-btn {
            min-width: 120px;
            padding: 10px 26px;
            border: 0;
            border-radius: 999px;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(135deg, #f0a030, #d97600);
            box-shadow: 0 6px 16px rgba(217, 118, 0, 0.3);
            cursor: pointer;
            transition: transform .15s ease, box-shadow .15s ease;
        }

            .sg-alert-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(217, 118, 0, 0.38);
            }

        @@keyframes sgFade {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes sgPop {
            from {
                opacity: 0;
                transform: scale(.92) translateY(8px);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }
    </style>

    <style id="sg-popup-polish">
        /* Compact message popup (replaces the browser alert) */
        .sg-alert-overlay {
            padding: 16px;
            background: rgba(33, 37, 41, 0.45);
        }

        .sg-alert-box {
            max-width: 340px;
            padding: 24px 22px 20px;
            border-radius: 20px;
            background: #ffffff;
            box-shadow: 0 18px 45px rgba(33, 37, 41, 0.22);
        }

        .sg-alert-icon {
            width: 54px;
            height: 54px;
            margin-bottom: 12px;
            font-size: 0;
            color: #d97600;
            background: #fff4e3;
            box-shadow: none;
        }

            .sg-alert-icon svg {
                width: 28px;
                height: 28px;
            }

        .sg-alert-box.success .sg-alert-icon {
            color: #198754;
            background: #e8f8ee;
            box-shadow: none;
        }

        .sg-alert-box.error .sg-alert-icon {
            color: #dc3545;
            background: #fdecec;
            box-shadow: none;
        }

        .sg-alert-title {
            margin: 0 0 6px;
            font-size: 1.08rem;
            font-weight: 700;
            color: #212529;
        }

        .sg-alert-text {
            margin: 0 0 16px;
            font-size: 0.92rem;
            line-height: 1.5;
            color: #6c757d;
        }

        .sg-alert-btn {
            min-width: 110px;
            padding: 0.55rem 1.6rem;
            border: 0;
            border-radius: 12px;
            font-weight: 600;
            color: #ffffff;
            background: #d97600;
        }

            .sg-alert-btn:hover {
                background: #bf6700;
            }
    </style>

    <style id="sg-modal-polish">
        /* Softer, rounded Bootstrap modals */
        .modal-content {
            border: 0;
            border-radius: 18px;
            box-shadow: 0 18px 50px rgba(33, 37, 41, 0.22);
            overflow: hidden;
        }

        .modal-backdrop.show {
            opacity: 0.4;
        }
    </style>
</head>

<body>

    <div class="modal fade support-modal" id="registrationHelpModal" tabindex="-1" aria-labelledby="registrationHelpTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="registrationHelpTitle">ServiceGo Registration Help</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p class="mb-3">If you need help with registration, select a topic below to see the instructions.</p>

                    <div class="support-option">
                        <button type="button" class="btn btn-link p-0 text-start text-decoration-none w-100" onclick="toggleSupportFaq('certificateFaq')">
                            <strong>What is a Certificate?</strong>
                            <small>Information about professional certificates and affidavits</small>
                        </button>
                        <div id="certificateFaq" class="support-faq">
                            If you are not sure whether you need a Professional Certificate or an Affidavit, please confirm the requirement with ServiceGo Support. Do not upload an incorrect document.
                        </div>
                    </div>

                    <div class="support-option">
                        <button type="button" class="btn btn-link p-0 text-start text-decoration-none w-100" onclick="toggleSupportFaq('addressFaq')">
                            <strong>Home / Shop Address</strong>
                            <small>Having trouble finding or setting your address?</small>
                        </button>
                        <div id="addressFaq" class="support-faq">
                            Enter your complete address and press Search. If your exact house or street is not found, search for a nearby famous landmark or use your current location.
                        </div>
                    </div>

                    <div class="support-option">
                        <button type="button" class="btn btn-link p-0 text-start text-decoration-none w-100" onclick="toggleSupportFaq('cnicFaq')">
                            <strong>CNIC / Documents</strong>
                            <small>Need help uploading your CNIC or profile picture?</small>
                        </button>
                        <div id="cnicFaq" class="support-faq">
                            Upload a clear JPG or PNG image. Select the correct document type and upload the CNIC Front and CNIC Back separately.
                        </div>
                    </div>

                    <div class="support-option">
                        <button type="button" class="btn btn-link p-0 text-start text-decoration-none w-100" onclick="toggleSupportFaq('serviceFaq')">
                            <strong>Service Selection</strong>
                            <small>Need help selecting your services?</small>
                        </button>
                        <div id="serviceFaq" class="support-faq">
                            Select only the services that you actually provide. You can select a maximum of 3 services.
                        </div>
                    </div>

                    <div class="alert alert-info mb-0">
                        <strong>ServiceGo Support</strong><br>
                        If you still need assistance, please email:<br>
                        <a class="support-email" href="mailto:servicego888@gmail.com?subject=ServiceGo%20Registration%20Help">
                            servicego888@gmail.com
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>


    <!-- Address Not Found / Address Help Modal -->
    <div class="modal fade address-help-modal" id="addressHelpModal" tabindex="-1" aria-labelledby="addressHelpTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="address-help-header">
                    <h5 class="address-help-title" id="addressHelpTitle">Address not found</h5>
                    <p class="address-help-subtitle">Famous place / landmark likhein.</p>
                </div>
                <div class="address-help-body">
                    <p class="mb-0 text-muted">
                        Agar exact address na mile to qareeb ki famous jagah, chowk, market, park, hospital ya landmark search karein.
                    </p>
                </div>
                <div class="address-help-footer">
                    <button type="button" class="btn btn-light w-100" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <div class="register-card">

        <img src="@Url.Content("~/images/Logo.png")" class="logo" onclick="window.location.href='@Url.Action("Index", "Home")'" />

        <h3 class="text-center mb-4" style="font-weight: 800;">
            @(isReRegistration ? "Re-Register as Provider" : "Register as Provider")
        </h3>

        @if (isReRegistration && !string.IsNullOrWhiteSpace(ViewBag.RejectionReason as string))
        {
            <div class="alert alert-warning text-start">
                <strong>Reason for Previous Rejection:</strong>
                <div>@ViewBag.RejectionReason</div>
            </div>
        }

        @if (isReRegistration)
        {
            <div class="alert alert-info text-start">
                <strong>
                    This is a fresh re-registration form. Your existing Provider ID / registration ID is retained.
                    Please enter the information you want to submit again. Your submission will be reviewed by the admin before approval.
                </strong>
            </div>
        }

        <form id="registerForm" action="@Url.Action("Register", "Home")" method="post" enctype="multipart/form-data" novalidate>
            <input type="hidden" id="registrationPendingUrl" value="@registrationPendingUrl" />

            @Html.AntiForgeryToken()

            <!-- Hidden Fields for Mapping -->
            <input type="hidden" id="registrationId" name="Id" value="@Model.Id" />
            <input type="hidden" asp-for="SelectedServices" id="hfSelectedServices" name="SelectedServices" />
            <input type="hidden" asp-for="SelectedServiceTypes" id="hfSelectedServiceTypes" name="SelectedServiceTypes" />
            <input type="hidden" asp-for="AvailableDays" id="hiddenAvailableDays" name="AvailableDays" />
            <input type="hidden" name="SignupId" value="@Model.SignupId" />

            <div class="col-12 form-group mb-3">
                <label class="form-label">Email Address</label>
                <input type="email" name="Email" value="@registrationEmail" class="form-control" readonly />
                <div id="emailClientError" class="client-error text-danger small"></div>
            </div>

            <input type="hidden" id="hiddenProviderIdReal" name="ProviderId" value="@providerIdValue" />
            <input type="hidden" name="IsReRegistration" value="@(isReRegistration ? "true" : "false")" />

            <div class="section-title">Personal Details</div>

            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label class="form-label">Full Name</label>
                    <input id="fullNameInput" name="Name" type="text" value="@Model.Name" class="form-control" autocomplete="name" />
                </div>

                <div class="col-md-6 form-group mb-3">
                    <label class="form-label">Father Name</label>
                    <input id="fatherNameInput" name="FatherName" type="text" value="@Model.FatherName" class="form-control" />
                </div>

                <div class="col-md-6 form-group mb-3">
                    <label class="form-label">Provider ID</label>
                    <input type="text" id="displayProviderId" value="@providerIdValue" readonly class="form-control provider-id bg-light" />
                </div>

                <div class="col-md-6 form-group mb-3">
                    <label class="form-label">CNIC Number</label>
                    <input name="CNIC" value="@Model.CNIC" id="cnicInput" class="form-control" placeholder="XXXXX-XXXXXXX-X" maxlength="15" oninput="formatCNIC(this)" />
                </div>

                <div class="col-md-6 form-group mb-3">
                    <label class="form-label">Phone Number</label>
                    <input name="PhoneNumber" value="@Model.PhoneNumber" id="phoneNumber" class="form-control" maxlength="13" oninput="formatPhone(this)" />
                </div>

                <div class="col-md-6 form-group mb-3">
                    <label class="form-label">City</label>
                    <input id="cityInput" name="City" type="text" value="@Model.City" class="form-control" />
                </div>

                <div class="col-12 form-group mb-3">
                    <label class="form-label">Local Address</label>
                    <input type="text" id="localAddressInput" name="LocalAddress" value="@Model.LocalAddress" class="form-control" />
                </div>

                <div class="col-12 form-group mb-3">
                    <label class="form-label">Permanent Address</label>
                    <input type="text" id="permanentAddressInput" name="PermanentAddress" value="@Model.PermanentAddress" class="form-control" />
                </div>
            </div>

            <div class="section-title">Identity Documents</div>
