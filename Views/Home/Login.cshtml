@model ServiceGo.Models.Login

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ServiceGo - Login</title>
    <link rel="icon" href="@Url.Content("~/images/Logo.png")" type="image/x-icon" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --brand: #f0ad4e;
            --brand-dark: #e39e3e;
        }

        body {
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px 12px;
            background: linear-gradient(135deg, #f8f9fa, #fff5e8);
            caret-color: transparent;
        }

        input, textarea, select, button {
            caret-color: auto;
        }

        .login-card {
            background: #fff;
            padding: 36px 40px;
            border-radius: 22px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 14px 40px rgba(0,0,0,.10);
        }

        .logo {
            width: 76px;
            display: block;
            margin: 0 auto 14px;
            cursor: pointer;
        }

        h4 {
            color: var(--brand);
            font-weight: 700;
            text-align: center;
            margin-bottom: 24px;
        }

        .form-label {
            font-weight: 600;
            color: #222;
        }

        .form-control {
            border-radius: 11px;
            padding: 11px 12px;
            border: 1px solid #d6d9dd;
            box-shadow: none;
        }

            .form-control:focus {
                border-color: var(--brand);
                box-shadow: 0 0 0 .2rem rgba(240,173,78,.14);
            }

        .password-wrap {
            position: relative;
        }

            .password-wrap .form-control {
                padding-right: 48px;
            }

        .password-toggle {
            position: absolute;
            top: 50%;
            right: 9px;
            transform: translateY(-50%);
            width: 34px;
            height: 34px;
            border: 0;
            border-radius: 50%;
            background: transparent;
            color: #6b7280;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            cursor: pointer;
        }

            .password-toggle:hover {
                background: #f7f7f7;
                color: var(--brand-dark);
            }

            .password-toggle svg {
                width: 19px;
                height: 19px;
            }

        /* Error message without creating extra empty space */
        .field-error {
            color: #dc3545;
            font-size: .78rem;
            font-weight: 500;
        }

            .field-error:empty {
                display: none;
            }

        .server-error {
            color: #842029;
            background: #fff5f5;
            border: 1px solid #f3c2c2;
            border-radius: 10px;
            padding: 10px 12px;
            margin-bottom: 16px;
            font-size: .82rem;
        }

        .success-message {
            color: #146c43;
            background: #f0fff7;
            border: 1px solid #bfe8d1;
            border-radius: 10px;
            padding: 10px 12px;
            margin-bottom: 16px;
            font-size: .82rem;
        }

        .btn-login {
            width: 100%;
            padding: 12px;
            border: 0;
            border-radius: 11px;
            background: linear-gradient(180deg, var(--brand), var(--brand-dark));
            color: #fff;
            font-weight: 700;
            margin-top: 8px;
            cursor: pointer;
            transition: .2s;
        }

            .btn-login:hover {
                transform: translateY(-1px);
            }

            .btn-login:disabled {
                opacity: .7;
                cursor: wait;
                transform: none;
            }

        .login-card a {
            display: block;
            text-align: center;
            margin-top: 14px;
            color: #6f42c1;
            font-size: .9rem;
            text-decoration: none;
            font-weight: 600;
        }

            .login-card a:hover {
                text-decoration: underline;
            }

        @@media (max-width:576px) {
            .login-card {
                padding: 28px 20px;
            }
        }

        /* Keep exactly one password visibility icon */
        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear {
            display: none;
            width: 0;
            height: 0;
        }

        input[type="password"]::-webkit-credentials-auto-fill-button {
            visibility: hidden;
            pointer-events: none;
            position: absolute;
            right: 0;
        }

        /* Remove Bootstrap validation icon */
        .form-control.is-invalid,
        .was-validated .form-control:invalid {
            background-image: none !important;
        }

        .input-wrap .form-control.is-invalid,
        .password-wrap .form-control.is-invalid {
            background-image: none !important;
        }

        .blocked-login-overlay {
            position: fixed;
            inset: 0;
            z-index: 1050;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(31, 25, 20, .42);
            backdrop-filter: blur(3px);
        }

        .blocked-login-popup {
            width: 100%;
            max-width: 390px;
            background: #fff;
            border: 1px solid #f4dfc8;
            border-radius: 20px;
            padding: 30px 26px 24px;
            text-align: center;
            box-shadow: 0 22px 55px rgba(0,0,0,.20);
        }

        .blocked-login-icon {
            width: 52px;
            height: 52px;
            margin: 0 auto 14px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff4e6;
            color: #f0ad4e;
            font-size: 25px;
            font-weight: 700;
        }

        .blocked-login-popup h5 {
            margin: 0 0 9px;
            color: #262626;
            font-size: 1.18rem;
            font-weight: 700;
        }

        .blocked-login-popup p {
            margin: 0;
            color: #666;
            font-size: .88rem;
            line-height: 1.6;
        }

        .blocked-home-btn {
            display: inline-block;
            margin-top: 20px;
            padding: 10px 24px;
            border: 0;
            border-radius: 10px;
            background: linear-gradient(180deg, var(--brand), var(--brand-dark));
            color: #fff !important;
            font-size: .9rem;
            font-weight: 700;
            text-decoration: none !important;
        }

            .blocked-home-btn:hover {
                transform: translateY(-1px);
            }

        @@media (max-width:576px) {
            .blocked-login-overlay {
                padding: 16px;
            }

            .blocked-login-popup {
                max-width: 350px;
                padding: 27px 20px 22px;
                border-radius: 18px;
            }
        }
    </style>
</head>

<body>

    @if (ViewData["ShowBlockedAccount"] is bool showBlockedAccount && showBlockedAccount)
    {
        <div class="blocked-login-overlay"
             role="dialog"
             aria-modal="true"
             aria-labelledby="blockedLoginTitle">

            <div class="blocked-login-popup">

                <div class="blocked-login-icon" aria-hidden="true">
                    !
                </div>

                <h5 id="blockedLoginTitle">
                    Account Blocked
                </h5>

                <p>
                    Your ServiceGo account has been blocked.
                    Please contact ServiceGo Support for more information.
                </p>

                <a class="blocked-home-btn"
                   href="@Url.Action("Index", "Home")">
                    Back to Home
                </a>

            </div>
        </div>
    }

    <div class="login-card">

        <img src="~/images/Logo.png"
             alt="ServiceGo Logo"
             class="logo"
             onclick="window.location.href='@Url.Action("Index", "Home")'">

        <h4>
            Welcome to ServiceGo
        </h4>

        @if (TempData["PasswordResetSuccess"] is string resetMessage &&
                !string.IsNullOrWhiteSpace(resetMessage))
        {
            <div class="success-message">
                @resetMessage
            </div>
        }

        <form asp-action="Login"
              asp-controller="Home"
              method="post"
              id="loginForm"
              novalidate>

            @Html.AntiForgeryToken()

            <div class="mb-3 text-start">

                <label for="Email" class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       name="Email"
                       id="Email"
                       type="email"
                       class="form-control"
                       autocomplete="email">

                <div id="EmailError" class="field-error">
                    @ViewData.ModelState["Email"]?.Errors.FirstOrDefault()?.ErrorMessage
                </div>

            </div>

            <div class="mb-2 text-start">

                <label for="Password" class="form-label">
                    Password
                </label>

                <div class="password-wrap">

                    <input asp-for="Password"
                           name="Password"
                           id="Password"
                           type="password"
                           class="form-control"
                           autocomplete="current-password">

                    <button type="button"
                            class="password-toggle"
                            id="passwordToggle"
                            aria-label="Show password"
                            title="Show password">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path>

                            <circle cx="12" cy="12" r="3"></circle>

                        </svg>

                    </button>

                </div>

                <div id="PasswordError" class="field-error">
                    @ViewData.ModelState["Password"]?.Errors.FirstOrDefault()?.ErrorMessage
                </div>

                <div id="ServerError" class="field-error">
                    @ViewData.ModelState[""]?.Errors.FirstOrDefault()?.ErrorMessage
                </div>

            </div>

            <button type="submit"
                    id="loginBtn"
                    class="btn-login">
                Log in
            </button>

            <a href="@Url.Action("Forget", "Home")">
                Forgotten password?
            </a>

        </form>

    </div>

    <script>
        (() => {

            const form = document.getElementById("loginForm");
            const email = document.getElementById("Email");
            const password = document.getElementById("Password");
            const emailError = document.getElementById("EmailError");
            const passwordError = document.getElementById("PasswordError");
            const serverError = document.getElementById("ServerError");
            const button = document.getElementById("loginBtn");
            const toggle = document.getElementById("passwordToggle");

            function clearFieldErrors() {

                emailError.textContent = "";
                passwordError.textContent = "";

                email.classList.remove("is-invalid");
                password.classList.remove("is-invalid");
            }

            form.addEventListener("submit", (event) => {

                clearFieldErrors();

                if (serverError) {
                    serverError.style.display = "none";
                }

                let valid = true;

                const emailValue = email.value.trim();

                if (!emailValue) {

                    emailError.textContent = "Email is required.";
                    email.classList.add("is-invalid");
                    valid = false;

                } else if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(emailValue)) {

                    emailError.textContent =
                        "Please enter a valid email address.";

                    email.classList.add("is-invalid");
                    valid = false;
                }

                if (!password.value) {

                    passwordError.textContent =
                        "Password is required.";

                    password.classList.add("is-invalid");
                    valid = false;
                }

                if (!valid) {

                    event.preventDefault();

                    form.querySelector(".is-invalid")?.focus();

                    return;
                }

                button.disabled = true;
                button.textContent = "Signing in...";
            });

            toggle.addEventListener("click", () => {

                const showing = password.type === "text";

                password.type = showing
                    ? "password"
                    : "text";

                toggle.setAttribute(
                    "aria-label",
                    showing ? "Show password" : "Hide password"
                );

                toggle.setAttribute(
                    "title",
                    showing ? "Show password" : "Hide password"
                );
            });

        })();
    </script>

</body>
</html>