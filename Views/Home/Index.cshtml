@{
    Layout = null;

    bool isLoggedIn = ViewBag.IsLoggedIn == true;
    string userRole = ViewBag.UserRole as string ?? "";
    string providerState = ViewBag.ProviderState as string ?? "";
    string providerName = ViewBag.ProviderName as string ?? "";
    string providerRejectionReason = ViewBag.ProviderRejectionReason as string ?? "";
    string providerCode = ViewBag.ProviderCode as string ?? "";
    string customerName = ViewBag.CustomerName as string ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>ServiceGo - Your All-in-One Home Service Solution</title>

    <meta name="description"
          content="ServiceGo helps customers find, connect with and book verified local service providers." />
    <meta name="theme-color" content="#f0ad4e" />

    <!-- Resource hints -->

    <link rel="preconnect"
          href="https://cdn.jsdelivr.net"
          crossorigin />

    <link rel="dns-prefetch"
          href="//cdn.jsdelivr.net" />

    <!-- Favicon -->
    <link rel="icon"
          href="/images/Logo.png"
          type="image/png" />

    <!--
       Lcp image
       Keep the first hero image high priority.
    -->

    <link rel="preload"
          as="image"
          href="/images/Engineers.png"
          fetchpriority="high" />

    <!-- Bootstrap CSS -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <style>

        :root {
            --primary-gradient: linear-gradient(135deg, #f0ad4e 0%, #ff6b6b 100%);
            --accent-color: #ff6b6b;
            --hover-color: #e0962f;
        }


        img {
            max-width: 100%;
            height: auto;
        }


        html {
            scroll-behavior: smooth;
        }

        /* Compact, modern public footer */
        .servicego-footer {
            margin-top: 0;
            padding: 52px 0 20px;
            background: linear-gradient(135deg, #fff4df 0%, #fffaf3 52%, #ffe9cf 100%);
            color: #3a2a1d;
            border-top: 1px solid rgba(216,137,32,.18);
            box-shadow: 0 -10px 35px rgba(91,61,28,.06);
        }

        .servicego-footer-brand {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .servicego-footer-logo {
            width: 48px;
            height: 48px;
            object-fit: contain;
            border-radius: 10px;
        }

        .servicego-footer h3,
        .servicego-footer h4 {
            margin: 0 0 10px;
            font-weight: 700;
        }

        .servicego-footer h3 {
            font-size: 1.2rem;
        }

        .servicego-footer h4 {
            color: #c97715;
            font-size: .92rem;
        }

        .servicego-footer p {
            margin: 0;
            color: #756452;
            font-size: .88rem;
        }

        .servicego-footer a {
            display: block;
            width: fit-content;
            margin: 0 0 9px;
            color: #655342;
            text-decoration: none;
            font-size: .88rem;
            transition: color .2s ease, transform .2s ease;
        }

            .servicego-footer a:hover {
                color: #c97715;
                transform: translateX(3px);
            }

        .servicego-footer-bottom {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            margin-top: 34px;
            padding-top: 16px;
            border-top: 1px solid rgba(115,79,40,.14);
            color: #806f5d;
            font-size: .78rem;
        }

        .servicego-footer-developer {
            color: #5b4938;
            font-weight: 700;
        }

            .servicego-footer-developer strong {
                color: #c97715;
            }

        @@media (max-width: 575px) {
            .servicego-footer {
                padding-top: 36px;
            }

            .servicego-footer-bottom {
                flex-direction: column;
            }
        }

        body {
            margin: 0;
            caret-color: transparent;
        }

        input,
        textarea,
        select,
        [contenteditable="true"] {
            caret-color: auto;
        }

        .navbar {
            min-height: 56px;
        }

        .navbar-nav .nav-link {
            color: #000 !important;
            font-weight: 600;
            transition: color .15s ease;
        }

            .navbar-nav .nav-link:hover {
                color: var(--accent-color) !important;
            }

        .servicego-logo {
            width: 40px;
            height: 40px;
            object-fit: contain;
            flex: 0 0 40px;
        }

        .hero-slider-container {
            position: relative;
            width: 100%;
            overflow: hidden;
            background: #222;
            min-height: 580px;
        }

        .slider-img {
            display: block;
            width: 100%;
            height: 580px;
            object-fit: cover;
        }

        .slider-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, .62);
            z-index: 1;
            pointer-events: none;
        }

        .slider-fixed-content {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 3;
            width: 100%;
            max-width: 850px;
            padding: 0 20px;
        }

            .slider-fixed-content h1 {
                color: #fff;
                text-shadow: 0 2px 12px rgba(0, 0, 0, .35);
            }

        .service-card {
            border-radius: 16px !important;
            overflow: hidden;
            transition: transform .15s ease, box-shadow .15s ease;
            cursor: pointer;
            contain: layout paint;
        }

            .service-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(255, 107, 107, .15) !important;
            }

            .service-card img {
                display: block;
                width: 100%;
                height: 200px;
                object-fit: cover;
            }

        .step-card {
            padding: 30px;
            border-radius: 12px;
            background: #fff;
            border: 2px dashed #f0ad4e;
            transition: background .15s ease, border-color .15s ease, transform .15s ease;
            min-height: 250px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            contain: layout paint;
        }

            .step-card:hover {
                background: #fffcf7;
                border-color: #ff6b6b;
                transform: translateY(-5px);
            }

        .step-icon {
            font-size: 42px;
            line-height: 1;
            color: var(--accent-color);
            margin-bottom: 15px;
        }

        .why-slider-img {
            display: block;
            width: 100%;
            height: 400px;
            object-fit: cover;
            border-radius: 12px;
        }

        .more .card {
            background: #fff;
            border-radius: 16px;
            cursor: pointer;
            border: none !important;
            box-shadow: 0 6px 15px rgba(0, 0, 0, .06) !important;
            width: 250px;
            height: 240px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            flex-shrink: 0;
            padding: 25px !important;
            contain: layout paint;
        }

            .more .card img {
                display: block;
                width: auto;
                max-width: 100%;
                height: 100px;
                object-fit: contain;
                margin: 0 auto;
            }

        .marquee-container {
            overflow: hidden;
            width: 100%;
            display: flex;
            padding: 30px 0;
        }

        .marquee-track {
            display: flex;
            gap: 2rem;
            width: max-content;
            will-change: transform;
            transform: translate3d(0, 0, 0);
            backface-visibility: hidden;
        }

        .extended-footer {
            min-height: 320px;
        }

            .extended-footer h5 {
                position: relative;
                padding-bottom: 10px;
            }

                .extended-footer h5::after {
                    content: '';
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 40px;
                    height: 3px;
                    background: var(--primary-gradient);
                    border-radius: 2px;
                }

        .footer-support-links a {
            color: #f0ad4e;
            text-decoration: none;
            font-weight: 500;
            transition: color .15s ease, padding-left .15s ease;
        }

            .footer-support-links a:hover {
                color: #ff6b6b;
                padding-left: 5px;
            }

        .services,
        .how-it-works,
        .why,
        .more {
            content-visibility: auto;
            contain-intrinsic-size: 600px;
        }

        /* Fluid responsive sizing - no media queries required */
        .hero-slider-container {
            min-height: clamp(420px, 40vw, 580px);
        }

        .slider-img {
            height: clamp(420px, 40vw, 580px);
        }

        .slider-fixed-content {
            padding: 0 clamp(15px, 2vw, 20px);
        }

            .slider-fixed-content h1 {
                font-size: clamp(2rem, 3.2vw, 3rem);
            }

            .slider-fixed-content p {
                font-size: clamp(1rem, 1.5vw, 1.25rem);
            }

        .why-slider-img {
            height: clamp(280px, 31.25vw, 400px);
        }

        .more .card {
            width: clamp(180px, 19.5vw, 250px);
            height: clamp(190px, 18.75vw, 240px);
            padding: clamp(15px, 2vw, 25px) !important;
        }

            .more .card img {
                height: clamp(75px, 7.8vw, 100px);
            }

        .step-card {
            min-height: clamp(0px, 19.5vw, 250px);
        }


        .header-greeting {
            color: #4b3a28;
            font-weight: 700;
            font-size: .94rem;
            white-space: nowrap;
            padding: 0 .35rem;
        }

        .hero-welcome {
            display: inline-block;
            margin-bottom: 12px;
            color: rgba(255,255,255,.96);
            font-size: clamp(1rem, 1.35vw, 1.18rem);
            font-weight: 600;
            letter-spacing: .01em;
            text-shadow: 0 2px 10px rgba(0,0,0,.45);
        }

        .header-status {
            color: #b87812;
            font-weight: 700;
            font-size: .92rem;
            white-space: nowrap;
            padding: 0 .35rem;
        }

        .header-action {
            color: #2f2f2f !important;
            font-weight: 700 !important;
        }

        .servicego-navbar .header-action[href*="HelpCenter"] {
            font-weight: 700 !important;
            white-space: nowrap;
        }

        .header-action:hover {
            color: #d88920 !important;
        }

        .provider-status-text {
            display: block;
            margin: 14px auto 0;
            color: #fff;
            font-size: 1rem;
            font-weight: 600;
            line-height: 1.65;
            text-shadow: 0 2px 10px rgba(0,0,0,.35);
        }

        .provider-hero-status {
            width: min(100%, 720px);
            margin: 18px auto 0;
            padding: 18px 22px;
            border: 1px solid rgba(255,255,255,.28);
            border-radius: 16px;
            background: rgba(0,0,0,.30);
            box-shadow: 0 10px 30px rgba(0,0,0,.18);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            color: #fff;
            text-align: center;
        }

        .provider-hero-status-title {
            margin-bottom: 6px;
            font-size: 1.12rem;
            font-weight: 800;
            color: #fff;
        }

        .provider-hero-status-message {
            margin: 0;
            font-size: .98rem;
            line-height: 1.65;
            color: rgba(255,255,255,.94);
        }

        .provider-hero-status.pending {
            border-color: rgba(240,173,78,.55);
        }

        .provider-hero-status.rejected {
            border-color: rgba(255,107,107,.55);
        }

        .provider-reason {
            margin: 13px auto 0;
            padding: 11px 14px;
            border-radius: 10px;
            background: rgba(255,255,255,.12);
            color: #fff;
            font-size: .95rem;
            line-height: 1.6;
            text-align: left;
        }

            .provider-reason strong {
                color: #ffd27a;
            }

        @@media (max-width: 576px) {
            .provider-hero-status {
                padding: 15px 16px;
                border-radius: 13px;
            }

            .provider-hero-status-title {
                font-size: 1rem;
            }

            .provider-hero-status-message,
            .provider-reason {
                font-size: .9rem;
            }
        }

        .nav-logout {
            color: #c66b00 !important;
            font-weight: 700 !important;
        }

        .navbar-nav {
            gap: clamp(2px, .5vw, 6px);
        }

            .navbar-nav .nav-link {
                font-size: clamp(.85rem, 1.1vw, 1rem);
                padding-left: clamp(.4rem, .8vw, .75rem) !important;
                padding-right: clamp(.4rem, .8vw, .75rem) !important;
            }

        .servicego-logo {
            width: clamp(36px, 3.2vw, 40px);
            height: clamp(36px, 3.2vw, 40px);
            flex-basis: clamp(36px, 3.2vw, 40px);
        }

        .servicego-navbar {
            min-height: 64px;
            border-bottom: 1px solid rgba(240,173,78,.12);
        }

            .servicego-navbar .navbar-brand {
                margin-right: 1.5rem;
            }

            .servicego-navbar .navbar-nav {
                gap: .45rem;
            }

            .servicego-navbar .nav-link {
                padding: .35rem .6rem !important;
                border-radius: 8px;
                font-weight: 700 !important;
            }

                .servicego-navbar .nav-link:hover {
                    background: #fff8ef;
                }


            /* Public navbar must remain fully visible after logout. */
            .servicego-navbar .navbar-collapse {
                display: flex !important;
                flex-grow: 1;
                justify-content: flex-end;
            }

            .servicego-navbar .public-nav {
                display: flex !important;
                align-items: center;
                visibility: visible !important;
                opacity: 1 !important;
            }

                .servicego-navbar .public-nav .nav-item,
                .servicego-navbar .public-nav .nav-link {
                    display: block !important;
                    visibility: visible !important;
                    opacity: 1 !important;
                }

                .servicego-navbar .public-nav .nav-link {
                    color: #1f1a16 !important;
                    font-weight: 700 !important;
                }

                    .servicego-navbar .public-nav .nav-link:hover {
                        color: #c97715 !important;
                        background: #fff8ef;
                    }

        /* Mobile navbar refinement: Help Center and header links fit cleanly. */
        @@media (max-width: 576px) {
            .servicego-navbar .container {
                padding-left: 10px;
                padding-right: 10px;
            }

            .servicego-navbar .navbar-brand {
                margin-right: .55rem;
                flex-shrink: 0;
            }

                .servicego-navbar .navbar-brand span {
                    font-size: .95rem;
                }

            .servicego-navbar .servicego-logo {
                width: 34px;
                height: 34px;
                flex-basis: 34px;
            }

            .servicego-navbar .navbar-nav {
                gap: .3rem;
                flex-wrap: nowrap;
            }

                .servicego-navbar .navbar-nav .nav-item {
                    flex-shrink: 0;
                }

                .servicego-navbar .navbar-nav .nav-link,
                .servicego-navbar .header-greeting,
                .servicego-navbar .header-status {
                    font-size: .78rem;
                    padding-left: .42rem !important;
                    padding-right: .42rem !important;
                    font-weight: 700 !important;
                }

            .servicego-navbar .header-greeting {
                padding-left: .3rem;
                padding-right: .3rem;
            }

            .servicego-navbar .header-action[href*="HelpCenter"] {
                line-height: normal;
                text-align: left;
                white-space: nowrap;
                max-width: none;
                font-weight: 700 !important;
            }
        }

        /* Motion preference is handled by the small JS initializer below. */

        /*
                 * Home content redesign
                 * Header + hero remain unchanged. These styles affect only
                 * the content below the hero.
                 */
        .redesigned-section {
            position: relative;
            padding: 92px 0;
        }

        .section-heading {
            max-width: 760px;
            margin: 0 auto 52px;
        }

        .section-kicker {
            display: inline-block;
            margin-bottom: 12px;
            padding: 7px 14px;
            border-radius: 999px;
            background: rgba(240,173,78,.12);
            color: #d88920;
            font-size: .74rem;
            font-weight: 800;
            letter-spacing: .16em;
        }

        .section-heading h2 {
            margin: 0 0 14px;
            color: #241b14;
            font-size: clamp(2rem,3.2vw,2.75rem);
            font-weight: 850;
            letter-spacing: -.035em;
        }

        .section-heading p {
            margin: 0;
            color: #746b63;
            font-size: 1.03rem;
            line-height: 1.8;
        }

        .services {
            background: linear-gradient(180deg,#fff 0%,#fffaf4 100%);
        }

        .service-grid {
            align-items: stretch;
        }

        .modern-service-card {
            height: 100%;
            overflow: hidden;
            border: 1px solid rgba(82,57,35,.08);
            border-radius: 24px;
            background: #fff;
            box-shadow: 0 12px 35px rgba(76,52,30,.08);
            transition: transform .25s ease,box-shadow .25s ease,border-color .25s ease;
        }

            .modern-service-card:hover {
                transform: translateY(-8px);
                border-color: rgba(240,173,78,.45);
                box-shadow: 0 20px 48px rgba(76,52,30,.14);
            }

        .service-image-wrap {
            position: relative;
            height: 235px;
            overflow: hidden;
            background: #f7f1e9;
        }

            .service-image-wrap::after {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(180deg,transparent 55%,rgba(22,14,8,.28));
                pointer-events: none;
            }

            .service-image-wrap img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                transition: transform .45s ease;
            }

        .modern-service-card:hover .service-image-wrap img {
            transform: scale(1.055);
        }

        .service-number {
            position: absolute;
            top: 16px;
            right: 16px;
            z-index: 2;
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: rgba(255,255,255,.92);
            color: #c97715;
            font-size: .75rem;
            font-weight: 900;
            box-shadow: 0 6px 18px rgba(0,0,0,.12);
        }

        .service-content {
            padding: 24px 24px 27px;
        }

        .service-label {
            color: #c97715;
            font-size: .68rem;
            font-weight: 900;
            letter-spacing: .14em;
        }

        .service-content h3 {
            margin: 8px 0 8px;
            color: #251d17;
            font-size: 1.25rem;
            font-weight: 800;
        }

        .service-content p {
            margin: 0;
            color: #766d65;
            line-height: 1.65;
            font-size: .92rem;
        }

        .how-section {
            background: #fbf7f1;
            overflow: hidden;
        }

        .process-grid {
            position: relative;
        }

        .process-line {
            position: absolute;
            left: 18%;
            right: 18%;
            top: 245px;
            border-top: 2px dashed rgba(240,173,78,.45);
            z-index: 0;
        }

        .process-card {
            position: relative;
            z-index: 1;
            min-height: 285px;
            padding: 34px 28px;
            text-align: center;
            border: 1px solid rgba(70,48,27,.08);
            border-radius: 24px;
            background: rgba(255,255,255,.88);
            box-shadow: 0 12px 34px rgba(70,48,27,.07);
            transition: transform .25s ease,box-shadow .25s ease;
        }

            .process-card:hover {
                transform: translateY(-7px);
                box-shadow: 0 20px 42px rgba(70,48,27,.12);
            }

        .featured-process {
            background: linear-gradient(145deg,#fffaf1,#fff);
            border-color: rgba(240,173,78,.42);
            box-shadow: 0 18px 45px rgba(240,173,78,.16);
        }

        .process-icon {
            width: 72px;
            height: 72px;
            margin: 0 auto 20px;
            display: grid;
            place-items: center;
            border-radius: 22px;
            background: var(--primary-gradient);
            color: #fff;
            font-size: 2rem;
            font-weight: 800;
            box-shadow: 0 10px 24px rgba(240,173,78,.22);
        }

        .process-step {
            color: #c97715;
            font-size: .68rem;
            font-weight: 900;
            letter-spacing: .15em;
        }

        .process-card h3 {
            margin: 10px 0 10px;
            color: #2a211a;
            font-size: 1.22rem;
            font-weight: 800;
        }

        .process-card p {
            margin: 0;
            color: #766d65;
            line-height: 1.7;
            font-size: .94rem;
        }

        .why-section {
            background: #fff;
        }

        .why-panel {
            overflow: hidden;
            border: 1px solid rgba(70,48,27,.08);
            border-radius: 30px;
            background: #fbf7f1;
            box-shadow: 0 18px 55px rgba(60,43,26,.09);
        }

        .why-image-wrap {
            position: relative;
            min-height: 475px;
            height: 100%;
            overflow: hidden;
        }

            .why-image-wrap .why-slider-img {
                height: 100%;
                min-height: 475px;
                border-radius: 0;
                object-fit: cover;
            }

        .why-badge {
            position: absolute;
            left: 24px;
            bottom: 24px;
            display: flex;
            flex-direction: column;
            gap: 2px;
            padding: 14px 18px;
            border: 1px solid rgba(255,255,255,.4);
            border-radius: 15px;
            background: rgba(20,14,8,.68);
            color: #fff;
            backdrop-filter: blur(8px);
        }

            .why-badge strong {
                font-size: 1rem;
            }

            .why-badge span {
                color: rgba(255,255,255,.82);
                font-size: .78rem;
            }

        .why-copy {
            padding: 52px 54px;
        }

        .why-mini {
            color: #c97715;
            font-size: .7rem;
            font-weight: 900;
            letter-spacing: .16em;
        }

        .why-copy h3 {
            margin: 10px 0 16px;
            color: #281f18;
            font-size: clamp(1.65rem,2.4vw,2.25rem);
            line-height: 1.18;
            font-weight: 850;
            letter-spacing: -.03em;
        }

        .why-copy > p {
            margin: 0 0 25px;
            color: #71675e;
            line-height: 1.8;
        }

        .why-points {
            display: grid;
            gap: 17px;
        }

            .why-points > div {
                display: flex;
                align-items: flex-start;
                gap: 13px;
            }

                .why-points > div > span {
                    flex: 0 0 30px;
                    width: 30px;
                    height: 30px;
                    display: grid;
                    place-items: center;
                    border-radius: 50%;
                    background: #fff;
                    color: #d88920;
                    font-weight: 900;
                    box-shadow: 0 5px 15px rgba(70,48,27,.09);
                }

            .why-points p {
                margin: 0;
                color: #2d251e;
                font-size: .92rem;
                line-height: 1.45;
            }

            .why-points strong {
                display: block;
                font-size: .96rem;
            }

            .why-points small {
                display: block;
                margin-top: 3px;
                color: #776e66;
                font-size: .83rem;
                line-height: 1.5;
            }

        .more-section {
