        }

        .premium-process-card p {
            margin: 0;
            color: #776d64;
            line-height: 1.65;
            font-size: .9rem;
        }

        .premium-why {
            overflow: hidden;
            border-radius: 30px;
            background: #211913;
            box-shadow: 0 22px 65px rgba(50,34,21,.14);
        }

        .premium-why-image {
            height: 100%;
            min-height: 470px;
            overflow: hidden;
        }

            .premium-why-image img {
                width: 100%;
                height: 100%;
                min-height: 470px;
                object-fit: cover;
                display: block;
            }

        .premium-why-copy {
            padding: 52px;
            color: #fff;
        }

            .premium-why-copy .eyebrow {
                color: #f0ad4e;
                font-size: .7rem;
                font-weight: 900;
                letter-spacing: .16em;
            }

            .premium-why-copy h3 {
                margin: 10px 0 15px;
                font-size: clamp(1.7rem,3vw,2.5rem);
                line-height: 1.12;
                letter-spacing: -.035em;
                font-weight: 900;
            }

            .premium-why-copy > p {
                margin: 0 0 25px;
                color: rgba(255,255,255,.68);
                line-height: 1.8;
            }

        .premium-benefit {
            display: flex;
            gap: 12px;
            margin-bottom: 17px;
        }

        .premium-benefit-icon {
            flex: 0 0 32px;
            width: 32px;
            height: 32px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: rgba(240,173,78,.15);
            color: #f0ad4e;
            font-weight: 900;
        }

        .premium-benefit strong {
            display: block;
            margin-bottom: 2px;
            font-size: .93rem;
        }

        .premium-benefit span {
            color: rgba(255,255,255,.62);
            font-size: .82rem;
            line-height: 1.5;
        }

        .premium-cta {
            margin-top: 72px;
            padding: 48px 35px;
            border-radius: 28px;
            text-align: center;
            background: linear-gradient(135deg,#f0ad4e,#ef7d37 55%,#df665f);
            box-shadow: 0 20px 50px rgba(220,118,48,.22);
            color: #fff;
        }

            .premium-cta h2 {
                margin: 0 0 10px;
                font-size: clamp(1.8rem,3vw,2.6rem);
                font-weight: 900;
                letter-spacing: -.03em;
            }

            .premium-cta p {
                max-width: 650px;
                margin: 0 auto 22px;
                color: rgba(255,255,255,.88);
                line-height: 1.7;
            }

            .premium-cta .public-btn-secondary {
                background: #fff;
                color: #5b3d23;
                border: 0;
            }

        @@media (max-width: 900px) {
            .public-intro-grid {
                grid-template-columns: 1fr;
            }

            .process-wrap::before {
                display: none;
            }

            .premium-why-copy {
                padding: 38px 30px;
            }
        }

        @@media (max-width: 576px) {
            .public-intro,
            .premium-section {
                padding: 62px 0;
            }

            .public-intro-copy {
                padding: 30px 23px;
            }

            .public-intro-card {
                min-height: auto;
                padding: 27px 22px;
            }

            .premium-why-image,
            .premium-why-image img {
                min-height: 300px;
            }

            .premium-why-copy {
                padding: 32px 23px;
            }

            .premium-cta {
                margin-top: 48px;
                padding: 36px 22px;
            }
        }
    </style>

    <style id="sg-modal-polish">
        /* Softer, rounded Bootstrap modals */
        .modal-content {
            border: 0;
            border-radius: 18px;
            box-shadow: 0 18px 50px rgba(33, 37, 41, 0.22);
            overflow: hidden;
        }

        .modal-backdrop.show {
            opacity: 0.4;
        }
    </style>
</head>

<body>

    <!-- Navbar -->

    <nav class="navbar navbar-expand navbar-light bg-white shadow-sm sticky-top servicego-navbar">

        <div class="container">

            <a class="navbar-brand d-flex align-items-center"
               href="@Url.Action("Index", "Home")"
               aria-label="ServiceGo Home">

                <img src="/images/Logo.png"
                     alt="ServiceGo Logo"
                     width="40"
                     height="40"
                     class="me-2 servicego-logo"
                     loading="eager"
                     decoding="async" />

                <span class="fw-bold text-dark">ServiceGo</span>
            </a>

            <div class="navbar-collapse">
                <ul class="navbar-nav ms-auto align-items-center public-nav">

                    @if (!isLoggedIn || string.IsNullOrWhiteSpace(userRole))
                    {
                        <!-- Public homepage navigation: always shown after logout. -->
                        <li class="nav-item">
                            <a class="nav-link" href="#servicesSection">Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Login", "Home")">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Choserole", "Home")">Sign Up</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link header-action" href="@Url.Action("HelpCenter", "Home")">Help Center</a>
                        </li>
                    }
                    else if (userRole.Equals("Customer", StringComparison.OrdinalIgnoreCase))
                    {
                        <li class="nav-item">
                            <a class="nav-link header-action" href="@Url.Action("CusDashboard", "Customer")">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-logout" href="@Url.Action("Logout", "Home")">Logout</a>
                        </li>
                    }
                    else if (userRole.Equals("Provider", StringComparison.OrdinalIgnoreCase))
                    {
                        @if (providerState == "Incomplete")
                        {
                            <li class="nav-item">
                                <a class="nav-link header-action" href="@Url.Action("Register", "Home")">Complete Registration</a>
                            </li>
                        }
                        else if (providerState == "Pending")
                        {
                            <li class="nav-item">
                                <span class="header-status">Registration Pending</span>
                            </li>
                        }
                        else if (providerState == "Rejected")
                        {
                            <li class="nav-item">
                                <a class="nav-link header-action" href="@Url.Action("ReRegistration", "Home")">Update Registration</a>
                            </li>
                        }
                        else if (providerState == "Approved")
                        {
                            <li class="nav-item">
                                <a class="nav-link header-action" href="@Url.Action("Dashboard", "Provider")">Dashboard</a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link nav-logout" href="@Url.Action("Logout", "Home")">Logout</a>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </nav>


    <!-- Main -->

    <main>
        <!-- Public logged-out users land directly on this Home/Index page. -->
        <!-- Hero -->
        @if (!isLoggedIn)
        {
            <section class="hero-slider-container"
                     aria-label="ServiceGo introduction">

                <div id="serviceGoHeroSlider"
                     class="carousel slide carousel-fade"
                     data-bs-ride="carousel"
                     data-bs-interval="4000"
                     data-bs-pause="false">

                    <div class="carousel-inner">

                        <!-- First / lcp slide -->

                        <div class="carousel-item active">

                            <div class="slider-overlay"
                                 aria-hidden="true"></div>

                            <img src="/images/Engineers.png"
                                 class="d-block w-100 slider-img"
                                 width="1920"
                                 height="580"
                                 alt="ServiceGo professional service providers"
                                 loading="eager"
                                 fetchpriority="high"
                                 decoding="async" />

                        </div>


                        <!-- Second slide -->

                        <div class="carousel-item">

                            <div class="slider-overlay"
                                 aria-hidden="true"></div>

                            <img src="/images/background.png"
                                 class="d-block w-100 slider-img"
                                 width="1920"
                                 height="1080"
                                 alt="ServiceGo home services"
                                 loading="lazy"
                                 fetchpriority="low"
                                 decoding="async" />

                        </div>


                        <!-- Third slide -->

                        <div class="carousel-item">

                            <div class="slider-overlay"
                                 aria-hidden="true"></div>

                            <img src="/images/Image.png"
                                 class="d-block w-100 slider-img"
                                 width="1920"
                                 height="1080"
                                 alt="ServiceGo local professionals"
                                 loading="lazy"
                                 fetchpriority="low"
                                 decoding="async" />

                        </div>

                    </div>

                </div>


                <!-- Fixed hero content -->

                <div class="slider-fixed-content text-center text-white">

                    @if (!isLoggedIn)
                    {
                        <h1 class="fw-bold display-5 mb-0">
                            SERVICEGO: Your Local Service Solution
                        </h1>

                        <p class="lead mt-3 mb-0">
                            A simple platform to find, connect with and book verified service providers.
                        </p>

                        <div class="mt-4">
                            <a href="@Url.Action("SearchResult", "Home")"
                               class="btn btn-warning btn-lg fw-bold px-5 py-3 shadow">
                                Explore Providers
                            </a>
                        </div>
                    }
                    else if (userRole.Equals("Customer", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="hero-welcome">
                            Hey @(string.IsNullOrWhiteSpace(customerName) ? "Customer" : customerName.Split(' ')[0]), Welcome to ServiceGo
                        </div>

                        <h1 class="fw-bold display-5 mb-0">
                            Find the Right Service for You
                        </h1>

                        <p class="lead mt-3 mb-0">
                            Discover trusted local professionals, compare their services and book the help you need.
                        </p>

                        <div class="mt-4 d-flex flex-wrap justify-content-center gap-3">
                            <a href="@Url.Action("SearchResult", "Home")"
                               class="btn btn-warning btn-lg fw-bold px-5 py-3 shadow">
                                Find Services
                            </a>
                            <a href="@Url.Action("CusDashboard", "Customer")"
                               class="btn btn-light btn-lg fw-bold px-4 py-3 shadow">
                                My Dashboard
                            </a>
                        </div>
                    }
                    else if (userRole.Equals("Provider", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="hero-welcome">
                            Welcome back, @(string.IsNullOrWhiteSpace(providerName) ? "Provider" : providerName.Split(' ')[0])
                        </div>

                        <h1 class="fw-bold display-5 mb-0">
                            Grow Your Service Business with ServiceGo
                        </h1>

                        <p class="lead mt-3 mb-0">
                            Manage your professional profile, stay connected with customers and keep your services ready for bookings.
                        </p>

                        <div class="mt-4">
                            @if (providerState == "Incomplete")
                            {
                                <a href="@Url.Action("Register", "Home")"
                                   class="btn btn-warning btn-lg fw-bold px-5 py-3 shadow">
                                    Complete Registration
                                </a>
                            }
                            else if (providerState == "Pending")
                            {
                                <div class="provider-hero-status pending">
                                    <div class="provider-hero-status-title">
                                        Your Registration Is Under Review
                                    </div>
                                    <p class="provider-hero-status-message">
                                        Your registration has been submitted successfully.
                                        Our admin is reviewing your details and will update you once a decision is made.
                                    </p>
                                </div>
                            }
                            else if (providerState == "Rejected")
                            {
                                <div class="provider-hero-status rejected">
                                    <div class="provider-hero-status-title">
                                        Registration Update Required
                                    </div>

                                    <p class="provider-hero-status-message">
                                        Please review the reason below and update your registration.
                                    </p>

                                    @if (!string.IsNullOrWhiteSpace(providerRejectionReason))
                                    {
                                        <div class="provider-reason">
                                            <strong>Admin's Reason:</strong>
                                            @providerRejectionReason
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="provider-reason">
                                            <strong>Reason:</strong>
                                            Please update your registration details and submit them again for review.
                                        </div>
                                    }
                                </div>

                                <a href="@Url.Action("ReRegistration", "Home")"
                                   class="btn btn-warning btn-lg fw-bold px-5 py-3 shadow mt-3">
                                    Update Registration
                                </a>
                            }
                            else
                            {
                                <a href="@Url.Action("Dashboard", "Provider")"
                                   class="btn btn-warning btn-lg fw-bold px-5 py-3 shadow">
                                    Open Provider Dashboard
                                </a>
                            }
                        </div>
                    }

                </div>

            </section>
        }


        @if (isLoggedIn && userRole.Equals("Provider", StringComparison.OrdinalIgnoreCase))
        {
            <!--
               Provider home
               Logged-in provider home starts directly below the header.
            -->
            <section class="role-home">
                <div class="container role-home-shell">
                    <div class="role-home-top">
                        <div>
                            <span class="role-home-eyebrow">Provider Home</span>
                            <h2 class="role-home-title">Welcome back, @(string.IsNullOrWhiteSpace(providerName) ? "Provider" : providerName)</h2>
                            <p class="role-home-subtitle">Your professional space is ready. Manage your ServiceGo profile, stay on top of customer activity and keep your services ready for new bookings.</p>
                        </div>
                        @if (providerState == "Approved")
                        {
                            <a class="role-home-primary" href="@Url.Action("Dashboard", "Provider")">Open Provider Dashboard</a>
                        }
                        else if (providerState == "Incomplete")
                        {
                            <a class="role-home-primary" href="@Url.Action("Register", "Home")">Complete Registration</a>
                        }
                        else if (providerState == "Rejected")
                        {
                            <a class="role-home-primary" href="@Url.Action("ReRegistration", "Home")">Update Registration</a>
                        }
                    </div>

                    @if (providerState == "Pending")
                    {
                        <div class="role-status-card pending">
                            <h3 class="role-status-title">Registration is under review</h3>
                            <p class="role-status-text">Your provider registration has been submitted successfully. The admin team is reviewing your details. You can return here after approval to access your provider workspace.</p>
                        </div>
                    }
                    else if (providerState == "Rejected")
                    {
                        <div class="role-status-card rejected">
                            <h3 class="role-status-title">Registration update required</h3>
                            <p class="role-status-text">Your registration needs an update before it can be approved. Please review the admin feedback and submit the corrected information.</p>
                            <div class="role-status-reason"><strong>Admin feedback:</strong> @(string.IsNullOrWhiteSpace(providerRejectionReason) ? "Please update your registration details and submit them again for review." : providerRejectionReason)</div>
                        </div>
                    }
                    else if (providerState == "Incomplete")
                    {
                        <div class="role-status-card incomplete">
                            <h3 class="role-status-title">Complete your provider profile</h3>
                            <p class="role-status-text">Finish your registration so your professional information, services, availability and location can be used by customers.</p>
                        </div>
                    }

                    <div class="role-stat-grid">
                        <div class="role-stat-card"><div class="role-stat-icon">P</div><div class="role-stat-label">Provider ID</div><div class="role-stat-value">@(string.IsNullOrWhiteSpace(providerCode) ? "Not assigned yet" : providerCode)</div></div>
                        <div class="role-stat-card"><div class="role-stat-icon">✓</div><div class="role-stat-label">Account status</div><div class="role-stat-value">@providerState</div></div>
                        <div class="role-stat-card"><div class="role-stat-icon">S</div><div class="role-stat-label">ServiceGo role</div><div class="role-stat-value">Professional Provider</div></div>
                    </div>

                    <div class="role-action-grid">
                        <a class="role-action-card" href="@Url.Action("Dashboard", "Provider")"><div class="role-action-icon">⌂</div><h3>Provider Dashboard</h3><p>Open your main provider workspace and manage your current ServiceGo activity.</p></a>
                        <a class="role-action-card" href="@(providerState == "Approved" ? Url.Action("Profile", "Provider") : Url.Action("Profile", "Provider"))"><div class="role-action-icon">✎</div><h3>Professional Profile</h3><p>Keep your registration information, services, availability and service locations up to date.</p></a>
                        <a class="role-action-card" href="@Url.Action("HelpCenter", "Home")"><div class="role-action-icon">?</div><h3>Provider Support</h3><p>Need help with your account or registration? Visit the ServiceGo Help Center.</p></a>
                    </div>

                    <div class="role-home-note">Your provider home is separate from the customer experience. Customers see their own service-focused home, while your provider tools remain focused on your professional work.</div>
                </div>
            </section>
        }
        else if (isLoggedIn && userRole.Equals("Customer", StringComparison.OrdinalIgnoreCase))
        {
            <!--
               Customer home
               Logged-in provider home starts directly below the header.
            -->
            <section class="role-home">
                <div class="container role-home-shell">
                    <div class="role-home-top">
                        <div>
                            <span class="role-home-eyebrow">Customer Home</span>
                            <h2 class="role-home-title">Welcome back, @(string.IsNullOrWhiteSpace(customerName) ? "Customer" : customerName)</h2>
                            <p class="role-home-subtitle">Find trusted local professionals, manage your bookings and keep your ServiceGo activity organized from one simple place.</p>
                        </div>
                        <a class="role-home-primary" href="@Url.Action("SearchResult", "Home")">Find a Service</a>
                    </div>

                    @if (ViewBag.CustomerProfileIncomplete == true)
                    {
                        <div class="role-status-card incomplete">
                            <h3 class="role-status-title">Complete your customer profile</h3>
                            <p class="role-status-text">Add your basic profile details to make your ServiceGo experience smoother.</p>
                            <div class="mt-3"><a class="role-home-primary" href="@Url.Action("CusDashboard", "Customer", new { openProfile = "1" })">Complete Profile</a></div>
                        </div>
                    }

                    <div class="role-stat-grid">
                        <div class="role-stat-card"><div class="role-stat-icon">⌕</div><div class="role-stat-label">Discover</div><div class="role-stat-value">Local service providers</div></div>
                        <div class="role-stat-card"><div class="role-stat-icon">✓</div><div class="role-stat-label">Booking</div><div class="role-stat-value">Manage your service requests</div></div>
                        <div class="role-stat-card"><div class="role-stat-icon">★</div><div class="role-stat-label">Experience</div><div class="role-stat-value">Ratings &amp; service feedback</div></div>
                    </div>

                    <div class="role-action-grid">
                        <a class="role-action-card" href="@Url.Action("SearchResult", "Home")"><div class="role-action-icon">⌕</div><h3>Find a Provider</h3><p>Search providers by service and location, review their information and choose the service you need.</p></a>
                        <a class="role-action-card" href="@Url.Action("CusDashboard", "Customer")"><div class="role-action-icon">▣</div><h3>My Dashboard</h3><p>View your bookings, account activity, notifications and customer options in one place.</p></a>
                        <a class="role-action-card" href="@Url.Action("HelpCenter", "Home")"><div class="role-action-icon">?</div><h3>Customer Support</h3><p>Get help with your ServiceGo account, bookings or other customer questions.</p></a>
                    </div>

                    <div class="role-home-note">Your customer home is separate from the provider experience. The provider portal has its own professional workspace, while your home stays focused on finding and managing services.</div>
                </div>
            </section>
        }
        else
        {
            <!--
               Public servicego home
               Logged-in customer home starts directly below the header.
            -->

            <div class="public-home">

                <section class="public-intro">
                    <div class="container">
                        <div class="public-intro-grid">

                            <div class="public-intro-copy">
                                <span class="public-kicker">SERVICEGO • LOCAL SERVICES</span>
                                <h2>Everything you need, <span>right when you need it.</span></h2>
                                <p>
                                    Discover skilled local professionals, compare provider details,
                                    check ratings and book the service that fits your needs — all from
                                    one simple ServiceGo experience.
                                </p>

                                <div class="public-intro-actions">
                                    <a class="public-btn-primary" href="@Url.Action("SearchResult", "Home")">
                                        Explore Providers
                                    </a>
                                    <a class="public-btn-secondary" href="#servicesSection">
                                        View Services
                                    </a>
                                </div>
                            </div>

                            <div class="public-intro-card">
                                <h3>Why people choose ServiceGo</h3>

                                <ul class="public-trust-list">
                                    <li>
                                        <div class="public-trust-icon">✓</div>
                                        <div>
                                            <strong>Discover local professionals</strong>
                                            <span>Browse services and providers in a straightforward experience.</span>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="public-trust-icon">★</div>
                                        <div>
                                            <strong>Review before you book</strong>
                                            <span>See provider information, ratings and customer feedback.</span>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="public-trust-icon">⌂</div>
                                        <div>
                                            <strong>Book the way you need</strong>
                                            <span>Choose available services and continue with your booking.</span>
                                        </div>
                                    </li>
                                </ul>
                            </div>

                        </div>
                    </div>
                </section>

                <section id="servicesSection" class="premium-section soft">
                    <div class="container">

                        <div class="premium-heading">
                            <span class="eyebrow">POPULAR SERVICES</span>
                            <h2>Professional help for everyday needs</h2>
                            <p>
                                From quick repairs to home improvement, explore the services available
                                through ServiceGo.
                            </p>
                        </div>

                        <div class="row g-4">

                            <div class="col-lg-4 col-md-6">
                                <div class="premium-service-card">
                                    <div class="premium-service-image">
                                        <img src="/images/Plumber.png" alt="Plumbing Work" loading="lazy" decoding="async" />
                                    </div>
                                    <div class="premium-service-body">
                                        <span class="premium-service-tag">HOME ESSENTIAL</span>
                                        <h3>Plumbing Work</h3>
                                        <p>Help with leaks, fittings, repairs and everyday plumbing needs.</p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-6">
                                <div class="premium-service-card">
                                    <div class="premium-service-image">
                                        <img src="/images/Electrician.png" alt="Electrical Repair" loading="lazy" decoding="async" />
                                    </div>
                                    <div class="premium-service-body">
                                        <span class="premium-service-tag">HOME ESSENTIAL</span>
                                        <h3>Electrical Repair</h3>
                                        <p>Professional support for electrical repairs and installations.</p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-6">
                                <div class="premium-service-card">
                                    <div class="premium-service-image">
                                        <img src="/images/AC repair.png" alt="AC and Fridge Repair" loading="lazy" decoding="async" />
                                    </div>
                                    <div class="premium-service-body">
                                        <span class="premium-service-tag">APPLIANCE CARE</span>
                                        <h3>AC &amp; Fridge Repair</h3>
                                        <p>Get cooling appliances checked, repaired and ready for use.</p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-6">
                                <div class="premium-service-card">
                                    <div class="premium-service-image">
                                        <img src="/images/Carpenter.png" alt="Carpentry and Woodwork" loading="lazy" decoding="async" />
                                    </div>
                                    <div class="premium-service-body">
                                        <span class="premium-service-tag">HOME IMPROVEMENT</span>
                                        <h3>Carpentry &amp; Woodwork</h3>
                                        <p>Practical woodwork, repairs and home improvement support.</p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-6">
                                <div class="premium-service-card">
                                    <div class="premium-service-image">
                                        <img src="@Url.Content("~/images/Car mechanic.png")" alt="Car Mechanic Services" loading="lazy" decoding="async" />
                                    </div>
                                    <div class="premium-service-body">
                                        <span class="premium-service-tag">AUTOMOTIVE</span>
                                        <h3>Car Mechanic</h3>
                                        <p>Get your car checked and repaired by trusted professional mechanics.</p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-6">
                                <div class="premium-service-card">
                                    <div class="premium-service-image">
                                        <img src="/images/Welder.png" alt="Welding Services" loading="lazy" decoding="async" />
