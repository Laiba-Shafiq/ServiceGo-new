@model ServiceGo.Models.ResetPassword
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ServiceGo - Reset Password</title>
    <link rel="icon" href="@Url.Content("~/images/Logo.png")" type="image/x-icon" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 12px;
            background: linear-gradient(135deg,#f8f9fa,#fff5e8);
            font-family: Poppins,Arial,sans-serif;
            caret-color: transparent;
        }

        input, textarea, select, button {
            caret-color: auto;
        }

        .card-box {
            width: 92%;
            max-width: 450px;
            background: #fff;
            padding: 36px;
            border-radius: 24px;
            box-shadow: 0 14px 40px rgba(0,0,0,.12);
        }

        .logo {
            width: 82px;
            height: 82px;
            object-fit: contain;
            display: block;
            margin: 0 auto 12px;
        }

        h3 {
            font-weight: 700;
            color: #f0ad4e;
        }

        .password-wrap {
            position: relative;
        }

            .password-wrap .form-control {
                padding-right: 50px;
            }

        .show-password {
            position: absolute;
            right: 9px;
            top: 50%;
            transform: translateY(-50%);
            width: 34px;
            height: 34px;
            border: 0;
            border-radius: 50%;
            background: transparent;
            color: #6b7280;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            padding: 0;
        }

            .show-password:hover {
                background: #f7f7f7;
                color: #d58f30;
            }

            .show-password svg {
                width: 19px;
                height: 19px;
            }

        .form-control {
            border-radius: 11px;
            padding: 11px 12px;
        }

            .form-control:focus {
                border-color: #f0ad4e;
                box-shadow: 0 0 0 .2rem rgba(240,173,78,.14);
            }

        .btn-main {
            width: 100%;
            padding: 12px;
            border: 0;
            border-radius: 11px;
            background: linear-gradient(180deg,#f0ad4e,#e39e3e);
            color: #fff;
            font-weight: 700;
        }

            .btn-main:disabled {
                opacity: .7;
                cursor: wait;
            }

        .field-error {
            min-height: 19px;
            color: #dc3545;
            font-size: .78rem;
            margin-top: 5px;
            font-weight: 500;
        }

            .field-error:empty {
                display: none;
            }

        .validation-summary {
            color: #842029;
            font-size: .82rem;
            margin: 0 0 10px;
            padding: 0;
            background: transparent;
            border: 0;
            border-radius: 0;
        }

            .validation-summary:empty {
                display: none;
            }

        .hint {
            font-size: .78rem;
            color: #6b7280;
            margin-top: 5px;
        }

        .back {
            display: block;
            text-align: center;
            margin-top: 18px;
            color: #e39e3e;
            text-decoration: none;
            font-weight: 600;
        }

        @@media (max-width:576px) {
            .card-box {
                padding: 28px 20px;
            }
        }

        /* Keep exactly one password visibility icon. Hide browser-native reveal/clear icons. */
        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear {
            display: none;
            width: 0;
            height: 0;
        }

        input[type="password"]::-webkit-credentials-auto-fill-button {
            visibility: hidden;
            pointer-events: none;
            position: absolute;
            right: 0;
        }
        /* Bootstrap adds a validation icon inside invalid inputs; remove it so it never sits under the eye icon. */
        .form-control.is-invalid,
        .was-validated .form-control:invalid {
            background-image: none !important;
        }

        .input-wrap .form-control.is-invalid,
        .password-wrap .form-control.is-invalid {
            background-image: none !important;
        }
    </style>
</head>
<body>
    <div class="card-box">
        <img src="@Url.Content("~/images/Logo.png")" alt="ServiceGo Logo" class="logo" />
        <h3 class="text-center mb-2">Create New Password</h3>
        <p class="text-muted text-center mb-4">Choose a strong password for your ServiceGo account.</p>

        <form id="resetPasswordForm" action="@Url.Action("ResetPassword", "Home")"
              method="post" autocomplete="off" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="Email" id="ResetEmail" value="@Model.Email" />

            <div id="serverMessage" class="validation-summary"></div>

            <div class="mb-3">
                <label for="NewPassword" class="form-label fw-semibold">New Password</label>
                <div class="password-wrap">
                    <input id="NewPassword" name="NewPassword" class="form-control" type="password"
                           autocomplete="new-password" minlength="6" required />
                    <button type="button" class="show-password" data-target="NewPassword"
                            aria-label="Show password" title="Show password">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                <div id="newPasswordError" class="field-error"></div>
                <div class="hint">Minimum 6 characters • uppercase • lowercase • number • symbol. Longer is allowed.</div>
            </div>

            <div class="mb-3">
                <label for="ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
                <div class="password-wrap">
                    <input id="ConfirmPassword" name="ConfirmPassword" class="form-control" type="password"
                           autocomplete="new-password" minlength="6" required />
                    <button type="button" class="show-password" data-target="ConfirmPassword"
                            aria-label="Show password" title="Show password">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                <div id="confirmPasswordError" class="field-error"></div>
            </div>

            <button id="resetBtn" type="submit" class="btn-main">Reset Password</button>
        </form>

        <a class="back" href="@Url.Action("Login", "Home")">Back to Login</a>
    </div>

    <script>
        (() => {
            const form = document.getElementById("resetPasswordForm");
            const newPassword = document.getElementById("NewPassword");
            const confirmPassword = document.getElementById("ConfirmPassword");
            const resetBtn = document.getElementById("resetBtn");
            const serverMessage = document.getElementById("serverMessage");
            const newError = document.getElementById("newPasswordError");
            const confirmError = document.getElementById("confirmPasswordError");
            const hiddenEmail = document.getElementById("ResetEmail");

            function clearErrors() {
                serverMessage.textContent = "";
                newError.textContent = "";
                confirmError.textContent = "";
                newPassword.classList.remove("is-invalid");
                confirmPassword.classList.remove("is-invalid");
            }

            function validate() {
                clearErrors();
                let valid = true;
                const password = newPassword.value || "";
                const confirm = confirmPassword.value || "";

                if (!password) {
                    newError.textContent = "New password is required.";
                    newPassword.classList.add("is-invalid");
                    valid = false;
                } else if (!/^(?=.{6,}$)(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z\d]).+$/.test(password)) {
                    newError.textContent = "Use at least 6 characters with uppercase, lowercase, number and symbol.";
                    newPassword.classList.add("is-invalid");
                    valid = false;
                }

                if (!confirm) {
                    confirmError.textContent = "Please confirm your password.";
                    confirmPassword.classList.add("is-invalid");
                    valid = false;
                } else if (password !== confirm) {
                    confirmError.textContent = "Passwords do not match.";
                    confirmPassword.classList.add("is-invalid");
                    valid = false;
                }

                return valid;
            }

            function showBackendErrors(items) {
                if (!Array.isArray(items)) return;
                items.forEach(item => {
                    const field = String(item.field || item.Field || "");
                    const messages = item.errors || item.Errors || [];
                    const message = Array.isArray(messages) ? messages[0] : String(messages);

                    if (field === "NewPassword") {
                        newError.textContent = message;
                        newPassword.classList.add("is-invalid");
                    } else if (field === "ConfirmPassword") {
                        confirmError.textContent = message;
                        confirmPassword.classList.add("is-invalid");
                    } else if (message) {
                        serverMessage.textContent = message;
                    }
                });
            }

            form.addEventListener("submit", async event => {
                event.preventDefault();

                if (!validate()) {
                    form.querySelector(".is-invalid")?.focus();
                    return;
                }

                resetBtn.disabled = true;
                resetBtn.textContent = "Updating Password...";

                try {
                    const formData = new FormData(form);
                    formData.set("Email", hiddenEmail.value || "");
                    formData.set("NewPassword", newPassword.value || "");
                    formData.set("ConfirmPassword", confirmPassword.value || "");

                    const response = await fetch(form.action, {
                        method: "POST",
                        body: formData,
                        headers: {
                            "X-Requested-With": "XMLHttpRequest",
                            "Accept": "application/json"
                        },
                        credentials: "same-origin"
                    });

                    const contentType = response.headers.get("content-type") || "";
                    if (!contentType.toLowerCase().includes("application/json")) {
                        throw new Error("Unexpected server response. Please try again.");
                    }

                    const result = await response.json();

                    if (result.success === true) {
                        window.location.href = result.redirectUrl || "@Url.Action("Login", "Home")";
                        return;
                    }

                    serverMessage.textContent = result.message || "Please correct the password fields.";
                    showBackendErrors(result.errors);
                } catch (error) {
                    console.error(error);
                    serverMessage.textContent = error.message || "Password could not be updated right now. Please try again.";
                } finally {
                    resetBtn.disabled = false;
                    resetBtn.textContent = "Reset Password";
                }
            });

            [newPassword, confirmPassword].forEach(input => {
                input.addEventListener("input", () => {
                    if (input === newPassword) newError.textContent = "";
                    if (input === confirmPassword) confirmError.textContent = "";
                    input.classList.remove("is-invalid");

                    if (confirmPassword.value) {
                        if (newPassword.value !== confirmPassword.value) {
                            confirmError.textContent = "Passwords do not match.";
                            confirmPassword.classList.add("is-invalid");
                        }
                    }
                });
            });

            document.querySelectorAll(".show-password").forEach(button => {
                button.addEventListener("click", () => {
                    const input = document.getElementById(button.dataset.target);
                    if (!input) return;
                    const showing = input.type === "text";
                    input.type = showing ? "password" : "text";
                    button.setAttribute("aria-label", showing ? "Show password" : "Hide password");
                    button.setAttribute("title", showing ? "Show password" : "Hide password");
                });
            });
        })();
    </script>
</body>
</html>
