@{
    Layout = null;
    var verificationError = ViewBag.VerificationError as string ?? "";
    var verificationEmail = ViewBag.VerificationEmail as string ?? "";
    bool showVerificationPrompt = ViewBag.ShowVerificationPrompt == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Provider Signup - ServiceGo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" href="~/images/Logo.png" type="image/x-icon">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand: #f0ad4e;
            --brand-dark: #e39e3e;
        }

        body {
            font-family: 'Poppins',sans-serif;
            min-height: 100vh;
            margin: 0;
            padding: 24px 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg,#f8f9fa,#fff5e8);
            caret-color: transparent;
        }

        input, button {
            caret-color: auto;
        }

        .card {
            width: 100%;
            max-width: 500px;
            background: #fff;
            padding: 36px 40px;
            border: 0;
            border-radius: 22px;
            box-shadow: 0 14px 40px rgba(0,0,0,.10);
        }

        .logo {
            width: 78px;
            display: block;
            margin: 0 auto 12px;
            cursor: pointer;
        }

        h3 {
            color: var(--brand);
            font-weight: 700;
            text-align: center;
            margin-bottom: 6px;
        }

        .subtitle {
            color: #6b7280;
            text-align: center;
            font-size: .9rem;
            margin-bottom: 26px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            font-weight: 600;
        }

        .input-wrap {
            position: relative;
        }

        .form-control {
            border-radius: 11px;
            padding: 11px 48px 11px 12px;
        }

            .form-control:focus {
                border-color: var(--brand);
                box-shadow: 0 0 0 .2rem rgba(240,173,78,.14);
            }

        .password-toggle {
            position: absolute;
            right: 9px;
            top: 50%;
            transform: translateY(-50%);
            width: 34px;
            height: 34px;
            border: 0;
            border-radius: 50%;
            background: transparent;
            color: #6b7280;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            cursor: pointer;
        }

            .password-toggle:hover {
                background: #f7f7f7;
                color: var(--brand-dark);
            }

            .password-toggle svg {
                width: 19px;
                height: 19px;
            }

        .field-error {
            min-height: 19px;
            color: #dc3545;
            font-size: .78rem;
            margin-top: 5px;
            font-weight: 500;
        }

            .field-error:empty {
                display: none;
            }

        .server-error {
            color: #842029;
            background: #fff5f5;
            border: 1px solid #f3c2c2;
            border-radius: 10px;
            padding: 10px 12px;
            margin-bottom: 16px;
            font-size: .82rem;
        }

            .server-error:empty {
                display: none;
            }

        .hint {
            color: #6b7280;
            font-size: .75rem;
            margin-top: 5px;
        }

        .btn-main {
            width: 100%;
            padding: 12px;
            border: 0;
            border-radius: 11px;
            background: linear-gradient(180deg,var(--brand),var(--brand-dark));
            color: #fff;
            font-weight: 700;
        }

            .btn-main:disabled {
                opacity: .7;
                cursor: wait;
            }

        .back {
            display: block;
            text-align: center;
            margin-top: 16px;
            color: #6f42c1;
            text-decoration: none;
            font-weight: 600;
            font-size: .9rem;
        }

        .email-check-note {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 11px 13px;
            margin: 0 0 18px;
            border: 1px solid #cfe9d9;
            border-radius: 10px;
            background: #f3fff7;
            color: #47745a;
            font-size: .78rem;
            line-height: 1.45;
        }

            .email-check-note strong {
                display: block;
                color: #3d8a5d;
                font-size: .84rem;
                margin-bottom: 2px;
            }

            .email-check-note span {
                display: block;
            }

        .email-check-icon {
            width: 24px;
            height: 24px;
            flex: 0 0 24px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: #d8f3e2;
            color: #3c9a61;
            font-weight: 800;
            margin-top: 1px;
        }

        @@media (max-width:576px) {
            .card {
                padding: 28px 20px;
            }
        }

        /* Keep exactly one password visibility icon. Hide browser-native reveal/clear icons. */
        input[type="password"]::-ms-reveal,
        input[type="password"]::-ms-clear {
            display: none;
            width: 0;
            height: 0;
        }

        /* Bootstrap adds a validation icon inside invalid inputs; remove it so it never sits under the eye icon. */
        .form-control.is-invalid,
        .was-validated .form-control:invalid {
            background-image: none !important;
        }

        .input-wrap .form-control.is-invalid,
        .password-wrap .form-control.is-invalid {
            background-image: none !important;
        }

        /* ServiceGo polished validation/caret styling */
        body, body * {
            caret-color: transparent;
        }

        input, textarea, select, [contenteditable="true"] {
            caret-color: auto;
        }

            input:focus, textarea:focus, select:focus {
                caret-color: var(--brand);
            }

        .field-error {
            min-height: 18px;
            margin-top: 6px;
            padding-left: 2px;
            color: #d56a9f !important;
            font-size: .77rem;
            font-weight: 600;
            line-height: 1.35;
        }

            .field-error:empty {
                display: none;
            }

        .server-error:empty {
            display: none;
        }

        .server-error {
            color: #c56a8f;
            background: #fff7fa;
            border: 1px solid #f3cddd;
            border-radius: 10px;
            padding: 9px 12px;
            margin-bottom: 14px;
            font-size: .8rem;
        }

        .logo-link {
            display: block;
            width: max-content;
            margin: 0 auto 12px;
            line-height: 0;
        }

            .logo-link .logo {
                margin: 0;
            }
    </style>
</head>
<body>
    <div class="card">
        <a href="@Url.Action("Index", "Home")" class="logo-link" aria-label="Go to ServiceGo Home"><img src="~/images/Logo.png" alt="ServiceGo Logo" class="logo"></a>
        <h3>Provider Signup</h3>
        <div class="subtitle">Create your provider account and verify your email.</div>

        @if (showVerificationPrompt)
        {
            <div class="email-check-note" role="status">
                <div class="email-check-icon">✓</div>
                <div>
                    <strong>Please check your email</strong>
                    <span>We sent a verification link to <b>@verificationEmail</b>. Open your email and click <b>Verify Email Address</b> to continue.</span>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(verificationError))
        {
            <div class="server-error">@verificationError</div>
        }
        <form asp-action="ProviderRegistrationStep1" asp-controller="Home"
              method="post" id="providerSignupForm" novalidate>
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="Name" class="form-label">Full Name</label>
                <input id="Name" name="Name" type="text" class="form-control"
                       value="@ViewData["SignupName"]" autocomplete="name">
                <div class="field-error">@ViewData.ModelState["Name"]?.Errors.FirstOrDefault()?.ErrorMessage</div>
            </div>

            <div class="form-group">
                <label for="Email" class="form-label">Email Address</label>
                <input id="Email" name="Email" type="email" class="form-control"
                       value="@ViewData["SignupEmail"]" autocomplete="email">
                <div class="field-error">@ViewData.ModelState["Email"]?.Errors.FirstOrDefault()?.ErrorMessage</div>
            </div>

            <div class="form-group">
                <label for="Password" class="form-label">Password</label>
                <div class="input-wrap">
                    <input id="Password" name="Password" type="password" class="form-control"
                           autocomplete="new-password" minlength="6" required>
                    <button type="button" class="password-toggle" data-target="Password"
                            aria-label="Show password" title="Show password">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                <div class="field-error">@ViewData.ModelState["Password"]?.Errors.FirstOrDefault()?.ErrorMessage</div>
                <div class="hint">Minimum 6 characters • uppercase • lowercase • number • symbol</div>
            </div>

            <div class="form-group">
                <label for="ConfirmPassword" class="form-label">Confirm Password</label>
                <div class="input-wrap">
                    <input id="ConfirmPassword" name="ConfirmPassword" type="password" class="form-control"
                           autocomplete="new-password" minlength="6" required>
                    <button type="button" class="password-toggle" data-target="ConfirmPassword"
                            aria-label="Show password" title="Show password">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>
                <div class="field-error">@ViewData.ModelState["ConfirmPassword"]?.Errors.FirstOrDefault()?.ErrorMessage</div>
            </div>

            <button type="submit" id="providerSignupBtn" class="btn-main">Sign Up</button>
        </form>

        <a href="@Url.Action("Login", "Home")" class="back">Already have an account? Login</a>
    </div>

    <script>
        (() => {
            const form = document.getElementById("providerSignupForm");
            const name = document.getElementById("Name");
            const email = document.getElementById("Email");
            const password = document.getElementById("Password");
            const confirm = document.getElementById("ConfirmPassword");
            const button = document.getElementById("providerSignupBtn");

            function errorBox(input) {
                return input.closest(".form-group")?.querySelector(".field-error");
            }

            function setError(input, message) {
                const box = errorBox(input);
                if (box) box.textContent = message || "";
                input.classList.toggle("is-invalid", !!message);
            }

            function validate() {
                let valid = true;
                [name,email,password,confirm].forEach(i => setError(i, ""));

                if (!name.value.trim()) { setError(name, "Full Name is required."); valid = false; }

                if (!email.value.trim()) {
                    setError(email, "Email is required."); valid = false;
                } else if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email.value.trim())) {
                    setError(email, "Please enter a valid email address."); valid = false;
                }

                if (!password.value) {
                    setError(password, "Password is required."); valid = false;
                } else if (!/^(?=.{6,}$)(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z\d]).+$/.test(password.value)) {
                    setError(password, "Use at least 6 characters with uppercase, lowercase, number and symbol."); valid = false;
                }

                if (!confirm.value) {
                    setError(confirm, "Please confirm your password."); valid = false;
                } else if (password.value !== confirm.value) {
                    setError(confirm, "Passwords do not match."); valid = false;
                }

                return valid;
            }

            form.addEventListener("submit", event => {
                if (!validate()) {
                    event.preventDefault();
                    form.querySelector(".is-invalid")?.focus();
                    return;
                }
                button.disabled = true;
                button.textContent = "Sending verification email...";
            });

            [name,email,password,confirm].forEach(input => {
                input.addEventListener("input", () => {
                    if (input.value.trim()) setError(input, "");
                    if (input === password || input === confirm) {
                        if (confirm.value && password.value !== confirm.value) {
                            setError(confirm, "Passwords do not match.");
                        } else if (confirm.value) {
                            setError(confirm, "");
                        }
                    }
                });
            });

            document.querySelectorAll(".password-toggle").forEach(button => {
                button.addEventListener("click", () => {
                    const input = document.getElementById(button.dataset.target);
                    const showing = input.type === "text";
                    input.type = showing ? "password" : "text";
                    button.setAttribute("aria-label", showing ? "Show password" : "Hide password");
                    button.setAttribute("title", showing ? "Show password" : "Hide password");
                });
            });
        })();
    </script>
</body>
</html>
