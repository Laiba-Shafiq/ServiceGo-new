@model ServiceGo.Models.VerifyOtp

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>ServiceGo - Verify OTP</title>

    <link rel="icon"
          href="@Url.Content("~/images/Logo.png")"
          type="image/x-icon" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <style>

        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f8f9fa, #fff5e8);
            font-family: Poppins, Arial, sans-serif;
        }

        .card-box {
            width: 90%;
            max-width: 360px;
            background: #fff;
            padding: 22px 24px 20px;
            border-radius: 20px;
            box-shadow: 0 14px 40px rgba(0, 0, 0, .12);
        }

        .logo {
            width: 68px;
            height: 68px;
            object-fit: contain;
            display: block;
            margin: 0 auto 6px;
        }

        h3 {
            font-weight: 700;
            color: #f0ad4e;
            margin: 0 0 5px;
            font-size: 1.65rem;
        }

        .card-box > p {
            margin: 0 0 12px !important;
            line-height: 1.45;
            font-size: .9rem;
        }

        .otp-row {
            display: flex;
            gap: 6px;
            justify-content: center;
        }

        .otp-box {
            width: 44px;
            height: 49px;
            text-align: center;
            font-size: 1.25rem;
            font-weight: 700;
            border: 1px solid #ced4da;
            border-radius: 10px;
            outline: none;
        }

            .otp-box:focus {
                border-color: #f0ad4e;
                box-shadow: 0 0 0 .2rem rgba(240, 173, 78, .2);
            }

        .btn-main {
            width: 100%;
            padding: 10px;
            border: 0;
            border-radius: 10px;
            background: linear-gradient(180deg, #f0ad4e, #e39e3e);
            color: #fff;
            font-weight: 600;
        }

            .btn-main:disabled {
                opacity: .7;
                cursor: not-allowed;
            }

        .text-danger {
            font-size: .82rem;
        }

        .back {
            display: block;
            text-align: center;
            margin-top: 10px;
            color: #e39e3e;
            text-decoration: none;
            font-weight: 600;
        }

        .otp-message {
            min-height: 10px;
            margin-bottom: 8px !important;
        }

        .otp-countdown {
            text-align: center;
            margin: 0 0 12px;
            color: #6c757d;
            font-size: .84rem;
            font-weight: 500;
        }

            .otp-countdown strong {
                color: #e39e3e;
                font-weight: 700;
            }

            .otp-countdown.expired {
                color: #dc3545;
            }

                .otp-countdown.expired strong {
                    color: #dc3545;
                }

        .mb-3 {
            margin-bottom: 12px !important;
        }

        .form-label {
            margin-bottom: 5px;
        }

        @@media (max-width: 420px) {

            .card-box {
                width: 92%;
                max-width: 350px;
                padding: 20px 18px 18px;
            }

            .otp-row {
                gap: 5px;
            }

            .otp-box {
                width: 41px;
                height: 47px;
            }
        }

        body {
            caret-color: transparent;
        }

        input,
        textarea,
        select,
        button,
        [contenteditable="true"] {
            caret-color: auto;
        }

    </style>

    <style id="sg-popup-base">
        /* Message popup (replaces the browser alert) */
        .sg-alert-overlay {
            position: fixed;
            inset: 0;
            z-index: 100000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            background: rgba(33, 37, 41, 0.45);
            backdrop-filter: blur(3px);
            animation: sgFade 0.18s ease-out;
        }

        .sg-alert-box {
            width: 100%;
            max-width: 340px;
            padding: 24px 22px 20px;
            text-align: center;
            font-family: 'Poppins', sans-serif;
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 18px 45px rgba(33, 37, 41, 0.22);
            animation: sgPop 0.22s ease-out;
        }

        .sg-alert-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 54px;
            height: 54px;
            margin-bottom: 12px;
            border-radius: 50%;
            color: #d97600;
            background: #fff4e3;
        }

            .sg-alert-icon svg {
                width: 28px;
                height: 28px;
            }

        .sg-alert-box.success .sg-alert-icon {
            color: #198754;
            background: #e8f8ee;
        }

        .sg-alert-box.error .sg-alert-icon {
            color: #dc3545;
            background: #fdecec;
        }

        .sg-alert-title {
            margin: 0 0 6px;
            font-size: 1.08rem;
            font-weight: 700;
            color: #212529;
        }

        .sg-alert-text {
            margin: 0 0 16px;
            font-size: 0.92rem;
            line-height: 1.5;
            color: #6c757d;
        }

        .sg-alert-btn {
            min-width: 110px;
            padding: 0.55rem 1.6rem;
            border: 0;
            border-radius: 12px;
            font-weight: 600;
            color: #ffffff;
            background: #d97600;
            cursor: pointer;
        }

            .sg-alert-btn:hover {
                background: #bf6700;
            }

        @@keyframes sgFade {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes sgPop {
            from {
                opacity: 0;
                transform: translateY(10px) scale(0.96);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }
    </style>
</head>

<body>

    <div class="card-box">

        <img src="@Url.Content("~/images/Logo.png")"
             alt="ServiceGo Logo"
             class="logo" />

        <h3 class="text-center">
            Verify OTP
        </h3>

        <p class="text-muted text-center">
            Enter the 6-digit OTP sent to your registered email.
            The OTP expires in 5 minutes.
        </p>

        <!-- 5 Minute OTP Countdown -->
        <div id="otpCountdown"
             class="otp-countdown"
             aria-live="polite">

            OTP expires in
            <strong id="countdownTime">05:00</strong>

        </div>


        <form asp-action="VerifyOtp"
              asp-controller="Home"
              method="post"
              id="otpForm"
              autocomplete="off">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Email"
                   id="Email" />

            <input type="hidden"
                   asp-for="Otp"
                   id="Otp"
                   name="Otp" />


            <div id="otpError"
                 class="text-danger text-center otp-message">
            </div>


            <div class="mb-3">

                <label class="form-label fw-semibold">
                    6-Digit OTP
                </label>


                <div class="otp-row">

                    <input class="otp-box"
                           type="text"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           maxlength="1"
                           autocomplete="one-time-code"
                           aria-label="OTP digit 1" />

                    <input class="otp-box"
                           type="text"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           maxlength="1"
                           aria-label="OTP digit 2" />

                    <input class="otp-box"
                           type="text"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           maxlength="1"
                           aria-label="OTP digit 3" />

                    <input class="otp-box"
                           type="text"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           maxlength="1"
                           aria-label="OTP digit 4" />

                    <input class="otp-box"
                           type="text"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           maxlength="1"
                           aria-label="OTP digit 5" />

                    <input class="otp-box"
                           type="text"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           maxlength="1"
                           aria-label="OTP digit 6" />

                </div>


                <span asp-validation-for="Otp"
                      class="text-danger">
                </span>

            </div>


            <button type="submit"
                    class="btn-main"
                    id="verifyBtn">

                Verify OTP

            </button>

        </form>


        <!-- Resend OTP -->
        <button type="button"
                id="resendBtn"
                class="btn btn-link back border-0 w-100">

            Resend OTP

        </button>


        <a class="back"
           href="@Url.Action("Forget", "Home")">

            Use a different email

        </a>

    </div>


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const form =
                document.getElementById("otpForm");

            const boxes =
                Array.from(
                    document.querySelectorAll(".otp-box")
                );

            const hiddenOtp =
                document.getElementById("Otp");

            const hiddenEmail =
                document.getElementById("Email");

            const errorBox =
                document.getElementById("otpError");

            const verifyBtn =
                document.getElementById("verifyBtn");

            const countdownBox =
                document.getElementById("otpCountdown");

            let countdownTimeRef =
                document.getElementById("countdownTime");

            const OTP_DURATION_SECONDS =
                5 * 60;

            let remainingSeconds =
                OTP_DURATION_SECONDS;

            let countdownTimer = null;


            /* OTP countdown */

            function updateCountdown() {

                const minutes =
                    Math.floor(
                        remainingSeconds / 60
                    );

                const seconds =
                    remainingSeconds % 60;

                countdownTimeRef.textContent =
                    String(minutes).padStart(2, "0") +
                    ":" +
                    String(seconds).padStart(2, "0");
            }


            function startOtpCountdown() {

                if (countdownTimer) {

                    clearInterval(
                        countdownTimer
                    );

                    countdownTimer = null;
                }

                remainingSeconds =
                    OTP_DURATION_SECONDS;

                countdownBox.classList.remove(
                    "expired"
                );

                countdownBox.innerHTML =
                    'OTP expires in <strong id="countdownTime">05:00</strong>';

                countdownTimeRef =
                    document.getElementById(
                        "countdownTime"
                    );

                verifyBtn.disabled = false;

                updateCountdown();


                countdownTimer =
                    setInterval(function () {

                        remainingSeconds--;


                        if (
                            remainingSeconds <= 0
                        ) {

                            remainingSeconds = 0;

                            clearInterval(
                                countdownTimer
                            );

                            countdownTimer = null;


                            countdownBox.classList.add(
                                "expired"
                            );

                            countdownBox.innerHTML =
                                'OTP <strong>expired</strong>. Please resend OTP.';


                            verifyBtn.disabled = true;


                            // Do not show the old error message again.

                            errorBox.textContent = "";

                            return;
                        }


                        updateCountdown();

                    }, 1000);
            }


            /* OTP functions */

            function getOtp() {

                return boxes
                    .map(function (box) {

                        return (
                            box.value || ""
                        ).replace(
                            /\D/g,
                            ""
                        );

                    })
                    .join("")
                    .slice(0, 6);
            }


            function syncOtp() {

                const otp =
                    getOtp();

                hiddenOtp.value =
                    otp;

                return otp;
            }


            function clearError() {

                errorBox.textContent = "";
            }


            function showError(message) {

                errorBox.textContent =
                    message;
            }


            /* OTP box input */

            boxes.forEach(function (box, index) {


                box.addEventListener(
                    "input",
                    function () {

                        clearError();

                        let value =
                            this.value || "";

                        value =
                            value.replace(
                                /\D/g,
                                ""
                            );


                        if (
                            value.length > 1
                        ) {

                            const remaining =
                                value.slice(
                                    0,
                                    6 - index
                                );


                            remaining
                                .split("")
                                .forEach(
                                    function (
                                        digit,
                                        offset
                                    ) {

                                        if (
                                            boxes[
                                                index +
                                                offset
                                            ]
                                        ) {

                                            boxes[
                                                index +
                                                offset
                                            ].value =
                                                digit;

                                        }

                                    }
                                );


                            const nextIndex =
                                Math.min(
                                    index +
                                    remaining.length,
                                    boxes.length - 1
                                );


                            boxes[
                                nextIndex
                            ].focus();


                        } else {

                            this.value =
                                value.slice(
                                    0,
                                    1
                                );


                            if (
                                this.value &&
                                index <
                                boxes.length - 1
                            ) {

                                boxes[
                                    index + 1
                                ].focus();

                            }

                        }


                        syncOtp();

                    }
                );


                box.addEventListener(
                    "keydown",
                    function (e) {


                        if (
                            e.key ===
                            "Backspace"
                        ) {

                            if (
                                !this.value &&
                                index > 0
                            ) {

                                boxes[
                                    index - 1
                                ].focus();

                                boxes[
                                    index - 1
                                ].value = "";

                                syncOtp();

                            }

                            return;
                        }


                        if (
                            e.key ===
                            "ArrowLeft" &&
                            index > 0
                        ) {

                            boxes[
                                index - 1
                            ].focus();

                            return;
                        }


                        if (
                            e.key ===
                            "ArrowRight" &&
                            index <
                            boxes.length - 1
                        ) {

                            boxes[
                                index + 1
                            ].focus();

                            return;
                        }


                        if (
                            e.key.length === 1 &&
                            !/[0-9]/.test(
                                e.key
                            )
                        ) {

                            e.preventDefault();

                        }

                    }
                );


                /* Paste OTP */

                box.addEventListener(
                    "paste",
                    function (e) {

                        e.preventDefault();

                        clearError();


                        const clipboard =
                            e.clipboardData ||
                            window.clipboardData;


                        let text =
                            clipboard
                                .getData("text")
                                .replace(
                                    /\D/g,
                                    ""
                                )
                                .slice(
                                    0,
                                    6
                                );


                        boxes.forEach(
                            function (b, i) {

                                b.value =
                                    text[i] || "";

                            }
                        );


                        syncOtp();


                        if (
                            text.length === 6
                        ) {

                            boxes[5].focus();

                        }
                        else if (
                            text.length > 0
                        ) {

                            boxes[
                                Math.min(
                                    text.length,
                                    boxes.length - 1
                                )
                            ].focus();

                        }
                        else {

                            boxes[0].focus();

                        }

                    }
                );

            });


            /* Verify OTP */

            form.addEventListener(
                "submit",
                async function (e) {

                    e.preventDefault();

                    clearError();


                    const otp =
                        syncOtp();


                    if (
                        remainingSeconds <= 0
                    ) {

                        countdownBox.classList.add(
                            "expired"
                        );

                        countdownBox.innerHTML =
                            'OTP <strong>expired</strong>. Please resend OTP.';

                        errorBox.textContent = "";

                        return;
                    }


                    if (
                        !/^[0-9]{6}$/.test(
                            otp
                        )
                    ) {

                        showError(
                            "Please enter the complete 6-digit OTP."
                        );


                        const emptyBox =
                            boxes.find(
                                function (box) {
                                    return !box.value;
                                }
                            );


                        if (emptyBox) {

                            emptyBox.focus();

                        }
                        else {

                            boxes[0].focus();

                        }

                        return;
                    }


                    hiddenOtp.value =
                        otp;


                    const formData =
                        new FormData(form);


                    formData.set(
                        "Otp",
                        otp
                    );


                    formData.set(
                        "Email",
                        hiddenEmail.value || ""
                    );


                    verifyBtn.disabled =
                        true;

                    verifyBtn.textContent =
                        "Verifying...";


                    try {

                        const response =
                            await fetch(
                                form.action,
                                {
                                    method: "POST",
                                    body: formData,
                                    headers: {
                                        "X-Requested-With":
                                            "XMLHttpRequest"
                                    }
                                }
                            );


                        const data =
                            await response.json();


                        if (
                            data.success === true &&
                            data.redirectUrl
                        ) {

                            window.location.href =
                                data.redirectUrl;

                            return;
                        }


                        showError(
                            data.message ||
                            "Invalid OTP. Please try again."
                        );


                    }
                    catch (error) {

                        console.error(
                            "Verify OTP Error:",
                            error
                        );


                        showError(
                            "Server error. Please try again."
                        );

                    }
                    finally {

                        if (
                            remainingSeconds > 0
                        ) {

                            verifyBtn.disabled =
                                false;

                        }


                        verifyBtn.textContent =
                            "Verify OTP";

                    }

                }
            );


            /*
             * Resend OTP
             * No 30 second counting
             */

            document
                .getElementById("resendBtn")
                .addEventListener(
                    "click",
                    async function () {

                        const btn =
                            this;


                        clearError();


                        btn.disabled =
                            true;

                        btn.textContent =
                            "Sending...";


                        try {

                            const token =
                                document.querySelector(
                                    'input[name="__RequestVerificationToken"]'
                                ).value;


                            const response =
                                await fetch(
                                    '@Url.Action("ResendOtp", "Home")',
                                    {
                                        method: "POST",

                                        headers: {
                                            "RequestVerificationToken":
                                                token,

                                            "X-Requested-With":
                                                "XMLHttpRequest"
                                        }
                                    }
                                );


                            const data =
                                await response.json();


                            if (
                                data.success
                            ) {

                                alert(
                                    data.message ||
                                    "A new OTP has been sent to your email."
                                );


                                boxes.forEach(
                                    function (box) {

                                        box.value =
                                            "";

                                    }
                                );


                                syncOtp();


                                boxes[0].focus();


                                // Restart the 5-minute OTP timer.

                                startOtpCountdown();


                                // No 30-second counter is shown under Resend OTP.

                                btn.disabled =
                                    false;

                                btn.textContent =
                                    "Resend OTP";

                            }
                            else {

                                showError(
                                    data.message ||
                                    "Unable to resend OTP."
                                );


                                btn.disabled =
                                    false;

                                btn.textContent =
                                    "Resend OTP";

                            }

                        }
                        catch (error) {

                            console.error(
                                "Resend OTP Error:",
                                error
                            );


                            showError(
                                "Unable to resend OTP. Please try again."
                            );


                            btn.disabled =
                                false;

                            btn.textContent =
                                "Resend OTP";

                        }

                    }
                );


            /* Start countdown */

            startOtpCountdown();


            if (
                boxes.length > 0
            ) {

                boxes[0].focus();

            }

        });

    </script>


    <script>
        // ServiceGo message popup: replaces the browser alert.
        function sgAlert(message, onClose) {
            var text = String(message == null ? "" : message).trim();
            var type = "info", title = "Please note";
            var icons = {
                info: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7.5" r="0.6" fill="currentColor"/><path d="M12 11.5v6"/></svg>',
                success: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>',
                error: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></svg>'
            };

            if (/^\[ok\]\s*/i.test(text)) { type = "success"; title = "Done"; text = text.replace(/^\[ok\]\s*/i, ""); }
            else if (/^\[error\]\s*/i.test(text)) { type = "error"; title = "Something went wrong"; text = text.replace(/^\[error\]\s*/i, ""); }

            var overlay = document.createElement("div");
            overlay.className = "sg-alert-overlay";

            var box = document.createElement("div");
            box.className = "sg-alert-box " + type;
            box.setAttribute("role", "alertdialog");
            box.setAttribute("aria-modal", "true");

            var iconEl = document.createElement("div");
            iconEl.className = "sg-alert-icon";
            iconEl.innerHTML = icons[type] || icons.info;

            var titleEl = document.createElement("h5");
            titleEl.className = "sg-alert-title";
            titleEl.textContent = title;

            var textEl = document.createElement("p");
            textEl.className = "sg-alert-text";
            textEl.textContent = text;

            var btn = document.createElement("button");
            btn.type = "button";
            btn.className = "sg-alert-btn";
            btn.textContent = "OK";

            box.appendChild(iconEl);
            box.appendChild(titleEl);
            box.appendChild(textEl);
            box.appendChild(btn);
            overlay.appendChild(box);
            document.body.appendChild(overlay);

            var closed = false;
            function close() {
                if (closed) return;
                closed = true;
                document.removeEventListener("keydown", onKey);
                overlay.remove();
                if (typeof onClose === "function") onClose();
            }
            function onKey(e) { if (e.key === "Escape" || e.key === "Enter") close(); }

            btn.addEventListener("click", close);
            overlay.addEventListener("click", function (e) { if (e.target === overlay) close(); });
            document.addEventListener("keydown", onKey);
            btn.focus();
        }

        window.alert = function (message) { sgAlert(message); };
    </script>
</body>
</html>