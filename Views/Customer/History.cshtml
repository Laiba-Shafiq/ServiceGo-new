                    width: 100% !important;
                    min-height: 48px !important;
                    height: 48px !important;
                    padding: 10px 16px !important;
                    margin: 0 !important;
                    display: flex !important;
                    align-items: center !important;
                    gap: 12px !important;
                    border-radius: 0 !important;
                    font-size: 16px !important;
                    line-height: 1.2 !important;
                    font-weight: 700 !important;
                    white-space: nowrap !important;
                    color: #2f2f2f !important;
                    background: #fff !important;
                    box-sizing: border-box !important;
                }

                    .mobile-profile-menu .dropdown-item i,
                    .mobile-dropdown-menu .dropdown-item i,
                    .customer-mobile-menu .dropdown-item i,
                    .mobile-top .dropdown-menu .dropdown-item i,
                    .mobile-top-header .dropdown-menu .dropdown-item i {
                        width: 20px !important;
                        min-width: 20px !important;
                        margin: 0 !important;
                        text-align: center !important;
                        font-size: 18px !important;
                        color: #444 !important;
                    }

                    .mobile-profile-menu .dropdown-item:hover,
                    .mobile-dropdown-menu .dropdown-item:hover,
                    .customer-mobile-menu .dropdown-item:hover,
                    .mobile-top .dropdown-menu .dropdown-item:hover,
                    .mobile-top-header .dropdown-menu .dropdown-item:hover,
                    .mobile-profile-menu .dropdown-item.active,
                    .mobile-dropdown-menu .dropdown-item.active,
                    .customer-mobile-menu .dropdown-item.active,
                    .mobile-top .dropdown-menu .dropdown-item.active,
                    .mobile-top-header .dropdown-menu .dropdown-item.active {
                        background: #fff3e0 !important;
                        color: #d97600 !important;
                    }

                        .mobile-profile-menu .dropdown-item:hover i,
                        .mobile-dropdown-menu .dropdown-item:hover i,
                        .customer-mobile-menu .dropdown-item:hover i,
                        .mobile-top .dropdown-menu .dropdown-item:hover i,
                        .mobile-top-header .dropdown-menu .dropdown-item:hover i,
                        .mobile-profile-menu .dropdown-item.active i,
                        .mobile-dropdown-menu .dropdown-item.active i,
                        .customer-mobile-menu .dropdown-item.active i,
                        .mobile-top .dropdown-menu .dropdown-item.active i,
                        .mobile-top-header .dropdown-menu .dropdown-item.active i {
                            color: #d97600 !important;
                        }

                .mobile-profile-menu .dropdown-divider,
                .mobile-dropdown-menu .dropdown-divider,
                .customer-mobile-menu .dropdown-divider,
                .mobile-top .dropdown-menu .dropdown-divider,
                .mobile-top-header .dropdown-menu .dropdown-divider {
                    margin: 0 !important;
                    border-top: 1px solid #ddd !important;
                    opacity: 1 !important;
                }

                .mobile-profile-menu .logout-item,
                .mobile-dropdown-menu .text-danger,
                .customer-mobile-menu .logout-item,
                .mobile-top .dropdown-menu .text-danger,
                .mobile-top-header .dropdown-menu .text-danger,
                .mobile-profile-menu .logout-item i,
                .mobile-dropdown-menu .text-danger i,
                .customer-mobile-menu .logout-item i,
                .mobile-top .dropdown-menu .text-danger i,
                .mobile-top-header .dropdown-menu .text-danger i {
                    color: #dc3545 !important;
                }
        }

        /* No blinking text caret anywhere. Typing still works; only the visual caret is hidden. */
        html, body, body * {
            caret-color: transparent !important;
        }

        /* Only the actual editable controls may receive text input. */
        input, textarea, [contenteditable="true"], [contenteditable=""] {
            caret-color: transparent !important;
        }

        /* Sidebar: active page is the only highlighted item. */
        .sidebar .nav a {
            background: transparent !important;
        }

            .sidebar .nav a:hover:not(.active) {
                background: transparent !important;
            }

            .sidebar .nav a.active {
                background: #ffb74d !important;
                color: #fff !important;
            }

        @@media (min-width: 769px) {
            .mobile-top, .mobile-top-header {
                display: none !important;
            }
        }


        /* =====================================================
                                                           COMPLAINT HISTORY — CLEAN SINGLE-CARD LAYOUT
                                                           Keeps the existing page shell and card styling intact.
                                                           ===================================================== */
        #complaintHistory .complaint-history-card {
            overflow: hidden;
        }

        #complaintHistory .complaint-info-list {
            padding: 0;
            background: #fff;
        }

        #complaintHistory .complaint-info-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 24px;
            padding: 13px 20px;
            border-top: 1px solid #f0f0f0;
        }

            #complaintHistory .complaint-info-row > span {
                flex: 0 0 145px;
                color: #8a8a8a;
                font-size: 11px;
                font-weight: 700;
            }

            #complaintHistory .complaint-info-row > strong {
                flex: 1;
                min-width: 0;
                color: #333;
                font-size: 12px;
                font-weight: 600;
                line-height: 1.55;
                text-align: left;
                overflow-wrap: anywhere;
                white-space: normal;
            }

        #complaintHistory .complaint-details-row > strong {
            font-weight: 500;
            color: #555;
        }

        @@media (max-width: 768px) {
            #complaintHistory .complaint-info-row {
                gap: 12px;
                padding: 10px 12px;
            }

                #complaintHistory .complaint-info-row > span {
                    flex: 0 0 105px;
                    font-size: 10px;
                }

                #complaintHistory .complaint-info-row > strong {
                    font-size: 11px;
                    line-height: 1.45;
                }
        }
    </style>

    <style>
        /* =====================================================
                                                           COMPLAINT HISTORY — COMPACT HORIZONTAL CARD
                                                           Keep the existing page/sidebar/cards intact.
                                                           Information stays side-by-side instead of stacking.
                                                           ===================================================== */
        #complaintHistory .complaint-history-card {
            width: 100%;
            overflow: hidden;
        }

        #complaintHistory .complaint-info-list {
            display: grid !important;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 0 !important;
            padding: 0 !important;
            background: #fff;
        }

        #complaintHistory .complaint-info-row {
            min-width: 0;
            min-height: 68px;
            display: flex !important;
            flex-direction: column !important;
            align-items: flex-start !important;
            justify-content: center !important;
            gap: 5px !important;
            padding: 12px 18px !important;
            border-top: 1px solid #f0f0f0 !important;
            border-right: 1px solid #f0f0f0 !important;
        }

            #complaintHistory .complaint-info-row:nth-child(4n) {
                border-right: 0 !important;
            }

            #complaintHistory .complaint-info-row > span {
                flex: none !important;
                width: 100%;
                color: #999 !important;
                font-size: 10px !important;
                font-weight: 600 !important;
                text-transform: uppercase;
                letter-spacing: .35px;
                line-height: 1.2 !important;
            }

            #complaintHistory .complaint-info-row > strong {
                flex: none !important;
                width: 100%;
                min-width: 0;
                color: #333 !important;
                font-size: 12px !important;
                font-weight: 600 !important;
                line-height: 1.35 !important;
                text-align: left !important;
                overflow-wrap: anywhere;
                white-space: normal;
            }

        #complaintHistory .complaint-details-row > strong {
            color: #555 !important;
            font-weight: 500 !important;
        }

        @@media (max-width: 1100px) {
            #complaintHistory .complaint-info-list {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            #complaintHistory .complaint-info-row:nth-child(4n) {
                border-right: 1px solid #f0f0f0 !important;
            }

            #complaintHistory .complaint-info-row:nth-child(3n) {
                border-right: 0 !important;
            }
        }

        @@media (max-width: 768px) {
            #complaintHistory .complaint-info-list {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            #complaintHistory .complaint-info-row {
                min-height: 62px;
                padding: 10px 12px !important;
                gap: 4px !important;
            }

                #complaintHistory .complaint-info-row:nth-child(3n),
                #complaintHistory .complaint-info-row:nth-child(4n) {
                    border-right: 1px solid #f0f0f0 !important;
                }

                #complaintHistory .complaint-info-row:nth-child(2n) {
                    border-right: 0 !important;
                }

                #complaintHistory .complaint-info-row > span {
                    font-size: 9px !important;
                }

                #complaintHistory .complaint-info-row > strong {
                    font-size: 10.5px !important;
                    line-height: 1.3 !important;
                }
        }

        @@media (max-width: 420px) {
            #complaintHistory .complaint-info-row {
                min-height: 58px;
                padding: 9px 10px !important;
            }

                #complaintHistory .complaint-info-row > span {
                    font-size: 8px !important;
                }

                #complaintHistory .complaint-info-row > strong {
                    font-size: 10px !important;
                }
        }
    </style>


    <style id="customer-greeting-fix">
        /* Desktop: greeting appears only when the sidebar expands. */
        .sidebar-greeting {
            width: calc(100% - 16px);
            margin: 0 8px 4px !important;
            padding: 4px 10px !important;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 15px;
            font-weight: 700;
            line-height: 1.2;
            white-space: nowrap;
            opacity: 0;
            transform: translateX(-4px);
            transition: opacity .2s ease, transform .2s ease;
        }

        .sidebar:hover .sidebar-greeting,
        .sidebar:focus-within .sidebar-greeting {
            opacity: 1;
            transform: none;
        }

        /* Mobile: profile picture + greeting are visible together. */
        .mobile-profile-dropdown {
            display: flex !important;
            align-items: center !important;
            gap: 9px !important;
        }

            .mobile-profile-dropdown .mobile-greeting-text {
                display: inline-block !important;
                color: #333 !important;
                font-size: 15px !important;
                font-weight: 700 !important;
                line-height: 1 !important;
                white-space: nowrap !important;
            }

        @@media (min-width: 769px) {
            .mobile-profile-dropdown {
                display: none !important;
            }
        }
    </style>


    <style id="sg-popup-theme">
        /* ---------- Compact, soft popups (SweetAlert2) ---------- */
        .swal2-container {
            padding: 12px !important;
        }

        .swal2-popup {
            width: min(340px, calc(100vw - 32px)) !important;
            padding: 22px 20px 18px !important;
            border-radius: 20px !important;
            box-shadow: 0 18px 50px rgba(33, 37, 41, .20) !important;
            font-family: inherit !important;
        }

        .swal2-icon {
            zoom: .72;
            margin: .2em auto .7em !important;
        }

        .swal2-title {
            font-size: 1.12rem !important;
            font-weight: 700 !important;
            color: #212529 !important;
            padding: 0 !important;
            margin: 0 0 .3rem !important;
        }

        .swal2-html-container {
            font-size: .9rem !important;
            line-height: 1.5 !important;
            color: #6c757d !important;
            margin: .2rem 0 0 !important;
            padding: 0 .2em !important;
        }

        .swal2-actions {
            margin-top: 1.1rem !important;
            gap: 8px;
        }

        .swal2-styled {
            border-radius: 12px !important;
            padding: .55rem 1.2rem !important;
            min-width: 92px;
            font-size: .9rem !important;
            font-weight: 600 !important;
            box-shadow: none !important;
        }

            .swal2-styled.swal2-confirm {
                background-color: #d97600 !important;
            }

            .swal2-styled.swal2-cancel {
                background-color: #e9ecef !important;
                color: #495057 !important;
            }

            .swal2-styled:focus {
                box-shadow: 0 0 0 3px rgba(217, 118, 0, .25) !important;
            }

        .swal2-popup.swal2-show {
            animation: sgPopIn .22s ease-out !important;
        }

        .swal2-popup.swal2-hide {
            animation: sgPopOut .15s ease-in !important;
        }

        @@keyframes sgPopIn {
            from {
                opacity: 0;
                transform: translateY(10px) scale(.96);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        @@keyframes sgPopOut {
            from {
                opacity: 1;
                transform: none;
            }

            to {
                opacity: 0;
                transform: translateY(6px) scale(.97);
            }
        }

        /* ---------- Bootstrap modals: smaller, rounded, smooth ---------- */
        .modal-content {
            border: 0 !important;
            border-radius: 18px !important;
            box-shadow: 0 18px 50px rgba(33, 37, 41, .20) !important;
            overflow: hidden;
        }

        .modal-header {
            padding: .85rem 1.1rem;
        }

        .modal-title {
            font-size: 1.05rem;
            font-weight: 700;
        }

        .modal-body {
            padding: 1rem 1.1rem;
        }

        .modal-footer {
            padding: .7rem 1.1rem;
            gap: 6px;
        }

        .modal-backdrop.show {
            opacity: .35;
        }

        .modal.fade .modal-dialog {
            transform: translateY(14px) scale(.97);
            transition: transform .22s ease-out;
        }

        .modal.show .modal-dialog {
            transform: none;
        }

        @@media (min-width: 576px) {
            .modal-dialog.modal-md {
                --bs-modal-width: 440px;
                max-width: 440px;
            }

            .modal-dialog.modal-lg {
                --bs-modal-width: 620px;
            }
        }

        .sg-rec-dot {
            display: inline-block;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #dc3545;
            margin-left: 4px;
            vertical-align: middle;
            animation: sgBlink 1s infinite;
        }

        @@keyframes sgBlink {
            50% {
                opacity: .25;
            }
        }
    </style>

    <style id="sg-mobile-header">
        /* Mobile header: "Hi Customer" first, then the profile photo with an orange ring (same as Dashboard) */
        @@media (max-width: 768px) {
            .mobile-top .dropdown,
            .mobile-top-header .dropdown {
                display: flex !important;
                align-items: center !important;
                gap: 10px !important;
            }

            .mobile-customer-label,
            .mobile-greeting-text,
            .mobile-customer-greeting {
                order: -1 !important;
                display: inline-block !important;
                margin: 0 !important;
                color: #212529 !important;
                font-size: .9rem !important;
                font-weight: 700 !important;
                line-height: 1 !important;
                white-space: nowrap !important;
            }

            .mobile-top .profile-thumb,
            .mobile-top-header .profile-thumb,
            .mobile-profile-trigger,
            .mobile-profile-image {
                width: 44px !important;
                height: 44px !important;
                min-width: 44px !important;
                min-height: 44px !important;
                padding: 0 !important;
                border-radius: 50% !important;
                object-fit: cover !important;
                display: block !important;
                border: 2px solid #f0a43c !important;
                background: #fff !important;
                box-sizing: content-box !important;
                cursor: pointer;
            }

            .mobile-profile-btn {
                width: auto !important;
                height: auto !important;
                min-width: 0 !important;
                min-height: 0 !important;
                padding: 0 !important;
                border: 0 !important;
                border-radius: 50% !important;
                background: transparent !important;
                box-shadow: none !important;
                display: flex !important;
            }
        }
    </style>


    <style id="sg-history-focus">
        /* Booking opened from a notification: highlighted briefly */
        .history-card.sg-history-focus {
            position: relative;
            border-color: #f0a43c !important;
            box-shadow: 0 0 0 3px rgba(240, 164, 60, .35), 0 14px 32px rgba(217, 118, 0, .18) !important;
            animation: sgHistoryGlow 1.2s ease-in-out 3;
        }

        .sg-history-focus-tag {
            position: absolute;
            top: 8px;
            right: 12px;
            padding: 3px 10px;
            border-radius: 999px;
            background: #d97600;
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .2px;
            box-shadow: 0 4px 10px rgba(217, 118, 0, .3);
            z-index: 2;
        }

        @@keyframes sgHistoryGlow {
            0%, 100% {
                box-shadow: 0 0 0 3px rgba(240, 164, 60, .35), 0 14px 32px rgba(217, 118, 0, .18);
            }

            50% {
                box-shadow: 0 0 0 7px rgba(240, 164, 60, .20), 0 14px 32px rgba(217, 118, 0, .28);
            }
        }
    </style>
</head>

<body>

    <!-- =====================================================
         DESKTOP SIDEBAR
         ===================================================== -->

    <aside class="sidebar">

        <img src="@Url.Content("~/images/Logo.png")"
             class="logo" width="60" height="60" loading="eager" decoding="async" asp-append-version="true"
             alt="ServiceGo"
             onclick="window.location.href='@Url.Action("Index", "Home")'" />

        <div class="sidebar-greeting" aria-label="Customer">
            <img src="@Url.Content(mobileProfileImage)" alt="Profile">
            <span>Hi Customer</span>
        </div>

        <div class="nav">

            <a href="@Url.Action("CusDashboard", "Customer")">
                <i class="bi bi-house-door"></i>
                <span>Dashboard</span>
            </a>

            <a href="@Url.Action("History", "Customer")"
               class="active">
                <i class="bi bi-clock-history"></i>
                <span>History</span>
            </a>

            <a href="@Url.Action("Messages", "Customer")">
                <i class="bi bi-chat-dots"></i>
                <span>Messages</span>
            </a>

            <a href="@Url.Action("Notifications", "Customer")">
                <i class="bi bi-bell"></i>
                <span>Notifications</span>
                @if ((ViewBag.UnreadNotificationCount as int? ?? 0) > 0)
                {
                    <span class="sidebar-notification-badge">@(ViewBag.UnreadNotificationCount)</span>
                }
            </a>

            <a href="@Url.Action("Logout", "Customer")">
                <i class="bi bi-box-arrow-right"></i>
                <span>Logout</span>
            </a>

        </div>
    </aside>


    <!-- =====================================================
         MOBILE HEADER
         ===================================================== -->

    <div class="mobile-top">

        <img src="@Url.Content("~/images/Logo.png")"
             class="mobile-logo" width="45" height="45" loading="eager" decoding="async" asp-append-version="true"
             alt="ServiceGo"
             onclick="window.location.href='@Url.Action("Index", "Home")'" />

        <div class="dropdown mobile-profile-dropdown">

            <span class="mobile-greeting-text">Hi Customer</span>

            <img src="@Url.Content(mobileProfileImage)"
                 class="profile-thumb"
                 id="historyMobileProfileImage" width="44" height="44" loading="eager" decoding="async" asp-append-version="true"
                 alt="Profile"
                 data-bs-toggle="dropdown"
                 aria-expanded="false" />

            <ul class="dropdown-menu dropdown-menu-end mobile-dropdown-menu">

                <li>
                    <a class="dropdown-item"
                       href="@Url.Action("CusDashboard", "Customer")">
                        <i class="bi bi-house-door"></i>
                        Dashboard
                    </a>
                </li>

                <li>
                    <a class="dropdown-item active"
                       href="@Url.Action("History", "Customer")">
                        <i class="bi bi-clock-history"></i>
                        History
                    </a>
                </li>

                <li>
                    <a class="dropdown-item"
                       href="@Url.Action("Messages", "Customer")">
                        <i class="bi bi-chat-dots"></i>
                        Messages
                    </a>
                </li>

                <li>
                    <a class="dropdown-item d-flex align-items-center"
                       href="@Url.Action("Notifications", "Customer")">
                        <i class="bi bi-bell"></i>
                        <span>Notifications</span>
                        @if ((ViewBag.UnreadNotificationCount as int? ?? 0) > 0)
                        {
                            <span class="badge rounded-pill text-bg-warning ms-auto">@(ViewBag.UnreadNotificationCount)</span>
                        }
                    </a>
                </li>

                <li>
                    <hr class="dropdown-divider" />
                </li>

                <li>
                    <a class="dropdown-item text-danger"
                       href="@Url.Action("Logout", "Customer")">
                        <i class="bi bi-box-arrow-right"></i>
                        Logout
                    </a>
                </li>

            </ul>

        </div>

    </div>


    <!-- =====================================================
         MAIN
         ===================================================== -->

    <main class="main">

        <div class="page-container">

            <!-- PAGE HEADER -->

            <div class="page-header">

                <div class="page-icon">
                    <i class="bi bi-clock-history"></i>
                </div>

                <h2>History</h2>

                <p>
                    View your jobs, ratings and submitted complaints.
                </p>

            </div>


            <!-- =================================================
                 THREE CATEGORIES
                 ================================================= -->

            <div class="history-tabs">

                <button type="button"
                        class="history-tab active"
                        data-target="jobHistory">

                    <i class="bi bi-briefcase"></i>

                    <span>Job History</span>

                    <small>
                        @jobHistoryCount
                    </small>

                </button>


                <button type="button"
                        class="history-tab"
                        data-target="ratingHistory">

                    <i class="bi bi-star-fill"></i>

                    <span>Rating History</span>

                    <small>
                        @(Model?.RatingHistory?.Count ?? 0)
                    </small>

                </button>


                <button type="button"
                        class="history-tab"
                        data-target="complaintHistory">

                    <i class="bi bi-exclamation-triangle"></i>

                    <span>Complaint History</span>

                    <small>
                        @(Model?.ComplaintHistory?.Count ?? 0)
                    </small>

                </button>

            </div>


            <!-- =================================================
                 JOB HISTORY
                 ================================================= -->

            <section id="jobHistory"
                     class="history-section active">

                <div class="section-heading">

                    <div>
                        <h4>Job History</h4>

                        <p>
                            Your completed, cancelled and rejected bookings.
                        </p>
                    </div>

                    <span class="section-pill">
                        <i class="bi bi-briefcase"></i>
                        @jobHistoryCount Jobs
                    </span>

                </div>


                @if (jobHistoryItems != null && jobHistoryItems.Any())
                {
                    foreach (var item in jobHistoryItems)
                    {
                        var status = string.IsNullOrWhiteSpace(item.Status)
                        ? "Unknown"
                        : item.Status.Trim();

                        var statusClass =
                        status.Equals("Completed", StringComparison.OrdinalIgnoreCase) ? "status-completed" :
                        status.Equals("Accepted", StringComparison.OrdinalIgnoreCase) ? "status-accepted" :
                        status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) ? "status-cancelled" :
                        status.Equals("Rejected", StringComparison.OrdinalIgnoreCase) ? "status-rejected" :
                        "status-expired";

                        var statusIcon =
                        status.Equals("Completed", StringComparison.OrdinalIgnoreCase) ? "bi-check-circle-fill" :
                        status.Equals("Accepted", StringComparison.OrdinalIgnoreCase) ? "bi-calendar-check" :
                        status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) ? "bi-x-circle-fill" :
                        status.Equals("Rejected", StringComparison.OrdinalIgnoreCase) ? "bi-slash-circle-fill" :
                        "bi-clock-history";

                        DateTime historyEventDate = item.BookingDate;
                        if (status.Equals("Completed", StringComparison.OrdinalIgnoreCase) && item.CompletedAt.HasValue)
                            historyEventDate = item.CompletedAt.Value;
                        else if (status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) && item.CancelledAt.HasValue)
                            historyEventDate = item.CancelledAt.Value;
                        else if (status.Equals("Rejected", StringComparison.OrdinalIgnoreCase) && item.RejectedAt.HasValue)
                            historyEventDate = item.RejectedAt.Value;

                        <article class="history-card" id="history-booking-@item.Id" data-booking-id="@item.Id">
                            <div class="history-card-top">
                                <div class="history-title-wrap">
                                    <div class="service-icon">
                                        <i class="bi @statusIcon"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-1">
                                            @(string.IsNullOrWhiteSpace(item.ServiceName) ? "Service" : item.ServiceName)
                                        </h5>
                                        <div class="small text-muted">
                                            Provider: @(string.IsNullOrWhiteSpace(item.ProviderName) ? "Not Assigned" : item.ProviderName)
                                        </div>
                                    </div>
                                </div>

                                <span class="status-badge @statusClass">
                                    @status
                                </span>
                            </div>

                            <div class="history-summary">
                                <span><i class="bi bi-hash"></i> @item.BookingId</span>
                                <span><i class="bi bi-calendar-event"></i> @historyEventDate.ToString("dd MMM yyyy")</span>
                                @if (!string.IsNullOrWhiteSpace(item.BookingTime))
                                {
                                    <span><i class="bi bi-clock"></i> @item.BookingTime</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.ServiceType))
                                {
                                    <span><i class="bi bi-house-gear"></i> @item.ServiceType</span>
                                }
                                @if (status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) &&
                                                        !string.IsNullOrWhiteSpace(item.CancelledBy))
                                {
                                    <span><i class="bi bi-person-x"></i> Cancelled by @item.CancelledBy</span>
                                }
                                @if (item.HasRescheduleHistory &&
                                                        status.Equals("Accepted", StringComparison.OrdinalIgnoreCase) &&
                                                        string.Equals(item.RescheduledStatus, "Accepted", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span><i class="bi bi-calendar2-week"></i> Rescheduled</span>
                                }
                            </div>
                        </article>
                    }
                }
                else
                {
                    <div class="empty-state">

                        <i class="bi bi-briefcase"></i>

                        <h5>No Job History Found</h5>

                        <p>
                            Your completed, cancelled and rejected
                            bookings will appear here.
                        </p>

                    </div>
                }

            </section>


            <!-- =================================================
                 RATING HISTORY
                 ================================================= -->

            <section id="ratingHistory"
                     class="history-section">

                <div class="section-heading">

                    <div>
                        <h4>Rating History</h4>

                        <p>
                            Ratings and reviews you submitted to service providers.
                        </p>
                    </div>

                    <span class="section-pill">
                        <i class="bi bi-star-fill"></i>
                        @(Model?.RatingHistory?.Count ?? 0) Ratings
                    </span>

                </div>


                @if (Model?.RatingHistory != null &&
                                Model.RatingHistory.Any())
                {
                    foreach (var item in Model.RatingHistory)
                    {
                        <article class="rating-card">

                            <div class="rating-main">

                                <div class="provider-box">

                                    <div class="provider-icon">
                                        <i class="bi bi-person-fill"></i>
                                    </div>

                                    <div>

                                        <h5>
                                            @(string.IsNullOrWhiteSpace(item.ProviderName)
                                                                                ? "Provider"
                                                                                : item.ProviderName)
                                </h5>

                                        <p>
                                            @item.ServiceName

                                    @if (!string.IsNullOrWhiteSpace(item.ServiceType))
                                            {
                                                <span>
                                                    • @item.ServiceType
                                                </span>
                                            }
                                        </p>

                                        <small>
                                            <i class="bi bi-calendar3"></i>
                                            @item.BookingDate.ToString("dd MMM yyyy")
                                        </small>

                                    </div>

                                </div>


                                <div class="rating-score">

                                    <div class="stars">

                                        @for (int star = 1; star <= 5; star++)
                                        {
                                            <i class="bi @(star <= item.Rating
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           ? "bi-star-fill"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           : "bi-star")"></i>
                                                                }

                                    </div>

                                    <strong>
                                        @item.Rating / 5
                                    </strong>

                                </div>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(item.ReviewComment))
                            {
                                <div class="review-box">

                                    <p>
                                        <i class="bi bi-quote"></i>
                                        @item.ReviewComment
                                    </p>

                                </div>
                            }


                            <div class="rating-footer">

                                <span>
                                    <i class="bi bi-receipt"></i>
                                    Booking:
                                    @item.BookingId
                                </span>

                                <span>
                                    <i class="bi bi-check-circle-fill"></i>
                                    Rating submitted
                                </span>

                            </div>

                        </article>
                    }
                }
                else
                {
                    <div class="empty-state">

                        <i class="bi bi-star"></i>

                        <h5>No Rating History Found</h5>

                        <p>
                            Ratings and reviews you give to providers
                            will appear here.
                        </p>

                    </div>
                }

            </section>


            <!-- =================================================
                 COMPLAINT HISTORY
                 ================================================= -->

            <section id="complaintHistory" class="history-section">

                <div class="section-heading">
                    <div>
                        <h4>Complaint History</h4>
                        <p>Track complaints submitted by you and their current status.</p>
                    </div>

                    <span class="section-pill">
                        <i class="bi bi-shield-exclamation"></i>
                        @(Model?.ComplaintHistory?.Count ?? 0) Complaints
                    </span>
                </div>

                @if (Model?.ComplaintHistory != null && Model.ComplaintHistory.Any())
                {
                    foreach (var complaint in Model.ComplaintHistory)
                    {
                        var complaintStatus = string.IsNullOrWhiteSpace(complaint.Status)
                        ? "Pending"
                        : complaint.Status.Trim();

                        var complaintStatusClass = complaintStatus.Equals("Resolved", StringComparison.OrdinalIgnoreCase)
                        ? "complaint-resolved"
                        : complaintStatus.Equals("Rejected", StringComparison.OrdinalIgnoreCase)
                        ? "complaint-rejected"
                        : "complaint-pending";

                        string historyIssue = string.Empty;

                        if (!string.IsNullOrWhiteSpace(complaint.OtherIssue) &&
                        !complaint.OtherIssue.Equals("Other", StringComparison.OrdinalIgnoreCase))
                        {
                            historyIssue = complaint.OtherIssue.Trim();
                        }
                        else if (!string.IsNullOrWhiteSpace(complaint.IssueCategory) &&
                        !complaint.IssueCategory.Equals("General", StringComparison.OrdinalIgnoreCase) &&
                        !complaint.IssueCategory.Equals("Other", StringComparison.OrdinalIgnoreCase))
                        {
                            historyIssue = complaint.IssueCategory.Trim();
                        }
                        else if (complaint.OtherIssue?.Equals("Other", StringComparison.OrdinalIgnoreCase) == true)
                        {
                            historyIssue = "Other";
                        }

                        <article class="complaint-card complaint-history-card">

                            <div class="complaint-top">
                                <div class="complaint-id">
                                    <div class="complaint-icon">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                    </div>
                                    <div>
                                        <h5>Complaint #@complaint.ComplaintId</h5>
                                        <span>@complaint.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                    </div>
                                </div>

                                <span class="complaint-status @complaintStatusClass">
                                    @complaintStatus
                                </span>
                            </div>

                            <div class="complaint-info-list">

                                <div class="complaint-info-row">
                                    <span>Provider ID</span>
                                    <strong>
                                        @(string.IsNullOrWhiteSpace(complaint.ProviderId) ? "N/A" : complaint.ProviderId)
                                    </strong>
                                </div>

                                <div class="complaint-info-row">
                                    <span>Provider Name</span>
                                    <strong>
                                        @(string.IsNullOrWhiteSpace(complaint.ProviderName) ? "N/A" : complaint.ProviderName)
                                    </strong>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(historyIssue))
                                {
                                    <div class="complaint-info-row">
                                        <span>Issue Category</span>
                                        <strong>@historyIssue</strong>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(complaint.ComplaintDetails))
                                {
                                    <div class="complaint-info-row complaint-details-row">
                                        <span>Complaint Details</span>
                                        <strong>@complaint.ComplaintDetails</strong>
                                    </div>
                                }

                            </div>

                        </article>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-shield-check"></i>
                        <h5>No Complaint History Found</h5>
                        <p>Complaints submitted by you will appear here with their current status.</p>
                    </div>
                }

            </section>

        </div>

    </main>


    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const tabs =
                document.querySelectorAll(".history-tab");

            const sections =
                document.querySelectorAll(".history-section");

            tabs.forEach(function (tab) {

                tab.addEventListener("click", function () {

                    const target =
                        this.getAttribute("data-target");

                    tabs.forEach(function (t) {
                        t.classList.remove("active");
                    });

                    sections.forEach(function (section) {
                        section.classList.remove("active");
                    });

                    this.classList.add("active");

                    const targetSection =
                        document.getElementById(target);

                    if (targetSection) {
                        targetSection.classList.add("active");
                    }

                });

            });

            const requestedTab = new URLSearchParams(window.location.search).get("tab");
            if (requestedTab) {
                const requestedButton = document.querySelector('.history-tab[data-target="' + requestedTab + '"]');
                if (requestedButton) requestedButton.click();
            }

        });

    </script>


    <script id="servicego-history-load-more">
        document.addEventListener("DOMContentLoaded", function () {
            const sections = [
                {
                    id: "jobHistory",
                    card: ".history-card",
                    button: "jobHistoryLoadMore"
                },
                {
                    id: "ratingHistory",
                    card: ".rating-card",
                    button: "ratingHistoryLoadMore"
                },
                {
                    id: "complaintHistory",
                    card: ".complaint-card",
                    button: "complaintHistoryLoadMore"
                }
            ];

            sections.forEach(function (cfg) {
                const section = document.getElementById(cfg.id);
                if (!section) return;

                const cards = Array.from(
                    section.querySelectorAll(cfg.card)
                );

                const totalCards = cards.length;
                const maxVisible = Math.min(totalCards, 30);

                // 1-15 cards: everything is visible and there is no button.
                if (totalCards <= 15) {
                    cards.forEach(function (card) {
                        card.hidden = false;
                    });
                    return;
                }

                let visibleCount = 15;

                const button = document.createElement("button");
                button.type = "button";
                button.className =
                    "btn btn-outline-warning d-block mx-auto mt-4 mb-4 px-4 py-2 fw-semibold";
                button.id = cfg.button;
                button.textContent = "Load More";
                button.setAttribute("aria-controls", cfg.id);
                button.setAttribute("aria-expanded", "false");

                section.appendChild(button);

                function update() {
                    cards.forEach(function (card, index) {
                        card.hidden = index >= visibleCount;
                    });

                    if (visibleCount >= maxVisible) {
                        button.textContent = "Show Less";
                        button.setAttribute("aria-expanded", "true");
                    } else {
                        button.textContent = "Load More";
                        button.setAttribute("aria-expanded", "false");
                    }
                }

                button.addEventListener("click", function () {
                    if (visibleCount >= maxVisible) {
                        // Collapse back to the first 15.
                        visibleCount = 15;
                    } else {
                        // Reveal the next 15.
                        visibleCount = Math.min(
                            visibleCount + 15,
                            maxVisible
                        );
                    }

                    update();
                });

                update();
            });
        });
    </script>


    <script id="servicego-history-focus">
        // Scroll to and highlight the booking that was opened from a notification.
        window.addEventListener("load", function () {
            var params = new URLSearchParams(window.location.search);
            var bookingId = params.get("bookingId");
            if (!bookingId || !/^\d+$/.test(bookingId)) return;

            // Wait briefly so the "Load More" script has finished hiding cards.
            setTimeout(function () {
                var card = document.getElementById("history-booking-" + bookingId);
                if (!card) return;

                // Make sure the Job History tab is open and the card is visible.
                var section = card.closest(".history-section");
                if (section && !section.classList.contains("active")) {
                    var tab = document.querySelector('.history-tab[data-target="' + section.id + '"]');
                    if (tab) tab.click();
                }
                card.hidden = false;

                card.classList.add("sg-history-focus");

                var tag = document.createElement("span");
                tag.className = "sg-history-focus-tag";
                tag.textContent = "From your notification";
                card.appendChild(tag);

                card.scrollIntoView({ behavior: "smooth", block: "center" });

                // Remove the highlight after a few seconds.
                setTimeout(function () {
                    card.classList.remove("sg-history-focus");
                    if (tag.parentNode) tag.parentNode.removeChild(tag);
                }, 4500);

                // A refresh should not highlight the card again.
                if (window.history && window.history.replaceState) {
                    params.delete("bookingId");
                    var query = params.toString();
                    window.history.replaceState(
                        null, "",
                        window.location.pathname + (query ? "?" + query : ""));
                }
            }, 250);
        });
    </script>
</body>
</html>
