@model ServiceGo.Models.CustomerDashboardViewModel
@using Microsoft.EntityFrameworkCore
@inject IConfiguration Configuration
@inject ServiceGo.Data.AppDbContext DbContext
@{
	Layout = null;

	var customerPhone = ViewBag.CustomerPhonePermanent as string ?? string.Empty;
	var customerCity = ViewBag.CustomerCity as string ?? string.Empty;
	var customerAddress = ViewBag.CustomerAddress as string ?? string.Empty;
	var customerProfileImage = ViewBag.CustomerProfileImage as string ?? string.Empty;

	// Always display exactly one Customer ID prefix.
	var customerIdDisplay = Model?.CustomerId ?? string.Empty;
	while (customerIdDisplay.StartsWith("CUS-", StringComparison.OrdinalIgnoreCase))
		customerIdDisplay = customerIdDisplay.Substring(4);
	while (customerIdDisplay.StartsWith("CUS", StringComparison.OrdinalIgnoreCase))
		customerIdDisplay = customerIdDisplay.Substring(3);
	customerIdDisplay = string.IsNullOrWhiteSpace(customerIdDisplay)
	? string.Empty
	: "CUS-" + customerIdDisplay;

	var cancellationAllowedIds =
	ViewBag.CancellationAllowedIds as HashSet<int>
	?? new HashSet<int>();

	var rescheduleAllowedIds =
	ViewBag.RescheduleAllowedIds as HashSet<int>
	?? new HashSet<int>();

	var customerComplaintBookingIds =
	ViewBag.CustomerComplaintBookingIds as HashSet<int>
	?? new HashSet<int>();

	var providerImageIds =
	(Model?.Bookings ?? Enumerable.Empty<ServiceGo.Models.BookingDetailViewModel>())
	.Select(b => int.TryParse(b.ProviderId, out var providerId) ? providerId : 0)
	.Where(id => id > 0)
	.Distinct()
	.ToList();

	var providerImageRows = providerImageIds.Count > 0
	? await DbContext.Register
	.AsNoTracking()
	.Where(r => providerImageIds.Contains(r.Id))
	.Select(r => new
	{
		r.Id,
		r.Name,
		r.ProfilePicPath
	})
	.ToListAsync()
	: new[]
	{
new
{
Id = 0,
Name = (string?)null,
ProfilePicPath = (string?)null
}
	}.Where(_ => false).ToList();

	var providerProfileImages =
	providerImageRows.ToDictionary(
	r => r.Id,
	r => r.ProfilePicPath ?? string.Empty);

	var providerProfileImagesByName =
	providerImageRows
	.Where(r => !string.IsNullOrWhiteSpace(r.Name))
	.ToDictionary(
	r => r.Name!.Trim(),
	r => r.ProfilePicPath ?? string.Empty,
	StringComparer.OrdinalIgnoreCase);

	// The first-time profile prompt is shown until Phone, City and Address
	// have been completed. Name and Email are account fields and are readonly.
	var customerProfileIncomplete =
	string.IsNullOrWhiteSpace(customerPhone) ||
	string.IsNullOrWhiteSpace(customerCity) ||
	string.IsNullOrWhiteSpace(customerAddress);
}

<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8" />

	<meta name="viewport"
		  content="width=device-width, initial-scale=1.0" />

	<title>ServiceGo - Customer Dashboard</title>

	<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
		  rel="stylesheet" />

	<link rel="stylesheet"
		  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

	<link rel="icon"
		  href="@Url.Content("~/images/Logo.png")"
		  type="image/x-icon" />

	<style>

		html, body {
			width: 100%;
			min-height: 100%;
			margin: 0;
		}

		body {
			font-family: 'Poppins', sans-serif;
			background-color: #f8f9fa;
			overflow-x: hidden;
		}

		/* Sidebar */

		.sidebar {
			position: fixed;
			top: 0;
			left: 0;
			width: 80px;
			height: 100vh;
			background-color: #d97600;
			transition: width 0.3s ease, box-shadow 0.3s ease;
			display: flex;
			flex-direction: column;
			align-items: center;
			z-index: 1040;
		}

			.sidebar:hover,
			.sidebar:focus-within {
				width: 240px;
				box-shadow: 4px 0 25px rgba(240, 173, 78, 0.3);
			}

			.sidebar img.logo,
			.sidebar .nav a {
				pointer-events: auto;
			}

			.sidebar img.logo {
				width: 55px;
				height: 55px;
				margin: 20px 0;
				border-radius: 12px;
				background: #fff;
				cursor: pointer;
				object-fit: contain;
				border: 2px solid #fff;
			}

		.sidebar-customer-label {
			color: #fff;
			opacity: 0;
			visibility: hidden;
			width: 0;
			min-height: 0;
			height: 0;
			overflow: hidden;
			margin: 0;
			font-weight: 700;
			font-size: .88rem;
			line-height: 1.2;
			display: flex;
			align-items: center;
			justify-content: center;
			white-space: nowrap;
		}

			.sidebar-customer-label img {
				width: 30px;
				height: 30px;
				border-radius: 50%;
				object-fit: cover;
				border: 2px solid rgba(255,255,255,.95);
				margin-right: 8px;
				flex: 0 0 30px;
			}

			.sidebar-customer-label i {
				font-size: 1.05rem;
			}

		.sidebar:hover .sidebar-customer-label,
		.sidebar:focus-within .sidebar-customer-label {
			opacity: 1;
			visibility: visible;
			width: auto;
			min-height: 28px;
			height: auto;
			overflow: visible;
			margin: 0 0 8px;
		}

		.sidebar .nav {
			width: 100%;
			margin-top: 10px;
			display: flex;
			flex-direction: column;
			align-items: center;
		}

			.sidebar .nav a {
				display: flex;
				align-items: center;
				color: #fff;
				padding: 12px 20px;
				text-decoration: none;
				border-radius: 10px;
				width: 90%;
				margin-bottom: 6px;
				white-space: nowrap;
				overflow: hidden;
			}

				.sidebar .nav a i {
					font-size: 1.4rem;
					margin-right: 15px;
					min-width: 25px;
					text-align: center;
				}

				.sidebar .nav a.active {
					background-color: #ffb74d;
					font-weight: 600;
					color: #fff;
				}

				.sidebar .nav a:hover:not(.active) {
					background-color: rgba(255, 255, 255, 0.15);
				}

			.sidebar .nav span {
				opacity: 0;
				transition: opacity 0.2s ease;
			}

		.sidebar:hover .nav span {
			opacity: 1;
		}

		/* Main */

		.main {
			position: relative;
			margin-left: 80px;
			padding: 30px 30px 40px;
			min-height: 100vh;
			width: calc(100% - 80px);
			max-width: none;
			box-sizing: border-box;
			overflow-x: visible;
			/* Keep the dashboard in sync with the expanding sidebar. */
			transition: margin-left 0.3s ease, width 0.3s ease;
		}

		/*
				 * Provider-style sidebar behavior
				 * when the sidebar opens, the dashboard itself moves/reflows instead
				 * of being covered by the sidebar. Cards therefore resize smoothly too.
				 */
		.sidebar:hover ~ .main,
		.sidebar:focus-within ~ .main {
			margin-left: 240px;
			width: calc(100% - 240px);
		}

		.sidebar,
		.profile-card,
		.request-card {
			transform: none;
		}

		h3 {
			color: #d97600;
			font-weight: 700;
		}

		/* Profile */

		.profile-card {
			width: 100%;
			background: #fff;
			border-radius: 16px;
			box-shadow: 0 4px 15px rgba(0,0,0,0.06);
			padding: 22px 26px;
			margin: 0 0 28px;
			display: flex;
			align-items: center;
			gap: 20px;
			box-sizing: border-box;
		}

			.profile-card .profile-summary {
				min-width: 0;
				flex: 1;
			}

			.profile-card img {
				width: 82px;
				height: 82px;
				flex: 0 0 82px;
				border-radius: 50%;
				border: 3px solid #f0ad4e;
				object-fit: cover;
			}

			.profile-card .profile-details {
				display: grid;
				grid-template-columns: repeat(2, minmax(220px, 1fr));
				gap: 4px 28px;
			}

				.profile-card .profile-details p {
					margin: 0;
					color: #6c757d;
					font-size: .93rem;
					line-height: 1.55;
					overflow-wrap: anywhere;
				}

				.profile-card .profile-details strong {
					color: #212529;
				}

			.profile-card .profile-customer-id {
				margin: -4px 0 8px;
				color: #6c757d;
				font-size: .93rem;
				line-height: 1.4;
			}

				.profile-card .profile-customer-id strong {
					color: #212529;
				}

		.profile-edit-btn {
			flex: 0 0 auto;
			white-space: nowrap;
		}

		/* Customer profile modal */

		#customerProfileModal .modal-dialog {
			width: min(720px, calc(100% - 24px));
			max-width: 720px;
			margin: 20px auto;
		}

		#customerProfileModal .modal-content {
			height: calc(100vh - 40px);
			max-height: calc(100vh - 40px);
			display: flex;
			flex-direction: column;
		}

		#customerProfileModal .modal-body {
			flex: 1 1 auto;
			min-height: 0;
			overflow-y: auto;
			overflow-x: hidden;
			-webkit-overflow-scrolling: touch;
		}

		#customerProfileModal .modal-header,
		#customerProfileModal .modal-footer {
			flex: 0 0 auto;
		}

		/*
				 * The form sits between the fixed header and footer, so the
				 * scrolling area must be the modal-body inside this form.
				 */
		#customerProfileModal form#customerProfileForm {
			flex: 1 1 auto;
			min-height: 0;
			display: flex;
			flex-direction: column;
		}

			#customerProfileModal form#customerProfileForm .modal-body {
				flex: 1 1 auto;
				min-height: 0;
				overflow-y: auto;
				overflow-x: hidden;
				max-height: none;
			}

			#customerProfileModal form#customerProfileForm .modal-footer {
				flex: 0 0 auto;
				background: #fff;
			}

		#customerProfileModal .readonly-field {
			background: #f5f6f8;
			color: #6c757d;
			cursor: not-allowed;
		}

		#customerProfileModal .form-control {
			border-radius: 10px;
			min-height: 44px;
		}

		#customerProfileModal textarea.form-control {
			min-height: 95px;
		}

		#customerProfileModal .form-control:focus {
			border-color: #f0ad4e;
			box-shadow: 0 0 0 0.2rem rgba(240,173,78,.18);
		}

		#customerProfileModal .btn {
			border-radius: 10px;
		}

		/* Request cards */

		.request-container {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 20px;
			align-items: start;
		}

		.request-card {
			background: #fff;
			content-visibility: auto;
			contain-intrinsic-size: 260px;
			border-radius: 16px;
			box-shadow: 0 4px 15px rgba(0,0,0,0.04);
			padding: 24px;
			width: 100%;
			min-width: 0;
			box-sizing: border-box;
			border-left: 6px solid transparent;
			transition: transform 0.2s ease, box-shadow 0.2s ease;
		}

			.request-card:hover {
				transform: translateY(-3px);
				box-shadow: 0 6px 20px rgba(0,0,0,0.08);
			}

		/* Buttons */

		.buttons-group {
			display: flex;
			gap: 10px;
			margin-top: 15px;
			flex-wrap: wrap;
		}

		/* Booking category tabs */
		/*
				 * Dashboard booking tabs intentionally mirror the History tabs.
				 * Keep the same shell/spacing so the dashboard feels like one
				 * professional product instead of a separate component.
				 */
		.booking-category-tabs {
			display: flex;
			align-items: center;
			gap: 10px;
			background: #fff;
			border: 1px solid #eee;
			border-radius: 14px;
			padding: 8px;
			margin: 10px auto 22px;
			box-shadow: 0 4px 12px rgba(0,0,0,.04);
			width: min(100%, 900px);
		}

		.booking-category-tab {
			flex: 1;
			border: 0;
			background: transparent;
			color: #555;
			border-radius: 10px;
			padding: 11px 16px;
			font-weight: 700;
			cursor: pointer;
			transition: .2s ease;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 8px;
		}

			.booking-category-tab:hover:not(.active) {
				background: #fff8ed;
				color: #d97600;
			}

			.booking-category-tab.active {
				background: #ffb74d;
				color: #fff;
			}

		.booking-category-count {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-width: 24px;
			height: 24px;
			padding: 3px 7px;
			border-radius: 12px;
			background: #f5f5f5;
			color: #666;
			font-size: 11px;
			font-weight: 700;
		}

		.booking-category-tab.active .booking-category-count {
			background: #fff;
			color: #d97600;
		}

		.booking-empty-state {
			display: none;
			/*
					 * The container is a 2-column grid: span BOTH columns so the
					 * message sits exactly in the center under the tabs.
					 */
			grid-column: 1 / -1;
			width: 100%;
			max-width: 460px;
			justify-self: center;
			text-align: center;
			margin: 10px auto 0;
			padding: 34px 24px 30px;
			box-sizing: border-box;
			background: linear-gradient(180deg, #fffaf2 0%, #fff4e3 100%);
			border: 2px dashed #f3c27a;
			border-radius: 22px;
			box-shadow: 0 8px 24px rgba(217, 118, 0, 0.08);
		}

			.booking-empty-state .empty-icon {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 68px;
				height: 68px;
				margin-bottom: 14px;
				border-radius: 50%;
				background: #fff;
				color: #d97600;
				font-size: 1.9rem;
				box-shadow: 0 4px 14px rgba(217, 118, 0, 0.18);
			}

			.booking-empty-state .empty-title {
				display: block;
				margin: 0 0 6px;
				color: #8a4b00;
				font-weight: 800;
				font-size: 1.1rem;
			}

			.booking-empty-state .empty-hint {
				display: block;
				color: #a3875f;
				font-weight: 500;
				font-size: .88rem;
			}

		.buttons-group .booking-action-btn {
			border: 0 !important;
			border-radius: 9px !important;
			min-height: 38px;
			padding: 8px 14px !important;
			font-size: .86rem !important;
			font-weight: 600;
			line-height: 1.2;
			box-shadow: 0 3px 9px rgba(0,0,0,.08) !important;
			transition: transform .16s ease, box-shadow .16s ease, filter .16s ease;
		}

			.buttons-group .booking-action-btn:hover {
				transform: translateY(-1px);
				filter: brightness(.97);
				box-shadow: 0 5px 12px rgba(0,0,0,.12) !important;
			}

		.sidebar-notification-badge {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-width: 20px;
			height: 20px;
			padding: 0 6px;
			margin-left: auto;
			border-radius: 10px;
			background: #fff;
			color: #d97600;
			font-size: .68rem;
			font-weight: 800;
			line-height: 1;
		}

		/* Mobile */

		.mobile-top {
			display: none !important;
		}

		.mobile-profile-menu {
			min-width: 220px;
			margin-top: 10px !important;
			padding: 8px;
			border: 1px solid rgba(217, 118, 0, 0.10) !important;
			border-radius: 16px;
			background: rgba(255, 255, 255, 0.98);
			box-shadow: 0 14px 35px rgba(33, 37, 41, 0.14) !important;
			overflow: hidden;
			transform-origin: top right;
		}

			.mobile-profile-menu.show {
				animation: customerDropdownIn 0.2s ease-out both;
			}

			.mobile-profile-menu .dropdown-item {
				color: #495057;
				border-radius: 10px;
				margin: 2px 0;
				padding: 10px 12px !important;
				transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
			}

				.mobile-profile-menu .dropdown-item:hover,
				.mobile-profile-menu .dropdown-item:focus {
					background-color: #fff4df;
					color: #d97600;
					transform: translateX(-2px);
				}

				.mobile-profile-menu .dropdown-item.active {
					background-color: #ffb74d;
					color: #fff;
				}

		.mobile-customer-label {
			color: #212529;
			font-weight: 700;
			font-size: .9rem;
			white-space: nowrap;
		}

		.mobile-profile-trigger {
			width: 42px;
			height: 42px;
			border: 2px solid #f0ad4e;
			border-radius: 50%;
			object-fit: cover;
			cursor: pointer;
			display: block;
		}

		/* Reschedule modal */

		.reschedule-section {
			border-radius: 12px;
			padding: 15px;
		}

		.current-appointment-box {
			background: #f8f9fa;
			border: 1px solid #e9ecef;
		}

		.new-appointment-box {
			background: #fffaf0;
			border: 1px solid #ffe8cc;
		}

		.modal-content {
			overflow: hidden;
		}

		/* Complaint modal */

		.complaint-modal {
			z-index: 1060;
		}

			.complaint-modal .modal-dialog {
				max-width: 650px;
			}

			.complaint-modal .modal-content {
				border-radius: 18px;
				border: 0;
				box-shadow: 0 10px 40px rgba(0,0,0,0.18);
			}

			.complaint-modal .modal-header {
				padding: 20px 24px 10px;
			}

			.complaint-modal .modal-body {
				padding: 15px 24px 24px;
			}

			.complaint-modal .form-label {
				font-weight: 600;
				color: #343a40;
			}

			.complaint-modal .form-control,
			.complaint-modal .form-select {
				border-radius: 8px;
				padding: 10px 12px;
			}

				.complaint-modal .form-control:focus,
				.complaint-modal .form-select:focus {
					border-color: #f0ad4e;
					box-shadow: 0 0 0 0.2rem rgba(240,173,78,0.18);
				}

		.complaint-submit-btn {
			background-color: #e74c3c;
			border: none;
			color: #fff;
			border-radius: 7px;
			padding: 10px 22px;
			font-weight: 600;
		}

			.complaint-submit-btn:hover {
				background-color: #d63c2e;
				color: #fff;
			}

		/* Responsive */

		@@media (max-width: 992px) {

			.request-card {
				width: 100% !important;
			}
		}

		@@media (max-width: 768px) {

			.booking-category-tabs {
				gap: 7px;
				margin-bottom: 18px;
			}

			.booking-category-tab {
				min-width: 0;
				min-height: 52px;
				padding: 8px 6px;
				font-size: .78rem;
			}

			.booking-category-count {
				min-width: 20px;
				height: 20px;
				margin-left: 4px;
				padding: 0 5px;
				font-size: .7rem;
			}

			.sidebar {
				display: none !important;
			}

				.sidebar:hover ~ .main,
				.sidebar:focus-within ~ .main {
					margin-left: 0 !important;
					width: 100% !important;
				}

			.mobile-top {
				display: flex !important;
				justify-content: space-between;
				align-items: center;
				background: #fff;
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 2000;
				box-shadow: 0 2px 8px rgba(0,0,0,0.06);
				padding: 10px 15px;
			}

				.mobile-top .dropdown {
					position: relative;
					z-index: 2005;
				}

			.mobile-profile-menu {
				position: absolute;
				right: 0;
				left: auto;
				z-index: 2100;
			}

			.main {
				margin-left: 0 !important;
				padding: 85px 12px 30px !important;
				width: 100% !important;
				box-sizing: border-box;
			}

			.profile-card {
				flex-direction: column;
				text-align: center;
				padding: 20px 16px;
				gap: 12px;
			}

				.profile-card .profile-summary {
					width: 100%;
					text-align: left;
				}

					.profile-card .profile-summary h3 {
						text-align: left !important;
						width: 100%;
						margin-bottom: 10px !important;
					}

				.profile-card .profile-details {
					grid-template-columns: 1fr;
					gap: 6px;
					width: 100%;
					text-align: left;
				}

					.profile-card .profile-details p {
						width: 100%;
						text-align: left;
						display: block;
						margin: 0;
						overflow-wrap: anywhere;
						word-break: normal;
					}

					.profile-card .profile-details strong {
						display: inline;
						white-space: nowrap;
					}

				.profile-card img {
					margin: 0;
				}

			.profile-edit-btn {
				width: 100%;
			}

			#customerProfileModal .modal-dialog {
				width: calc(100% - 16px);
				max-width: none;
				margin: 8px auto;
			}

			#customerProfileModal .modal-content {
				height: calc(100vh - 16px);
				max-height: calc(100vh - 16px);
			}

			.request-container {
				grid-template-columns: 1fr;
			}

			.request-card {
				width: 100% !important;
			}

			.buttons-group {
				flex-direction: column;
			}

				.buttons-group .btn {
					width: 100%;
					justify-content: center;
				}

			.complaint-modal .modal-dialog {
				margin: 10px;
			}

			.complaint-modal .modal-body {
				padding: 12px 18px 20px;
			}
		}

		/* Servicego customer shell — same on every page */
		.sidebar,
		.sidebar#sidebar {
			width: 80px !important;
			min-width: 80px !important;
