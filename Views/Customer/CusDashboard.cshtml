	</div>

	<!-- Bootstrap -->

	<script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

	<!-- Sweetalert2 -->

	<script defer src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	<script>

		/* Servicego - customer dashboard */

		let currentProviderRescheduleBookingId = null;

		/* Anti forgery token */

		function getAntiForgeryToken() {

		const tokenElement =
		document.querySelector(
		'#rescheduleForm input[name="__RequestVerificationToken"]'
		) ||
		document.querySelector(
		'#complaintForm input[name="__RequestVerificationToken"]'
		) ||
		document.querySelector(
		'input[name="__RequestVerificationToken"]'
		);

		return tokenElement
		? tokenElement.value
		: '';

		}

		/* Error */

		function showError(message) {

		if (typeof Swal !== 'undefined') {

		Swal.fire({

		title: 'Error!',

		text: message,

		icon: 'error',

		confirmButtonColor: '#d97600'

		});

		}
		else {

		console.error(message);

		}

		}

		/* Open chat */

		function openChat(providerId, providerName) {

		if (!providerId) {

		showError(
		'Provider information is missing.'
		);

		return;

		}

		const url =
		'@Url.Action("Messages", "Customer")' +
		'?providerId=' +
		encodeURIComponent(providerId) +
		'&providerName=' +
		encodeURIComponent(providerName || '');

		window.location.href = url;

		}

		/* Open complaint modal */

		function openComplaint(
		bookingId,
		providerId,
		providerName,
		detailModalId
		) {

		const complaintForm =
		document.getElementById(
		'complaintForm'
		);

		if (!complaintForm) {

		showError(
		'Complaint form was not found.'
		);

		return;

		}

		const providerIdInput =
		document.getElementById(
		'complaintProviderId'
		);

		const providerNameInput =
		document.getElementById(
		'complaintProviderName'
		);

		const bookingInput =
		document.getElementById(
		'complaintBookingId'
		);

		if (providerIdInput) {

		providerIdInput.value =
		providerId || '';

		}

		if (providerNameInput) {

		providerNameInput.value =
		providerName || 'Not Assigned';

		}

		if (bookingInput) {

		bookingInput.value =
		bookingId || '';

		}

		/* Complaint ID */

		const complaintIdDisplay =
		document.getElementById(
		'complaintIdDisplay'
		);

		const complaintIdInput =
		document.getElementById(
		'complaintId'
		);

		if (
		complaintIdDisplay &&
		complaintIdInput
		) {

		let nextComplaintId =
		complaintIdInput.value;

		if (
		!nextComplaintId ||
		nextComplaintId.trim() === ''
		) {

		nextComplaintId =
		'COMP-1';

		}

		complaintIdDisplay.value =
		nextComplaintId;

		complaintIdInput.value =
		nextComplaintId;

		}

		/* Reset form fields */

		const issueTitle =
		document.getElementById(
		'issueTitle'
		);

		const otherBox =
		document.getElementById(
		'otherBox'
		);

		const otherInput =
		document.getElementById(
		'OtherIssueText'
		);

		const details =
		document.getElementById(
		'complaintDetails'
		);

		if (issueTitle) {

		issueTitle.value = '';

		}

		if (otherBox) {

		otherBox.style.display =
		'none';

		}

		if (otherInput) {

		otherInput.value = '';

		otherInput.removeAttribute(
		'required'
		);

		}

		if (details) {

		details.value = '';

		}

		/* Show optional complaint details after issue selection */

		const complaintDetailsBox =
		document.getElementById(
		'complaintDetailsBox'
		);

		function updateComplaintDetailsVisibility() {
		if (!complaintDetailsBox || !issueTitle) return;

		const hasIssueSelected =
		issueTitle.value.trim() !== '';

		complaintDetailsBox.style.display =
		hasIssueSelected ? 'block' : 'none';
		}

		if (issueTitle) {
		issueTitle.addEventListener(
		'change',
		updateComplaintDetailsVisibility
		);

		updateComplaintDetailsVisibility();
		}

		/* Reset submit button */

		const submitButton =
		document.getElementById(
		'submitComplaintBtn'
		);

		if (submitButton) {

		submitButton.disabled =
		false;

		submitButton.innerHTML =
		'<i class="bi bi-send me-1"></i> Submit Complaint';

		}

		/* Complaint modal */

		const complaintModalElement =
		document.getElementById(
		'complaintModal'
		);

		if (!complaintModalElement) {

		showError(
		'Complaint modal was not found.'
		);

		return;

		}

		const complaintModal =
		bootstrap.Modal.getOrCreateInstance(
		complaintModalElement,
		{
		backdrop: true,
		keyboard: true
		}
		);

		/* Close detail modal first */

		const detailModalElement =
		detailModalId
		? document.getElementById(
		detailModalId
		)
		: null;

		if (
		detailModalElement &&
		detailModalElement.classList.contains('show')
		) {

		const detailModal =
		bootstrap.Modal.getInstance(
		detailModalElement
		) ||
		bootstrap.Modal.getOrCreateInstance(
		detailModalElement
		);

		const openComplaintAfterClose =
		function () {

		detailModalElement.removeEventListener(
		'hidden.bs.modal',
		openComplaintAfterClose
		);

		complaintModal.show();

		};

		detailModalElement.addEventListener(
		'hidden.bs.modal',
		openComplaintAfterClose
		);

		detailModal.hide();

		}
		else {

		complaintModal.show();

		}

		}

		/* Cancel booking */

		function cancelRequest(bookingId) {

		if (!bookingId) {

		showError(
		'Booking ID is missing.'
		);

		return;

		}

		Swal.fire({

		title: 'Cancel Booking?',

		text:
		'Are you sure you want to cancel this booking?',

		icon: 'warning',

		showCancelButton: true,

		confirmButtonColor: '#d33',

		cancelButtonColor: '#6c757d',

		confirmButtonText: 'Yes, Cancel',

		cancelButtonText: 'No'

		}).then((result) => {

		if (!result.isConfirmed) {

		return;

		}

		window.location.href =
		'@Url.Action("CancelBooking", "Customer")' +
		'?id=' +
		encodeURIComponent(bookingId);

		});

		}

		/* Customer reschedule modal */

		function openReschedule(
		bookingId,
		currentDate,
		currentTime
		) {

		if (!bookingId) {

		showError(
		'Booking ID is missing.'
		);

		return;

		}

		const bookingIdInput =
		document.getElementById(
		'rescheduleBookingId'
		);

		const currentDateElement =
		document.getElementById(
		'rescheduleCurrentDate'
		);

		const currentTimeElement =
		document.getElementById(
		'rescheduleCurrentTime'
		);

		const newDateInput =
		document.getElementById(
		'newDateInput'
		);

		const newTimeInput =
		document.getElementById('newTimeInput');

		wireCustomerRescheduleFieldValidation();

		if (bookingIdInput) {

		bookingIdInput.value =
		bookingId;

		}

		if (currentDateElement) {

		currentDateElement.innerText =
		currentDate || 'N/A';

		}

		if (currentTimeElement) {

		currentTimeElement.innerText =
		currentTime || 'N/A';

		}

		if (newDateInput) {

		newDateInput.value = '';

		}

		if (newTimeInput) {

		newTimeInput.value = '';

		}

		/* Prevent past dates */

		if (newDateInput) {

		const now =
		new Date();

		const year =
		now.getFullYear();

		const month =
		String(
		now.getMonth() + 1
		).padStart(
		2,
		'0'
		);

		const day =
		String(
		now.getDate()
		).padStart(
		2,
		'0'
		);

		const today =
		year +
		'-' +
		month +
		'-' +
		day;

		newDateInput.min =
		today;

		}

		const modalElement =
		document.getElementById(
		'rescheduleModal'
		);

		if (!modalElement) {

		showError(
		'Reschedule modal was not found.'
		);

		return;

		}

		const modal =
		bootstrap.Modal.getOrCreateInstance(
		modalElement,
		{
		backdrop: true,
		keyboard: true
		}
		);

		modal.show();

		}

		/* Provider reschedule modal */

		function openProviderReschedule(bookingId) {

		if (!bookingId) {

		showError(
		'Booking ID is missing.'
		);

		return;

		}

		currentProviderRescheduleBookingId =
		String(bookingId);

		const bookingData =
		providerRescheduleData[
		String(bookingId)
		];

		if (!bookingData) {

		showError(
		'Reschedule request information could not be found.'
		);

		return;

		}

		const oldDate =
		document.getElementById(
		'providerOldDate'
		);

		const oldTime =
		document.getElementById(
		'providerOldTime'
		);

		const newDate =
		document.getElementById(
		'providerNewDate'
		);

		const newTime =
		document.getElementById(
		'providerNewTime'
		);

		if (oldDate) {

		oldDate.innerText =
		bookingData.oldDate || 'N/A';

		}

		if (oldTime) {

		oldTime.innerText =
		bookingData.oldTime || 'N/A';

		}

		if (newDate) {

		newDate.innerText =
		bookingData.newDate || 'N/A';

		}

		if (newTime) {

		newTime.innerText =
		bookingData.newTime || 'N/A';

		}

		const modalElement =
		document.getElementById(
		'providerRescheduleModal'
		);

		if (!modalElement) {

		showError(
		'Provider reschedule modal was not found.'
		);

		return;

		}

		const modal =
		bootstrap.Modal.getOrCreateInstance(
		modalElement,
		{
		backdrop: true,
		keyboard: true
		}
		);

		modal.show();

		}

		/* Provider reschedule data */
		@{
							var providerRescheduleJson = System.Text.Json.JsonSerializer.Serialize(
							Model?.Bookings?
							.Where(b => b.IsRescheduledByProvider)
							.ToDictionary(
							b => b.Id.ToString(),
							b => (object)new
							{
												oldDate = b.BookingDate.ToString("yyyy-MM-dd"),
												oldTime = b.BookingTime ?? "",
												newDate = b.RequestedDate.HasValue
							? b.RequestedDate.Value.ToString("yyyy-MM-dd")
							: "",
												newTime = b.RequestedTime ?? ""
							}
							)
							?? new System.Collections.Generic.Dictionary<string, object>()
							);
		}

		const providerRescheduleData = @Html.Raw(providerRescheduleJson);

		/* Rating */

		function openRating(
		bookingId,
		providerId
		) {

		const bookingInput =
		document.getElementById(
		'rateBookingId'
		);

		const providerInput =
		document.getElementById(
		'rateProviderId'
		);

		const ratingInput =
		document.getElementById(
		'ratingValueInput'
		);

		const feedbackInput =
		document.getElementById(
		'feedbackComment'
		);

		if (bookingInput) {

		bookingInput.value =
		bookingId || '';

		}

		if (providerInput) {

		providerInput.value =
		providerId || '';

		}

		if (ratingInput) {

		ratingInput.value =
		'0';

		}

		if (feedbackInput) {

		feedbackInput.value =
		'';

		}

		setRating(0);

		const modalElement =
		document.getElementById(
		'rateModal'
		);

		if (!modalElement) {

		return;

		}

		bootstrap.Modal
		.getOrCreateInstance(
		modalElement
		)
		.show();

		}

		/* Set rating */

		function setRating(value) {

		const ratingInput =
		document.getElementById(
		'ratingValueInput'
		);

		if (ratingInput) {

		ratingInput.value =
		value;

		}

		document
		.querySelectorAll('.star')
		.forEach(star => {

		const starValue =
		parseInt(
		star.getAttribute(
		'data-value'
		)
		);

		if (starValue <= value) {

		star.classList.remove(
		'text-secondary'
		);

		star.classList.add(
		'text-warning'
		);

		}
		else {

		star.classList.remove(
		'text-warning'
		);

		star.classList.add(
		'text-secondary'
		);

		}

		});

		}

		/* Move modals to body */

		function openDetails(bookingId) {
		if (!bookingId) return;

		const modalId = `detailModal_${bookingId}`;
		let modalElement = document.getElementById(modalId);

		// Detail modals are kept in <template> elements so the browser
		// does not build dozens of hidden Bootstrap modal DOM trees on
		// the initial dashboard load. The exact same modal markup is
		// created only when the customer asks to view that booking.
		if (!modalElement) {
		const template =
		document.getElementById(`detailModalTemplate_${bookingId}`);

		if (!template) {
		console.error("Booking detail template not found:", bookingId);
		return;
		}

		const fragment = template.content.cloneNode(true);
		modalElement = fragment.querySelector(`#${CSS.escape(modalId)}`);

		if (!modalElement) {
		console.error("Booking detail modal not found:", bookingId);
		return;
		}

		document.body.appendChild(fragment);

		modalElement = document.getElementById(modalId);

		if (!modalElement) return;

		modalElement.addEventListener("hidden.bs.modal", function () {
		const instance = bootstrap.Modal.getInstance(modalElement);
		if (instance) instance.dispose();
		modalElement.remove();
		}, { once: true });
		}

		const modal =
		bootstrap.Modal.getOrCreateInstance(modalElement);

		modal.show();

		// Always initialize the profile map when Edit Profile opens.
		// The shown.bs.modal listener below remains as a second safety net.
		setTimeout(function () {
		loadCustomerProfileGoogleMaps()
		.catch(function (error) {
		console.error('Customer profile Google Maps loading error:', error);
		showCustomerProfileMapFallback();
		});
		}, 250);
		}

		/* Move bootstrap modals to body */

		function moveModalsToBody() {

		document
		.querySelectorAll('.modal')
		.forEach(modal => {

		if (
		modal.parentElement !==
		document.body
		) {

		document.body.appendChild(
		modal
		);

		}

		});

		}

		/* Clean bootstrap modal backdrop */

		function cleanModalBackdrop() {

		const visibleModal =
		document.querySelector(
		'.modal.show'
		);

		if (!visibleModal) {

		document
		.querySelectorAll(
		'.modal-backdrop'
		)
		.forEach(backdrop => {

		backdrop.remove();

		});

		document.body.classList.remove(
		'modal-open'
		);

		document.body.style.removeProperty(
		'padding-right'
		);

		}

		}

		/* Submit customer reschedule */

		function validateCustomerRescheduleFields(showMessages = true) {

		const dateInput = document.getElementById('newDateInput');
		const timeInput = document.getElementById('newTimeInput');
		let valid = true;

		if (dateInput) dateInput.classList.remove('is-invalid');
		if (timeInput) timeInput.classList.remove('is-invalid');

		const dateError = document.getElementById('newDateError');
		const timeError = document.getElementById('newTimeError');
		if (dateError) { dateError.textContent = ''; dateError.style.display = 'none'; }
		if (timeError) { timeError.textContent = ''; timeError.style.display = 'none'; }

		if (dateInput && dateInput.value) {
		const selected = new Date(dateInput.value + 'T00:00:00');
		const today = new Date();
		today.setHours(0,0,0,0);
		if (selected < today) {
		if (showMessages) showRescheduleFieldError('date', 'This date is not available.');
		valid = false;
		}
		}

		if (timeInput && timeInput.value) {
		const parts = timeInput.value.split(':');
		const h = Number(parts[0]);
		const m = Number(parts[1]);
		if (!Number.isFinite(h) || !Number.isFinite(m) || h < 0 || h > 23 || m < 0 || m > 59) {
		if (showMessages) showRescheduleFieldError('time', 'This time is not available.');
		valid = false;
		}
		}

		return valid;
		}

		function wireCustomerRescheduleFieldValidation() {
		const dateInput = document.getElementById('newDateInput');
		const timeInput = document.getElementById('newTimeInput');
		if (dateInput && !dateInput.dataset.validationWired) {
		dateInput.dataset.validationWired = '1';
		dateInput.addEventListener('input', () => validateCustomerRescheduleFields(true));
		dateInput.addEventListener('change', () => validateCustomerRescheduleFields(true));
		}
		if (timeInput && !timeInput.dataset.validationWired) {
		timeInput.dataset.validationWired = '1';
		timeInput.addEventListener('input', () => validateCustomerRescheduleFields(true));
		timeInput.addEventListener('change', () => validateCustomerRescheduleFields(true));
		}
		}

		function clearRescheduleFieldErrors() {

		const dateError = document.getElementById('newDateError');
		const timeError = document.getElementById('newTimeError');

		if (dateError) {
		dateError.textContent = '';
		dateError.style.display = 'none';
		}

		if (timeError) {
		timeError.textContent = '';
		timeError.style.display = 'none';
		}

		document.getElementById('newDateInput')?.classList.remove('is-invalid');
		document.getElementById('newTimeInput')?.classList.remove('is-invalid');
		}

		function showRescheduleFieldError(field, message) {

		const input =
		document.getElementById(field === 'date' ? 'newDateInput' : 'newTimeInput');

		const error =
		document.getElementById(field === 'date' ? 'newDateError' : 'newTimeError');

		if (input)
		input.classList.add('is-invalid');

		if (error) {
		error.textContent = message;
		error.style.display = 'block';
		}
		}

		function showRescheduleValidationFromServer(message) {

		const text = String(message || 'Unable to send reschedule request.');
		const lower = text.toLowerCase();

		if (lower.includes('not available on')) {
		showRescheduleFieldError('date', 'This date is not available.');
		return;
		}

		if (lower.includes('available only between') ||
		lower.includes('valid time')) {
		showRescheduleFieldError('time', 'This time is not available.');
		return;
		}

		if (lower.includes('date')) {
		showRescheduleFieldError('date', 'This date is not available.');
		return;
		}

		if (lower.includes('time')) {
		showRescheduleFieldError('time', 'This time is not available.');
		return;
		}

		showError(text);
		}

		async function submitReschedule(event) {

		if (event) {

		event.preventDefault();

		}

		const bookingId =
		document.getElementById(
		'rescheduleBookingId'
		)?.value;

		const newDate =
		document.getElementById(
		'newDateInput'
		)?.value;

		const newTime =
		document.getElementById('newTimeInput')?.value?.trim() || "";

		clearRescheduleFieldErrors();

		/* Validation */

		if (!bookingId) {

		showError(
		'Booking ID is missing.'
		);

		return false;

		}

		if (!newDate) {

		showRescheduleFieldError(
		'date',
		'Please select a date.'
		);

		return false;

		}

		if (!newTime) {

		showRescheduleFieldError(
		'time',
		'Please select a time.'
		);

		return false;

		}

		if (!validateCustomerRescheduleFields(true)) {
		return false;
		}

		/* Prevent past date */

		const selectedDate =
		new Date(
		newDate + 'T00:00:00'
		);

		const today =
		new Date();

		today.setHours(
		0,
		0,
		0,
		0
		);

		if (selectedDate < today) {

		showRescheduleFieldError(
		'date',
		'This date is not available.'
		);

		return false;

		}

		const submitButton =
		document.getElementById(
		'submitRescheduleBtn'
		);

		if (submitButton) {

		submitButton.disabled =
		true;

		submitButton.innerHTML =
		'<span class="spinner-border spinner-border-sm me-1"></span> Sending...';

		}

		try {

		/* Form data */

		const formData =
		new FormData();

		formData.append(
		'id',
		bookingId
		);

		formData.append(
		'newDate',
		newDate
		);

		formData.append(
		'newTime',
		newTime
		);

		/* Anti forgery token */

		const token =
		document.querySelector(
		'#rescheduleForm input[name="__RequestVerificationToken"]'
		);

		if (token && token.value) {

		formData.append(
		'__RequestVerificationToken',
		token.value
		);

		}

		/* Send request */

		const response =
		await fetch(
		'@Url.Action("SubmitReschedule", "Customer")',
		{
		method: 'POST',
		body: formData,
		headers: {
		'X-Requested-With':
		'XMLHttpRequest'
		}
		}
