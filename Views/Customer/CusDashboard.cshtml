	<style id="sg-popup-theme">
		/* Compact, soft popups (SweetAlert2) */
		.swal2-container {
			padding: 12px !important;
		}

		.swal2-popup {
			width: min(340px, calc(100vw - 32px)) !important;
			padding: 22px 20px 18px !important;
			border-radius: 20px !important;
			box-shadow: 0 18px 50px rgba(33, 37, 41, .20) !important;
			font-family: inherit !important;
		}

		.swal2-icon {
			zoom: .72;
			margin: .2em auto .7em !important;
		}

		.swal2-title {
			font-size: 1.12rem !important;
			font-weight: 700 !important;
			color: #212529 !important;
			padding: 0 !important;
			margin: 0 0 .3rem !important;
		}

		.swal2-html-container {
			font-size: .9rem !important;
			line-height: 1.5 !important;
			color: #6c757d !important;
			margin: .2rem 0 0 !important;
			padding: 0 .2em !important;
		}

		.swal2-actions {
			margin-top: 1.1rem !important;
			gap: 8px;
		}

		.swal2-styled {
			border-radius: 12px !important;
			padding: .55rem 1.2rem !important;
			min-width: 92px;
			font-size: .9rem !important;
			font-weight: 600 !important;
			box-shadow: none !important;
		}

			.swal2-styled.swal2-confirm {
				background-color: #d97600 !important;
			}

			.swal2-styled.swal2-cancel {
				background-color: #e9ecef !important;
				color: #495057 !important;
			}

			.swal2-styled:focus {
				box-shadow: 0 0 0 3px rgba(217, 118, 0, .25) !important;
			}

		.swal2-popup.swal2-show {
			animation: sgPopIn .22s ease-out !important;
		}

		.swal2-popup.swal2-hide {
			animation: sgPopOut .15s ease-in !important;
		}

		@@keyframes sgPopIn {
			from {
				opacity: 0;
				transform: translateY(10px) scale(.96);
			}

			to {
				opacity: 1;
				transform: none;
			}
		}

		@@keyframes sgPopOut {
			from {
				opacity: 1;
				transform: none;
			}

			to {
				opacity: 0;
				transform: translateY(6px) scale(.97);
			}
		}

		/* Bootstrap modals: smaller, rounded, smooth */
		.modal-content {
			border: 0 !important;
			border-radius: 18px !important;
			box-shadow: 0 18px 50px rgba(33, 37, 41, .20) !important;
			overflow: hidden;
		}

		.modal-header {
			padding: .85rem 1.1rem;
		}

		.modal-title {
			font-size: 1.05rem;
			font-weight: 700;
		}

		.modal-body {
			padding: 1rem 1.1rem;
		}

		.modal-footer {
			padding: .7rem 1.1rem;
			gap: 6px;
		}

		.modal-backdrop.show {
			opacity: .35;
		}

		.modal.fade .modal-dialog {
			transform: translateY(14px) scale(.97);
			transition: transform .22s ease-out;
		}

		.modal.show .modal-dialog {
			transform: none;
		}

		@@media (min-width: 576px) {
			.modal-dialog.modal-md {
				--bs-modal-width: 440px;
				max-width: 440px;
			}

			.modal-dialog.modal-lg {
				--bs-modal-width: 620px;
			}
		}

		.sg-rec-dot {
			display: inline-block;
			width: 9px;
			height: 9px;
			border-radius: 50%;
			background: #dc3545;
			margin-left: 4px;
			vertical-align: middle;
			animation: sgBlink 1s infinite;
		}

		@@keyframes sgBlink {
			50% {
				opacity: .25;
			}
		}
	</style>

</head>

<body data-profile-incomplete="@(customerProfileIncomplete ? "true" : "false")">

	@Html.AntiForgeryToken()

	<!-- Desktop sidebar -->

	<div class="sidebar">

		<img src="@Url.Content("~/images/Logo.png")"
			 class="logo" width="60" height="60" loading="eager" decoding="async" asp-append-version="true"
			 alt="Logo"
			 onclick="window.location.href='@Url.Action("Index", "Home")'">

		<div class="sidebar-customer-label" aria-label="Customer">
			<img src="@Url.Content(string.IsNullOrWhiteSpace(customerProfileImage) ? "~/images/Profile icon.png" : customerProfileImage)"
				 alt="Profile">
			<span>Hi Customer</span>
		</div>

		<div class="nav">

			<a href="@Url.Action("CusDashboard", "Customer")"
			   class="active">

				<i class="bi bi-house-door"></i>
				<span>Dashboard</span>

			</a>

			<a href="@Url.Action("History", "Customer")">
				<i class="bi bi-clock-history"></i>
				<span>History</span>
			</a>

			<a href="@Url.Action("Messages", "Customer")">
				<i class="bi bi-chat-dots"></i>
				<span>Messages</span>
			</a>

			<a href="@Url.Action("Notifications", "Customer")">
				<i class="bi bi-bell"></i>
				<span>Notifications</span>
				@if ((ViewBag.UnreadNotificationCount as int? ?? 0) > 0)
				{
					<span class="sidebar-notification-badge">@(ViewBag.UnreadNotificationCount)</span>
				}
			</a>

			<a href="@Url.Action("Logout", "Customer")">
				<i class="bi bi-box-arrow-right"></i>
				<span>Logout</span>
			</a>

		</div>

	</div>

	<!-- Mobile top -->

	<div class="mobile-top d-md-none">

		<img src="@Url.Content("~/images/Logo.png")"
			 width="40"
			 height="40" loading="eager" decoding="async" asp-append-version="true"
			 alt="Logo"
			 style="cursor:pointer; border-radius:8px;"
			 onclick="window.location.href='@Url.Action("Index", "Home")'">

		<div class="dropdown d-flex align-items-center gap-2">

			<span class="mobile-customer-label">Hi Customer</span>

			<img src="@Url.Content(string.IsNullOrWhiteSpace(customerProfileImage) ? "~/images/Profile icon.png" : customerProfileImage)"
				 class="mobile-profile-trigger"
				 id="mobileCustomerProfileImage" width="44" height="44" loading="eager" decoding="async" asp-append-version="true"
				 alt="Profile"
				 data-bs-toggle="dropdown"
				 aria-expanded="false">

			<ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2 mobile-profile-menu">

				<li>
					<a class="dropdown-item active py-2 fw-bold"
					   href="@Url.Action("CusDashboard", "Customer")">
						<i class="bi bi-house-door me-2"></i>
						Dashboard
					</a>
				</li>

				<li>
					<a class="dropdown-item py-2 fw-bold"
					   href="@Url.Action("History", "Customer")">
						<i class="bi bi-clock-history me-2"></i>
						History
					</a>
				</li>

				<li>
					<a class="dropdown-item py-2 fw-bold"
					   href="@Url.Action("Messages", "Customer")">
						<i class="bi bi-chat-dots me-2"></i>
						Messages
					</a>
				</li>

				<li>
					<a class="dropdown-item py-2 fw-bold d-flex align-items-center"
					   href="@Url.Action("Notifications", "Customer")">
						<i class="bi bi-bell me-2"></i>
						<span>Notifications</span>
						@if ((ViewBag.UnreadNotificationCount as int? ?? 0) > 0)
						{
							<span class="badge rounded-pill text-bg-warning ms-auto">@(ViewBag.UnreadNotificationCount)</span>
						}
					</a>
				</li>

				<li>
					<hr class="dropdown-divider my-1">
				</li>

				<li>
					<a class="dropdown-item text-danger py-2 fw-bold"
					   href="@Url.Action("Logout", "Customer")">
						<i class="bi bi-box-arrow-right me-2"></i>
						Logout
					</a>
				</li>

			</ul>

		</div>

	</div>
	<!-- Main content -->

	<div class="main">

		<div class="profile-card bg-white">

			<img src="@Url.Content(string.IsNullOrWhiteSpace(customerProfileImage) ? "~/images/Profile icon.png" : customerProfileImage)"
				 alt="Profile Icon"
				 id="dashboardProfileImage" width="82" height="82" loading="eager" decoding="async" asp-append-version="true">

			<div class="profile-summary">

				<h3 class="text-start mb-2 fw-bold"
					style="color:#212529; font-size:24px;">
					@Model.CustomerName
				</h3>

				<p class="profile-customer-id">
					<strong>Customer ID:</strong>
					<span id="dashboardCustomerId">@customerIdDisplay</span>
				</p>

				<div class="profile-details">

					<p>
						<strong>Email:</strong>
						<span id="dashboardCustomerEmail">@Model.CustomerEmail</span>
					</p>

					<p>
						<strong>Phone:</strong>
						<span id="dashboardCustomerPhone" data-customer-phone>
							@(string.IsNullOrWhiteSpace(customerPhone) || customerPhone == "N/A"
														? "N/A"
														: customerPhone)
																	</span>
																</p>

					<p>
						<strong>City:</strong>
						<span id="dashboardCustomerCity">
							@(string.IsNullOrWhiteSpace(customerCity)
														? "N/A"
														: customerCity)
										   						</span>
										   					</p>

					<p>
						<strong>Address:</strong>
						<span id="dashboardCustomerAddress">
							@(string.IsNullOrWhiteSpace(customerAddress)
														? "N/A"
														: customerAddress)
						</span>
					</p>


				</div>
			</div>

			<button type="button"
					class="btn text-white profile-edit-btn"
					style="background:#d97600; border-radius:10px;"
					onclick="openCustomerProfile();">
				<i class="bi bi-pencil-square me-1"></i>
				Edit Profile
			</button>

		</div>

		<!--
		   Complete customer profile modal
		   Profile data is saved permanently in CustomerSignup.
		   It is NOT read from Booking.
		-->
		<div class="modal fade"
			 id="customerProfileModal"
			 tabindex="-1"
			 aria-labelledby="customerProfileModalLabel"
			 aria-hidden="true">

			<div class="modal-dialog modal-dialog-centered modal-lg">
				<div class="modal-content border-0 shadow-lg"
					 style="border-radius:18px; overflow:hidden;">

					<div class="modal-header"
						 style="background:#d97600; color:#fff;">

						<div>
							<h5 class="modal-title fw-bold mb-1"
								id="customerProfileModalLabel">
								<span id="customerProfileModalTitle">Edit Your Profile</span>
							</h5>

							<small id="customerProfileModalSubtitle" style="opacity:.9;">
								Update your permanent customer information.
							</small>
						</div>

						<button type="button"
								class="btn-close btn-close-white"
								data-bs-dismiss="modal"
								aria-label="Close">
						</button>
					</div>

					<form id="customerProfileForm"
						  method="post"
						  enctype="multipart/form-data"
						  action="@Url.Action("Profile", "Customer")">

						@Html.AntiForgeryToken()

						<div class="modal-body p-4">

							<div id="customerProfileError"
								 class="alert alert-danger d-none">
							</div>

							<div id="customerProfileSuccess"
								 class="alert alert-success d-none">
							</div>

							<div class="row g-3">

								<div class="col-12 text-center mb-2">
									<img id="customerModalProfileImage"
										 src="@Url.Content(string.IsNullOrWhiteSpace(customerProfileImage) ? "~/images/Profile icon.png" : customerProfileImage)"
										 alt="Profile" width="90" height="90" loading="lazy" decoding="async" asp-append-version="true"
										 style="width:90px;height:90px;border-radius:50%;object-fit:cover;border:3px solid #f0ad4e;">

									<div class="mt-2">
										<label for="customerProfileImageFile"
											   class="btn btn-sm btn-outline-warning">
											<i class="bi bi-camera me-1"></i>
											Choose Profile Photo
										</label>

										<input type="file"
											   id="customerProfileImageFile"
											   name="profileImageFile"
											   accept=".jpg,.jpeg,.png,.webp"
											   class="d-none">
									</div>
								</div> <div class="col-md-6">
									<label class="form-label fw-semibold">
										Customer ID
									</label>
									<input type="text"
										   class="form-control readonly-field"
										   value="@customerIdDisplay"
										   readonly
										   aria-readonly="true">
								</div>

								<div class="col-md-6">
									<label class="form-label fw-semibold">
										Full Name
									</label>

									<input type="text"
										   class="form-control readonly-field"
										   value="@Model.CustomerName"
										   readonly
										   aria-readonly="true">
								</div>

								<div class="col-md-6">
									<label class="form-label fw-semibold">
										Email
									</label>

									<input type="email"
										   class="form-control readonly-field"
										   value="@Model.CustomerEmail"
										   readonly
										   aria-readonly="true">
								</div>

								<div class="col-md-6">
									<label class="form-label fw-semibold">
										Phone Number <span class="text-danger">*</span>
									</label>

									<input type="text"
										   id="customerProfilePhone"
										   name="Phone"
										   class="form-control"
										   maxlength="20"
										   value="@((ViewBag.CustomerPhonePermanent as string) ?? "")"
										   placeholder="Enter your phone number"
										   required>
								</div>

								<div class="col-md-6">
									<label class="form-label fw-semibold">
										City <span class="text-danger">*</span>
									</label>

									<input type="text"
										   id="customerProfileCity"
										   name="City"
										   class="form-control"
										   maxlength="100"
										   value="@((ViewBag.CustomerCity as string) ?? "")"
										   placeholder="Enter your city"
										   required>
								</div>

								@*
   Only ONE location option is shown: "Permanent Location" below.
   The address text is kept in this hidden field and is filled by
   Search / Use My Location, then saved as the customer's Address.
*@
								<input type="hidden"
									   id="customerProfileAddress"
									   name="Address"
									   value="@((ViewBag.CustomerAddress as string) ?? "")" />

								<div class="col-12">
									<div class="border rounded-3 p-3 bg-light">
										<div class="fw-semibold mb-2">
											<i class="bi bi-geo-alt-fill me-1" style="color:#d97600;"></i>
											Permanent Location <span class="text-danger">*</span>
										</div>
										<small class="text-muted d-block mb-3">Search your permanent address, or use your current location. The selected location will be saved with your profile.</small>

										<div class="input-group mb-2">
											<input type="text" id="customerProfileAddressSearch" class="form-control" placeholder="Enter your permanent address and search..." value="@customerAddress">
											<button type="button" class="btn btn-warning" id="customerAddressSearchBtn" onclick="searchCustomerProfileAddress()">
												<i class="bi bi-search me-1"></i> Search
											</button>
										</div>

										<button type="button" class="btn btn-sm btn-outline-warning mb-3" id="customerLocationBtn" onclick="getCustomerProfileLocation()">
											<i class="bi bi-crosshair me-1"></i> Use My Location
										</button>

										<div id="customerProfileMap" style="width:100%;height:300px;border-radius:12px;border:1px solid #dee2e6;background:#e9ecef;"></div>

										<div id="customerProfileLocationText" class="small text-muted mt-2">
											@if (ViewBag.CustomerLatitude != null && ViewBag.CustomerLongitude != null)
											{
												<span class="text-success fw-semibold">Saved location: @ViewBag.CustomerLatitude, @ViewBag.CustomerLongitude</span>
											}
											else
											{
												<span>No location selected yet.</span>
											}
										</div>

										<input type="hidden" id="customerProfileLatitude" name="Latitude" value="@((ViewBag.CustomerLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture)) ?? "")">
										<input type="hidden" id="customerProfileLongitude" name="Longitude" value="@((ViewBag.CustomerLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture)) ?? "")">
									</div>
								</div>

							</div>
						</div>

						<div class="modal-footer px-4 pb-4 border-0">
							<button type="button"
									class="btn btn-light border"
									data-bs-dismiss="modal">
								Cancel
							</button>

							<button type="submit"
									class="btn text-white"
									id="saveCustomerProfileBtn"
									style="background:#d97600;">
								<i class="bi bi-check2-circle me-1"></i>
								Save Changes
							</button>
						</div>

					</form>
				</div>
			</div>
		</div>

		<h3 class="mt-4 mb-3 text-center fw-bold"
			style="font-size:1.5rem; color:#000 !important; text-align:center !important; font-weight:800;">

			Current Bookings

		</h3>

		<div class="booking-category-tabs" role="tablist" aria-label="Booking categories">
			<button type="button" class="booking-category-tab active" data-booking-category="pending" role="tab" aria-selected="true">
				<i class="bi bi-hourglass-split"></i>
				<span>Pending</span>
				<span class="booking-category-count" id="pendingBookingCount">0</span>
			</button>
			<button type="button" class="booking-category-tab" data-booking-category="accepted" role="tab" aria-selected="false">
				<i class="bi bi-calendar-check"></i>
				<span>Accepted</span>
				<span class="booking-category-count" id="acceptedBookingCount">0</span>
			</button>
			<button type="button" class="booking-category-tab" data-booking-category="completed" role="tab" aria-selected="false">
				<i class="bi bi-check-circle"></i>
				<span>Completed</span>
				<span class="booking-category-count" id="completedBookingCount">0</span>
			</button>
		</div>

		<div id="requestContainer"
			 class="request-container">

			@if (Model != null &&
						Model.Bookings != null &&
						Model.Bookings.Any())
			{
				var bookingActivityTimes = ViewBag.BookingActivityTimes as IDictionary<string, DateTime>
				?? new Dictionary<string, DateTime>();

				var orderedBookings = ((IEnumerable<ServiceGo.Models.BookingDetailViewModel>)Model.Bookings)
				.OrderBy((ServiceGo.Models.BookingDetailViewModel b) =>
				string.Equals(b.Status, "Pending", StringComparison.OrdinalIgnoreCase) ? 1 :
				string.Equals(b.Status, "Accepted", StringComparison.OrdinalIgnoreCase) ? 2 :
				string.Equals(b.Status, "Completed", StringComparison.OrdinalIgnoreCase) ? 3 : 4)
				.ThenByDescending((ServiceGo.Models.BookingDetailViewModel b) =>
				bookingActivityTimes.TryGetValue(b.Id, out var activityAt)
				? activityAt
				: DateTime.MinValue)
				.ThenByDescending((ServiceGo.Models.BookingDetailViewModel b) => b.Id)
				.ToList();

				var ratingPendingIds = ViewBag.RatingPendingIds as HashSet<int>
				?? new HashSet<int>();

				var customerRatedBookingIds = ViewBag.CustomerRatedBookingIds as HashSet<int>
				?? new HashSet<int>();

				foreach (var req in orderedBookings)
				{
					// Rejected bookings are kept in the database/history,
					// but must not appear as active dashboard cards.
					if (string.Equals(req.Status, "Rejected", StringComparison.OrdinalIgnoreCase))
					{
						continue;
					}

					// Customer-facing provider location security
					// Home Service -> provider home address/map are PRIVATE and must never be shown.
					// Shop Service -> only the provider's PUBLIC shop address/map may be shown.
					string mapLat = "";
					string mapLng = "";
					string displayAddress = "";
					string mapQuery = "";

					bool isShop =
					!string.IsNullOrEmpty(req.ServiceType) &&
					(req.ServiceType.Equals(
					"Shop",
					StringComparison.OrdinalIgnoreCase) ||
					req.ServiceType.Equals(
					"Shop Service",
					StringComparison.OrdinalIgnoreCase));

					bool isHome =
					!string.IsNullOrEmpty(req.ServiceType) &&
					(req.ServiceType.Equals(
					"Home",
					StringComparison.OrdinalIgnoreCase) ||
					req.ServiceType.Equals(
					"Home Service",
					StringComparison.OrdinalIgnoreCase));

					if (isShop)
					{

						mapLat =
						!string.IsNullOrEmpty(req.ShopLat) &&
						req.ShopLat != "0" &&
						req.ShopLat != "null"
						? req.ShopLat
						: "";

						mapLng =
						!string.IsNullOrEmpty(req.ShopLng) &&
						req.ShopLng != "0" &&
						req.ShopLng != "null"
						? req.ShopLng
						: "";

						displayAddress =
						!string.IsNullOrEmpty(req.ShopAddressInput)
						? req.ShopAddressInput
						: req.ProviderAddress;

						mapQuery =
						!string.IsNullOrWhiteSpace(mapLat) &&
						!string.IsNullOrWhiteSpace(mapLng)
						? $"{mapLat},{mapLng}"
						: displayAddress;

					}
					else if (isHome)
					{
						// Home Service: deliberately leave provider location blank.
						// The provider's home/base address and coordinates are private.
						mapLat = "";
						mapLng = "";
						displayAddress = "";
						mapQuery = "";
					}
					else
					{
						// Unknown/legacy service type: do not expose a provider location.
						// This prevents a private home location from leaking through a fallback.
						mapLat = "";
						mapLng = "";
						displayAddress = "";
						mapQuery = "";
					}

					bool isPendingBooking =
					string.Equals(
					req.Status,
					"Pending",
					StringComparison.OrdinalIgnoreCase);

					bool isAcceptedBooking =
					string.Equals(
					req.Status,
					"Accepted",
					StringComparison.OrdinalIgnoreCase);

					bool providerReschedulePending =
					req.IsRescheduledByProvider &&
					string.Equals(req.RescheduleRequestedBy, "Provider", StringComparison.OrdinalIgnoreCase) &&
					string.Equals(req.RescheduledStatus, "Pending", StringComparison.OrdinalIgnoreCase);

					bool customerReschedulePending =
					string.Equals(req.RescheduledStatus, "Pending", StringComparison.OrdinalIgnoreCase) &&
					(req.IsRescheduledByCustomer ||
					string.Equals(req.RescheduleRequestedBy, "Customer", StringComparison.OrdinalIgnoreCase));

					// Rejected customer reschedule must remain visible so the
					// customer can see that the provider rejected the request.
					// The reschedule button stays hidden because a rejected
					// request already consumes the one-reschedule opportunity.
					bool customerRescheduleRejected =
					string.Equals(req.RescheduledStatus, "Rejected", StringComparison.OrdinalIgnoreCase) &&
					string.Equals(req.RescheduleRequestedBy, "Customer", StringComparison.OrdinalIgnoreCase);

					// Customer must not be able to request another reschedule
					// after the customer has already used the reschedule option.
					// A provider's pending request does NOT hide the button;
					// the button must remain visible on the "View Reschedule Request" card.
					bool rescheduleAlreadyUsed =
					req.RescheduledDate.HasValue ||
					string.Equals(req.RescheduledStatus, "Rejected", StringComparison.OrdinalIgnoreCase) ||
					req.IsRescheduledByCustomer ||
					req.IsRescheduledByProvider;

					bool hasCustomerRescheduleRequest =
					req.IsRescheduledByCustomer ||
					string.Equals(
					req.RescheduleRequestedBy,
					"Customer",
					StringComparison.OrdinalIgnoreCase) ||
					(req.RequestedDate.HasValue &&
					string.Equals(
					req.RescheduleRequestedBy,
					"Customer",
					StringComparison.OrdinalIgnoreCase));

					string displayStatus =
					string.IsNullOrWhiteSpace(req.Status)
					? "Pending"
					: req.Status;

					string displayStatusColor =
					GetStatusColor(displayStatus);

					// Backend provides the exact cancellation permission.
					// Pending = anytime; Accepted = before the 2-hour cutoff.
					bool canCustomerCancel =
					int.TryParse(req.Id, out var requestBookingId) &&
					cancellationAllowedIds.Contains(requestBookingId);

					// Reschedule is available for Pending bookings and for
					// Accepted bookings that are still before the two-hour cutoff.
					// If either side already has a pending/used request, hide the button.
					bool hasAnyPendingReschedule =
					providerReschedulePending ||
					customerReschedulePending;

					bool canCustomerReschedule =
					isPendingBooking
					&&
					rescheduleAllowedIds.Contains(requestBookingId)
					&&
					!hasAnyPendingReschedule
					&&
					!hasCustomerRescheduleRequest
					&&
					!rescheduleAlreadyUsed;

					<!-- Request card -->

					<div class="request-card booking-item"
						 data-booking-id="@req.Id"
						 data-booking-category="@(isPendingBooking ? "pending" : isAcceptedBooking ? "accepted" : string.Equals(req.Status, "Completed", StringComparison.OrdinalIgnoreCase) ? "completed" : "other")"
						 style="border-left-color:@displayStatusColor;">

						<div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">

							<h4 class="fw-bold mb-0 text-dark"
								style="font-size:1.2rem;
										color:#d97600 !important;">

								@req.ServiceName

							</h4>

							<span class="badge px-3 py-2"
								  style="background-color:@displayStatusColor;
										color:white;
										font-size:0.8rem;
										border-radius:6px;">

								@displayStatus

							</span>

						</div>

						<!-- Provider information -->

						<div class="p-3 mb-3 rounded-3"
							 style="background-color:#fffaf0;
										border:1px solid #ffe8cc;">

							<div class="fw-bold mb-1"
								 style="color:#d97600;
										font-size:0.95rem;">

								<i class="bi bi-person-badge-fill me-1"></i>
								Provider Information

							</div>

							<div class="mb-1"
								 style="font-size:0.9rem;">

								<span class="text-secondary fw-semibold">
									Name:
								</span>

								<span class="text-dark fw-bold">

									@(string.IsNullOrEmpty(req.ProviderName)
																? "Not Assigned"
																: req.ProviderName)

						</span>

							</div>

							<div style="font-size:0.9rem;">

								<span class="text-secondary fw-semibold">
									Rating:
								</span>

								<span class="ms-1" aria-label="@req.Rating out of 5 stars">
							@{
										int providerRatingDisplay = (int)Math.Round(req.Rating, MidpointRounding.AwayFromZero);
										providerRatingDisplay = Math.Max(0, Math.Min(5, providerRatingDisplay));
										for (int star = 1; star <= 5; star++)
										{
											if (star <= providerRatingDisplay)
											{
												<span class="text-warning" style="font-size:1.05rem;">★</span>
											}
											else
											{
												<span class="text-secondary" style="font-size:1.05rem;opacity:.35;">★</span>
											}
										}
									}
								</span>

							</div>

						</div>

						<!-- Provider reschedule request -->
						@if (providerReschedulePending)
						{

							<div class="mb-3 d-flex align-items-center gap-3 flex-wrap">

								<a href="javascript:void(0);"
								   class="fw-bold text-primary text-decoration-none"
								   style="font-size:0.9rem;"
								   onclick="openProviderReschedule('@req.Id')">

									<i class="bi bi-arrow-repeat me-1"></i>

									View Reschedule Request

								</a>

							</div>

						}

						<!-- Customer reschedule pending -->
						@if (customerReschedulePending)
						{
							<p class="mb-2 text-secondary" style="font-size:0.9rem;">
								<strong>
									<i class="bi bi-arrow-repeat me-1"></i>
									Reschedule Request:
								</strong>
								<span class="text-warning fw-bold">Pending</span>
							</p>
						}
						else if (customerRescheduleRejected)
						{
							<p class="mb-2 text-secondary" style="font-size:0.9rem;">
								<strong>
									<i class="bi bi-arrow-repeat me-1"></i>
									Reschedule Request:
								</strong>
								<span class="text-danger fw-bold">Rejected</span>
							</p>
						}

						<!-- Booking buttons -->

						<div class="buttons-group pt-2 border-top">

							<!-- View details -->

							<button type="button"
									class="btn btn-sm text-white px-3 py-2 shadow-sm booking-action-btn"
									style="background-color:#d97600;
										font-size:0.88rem;
										border-radius:6px;"
									onclick="openDetails('@req.Id')">

								<i class="bi bi-eye-fill me-1"></i>

								View Details

							</button>

							<!-- Reschedule -->
							@if (canCustomerReschedule)
							{

								<button type="button"
										class="btn btn-sm text-white px-3 py-2 shadow-sm booking-action-btn customer-reschedule-btn"
										style="background-color:#f0ad4e;
															font-size:0.88rem;
															border-radius:6px;"
										onclick="openReschedule(
															'@req.Id',
															'@req.BookingDate.ToString("yyyy-MM-dd")',
															'@Html.Raw(
																							   System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
																			   	   req.BookingTime ?? ""
																			   	   )
																			   	   )'
)">

									<i class="bi bi-clock me-1"></i>
									Reschedule

								</button>

										}

							<!-- Cancel -->
							@if (canCustomerCancel)
							{
								<button type="button"
										class="btn btn-sm text-white px-3 py-2 shadow-sm booking-action-btn cancel-booking-btn"
										style="background-color:#e74c3c;
															font-size:0.88rem;
															border-radius:6px;"
										data-booking-status="@displayStatus"
										data-booking-date="@req.BookingDate.ToString("yyyy-MM-dd")"
										data-booking-time="@req.BookingTime"
										onclick="cancelRequest('@req.Id')">

									<i class="bi bi-x-circle me-1"></i>
									Cancel

								</button>
							}

							<!-- Message - accepted only -->
							@if (string.Equals(req.Status, "Accepted", StringComparison.OrdinalIgnoreCase))
							{
								<button type="button"
										class="btn btn-sm text-white px-3 py-2 shadow-sm booking-action-btn"
										style="background-color:#f0ad4e; font-size:0.88rem; border-radius:6px;"
										onclick="openChat(
															'@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(req.ProviderId ?? ""))',
															'@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(req.ProviderName ?? ""))'
															)">
									<i class="bi bi-chat-dots me-1"></i>
									Message
								</button>
							}

							<!-- Rating -->
							@if (string.Equals(
												req.Status,
												"Completed",
												StringComparison.OrdinalIgnoreCase) &&
												int.TryParse(req.Id, out var ratingBookingId) &&
												ratingPendingIds.Contains(ratingBookingId) &&
												!customerRatedBookingIds.Contains(ratingBookingId))
							{

								<button type="button"
										class="btn btn-sm text-white px-3 py-2 shadow-sm booking-action-btn customer-rate-btn"
										data-rate-booking-id="@req.Id"
										style="background-color:#d97600;
															font-size:0.88rem;
															border-radius:6px;"
										onclick="openRating(
															'@req.Id',
															'@Html.Raw(
																							   System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
																			   	   req.ProviderId ?? ""
																			   	   )
																			   	   )'
)">

									<i class="bi bi-star-fill me-1"></i>

									Rate Now

								</button>

										}

							@if (string.Equals(req.Status, "Completed", StringComparison.OrdinalIgnoreCase) &&
												int.TryParse(req.Id, out var complaintBookingId) &&
												!customerComplaintBookingIds.Contains(complaintBookingId))
							{
								<button type="button"
										class="btn btn-sm text-white px-3 py-2 customer-complaint-btn booking-action-btn"
										data-complaint-booking-id="@req.Id"
										style="background-color:#e74c3c; font-size:0.88rem; border-radius:6px;"
										onclick="openComplaint(
															'@req.Id',
															'@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(req.ProviderId ?? ""))',
															'@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(req.ProviderName ?? ""))',
															'detailModal_@req.Id'
															)">
									<i class="bi bi-exclamation-triangle me-1"></i>
									File Complaint
								</button>
							}

						</div>

					</div>

					<!-- Detail modal -->

					<template id="detailModalTemplate_@req.Id">
						<div class="modal fade"
							 id="detailModal_@req.Id"
							 tabindex="-1"
							 aria-hidden="true">

							<div class="modal-dialog modal-lg modal-dialog-centered">

								<div class="modal-content p-3 rounded-4 shadow border-0">

									<div class="modal-header border-0 pb-0">

										<h5 class="modal-title fw-bold"
											style="color:#d97600;">

											<i class="bi bi-info-circle me-1"></i>

											Service & Provider Details

										</h5>

										<button type="button"
												class="btn-close"
												data-bs-dismiss="modal">
										</button>

									</div>

									<div class="modal-body">

										<!-- Schedule -->

										<div class="p-3 mb-4 rounded-3"
											 style="background-color:#f8f9fa;
										border:1px solid #e9ecef;">

											<div class="fw-bold mb-2"
												 style="color:#d97600;">

												<i class="bi bi-calendar-check me-1"></i>

												Schedule & Availability

											</div>

											<div class="row text-secondary"
												 style="font-size:0.9rem;">

												<div class="col-md-6 mb-1">

													<strong>
														Current Appointment:
													</strong>

													<span class="badge bg-secondary">

														@req.BookingDate.ToString("yyyy-MM-dd")
														(@req.BookingTime)

													</span>

												</div>

												<div class="col-md-6 mb-1">

													<strong>
														Available Days:
													</strong>

													@req.AvailableDays

												</div>

												<div class="col-md-12">

													<strong>
														Available Time:
													</strong>

													@req.AvailableTime

												</div>

											</div>

										</div>

										<div class="row mb-3">

											<!-- Booking information -->

											<div class="col-md-6">

												<h6 class="fw-bold border-bottom pb-2 mb-3"
													style="color:#d97600;">

													Booking Information

												</h6>

												<p class="mb-2 text-secondary"
												   style="font-size:0.9rem;">

													<strong>
														Booking ID:
													</strong>

													@req.Id

												</p>

												<p class="mb-2 text-secondary"
												   style="font-size:0.9rem;">

													<strong>
														Service:
													</strong>

													@req.ServiceName

												</p>

												<p class="mb-2 text-secondary"
												   style="font-size:0.9rem;">

													<strong>
														Service Type:
													</strong>

													@(isHome ? "Home Service" : isShop ? "Shop Service" : req.ServiceType)

												</p>

												<p class="mb-2 text-secondary"
												   style="font-size:0.9rem;">

													<strong>
														Status:
													</strong>

													<span class="badge"
														  style="background-color:@displayStatusColor;
										color:white;">

														@displayStatus

													</span>

												</p>

												@if (customerReschedulePending || customerRescheduleRejected)
												{
													var customerRescheduleDisplayStatus =
													customerRescheduleRejected ? "Rejected" : "Pending";

													var customerRescheduleDisplayColor =
													customerRescheduleRejected ? "#e74c3c" : "#f39c12";

													<p class="mb-2 text-secondary"
													   style="font-size:0.9rem;">

														<strong>
															Reschedule Status:
														</strong>

														<span class="badge"
															  style="background-color:@customerRescheduleDisplayColor;
															color:white;
															border-radius:6px;">

															@customerRescheduleDisplayStatus

														</span>

													</p>

												}

												@if (isHome)
												{
													<p class="mb-2 text-secondary"
													   style="font-size:0.9rem;">

														<strong>
															Visit Charges:
														</strong>

														<span class="text-success fw-bold">
															Rs. @req.VisitCharges
														</span>

													</p>
												}

											</div>

											<!-- Provider information -->

											<div class="col-md-6 border-start">

												<h6 class="fw-bold border-bottom pb-2 mb-3"
													style="color:#d97600;">

													Provider Information

												</h6>

												@{
													int providerDbIdForImage = 0;
													int.TryParse(req.ProviderId, out providerDbIdForImage);
													string providerImageForDetails = string.Empty;

													if (providerDbIdForImage > 0)
													{
														providerProfileImages.TryGetValue(
														providerDbIdForImage,
														out providerImageForDetails);
													}

													if (string.IsNullOrWhiteSpace(providerImageForDetails) &&
													!string.IsNullOrWhiteSpace(req.ProviderName))
													{
														providerProfileImagesByName.TryGetValue(
														req.ProviderName.Trim(),
														out providerImageForDetails);
													}
												}

												<div class="d-flex align-items-center gap-3 mb-3 p-2 rounded-3"
													 style="background:#fff8ed;border:1px solid #f3dfc2;">
													<img src="@Url.Content(string.IsNullOrWhiteSpace(providerImageForDetails) ? "~/images/Profile icon.png" : providerImageForDetails)"
														 alt="Provider Profile"
														 width="76"
														 height="76"
														 loading="lazy"
														 decoding="async"
														 style="width:76px;height:76px;object-fit:cover;border-radius:50%;border:3px solid #fff;box-shadow:0 3px 10px rgba(0,0,0,.12);"
														 onerror="this.onerror=null;this.src='@Url.Content("~/images/Profile icon.png")';" />
													<div>
														<div class="fw-bold text-dark">@req.ProviderName</div>
														<div class="small text-muted">Service Provider</div>
													</div>
												</div>

												<p class="mb-2 text-secondary"
												   style="font-size:0.9rem;">

													<strong>
														Provider ID:
													</strong>

													@req.ProviderId

												</p>

												<p class="mb-2 text-secondary"
												   style="font-size:0.9rem;">

													<strong>
														Name:
													</strong>

													@req.ProviderName

												</p>

												@if (isShop)
												{
													<p class="mb-2 text-secondary"
													   style="font-size:0.9rem;">

														<strong>
															Location:
														</strong>

														Shop

													</p>

													<p class="mb-2 text-secondary"
													   style="font-size:0.9rem;">

														<strong>
															Shop Address:
														</strong>

														@displayAddress

													</p>
												}

												<p class="mb-2 text-secondary"
												   style="font-size:0.9rem;">

													<strong>
														Rating:
													</strong>

													<span class="ms-1"
														  aria-label="@req.Rating out of 5 stars">
														@{
															int providerRatingRounded =
															(int)Math.Round(
															req.Rating,
															MidpointRounding.AwayFromZero);
															providerRatingRounded =
															Math.Max(0, Math.Min(5, providerRatingRounded));

															for (int star = 1; star <= 5; star++)
															{
																if (star <= providerRatingRounded)
																{
																	<span class="text-warning"
																		  style="font-size:1.05rem;">★</span>
																}
																else
																{
																	<span class="text-secondary"
																		  style="font-size:1.05rem; opacity:.35;">★</span>
																}
															}
														}
													</span>

												</p>

												@if (isShop)
												{
													<!-- Shop map only -->
													<div class="mb-2">

														<label class="fw-bold text-secondary mb-1"
															   style="font-size:0.9rem;">

															<i class="bi bi-shop"></i>

															Shop Location Map

														</label>

														<div style="position:relative;
															width:100%;
															height:160px;
															border-radius:8px;
															border:1px solid #dee2e6;
															overflow:hidden;">

															<a href="https://www.google.com/maps/search/?api=1&query=@System.Uri.EscapeDataString(mapQuery)"
															   target="_blank"
															   rel="noopener noreferrer"
															   class="btn btn-sm btn-light shadow-sm position-absolute top-0 start-0 m-2 fw-semibold text-primary"
															   style="z-index:10;
															font-size:0.75rem;
															background:white;
															border:1px solid #ccc;">

																Open in Maps

																<i class="bi bi-box-arrow-up-right"></i>

															</a>

															<iframe style="width:100%; height:500px; border:0;"
																	frameborder="0"
																	scrolling="no"
																	marginheight="0"
																	marginwidth="0"
																	data-google-map-src="https://maps.google.com/maps?q=@System.Uri.EscapeDataString(mapQuery)&z=15&output=embed"
																	title="Provider Google Map"
																	loading="lazy">
															</iframe>

														</div>

													</div>
												}

											</div>

										</div>

									</div>

									<!-- Detail modal footer -->
									<!--
									   Booking View Details is information-only.
									   No booking action buttons appear inside this popup.
									-->

								</div>

							</div>

						</div>
					</template>

				}

			}
			else
			{

				<p id="legacyBookingEmptyState" class="text-center text-muted w-100 py-4">

					No booking requests found.

				</p>

			}

		</div>

	</div>

	<!-- Helper -->
	@functions {

		string GetStatusColor(string status)
		{
			return status switch
			{
				"Pending" => "#f39c12",
				"Accepted" => "#3498db",
				"Reschedule Requested" => "#9b59b6",
				"Completed" => "#2ecc71",
				"Cancelled" => "#e74c3c",
				"Rejected" => "#c0392b",
				"Expired" => "#7f8c8d",
				_ => "#7f8c8d"
			};
		}

	}

	<!-- Provider reschedule modal -->

	<div class="modal fade"
		 id="providerRescheduleModal"
		 tabindex="-1"
		 aria-hidden="true">

		<div class="modal-dialog modal-dialog-centered modal-md">

			<div class="modal-content rounded-4 border-0 shadow">

				<div class="modal-header border-0 pb-2">

					<h5 class="modal-title fw-bold"
						style="color:#d97600;">

						<i class="bi bi-arrow-repeat me-1"></i>

						Reschedule Request

					</h5>

					<button type="button"
							class="btn-close"
							data-bs-dismiss="modal"
							aria-label="Close">
					</button>

				</div>

				<div class="modal-body pt-2">

					<div class="p-3 rounded-3"
						 style="background:#f0f7ff;
border:1px solid #cfe2ff;">

						<div class="fw-bold text-primary mb-3"
							 style="font-size:0.9rem;">

							<i class="bi bi-clock-history me-1"></i>

							Provider requested to reschedule this booking.

						</div>

						<div class="p-3 mb-3 rounded-3"
							 style="background:#ffffff;
border:1px solid #e9ecef;">

							<div class="fw-bold text-secondary mb-2"
								 style="font-size:0.9rem;">

								<i class="bi bi-calendar-event me-1"></i>

								Current / Old Appointment

							</div>

							<div class="mb-1"
								 style="font-size:0.88rem;">

								<strong>
									Date:
								</strong>

								<span id="providerOldDate">
									N/A
								</span>

							</div>

							<div style="font-size:0.88rem;">

								<strong>
									Time:
								</strong>

								<span id="providerOldTime">
									N/A
								</span>

							</div>

						</div>

						<div class="p-3 mb-3 rounded-3"
							 style="background:#fff8e8;
border:1px solid #ffe0a3;">

							<div class="fw-bold mb-2"
								 style="color:#d97600;
font-size:0.9rem;">

								<i class="bi bi-calendar-plus me-1"></i>

								New Appointment Requested

							</div>

							<div class="mb-1"
								 style="font-size:0.88rem;">

								<strong>
									Date:
								</strong>

								<span id="providerNewDate">
									N/A
								</span>

							</div>

							<div style="font-size:0.88rem;">

								<strong>
									Time:
								</strong>

								<span id="providerNewTime">
									N/A
								</span>

							</div>

						</div>

						<div class="d-flex justify-content-end gap-2">

							<button type="button"
									class="btn btn-success btn-sm px-4"
									onclick="respondReschedule(
currentProviderRescheduleBookingId,
'Accept'
)">

								<i class="bi bi-check-circle me-1"></i>

								Accept

							</button>

							<button type="button"
									class="btn btn-danger btn-sm px-4"
									onclick="respondReschedule(
currentProviderRescheduleBookingId,
'Reject'
)">

								<i class="bi bi-x-circle me-1"></i>

								Reject

							</button>

						</div>

					</div>

				</div>

				<div class="modal-footer border-0 pt-0">

					<button type="button"
							class="btn btn-secondary btn-sm px-4"
							data-bs-dismiss="modal">

						Close

					</button>

				</div>

			</div>

		</div>

	</div>

	<!-- Customer reschedule modal -->

	<div class="modal fade"
		 id="rescheduleModal"
		 tabindex="-1"
		 aria-hidden="true">

		<div class="modal-dialog modal-dialog-centered modal-md">

			<div class="modal-content rounded-4 border-0 shadow">

				<div class="modal-header border-0">

					<h5 class="modal-title fw-bold"
						style="color:#d97600;">

						<i class="bi bi-arrow-repeat me-1"></i>

						Reschedule Service

					</h5>

					<button type="button"
							class="btn-close"
							data-bs-dismiss="modal"
							aria-label="Close">
					</button>

				</div>

				<div class="modal-body">

					<form id="rescheduleForm">

						@Html.AntiForgeryToken()

						<input type="hidden"
							   id="rescheduleBookingId"
							   name="id" />

						<!-- Current appointment -->

						<div class="reschedule-section current-appointment-box mb-3">

							<div class="fw-bold text-secondary mb-2"
								 style="font-size:0.9rem;">

								<i class="bi bi-calendar-event me-1"></i>

								Current / Old Appointment

							</div>

							<div class="row">

								<div class="col-md-6 mb-2 mb-md-0">

									<label class="text-muted small d-block">
										Date
									</label>

									<div id="rescheduleCurrentDate"
										 class="fw-semibold text-dark">
									</div>

								</div>

								<div class="col-md-6">

									<label class="text-muted small d-block">
										Time
									</label>

									<div id="rescheduleCurrentTime"
										 class="fw-semibold text-dark">
									</div>

								</div>

							</div>

						</div>

						<!-- New appointment -->

						<div class="reschedule-section new-appointment-box mb-3">

							<div class="fw-bold mb-3"
								 style="color:#d97600;
font-size:0.9rem;">

								<i class="bi bi-calendar-plus me-1"></i>

								New Appointment

							</div>

							<div class="mb-3">

								<label for="newDateInput"
									   class="form-label fw-semibold">

									New Date

								</label>

								<input type="date"
									   id="newDateInput"
									   name="newDate"
									   class="form-control"
									   required />

								<div id="newDateError"
									 class="text-danger small fw-semibold mt-1"
									 style="display:none;"></div>

							</div>

							<div class="mb-0">

								<label for="newTimeInput"
									   class="form-label fw-semibold">

									New Time

								</label>

								<div class="input-group">
									<input type="time"
										   id="newTimeInput"
										   name="newTime"
										   class="form-control"
										   step="60"
										   required />
								</div>

								<div id="newTimeError"
									 class="text-danger small fw-semibold mt-1"
									 style="display:none;"></div>

							</div>

						</div>

						<div class="d-flex justify-content-end gap-2 mt-4">

							<button type="button"
									class="btn btn-secondary px-4"
									data-bs-dismiss="modal">

								Cancel

							</button>

							<button type="submit"
									id="submitRescheduleBtn"
									class="btn px-4 text-white"
									style="background:#d97600;">

								<i class="bi bi-send me-1"></i>

								Send Reschedule Request

							</button>

						</div>

					</form>

				</div>

			</div>

		</div>

	</div>

	<!-- Rate modal -->

	<div class="modal fade"
		 id="rateModal"
		 tabindex="-1"
		 aria-hidden="true">

		<div class="modal-dialog modal-dialog-centered modal-md">

			<div class="modal-content p-4 rounded-4 text-center border-0 shadow">

				<h5 class="fw-bold mb-3"
					style="color:#d97600;">

					Rate Provider

				</h5>

				<form id="rateForm"
					  method="post"
					  action="@Url.Action("RateProvider", "Customer")">

					@Html.AntiForgeryToken()

					<input type="hidden"
						   id="rateBookingId"
						   name="bookingId" />

					<input type="hidden"
						   id="rateProviderId"
						   name="providerId" />

					<input type="hidden"
						   id="ratingValueInput"
						   name="rating"
						   value="0" />

					<div class="d-flex justify-content-center gap-2 mb-3"
						 id="starContainer">

						<i class="bi bi-star-fill star fs-2 text-secondary"
						   style="cursor:pointer;"
						   data-value="1"></i>

						<i class="bi bi-star-fill star fs-2 text-secondary"
						   style="cursor:pointer;"
						   data-value="2"></i>

						<i class="bi bi-star-fill star fs-2 text-secondary"
						   style="cursor:pointer;"
						   data-value="3"></i>

						<i class="bi bi-star-fill star fs-2 text-secondary"
						   style="cursor:pointer;"
						   data-value="4"></i>

						<i class="bi bi-star-fill star fs-2 text-secondary"
						   style="cursor:pointer;"
						   data-value="5"></i>

					</div>

<textarea id="feedbackComment"
		  name="comment"
		  class="form-control mb-3"
		  rows="4"
		  placeholder="Write your review here..."></textarea>

					<div class="d-flex justify-content-center gap-2">

						<button type="button"
								class="btn btn-secondary btn-sm px-4"
								data-bs-dismiss="modal">

							Cancel

						</button>

						<button type="submit"
								id="submitRatingBtn"
								class="btn btn-sm px-4 text-white"
								style="background:#d97600;">

							Submit

						</button>

					</div>

				</form>

			</div>

		</div>

	</div>

	<!-- Complaint modal -->

	<div class="modal fade complaint-modal"
		 id="complaintModal"
		 tabindex="-1"
		 aria-hidden="true">

		<div class="modal-dialog modal-dialog-centered">

			<div class="modal-content">

				<div class="modal-header border-0">

					<h5 class="modal-title fw-bold"
						style="color:#e74c3c;">

						<i class="bi bi-exclamation-triangle-fill me-1"></i>

						Submit a Complaint

					</h5>

					<button type="button"
							class="btn-close"
							data-bs-dismiss="modal"
							aria-label="Close">
					</button>

				</div>

				<div class="modal-body">

					<!-- Complaint form -->

					<form id="complaintForm"
						  method="post"
						  action="@Url.Action("Complaint", "Customer")">

						@Html.AntiForgeryToken()

						<!-- Complaint ID -->

						<div class="mb-3">

							<label for="complaintIdDisplay"
								   class="form-label">

								Complaint ID

							</label>

							<input type="text"
								   id="complaintIdDisplay"
								   class="form-control"
								   value="@(ViewBag.NextComplaintId ?? "COMP-1")"
								   readonly
								   style="background-color:#e9ecef;
font-weight:600;" />

							<input type="hidden"
								   id="complaintId"
								   name="ComplaintId"
								   value="@(ViewBag.NextComplaintId ?? "COMP-1")" />

						</div>

						<!-- Complaint type -->

						<input type="hidden"
							   id="complaintType"
							   name="ComplaintType"
							   value="Customer vs Provider" />

						<!-- Booking ID -->

						<input type="hidden"
							   id="complaintBookingId"
							   name="BookingId"
							   value="" />

						<!-- Provider ID -->

						<div class="mb-3">

							<label for="complaintProviderId"
								   class="form-label">

								Provider ID

							</label>

							<input type="text"
								   id="complaintProviderId"
								   name="ProviderId"
								   class="form-control"
								   value=""
								   readonly
								   style="background-color:#e9ecef;" />

						</div>

						<!-- Provider name -->

						<div class="mb-3">

							<label for="complaintProviderName"
								   class="form-label">

								Provider Name

							</label>

							<input type="text"
								   id="complaintProviderName"
								   name="ProviderName"
								   class="form-control"
								   value=""
								   readonly
								   style="background-color:#e9ecef;" />

						</div>

						<!-- Issue title -->

						<div class="mb-3">

							<label for="issueTitle"
								   class="form-label">

								Issue Title

							</label>

							<select class="form-select"
									id="issueTitle"
									name="OtherIssue"
									required>

								<option value="">
									Select issue
								</option>

								<option value="Late Arrival">
									Late Arrival
								</option>

								<option value="Overcharging">
									Overcharging
								</option>

								<option value="Unprofessional Behavior">
									Unprofessional Behavior
								</option>

								<option value="Service Not Completed">
									Service Not Completed
								</option>

								<option value="Other">
									Other
								</option>

							</select>

						</div>

						<!-- Other issue -->

						<div class="mb-3"
							 id="otherBox"
							 style="display:none;">

							<label for="OtherIssueText"
								   class="form-label">

								Specify Other Issue

							</label>

							<input type="text"
								   name="OtherIssueText"
								   id="OtherIssueText"
								   class="form-control" />

						</div>

						<!-- Complaint details -->

						<div class="mb-3"
							 id="complaintDetailsBox"
							 style="display:none;">

							<label for="complaintDetails"
								   class="form-label">

								Complaint Details <span class="text-muted">(Optional)</span>

							</label>

<textarea class="form-control"
		  id="complaintDetails"
		  name="ComplaintDetails"
		  rows="4"
		  maxlength="2000"
		  placeholder="Describe your issue in detail (optional)..."></textarea>

						</div>

						<!-- Buttons -->

						<div class="d-flex justify-content-end gap-2 mt-4">

							<button type="button"
									class="btn btn-secondary px-4"
									data-bs-dismiss="modal">

								Cancel

							</button>

							<button type="submit"
									id="submitComplaintBtn"
									class="complaint-submit-btn">

								<i class="bi bi-send me-1"></i>

								Submit Complaint

							</button>

