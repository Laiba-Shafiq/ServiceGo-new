		customerProfileMapsLoading = null;
		reject(new Error('Google Maps API loading timed out.'));
		}, 15000);

		const existingScript = document.querySelector('script[data-servicego-customer-maps="true"]');

		if (existingScript) {
		if (window.google && google.maps) {
		window.initCustomerProfileMap();
		}
		return;
		}

		const script = document.createElement('script');
		script.async = true;
		script.defer = true;
		script.dataset.servicegoCustomerMaps = 'true';
		script.src =
		'https://maps.googleapis.com/maps/api/js' +
		'?key=' + encodeURIComponent(apiKey) +
		'&libraries=places' +
		'&language=en' +
		'&region=PK' +
		'&callback=initCustomerProfileMap' +
		'&loading=async' +
		'&v=weekly';

		script.onerror = function () {
		if (customerProfileMapsTimeout) {
		clearTimeout(customerProfileMapsTimeout);
		customerProfileMapsTimeout = null;
		}
		customerProfileMapsResolve = null;
		customerProfileMapsReject = null;
		customerProfileMapsLoading = null;
		reject(new Error('Google Maps script failed to load.'));
		};

		document.head.appendChild(script);
		});

		return customerProfileMapsLoading;
		}

		function renderCustomerProfileMap() {
		const mapElement = document.getElementById('customerProfileMap');

		if (!mapElement || !window.google || !google.maps) {
		return;
		}

		mapElement.style.width = '100%';
		mapElement.style.height = '300px';

		if (!customerProfileGeocoder) {
		customerProfileGeocoder = new google.maps.Geocoder();
		}

		if (customerProfileMap) {
		setTimeout(function () {
		if (customerProfileMap && google.maps.event) {
		google.maps.event.trigger(customerProfileMap, 'resize');
		}
		}, 150);
		return;
		}

		const latInput = document.getElementById('customerProfileLatitude');
		const lngInput = document.getElementById('customerProfileLongitude');
		const savedLat = parseFloat(latInput?.value);
		const savedLng = parseFloat(lngInput?.value);

		const hasSavedLocation =
		Number.isFinite(savedLat) && Number.isFinite(savedLng);

		const center = hasSavedLocation
		? { lat: savedLat, lng: savedLng }
		: { lat: 33.6844, lng: 73.0479 };

		customerProfileMap = new google.maps.Map(mapElement, {
		center: center,
		zoom: hasSavedLocation ? 16 : 12,
		mapTypeControl: false,
		streetViewControl: false,
		fullscreenControl: true,
		clickableIcons: true
		});

		if (hasSavedLocation) {
		setCustomerProfileMapLocation(savedLat, savedLng, 'Saved location');
		}

		customerProfileMap.addListener('click', function (event) {
		if (!event || !event.latLng) return;
		setCustomerProfileMapLocation(
		event.latLng.lat(),
		event.latLng.lng(),
		'Location selected'
		);

		reverseCustomerProfileGeocode(
		event.latLng.lat(),
		event.latLng.lng()
		);
		});

		const searchInput = document.getElementById('customerProfileAddressSearch');

		if (
		searchInput &&
		google.maps.places &&
		!customerProfileAutocomplete
		) {
		customerProfileAutocomplete =
		new google.maps.places.Autocomplete(searchInput, {
		fields: ['formatted_address', 'geometry', 'name'],
		componentRestrictions: { country: 'pk' }
		});

		customerProfileAutocomplete.addListener('place_changed', function () {
		const place = customerProfileAutocomplete.getPlace();

		if (
		place &&
		place.geometry &&
		place.geometry.location
		) {
		const address =
		place.formatted_address ||
		place.name ||
		searchInput.value;

		const addressField =
		document.getElementById('customerProfileAddress');

		if (addressField) {
		addressField.value = address;
		}

		searchInput.value = address;

		setCustomerProfileMapLocation(
		place.geometry.location.lat(),
		place.geometry.location.lng(),
		'Address location selected'
		);
		}
		});
		}

		setTimeout(function () {
		if (customerProfileMap && window.google && google.maps) {
		google.maps.event.trigger(customerProfileMap, 'resize');
		}
		}, 300);
		}

		document.addEventListener('shown.bs.modal', function (event) {
		if (!event.target || event.target.id !== 'customerProfileModal') {
		return;
		}

		loadCustomerProfileGoogleMaps()
		.then(function () {
		setTimeout(function () {
		if (customerProfileMap && window.google && google.maps) {
		google.maps.event.trigger(customerProfileMap, 'resize');

		const latInput = document.getElementById('customerProfileLatitude');
		const lngInput = document.getElementById('customerProfileLongitude');
		const lat = parseFloat(latInput?.value);
		const lng = parseFloat(lngInput?.value);

		if (Number.isFinite(lat) && Number.isFinite(lng)) {
		customerProfileMap.setCenter({ lat: lat, lng: lng });
		customerProfileMap.setZoom(16);
		}
		}
		}, 150);
		})
		.catch(function (error) {
		console.error('Customer profile Google Maps loading error:', error);
		showCustomerProfileMapFallback();
		});
		});

		function setCustomerProfileMapLocation(lat, lng, label) {
		// Always store the coordinates in the hidden inputs first, so Save works
		// even if the map object could not be drawn.
		const checkLat = Number(lat);
		const checkLng = Number(lng);

		if (
		Number.isFinite(checkLat) && Number.isFinite(checkLng) &&
		checkLat >= -90 && checkLat <= 90 &&
		checkLng >= -180 && checkLng <= 180
		) {
		saveCustomerProfileCoordinates(checkLat, checkLng, label);
		}

		if (!customerProfileMap || !window.google || !google.maps) {
		console.error('Customer profile map object is not ready (coordinates were still saved in the form).');
		return;
		}

		const position = {
		lat: Number(lat),
		lng: Number(lng)
		};

		if (
		!Number.isFinite(position.lat) ||
		!Number.isFinite(position.lng) ||
		position.lat < -90 ||
		position.lat > 90 ||
		position.lng < -180 ||
		position.lng > 180
		) {
		return;
		}

		customerProfileMap.setCenter(position);
		customerProfileMap.setZoom(17);

		// Keep one marker on the map and always move it to the
		// newly selected/search/current location.
		if (!customerProfileMarker) {
		customerProfileMarker = new google.maps.Marker({
		position: position,
		map: customerProfileMap,
		draggable: true,
		title: 'Customer Location',
		zIndex: 1000
		});

		customerProfileMarker.addListener('dragend', function (event) {
		if (!event || !event.latLng) return;

		const dragLat = event.latLng.lat();
		const dragLng = event.latLng.lng();

		saveCustomerProfileCoordinates(
		dragLat,
		dragLng,
		'Location adjusted'
		);

		reverseCustomerProfileGeocode(dragLat, dragLng);
		});
		} else {
		customerProfileMarker.setMap(customerProfileMap);
		customerProfileMarker.setPosition(position);
		customerProfileMarker.setVisible(true);
		}

		saveCustomerProfileCoordinates(lat, lng, label);

		// Recalculate the map after Bootstrap modal layout settles.
		setTimeout(function () {
		if (customerProfileMap && window.google && google.maps) {
		google.maps.event.trigger(customerProfileMap, 'resize');
		customerProfileMap.setCenter(position);
		}
		}, 100);
		}

		function saveCustomerProfileCoordinates(lat, lng, label) {
		const latInput = document.getElementById('customerProfileLatitude');
		const lngInput = document.getElementById('customerProfileLongitude');

		if (latInput) {
		latInput.value = Number(lat).toFixed(7);
		}

		if (lngInput) {
		lngInput.value = Number(lng).toFixed(7);
		}

		const text = document.getElementById('customerProfileLocationText');

		if (text) {
		text.innerHTML =
		`<span class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>${label}: ${Number(lat).toFixed(6)}, ${Number(lng).toFixed(6)}</span>`;
		}
		}

		function reverseCustomerProfileGeocode(lat, lng) {
		if (!customerProfileGeocoder) return;

		customerProfileGeocoder.geocode(
		{
		location: {
		lat: Number(lat),
		lng: Number(lng)
		}
		},
		function (results, status) {
		if (
		status === 'OK' &&
		results &&
		results[0]
		) {
		const address = results[0].formatted_address || '';
		const addressField = document.getElementById('customerProfileAddress');
		const searchField = document.getElementById('customerProfileAddressSearch');

		if (address && addressField) {
		addressField.value = address;
		}

		if (address && searchField) {
		searchField.value = address;
		}
		}
		}
		);
		}

		function showCustomerProfileMapFallback(query) {
		const mapElement = document.getElementById('customerProfileMap');
		if (!mapElement) return;

		const address =
		(query || document.getElementById('customerProfileAddressSearch')?.value || '').trim()
		|| document.getElementById('customerProfileAddress')?.value?.trim()
		|| 'Rawalpindi, Pakistan';

		const iframe = document.createElement('iframe');
		iframe.style.width = '100%';
		iframe.style.height = '300px';
		iframe.style.border = '0';
		iframe.style.borderRadius = '12px';
		iframe.loading = 'lazy';
		iframe.referrerPolicy = 'no-referrer-when-downgrade';
		iframe.title = 'Customer Google Map';
		const latInput = document.getElementById('customerProfileLatitude');
		const lngInput = document.getElementById('customerProfileLongitude');
		const savedLat = parseFloat(latInput?.value);
		const savedLng = parseFloat(lngInput?.value);

		const mapQuery =
		Number.isFinite(savedLat) && Number.isFinite(savedLng)
		? savedLat + ',' + savedLng
		: address;

		iframe.src =
		'https://maps.google.com/maps?q=' +
		encodeURIComponent(mapQuery) +
		'&z=17&output=embed';

		mapElement.innerHTML = '';
		mapElement.appendChild(iframe);
		}

		async function searchCustomerProfileAddress() {
		const input = document.getElementById('customerProfileAddressSearch');
		const addressField = document.getElementById('customerProfileAddress');
		const button = document.getElementById('customerAddressSearchBtn');
		const query = input?.value.trim();

		if (!query) {
		if (typeof Swal !== 'undefined') {
		Swal.fire({
		icon: 'info',
		title: 'Enter an address',
		text: 'Please enter an address first.',
		confirmButtonColor: '#d97600'
		});
		}
		input?.focus();
		return;
		}

		if (button) {
		button.disabled = true;
		button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Searching...';
		}

		try {
		await loadCustomerProfileGoogleMaps();

		if (!customerProfileGeocoder && window.google?.maps) {
		customerProfileGeocoder = new google.maps.Geocoder();
		}

		if (!customerProfileGeocoder) {
		throw new Error('Google Maps Geocoder is not available.');
		}

		if (!customerProfileMap) {
		renderCustomerProfileMap();
		}

		customerProfileGeocoder.geocode(
		{
		address: query + ', Pakistan',
		region: 'PK'
		},
		function (results, status) {
		if (button) {
		button.disabled = false;
		button.innerHTML = '<i class="bi bi-search me-1"></i> Search';
		}

		if (
		status === 'OK' &&
		results &&
		results.length > 0 &&
		results[0]?.geometry?.location
		) {
		const result = results[0];
		const location = result.geometry.location;
		const lat = location.lat();
		const lng = location.lng();
		const address = result.formatted_address || query;

		if (addressField) addressField.value = address;
		if (input) input.value = address;

		setCustomerProfileMapLocation(
		lat,
		lng,
		'Address location selected'
		);

		reverseCustomerProfileGeocode(lat, lng);

		if (customerProfileMap) {
		customerProfileMap.setCenter({ lat, lng });
		customerProfileMap.setZoom(17);
		setTimeout(function () {
		google.maps.event.trigger(customerProfileMap, 'resize');
		}, 150);
		}

		return;
		}

		let message = 'Address search could not find a location.';
		if (status === 'ZERO_RESULTS') {
		message = 'Address could not be found. Please enter a more complete address.';
		} else if (status === 'REQUEST_DENIED') {
		message = 'Google Maps search was denied. Please check the Geocoding API, Maps JavaScript API, billing, and API-key restrictions.';
		} else if (status) {
		message = 'Address search error. Status: ' + status;
		}

		if (typeof Swal !== 'undefined') {
		Swal.fire({
		icon: 'warning',
		title: 'Address not found',
		text: message,
		confirmButtonColor: '#d97600'
		});
		}
		}
		);
		}
		catch (error) {
		console.error('Customer profile address search error:', error);

		if (button) {
		button.disabled = false;
		button.innerHTML = '<i class="bi bi-search me-1"></i> Search';
		}

		if (typeof Swal !== 'undefined') {
		Swal.fire({
		icon: 'error',
		title: 'Search failed',
		text: 'Google Maps could not search this address. Please try again.',
		confirmButtonColor: '#d97600'
		});
		}
		}
		}

		function getCustomerProfileLocation() {
		const locationText = document.getElementById('customerProfileLocationText');
		const button = document.getElementById('customerLocationBtn');

		if (!navigator.geolocation) {
		if (locationText) {
		locationText.innerHTML = '<span class="text-danger">Geolocation is not supported by this browser.</span>';
		}
		return;
		}

		if (button) {
		button.disabled = true;
		button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Getting...';
		}

		navigator.geolocation.getCurrentPosition(
		function (position) {
		const lat = position.coords.latitude;
		const lng = position.coords.longitude;

		loadCustomerProfileGoogleMaps()
		.then(function () {
		setCustomerProfileMapLocation(
		lat,
		lng,
		'Current location selected'
		);

		reverseCustomerProfileGeocode(lat, lng);

		if (button) {
		button.disabled = false;
		button.innerHTML = '<i class="bi bi-check2 me-1"></i> Location Selected';
		}
		})
		.catch(function (error) {
		console.error('Customer location map error:', error);

		if (button) {
		button.disabled = false;
		button.innerHTML = '<i class="bi bi-crosshair me-1"></i> Use My Location';
		}
		});
		},
		function (error) {
		if (button) {
		button.disabled = false;
		button.innerHTML = '<i class="bi bi-crosshair me-1"></i> Use My Location';
		}

		if (locationText) {
		let message = 'Location access denied. Please allow location permission.';
		if (error && error.code === 2) {
		message = 'Your current location could not be determined. Please try again.';
		} else if (error && error.code === 3) {
		message = 'Location request timed out. Please try again.';
		}

		locationText.innerHTML =
		'<span class="text-danger">' + message + '</span>';
		}
		},
		{
		enableHighAccuracy: true,
		timeout: 15000,
		maximumAge: 0
		}
		);
		}

		const customerProfileForm =
		document.getElementById(
		'customerProfileForm'
		);

		if (customerProfileForm) {

		customerProfileForm.addEventListener(
		'submit',
		async function (event) {

		event.preventDefault();

		const errorBox =
		document.getElementById(
		'customerProfileError'
		);

		const successBox =
		document.getElementById(
		'customerProfileSuccess'
		);

		const saveButton =
		document.getElementById(
		'saveCustomerProfileBtn'
		);

		const phone =
		document.getElementById(
		'customerProfilePhone'
		);

		const city =
		document.getElementById(
		'customerProfileCity'
		);

		const address =
		document.getElementById(
		'customerProfileAddress'
		);

		if (errorBox) {
		errorBox.classList.add('d-none');
		errorBox.textContent = '';
		}

		if (successBox) {
		successBox.classList.add('d-none');
		successBox.textContent = '';
		}

		if (!phone || !phone.value.trim()) {
		if (errorBox) {
		errorBox.textContent =
		'Phone number is required.';
		errorBox.classList.remove('d-none');
		}
		phone?.focus();
		return;
		}

		if (!city || !city.value.trim()) {
		if (errorBox) {
		errorBox.textContent =
		'City is required.';
		errorBox.classList.remove('d-none');
		}
		city?.focus();
		return;
		}

		const addressSearchBox =
		document.getElementById(
		'customerProfileAddressSearch'
		);

		const typedAddress =
		(addressSearchBox?.value || '').trim();

		if (!typedAddress) {
		if (errorBox) {
		errorBox.textContent =
		'Permanent location is required. Search your address or use My Location.';
		errorBox.classList.remove('d-none');
		}
		addressSearchBox?.focus();
		return;
		}

		// The address that will be saved is the one confirmed on the map.
		if (!address || typedAddress !== address.value.trim()) {
		if (errorBox) {
		errorBox.textContent =
		'Please press Search to confirm your address on the map, or use My Location.';
		errorBox.classList.remove('d-none');
		}
		addressSearchBox?.focus();
		return;
		}

		const latCheck = document.getElementById('customerProfileLatitude')?.value;
		const lngCheck = document.getElementById('customerProfileLongitude')?.value;

		if (!latCheck || !lngCheck) {
		if (errorBox) {
		errorBox.textContent =
		'Please select your location on the map (Search, click on map, or Use My Location).';
		errorBox.classList.remove('d-none');
		}
		return;
		}

		const formData =
		new FormData(customerProfileForm);

		const token =
		customerProfileForm.querySelector(
		'input[name="__RequestVerificationToken"]'
		);

		if (token) {
		formData.set(
		'__RequestVerificationToken',
		token.value
		);
		}

		if (saveButton) {
		saveButton.disabled = true;
		saveButton.innerHTML =
		'<span class="spinner-border spinner-border-sm me-1"></span> Saving...';
		}

		try {

		const response =
		await fetch(
		customerProfileForm.action,
		{
		method: 'POST',
		body: formData,
		headers: {
		'X-Requested-With':
		'XMLHttpRequest'
		}
		}
		);

		const text =
		await response.text();

		let data = null;

		try {
		data = JSON.parse(text);
		}
		catch {
		throw new Error(
		'Server returned an invalid response.'
		);
		}

		if (!response.ok || !data.success) {
		throw new Error(
		data.message ||
		'Unable to save your profile.'
		);
		}

		if (successBox) {
		successBox.textContent =
		data.message ||
		'Your profile has been updated successfully.';
		successBox.classList.remove('d-none');
		}

		const dashboardPhone =
		document.getElementById(
		'dashboardCustomerPhone'
		);

		const dashboardCity =
		document.getElementById(
		'dashboardCustomerCity'
		);

		const dashboardAddress =
		document.getElementById(
		'dashboardCustomerAddress'
		);

		if (dashboardPhone) {
		dashboardPhone.textContent =
		data.profile.phone || 'N/A';
		}

		if (dashboardCity) {
		dashboardCity.textContent =
		data.profile.city || 'N/A';
		}

		if (dashboardAddress) {
		dashboardAddress.textContent =
		data.profile.address || 'N/A';
		}

		// The profile is now complete. Future opens are edit mode.
		const updatedTitle = document.getElementById('customerProfileModalTitle');
		const updatedSubtitle = document.getElementById('customerProfileModalSubtitle');
		if (updatedTitle) updatedTitle.textContent = 'Edit Your Profile';
		if (updatedSubtitle) updatedSubtitle.textContent = 'Update your permanent customer information.';

		if (data.profile.profileImage) {

		const modalImage =
		document.getElementById(
		'customerModalProfileImage'
		);

		const dashboardImage =
		document.getElementById(
		'dashboardProfileImage'
		);

		const mobileProfileImage =
		document.getElementById(
		'mobileCustomerProfileImage'
		);

		const cacheBustedImage =
		data.profile.profileImage + '?v=' + Date.now();

		if (modalImage)
		modalImage.src = cacheBustedImage;

		if (dashboardImage)
		dashboardImage.src = cacheBustedImage;

		if (mobileProfileImage)
		mobileProfileImage.src = cacheBustedImage;
		}

		await Swal.fire({
		icon: 'success',
		title: 'Profile Updated',
		text:
		'Your profile information has been saved permanently.',
		confirmButtonColor: '#d97600',
		confirmButtonText: 'OK'
		});

		const modalElement =
		document.getElementById(
		'customerProfileModal'
		);

		if (modalElement) {
		const modal =
		bootstrap.Modal.getOrCreateInstance(
		modalElement
		);

		modal.hide();
		}

		if (data.bookingCreated && data.redirectUrl) {
		window.location.href = data.redirectUrl;
		return;
		}

		}
		catch (error) {

		if (errorBox) {
		errorBox.textContent =
		error.message ||
		'Something went wrong while saving your profile.';
		errorBox.classList.remove('d-none');
		}

		}
		finally {

		if (saveButton) {
		saveButton.disabled = false;
		saveButton.innerHTML =
		'<i class="bi bi-check2-circle me-1"></i> Save Changes';
		}
		}
		}
		);
		}

	</script>

	<script id="servicego-ampm-time-input-fix">
		document.addEventListener("input", function (event) {
		const id = event.target && event.target.id;
		if (["pNewHour","pNewMinute","newHourInput","newMinuteInput"].includes(id)) {
		event.target.value = event.target.value.replace(/\D/g, "").slice(0, 2);
		}
		});
	</script>

	<script id="servicego-customer-dashboard-load-more">
		document.addEventListener("DOMContentLoaded", function () {
		const container = document.getElementById("requestContainer");
		if (!container) return;

		// Completed bookings
		// 1-15 -> all shown, no button
		// 16+ -> first 15 + Load More
		// After loading the maximum 30 -> Show Less
		// Show Less -> returns to first 15
		const completedCards = Array.from(
		container.querySelectorAll('.request-card[data-booking-category="completed"]')
		);

		const totalCompleted = completedCards.length;
		const maxCompleted = Math.min(totalCompleted, 30);

		if (totalCompleted <= 15) {
		completedCards.forEach(function (card) {
		card.hidden = false;
		});
		return;
		}

		let visibleCompleted = 15;

		const button = document.createElement("button");
		button.type = "button";
		button.className = "btn btn-outline-warning d-block mx-auto mt-4 mb-4 px-4 py-2 fw-semibold";
		button.id = "customerBookingsLoadMore";
		button.textContent = "Load More";
		button.setAttribute("aria-controls", "requestContainer");

		container.parentNode.insertBefore(button, container.nextSibling);

		function updateCompleted() {
		completedCards.forEach(function (card, index) {
		card.hidden = index >= visibleCompleted;
		});

		if (visibleCompleted >= maxCompleted) {
		button.textContent = "Show Less";
		button.setAttribute("aria-expanded", "true");
		} else {
		button.textContent = "Load More";
		button.setAttribute("aria-expanded", "false");
		}
		}

		button.addEventListener("click", function () {
		if (visibleCompleted >= maxCompleted) {
		visibleCompleted = 15;
		} else {
		visibleCompleted = Math.min(
		visibleCompleted + 15,
		maxCompleted
		);
		}

		updateCompleted();
		});

		updateCompleted();
		});
	</script>

	<script>
		/*
		 * Provider detail google map - lazy load
		 * Google Maps stays enabled. The map iframe is only loaded
		 * when the customer opens that booking's View Details modal.
		 */
		document.addEventListener("shown.bs.modal", function (event) {
		const modal = event.target;
		if (!modal || !modal.id || !modal.id.startsWith("detailModal_")) {
		return;
		}

		const mapFrame = modal.querySelector("iframe[data-google-map-src]");
		if (!mapFrame) {
		return;
		}

		if (!mapFrame.getAttribute("src")) {
		const mapSrc = mapFrame.getAttribute("data-google-map-src");
		if (mapSrc) {
		mapFrame.setAttribute("src", mapSrc);
		}
		}
		});
	</script>

	<script>
		/*
		 * Customer booking category tabs
		 * Shows only the selected booking category without changing
		 * the existing booking cards, actions, modals or layout.
		 */
		document.addEventListener("DOMContentLoaded", function () {
		const container = document.getElementById("requestContainer");
		if (!container) return;

		const tabs = Array.from(document.querySelectorAll(".booking-category-tab"));
		const items = Array.from(container.querySelectorAll(".booking-item"));
		const legacyEmptyState = document.getElementById("legacyBookingEmptyState");
		if (legacyEmptyState) legacyEmptyState.style.display = "none";

		const emptyState = document.createElement("div");
		emptyState.className = "booking-empty-state";
		emptyState.id = "bookingCategoryEmptyState";
		container.appendChild(emptyState);

		function updateCounts() {
		["pending", "accepted", "completed"].forEach(function (category) {
		const count = items.filter(function (item) {
		return item.dataset.bookingCategory === category;
		}).length;
		const countEl = document.getElementById(category + "BookingCount");
		if (countEl) countEl.textContent = count;
		});
		}

		function showCategory(category) {
		let visibleCount = 0;

		items.forEach(function (item) {
		const visible = item.dataset.bookingCategory === category;
		item.style.display = visible ? "block" : "none";
		if (visible) visibleCount++;
		});

		tabs.forEach(function (tab) {
		const active = tab.dataset.bookingCategory === category;
		tab.classList.toggle("active", active);
		tab.setAttribute("aria-selected", active ? "true" : "false");
		});

		if (visibleCount === 0) {
		const emptyInfo = {
		pending: { icon: "bi-hourglass-split", hint: "New booking requests will show up here." },
		accepted: { icon: "bi-calendar-check", hint: "Bookings accepted by providers will show up here." },
		completed: { icon: "bi-check-circle", hint: "Your finished services will show up here." }
		}[category] || { icon: "bi-inbox", hint: "" };

		emptyState.innerHTML =
		'<span class="empty-icon"><i class="bi ' + emptyInfo.icon + '"></i></span>' +
		'<span class="empty-title">No ' + category.charAt(0).toUpperCase() + category.slice(1) + ' Bookings</span>' +
		'<span class="empty-hint">' + emptyInfo.hint + '</span>';
		emptyState.style.display = "block";
		} else {
		emptyState.style.display = "none";
		}
		}

		tabs.forEach(function (tab) {
		tab.addEventListener("click", function () {
		showCategory(tab.dataset.bookingCategory);
		});
		});

		updateCounts();

		const params = new URLSearchParams(window.location.search);
		const focusBookingId = params.get("bookingId");
		const focusedItem = focusBookingId
		? items.find(function (item) {
		return String(item.dataset.bookingId) === String(focusBookingId);
		})
		: null;

		if (focusedItem) {
		// Notification clicks open the exact booking, and the
		// matching category tab is activated so the status is
		// never shown under the wrong tab.
		const focusedCategory = focusedItem.dataset.bookingCategory || "pending";
		const focusedTab = tabs.find(function (tab) {
		return tab.dataset.bookingCategory === focusedCategory;
		});

		if (focusedTab) {
		tabs.forEach(function (tab) {
		const active = tab === focusedTab;
		tab.classList.toggle("active", active);
		tab.setAttribute("aria-selected", active ? "true" : "false");
		});
		}

		items.forEach(function (item) { item.style.display = "none"; });
		emptyState.style.display = "none";
		focusedItem.style.display = "block";
		setTimeout(function () {
		if (typeof openDetails === "function") {
		openDetails(focusBookingId);
		}
		}, 120);
		} else {
		showCategory("pending");
		}
		});
	</script>
</body>

