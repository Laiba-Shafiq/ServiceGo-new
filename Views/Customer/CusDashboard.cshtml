		/* Respond to provider reschedule */

		async function respondReschedule(
		bookingId,
		actionType
		) {

		if (!bookingId) {

		showError(
		'Booking ID is missing.'
		);

		return;

		}

		const normalizedAction =
		String(actionType)
		.toLowerCase() === 'accept'
		? 'Accept'
		: 'Reject';

		const isAccept =
		normalizedAction === 'Accept';

		const result =
		await Swal.fire({

		title:
		isAccept
		? 'Accept Reschedule?'
		: 'Reject Reschedule?',

		text:
		isAccept
		? 'The provider requested a new date and time. Accepting will apply the requested schedule.'
		: 'The original booking date and time will remain unchanged.',

		icon: 'question',

		showCancelButton: true,

		confirmButtonColor:
		isAccept
		? '#198754'
		: '#dc3545',

		cancelButtonColor:
		'#6c757d',

		confirmButtonText:
		isAccept
		? 'Yes, Accept'
		: 'Yes, Reject',

		cancelButtonText:
		'Cancel'

		});

		if (!result.isConfirmed) {

		return;

		}

		try {

		const formData =
		new FormData();

		formData.append(
		'id',
		bookingId
		);

		formData.append(
		'action',
		normalizedAction
		);

		const token =
		getAntiForgeryToken();

		if (token) {

		formData.append(
		'__RequestVerificationToken',
		token
		);

		}

		const response =
		await fetch(
		'@Url.Action("RespondReschedule", "Customer")',
		{
		method: 'POST',
		body: formData,
		headers: {
		'X-Requested-With':
		'XMLHttpRequest'
		}
		}
		);

		if (!response.ok) {

		let errorMessage =
		'Failed to process reschedule request.';

		try {

		const responseText =
		await response.text();

		if (responseText) {

		errorMessage =
		responseText;

		}

		}
		catch (error) {

		console.error(
		error
		);

		}

		throw new Error(
		errorMessage
		);

		}

		const modalElement =
		document.getElementById(
		'providerRescheduleModal'
		);

		if (modalElement) {

		const modal =
		bootstrap.Modal.getInstance(
		modalElement
		);

		if (modal) {

		modal.hide();

		}

		}

		await Swal.fire({

		title: 'Success!',

		text:
		isAccept
		? 'Provider reschedule request accepted successfully.'
		: 'Provider reschedule request rejected successfully.',

		icon: 'success',

		confirmButtonColor:
		'#d97600'

		});

		window.location.reload();

		}
		catch (error) {

		console.error(
		'Respond Reschedule Error:',
		error
		);

		showError(
		error.message ||
		'Something went wrong while processing the reschedule request.'
		);

		}

		}

		/* Live booking action visibility */

		function parseBookingStartLocal(dateText, timeText) {
		if (!dateText || !timeText) return null;
		let value = String(timeText).trim();
		const match = value.match(/^(\d{1,2}):(\d{2})(?:\s*([AaPp][Mm]))?$/);
		if (!match) return null;
		let h = Number(match[1]);
		const m = Number(match[2]);
		const ap = (match[3] || '').toUpperCase();
		if (ap === 'PM' && h < 12) h += 12;
		if (ap === 'AM' && h === 12) h = 0;
		if (h > 23 || m > 59) return null;
		const d = new Date(`${dateText}T00:00:00`);
		if (Number.isNaN(d.getTime())) return null;
		d.setHours(h, m, 0, 0);
		return d;
		}

		function updateCustomerCancellationButtons() {
		document.querySelectorAll('.cancel-booking-btn').forEach(button => {
		const status = String(button.dataset.bookingStatus || '').trim().toLowerCase();
		if (status === 'pending') {
		button.style.display = '';
		return;
		}
		if (status !== 'accepted') {
		button.style.display = 'none';
		return;
		}
		const start = parseBookingStartLocal(button.dataset.bookingDate, button.dataset.bookingTime);
		button.style.display = start && new Date() < new Date(start.getTime() - 2 * 60 * 60 * 1000) ? '' : 'none';
		});
		}

