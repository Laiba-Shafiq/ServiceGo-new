@model List<ServiceGo.Models.Message>

@using System
@using System.Linq
@using System.Text.Json
@using System.Collections.Generic
@{
    Layout = null;

    var chatsList = ViewBag.Chats as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var activeProviderId = ViewBag.ActiveProviderId as string ?? string.Empty;
    var activeProviderName = ViewBag.ActiveProviderName as string ?? "Select a chat";

    var customerUnreadCount = ViewBag.UnreadNotificationCount as int? ?? 0;

    var customerProfileImage = ViewBag.CustomerProfileImage as string ?? string.Empty;
    var profileImageUrl = string.IsNullOrWhiteSpace(customerProfileImage)
        ? Url.Content("~/images/Profile icon.png")
        : Url.Content(customerProfileImage);

    var activeProviderProfileImage = Convert.ToString(ViewBag.ActiveProviderProfileImage) ?? string.Empty;
    var activeProviderProfileImageUrl = string.IsNullOrWhiteSpace(activeProviderProfileImage)
        ? Url.Content("~/images/Profile icon.png")
        : Url.Content(activeProviderProfileImage);

    var customerChats = new List<object>();

    foreach (var c in chatsList)
    {
        var providerId = Convert.ToString(c.ProviderId) ?? string.Empty;
        var providerName = Convert.ToString(c.ProviderName) ?? "Provider";
        var providerImage = Convert.ToString(c.ProviderProfileImage);

        var providerImageUrl = string.IsNullOrWhiteSpace(providerImage)
            ? Url.Content("~/images/Profile icon.png")
            : (providerImage.StartsWith("~")
                ? Url.Content(providerImage)
                : providerImage.StartsWith("/")
                    ? providerImage
                    : Url.Content("~/" + providerImage.TrimStart('/')));

        var messages = new List<object>();

        // The controller supplies Messages for every provider chat,
        // exactly like the working Provider Messages page.
        // For compatibility, the active chat can still fall back to Model.
        try
        {
            var chatMessagesProperty = c.GetType().GetProperty("Messages");
            var chatMessagesValue = chatMessagesProperty?.GetValue(c) as System.Collections.IEnumerable;

            if (chatMessagesValue != null)
            {
                foreach (var rawMessage in chatMessagesValue)
                {
                    var messageType = rawMessage.GetType();
                    messages.Add(new
                    {
                        id = Convert.ToString(messageType.GetProperty("id")?.GetValue(rawMessage)) ?? string.Empty,
                        type = Convert.ToString(messageType.GetProperty("type")?.GetValue(rawMessage)) ?? "received",
                        text = Convert.ToString(messageType.GetProperty("text")?.GetValue(rawMessage)) ?? string.Empty,
                        time = Convert.ToString(messageType.GetProperty("time")?.GetValue(rawMessage)) ?? string.Empty
                    });
                }
            }
        }
        catch
        {
            // Keep the page alive if an older controller build has no Messages property.
        }

        if (messages.Count == 0 &&
            string.Equals(activeProviderId, providerId, StringComparison.OrdinalIgnoreCase))
        {
            foreach (var m in Model ?? Enumerable.Empty<ServiceGo.Models.Message>())
            {
                messages.Add(new
                {
                    id = m.MessageId,
                    type = m.IsFromCustomer ? "sent" : "received",
                    text = m.TextContent ?? string.Empty,
                    time = m.Timestamp.ToString("hh:mm tt")
                });
            }
        }

        customerChats.Add(new
        {
            providerId,
            name = providerName,
            img = providerImageUrl,
            messages
        });
    }

    var customerMessagesConfig = new
    {
        chats = customerChats,
        activeId = activeProviderId,
        activeName = activeProviderName,
        activeProviderProfileImageUrl,
        defaultProfileImageUrl = Url.Content("~/images/Profile icon.png"),
        messagesUrl = Url.Action("Messages", "Customer"),
        sendMessageUrl = Url.Action("SendMessage", "Customer"),
        sendAudioMessageUrl = Url.Action("SendAudioMessage", "Customer"),
        deleteMessageUrl = Url.Action("DeleteMessage", "Customer"),
        deleteChatUrl = Url.Action("DeleteChat", "Customer")
    };
}

<!DOCTYPE html>
<html lang="en">
