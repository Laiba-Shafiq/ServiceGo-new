            background: none;
            border: none;
            font-size: 20px;
            color: #000;
            margin-right: 10px;
            padding: 5px;
            cursor: pointer;
        }

        /* Caret fix */

        html,
        body,
        body * {
            caret-color: transparent !important;
        }

        input,
        textarea,
        [contenteditable="true"],
        [contenteditable=""] {
            caret-color: auto !important;
        }

