        <img src="@Url.Content("~/images/Logo.png")"
             class="mobile-logo"
             alt="ServiceGo"
             onclick="window.location.href='@Url.Action("Index", "Home")'">

        <div class="dropdown">

            <span class="mobile-customer-greeting">Hi Customer</span>

            <img src="@profileImageUrl"
                 onerror="this.onerror=null;this.src='@Url.Content("~/images/Profile icon.png")';"
                 class="rounded-circle mobile-profile-trigger"
                 id="mobileCustomerProfileImage"
                 alt="Profile"
                 width="40"
                 height="40"
                 data-bs-toggle="dropdown"
                 aria-expanded="false">

            <ul class="dropdown-menu dropdown-menu-end mobile-profile-menu shadow">

                <li>
                    <a class="dropdown-item"
                       href="@Url.Action("CusDashboard", "Customer")">
                        <i class="bi bi-house-door"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <li>
                    <a class="dropdown-item"
                       href="@Url.Action("History", "Customer")">
