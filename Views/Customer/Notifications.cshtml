@model List<ServiceGo.Models.Notification>

@{
    Layout = null;


    var customerProfileImage = ViewBag.CustomerProfileImage as string ?? string.Empty;
    var profileImageUrl = string.IsNullOrWhiteSpace(customerProfileImage)
        ? Url.Content("~/images/Profile icon.png")
        : Url.Content(customerProfileImage);


}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Customer - Notifications</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="icon" href="@Url.Content("~/images/Logo.png")" type="image/x-icon">

    <style>
        /*
                 * Servicego customer notifications
                 * All CSS merged into this cshtml
                 */

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            font-family: "Poppins", sans-serif;
            background-color: #f2f2f2;
            overflow-x: hidden;
        }

        /* Mobile menu button */

        .mobile-menu-btn {
            position: fixed;
            top: 15px;
            left: 15px;
            z-index: 2000;
            background: #f0ad4e;
            border: none;
            color: #fff;
            font-size: 1.8rem;
            padding: 8px 12px;
            border-radius: 10px;
            display: none;
        }

        /* Sidebar */

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 80px !important;
            min-width: 80px !important;
            height: 100vh !important;
            background-color: #d97600 !important;
            transition: width 0.3s ease, box-shadow 0.3s ease !important;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow: hidden;
            z-index: 1040 !important;
        }

            .sidebar:hover,
            .sidebar:focus-within {
                width: 240px !important;
                box-shadow: 4px 0 25px rgba(240, 173, 78, 0.3) !important;
            }

            .sidebar img.logo {
                width: 60px;
                height: 60px;
                margin: 20px 0;
                border-radius: 10%;
                background: #fff;
                cursor: pointer;
                object-fit: contain;
                border: 2px solid #fff;
                transition: transform 0.3s;
            }

                .sidebar img.logo:hover {
                    transform: scale(1.05);
                }

            .sidebar .nav {
                width: 100% !important;
                margin-top: 10px;
                display: flex;
                flex-direction: column;
                align-items: center;
            }

                .sidebar .nav a {
                    display: flex;
                    align-items: center;
                    color: #fff;
                    padding: 12px 20px !important;
                    text-decoration: none;
                    border-radius: 10px !important;
                    width: 90% !important;
                    margin-bottom: 6px !important;
                    transition: all 0.3s;
                    gap: 0 !important;
                    background: transparent !important;
                }

                    .sidebar .nav a i {
                        font-size: 1.4rem !important;
                        margin-right: 15px !important;
                        min-width: 25px !important;
                        text-align: center !important;
                    }

                    /* Only active page highlighted */
                    .sidebar .nav a:hover:not(.active) {
                        background: transparent !important;
                        transform: translateX(5px);
                    }

                    .sidebar .nav a.active {
                        background: #ffb74d !important;
                        color: #fff !important;
                        font-weight: 600;
                    }

                .sidebar .nav span {
                    opacity: 0 !important;
                    transition: opacity 0.2s ease !important;
                }

            .sidebar:hover .nav span,
            .sidebar:focus-within .nav span {
                opacity: 1 !important;
            }

        /* Main content */

        .main {
            min-height: 100vh;
            margin-left: 80px !important;
            width: calc(100% - 80px) !important;
            padding: 42px 48px 55px;
            transition: margin-left 0.3s ease, width 0.3s ease !important;
            box-sizing: border-box !important;
        }

        .sidebar:hover ~ .main,
        .sidebar:focus-within ~ .main {
            margin-left: 240px !important;
            width: calc(100% - 240px) !important;
        }

        .page-container {
            width: 100%;
            max-width: 1100px;
            margin: 0 auto;
        }

        h4 {
            font-weight: 700;
            color: #000;
        }

        .page-title {
            margin-bottom: 25px;
        }

        /* Notification cards */

        .notif-card {
            width: 100%;
            min-width: 0;
            word-break: break-word;
            background: #fff;
            border-radius: 15px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            padding: 20px;
            margin-bottom: 15px;
            transition: 0.3s;
            display: flex;
            align-items: center;
            gap: 15px;
        }

            .notif-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 6px 15px rgba(240, 173, 78, 0.3);
            }

            .notif-card.unread {
                border-left: 4px solid #f0ad4e;
                background-color: #fffdf8 !important;
            }

            /* Notification icon */

            .notif-card .notif-icon {
                width: 44px !important;
                height: 44px !important;
                min-width: 44px !important;
                flex: 0 0 44px !important;
                margin-right: 14px !important;
                border-radius: 50% !important;
                background: #fff3df !important;
                color: #d97600 !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                font-size: 1.15rem !important;
            }

            .notif-card.unread .notif-icon {
                background: #ffe4b8 !important;
            }

            .notif-card .notif-icon i {
                line-height: 1 !important;
            }

        /* Notification text */

        .notif-text {
            flex: 1;
            min-width: 0;
        }

            .notif-text p {
                margin: 0;
                color: #555;
                font-size: 15px;
                overflow-wrap: anywhere;
            }

        .notif-title {
            font-weight: 600;
            font-size: 0.95rem;
            margin-bottom: 2px;
        }

        .notif-time {
            font-size: 0.9rem;
            color: #999;
        }

        /* Footer */

        footer {
            text-align: center;
            color: #777;
            font-size: 0.9rem;
            margin-top: 40px;
            overflow-wrap: anywhere;
        }

        /* Mobile header */

        .mobile-top,
        .mobile-top-header {
            display: none !important;
        }

        .mobile-profile-trigger {
            object-fit: cover;
            border: 2px solid #f0a43c !important;
            cursor: pointer;
        }

        .mobile-profile-btn {
            border: 2px solid #f0a43c !important;
            border-radius: 50% !important;
            background: #fff !important;
        }

            .mobile-profile-btn::after {
                display: none !important;
            }

        /* Dropdown */

        .dropdown-item.active,
        .dropdown-item:active {
            background-color: #fff3e0 !important;
            color: #d97600 !important;
            font-weight: 600;
        }

        .dropdown-item:hover {
            background-color: #fff8f0;
            color: #f0ad4e;
        }

        /* Caret fix */

        html,
        body,
        body * {
            caret-color: transparent !important;
        }

        input,
        textarea,
        [contenteditable="true"],
        [contenteditable=""] {
            caret-color: transparent !important;
        }

        /* Notification status / filters */

        .sidebar .nav a .sidebar-notification-badge {
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            min-width: 22px;
            height: 22px;
            padding: 0 7px;
            margin-left: auto;
            border-radius: 999px;
            background: #fff !important;
            color: #d97600 !important;
            font-size: .70rem;
            font-weight: 800;
            line-height: 1;
            opacity: 1 !important;
            white-space: nowrap;
        }

        .notification-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 22px;
        }

        .notification-heading {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

            .notification-heading h4 {
                margin: 0;
            }

        .notification-unread-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 13px;
            border-radius: 999px;
            background: #fff;
            border: 1px solid #ececec;
            color: #555;
            font-size: .82rem;
            font-weight: 600;
            box-shadow: 0 3px 12px rgba(0,0,0,.05);
            white-space: nowrap;
        }

            .notification-unread-pill .count {
                min-width: 23px;
                height: 23px;
                padding: 0 6px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 999px;
                background: #fff3e0;
                color: #d97600;
                font-weight: 700;
            }

        .notification-filters {
            display: grid;
            grid-template-columns: repeat(2, minmax(150px, 1fr));
            gap: 7px;
            padding: 7px;
            margin: 0 auto 24px;
            width: min(100%, 900px);
            background: #fff;
            border: 1px solid #eee;
            border-radius: 16px;
            box-shadow: 0 4px 18px rgba(0,0,0,.05);
        }

        .notification-filter {
            min-height: 54px;
            border: 0;
            border-radius: 12px;
            background: transparent;
            color: #666;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            transition: all .18s ease;
        }

            .notification-filter:hover {
                background: #fafafa;
                color: #d97600;
            }

            .notification-filter.active {
                background: #fff3e0;
                color: #d97600;
            }

            .notification-filter .filter-count {
                min-width: 23px;
                height: 23px;
                padding: 0 6px;
                border-radius: 999px;
                background: #f1f1f1;
                color: #777;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: .78rem;
                font-weight: 700;
            }

            .notification-filter.active .filter-count {
                background: #d97600;
                color: #fff;
            }

        .notif-card.read {
            background: #fff;
            border-left: 4px solid transparent;
        }

        .notif-card.unread {
            border-left: 4px solid #d97600;
            background: #fffaf3 !important;
        }

        .notif-status-dot {
            width: 8px;
            height: 8px;
            min-width: 8px;
            border-radius: 50%;
            background: #d97600;
            margin-top: 7px;
            box-shadow: 0 0 0 3px rgba(217,118,0,.10);
        }

            .notif-status-dot.read-dot {
                visibility: hidden;
            }

        .notif-card.unread .notif-title {
            font-weight: 750;
        }

        .notif-card.read .notif-title {
            font-weight: 600;
        }

        .notification-empty-filter {
            display: none;
        }

        /* Notification interaction */

        /* Clickable notifications: light orange + pointer + arrow */
        .notification-main .notif-card {
            background: #fff8ee !important;
            border-left: 4px solid #f0ad4e !important;
        }

            .notification-main .notif-card::after {
                content: "\2192";
                position: absolute;
                right: 16px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 20px;
                font-weight: 700;
                color: #d97600;
            }

        /* Non-clickable notifications: plain white + no arrow */
        .notification-view-only .notif-card {
            background: #fff !important;
            border-left: 4px solid transparent !important;
        }

            .notification-view-only .notif-card::after {
                content: none;
            }

        .notification-row {
            position: relative;
            width: 100%;
            margin-bottom: 14px;
        }

        .notification-main {
            display: block;
            width: 100%;
            min-width: 0;
            color: inherit;
            text-decoration: none !important;
            cursor: pointer !important;
        }

            .notification-main .notif-card {
                width: 100%;
                min-height: 108px;
                margin-bottom: 0 !important;
                padding-right: 58px !important;
                cursor: pointer !important;
                position: relative;
            }

        .notification-view-only {
            width: 100%;
            min-width: 0;
            cursor: default !important;
        }

            .notification-view-only .notif-card {
                width: 100%;
                min-height: 108px;
                margin-bottom: 0 !important;
                padding-right: 58px !important;
                cursor: default !important;
                position: relative;
            }

        /* Small orange delete button sits INSIDE the card's top-right corner. */
        .notification-dismiss-form {
            position: absolute;
            top: 10px;
            right: 10px;
            z-index: 5;
            margin: 0;
        }

        .notification-dismiss {
            width: 32px;
            height: 32px;
            border: 1px solid #f2c58d;
            border-radius: 10px;
            background: #fff7ec;
            color: #d97600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(217,118,0,.10);
            transition: transform .18s ease, background .18s ease, color .18s ease, box-shadow .18s ease;
        }

            .notification-dismiss:hover,
            .notification-dismiss:focus-visible {
                background: #d97600;
                color: #fff;
                border-color: #d97600;
                transform: translateY(-1px);
                box-shadow: 0 4px 10px rgba(217,118,0,.22);
                outline: none;
            }

            .notification-dismiss i {
                font-size: .9rem;
                pointer-events: none;
            }

        .notification-row .notif-card,
        .notif-card,
        .notif-item,
        .notification-card {
            user-select: text !important;
        }

        .notification-view-only,
        .notification-view-only.notif-item {
            cursor: default !important;
        }


        /* Mobile responsive */

        @@media (max-width: 768px) {
            .notification-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .notification-filters {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .notification-row {
                margin-bottom: 12px;
            }

            .notification-main .notif-card,
            .notification-view-only .notif-card {
                min-height: 100px;
                padding-right: 50px !important;
            }

            .notification-dismiss-form {
                top: 8px;
                right: 8px;
            }

            .notification-dismiss {
                width: 30px;
                height: 30px;
                border-radius: 9px;
            }

            .page-title > div {
                width: 100%;
            }

                .page-title > div form {
                    flex: 1 1 0;
                }

                .page-title > div button {
                    width: 100%;
                }
            /* Hide desktop sidebar */
            .sidebar {
                display: none !important;
            }
            /* Mobile header */
            .mobile-top,
            .mobile-top-header {
                height: 70px !important;
                min-height: 70px !important;
                padding: 0 15px !important;
                background: #fff !important;
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                right: 0 !important;
                display: flex !important;
                align-items: center !important;
                justify-content: space-between !important;
                z-index: 3000 !important;
                box-sizing: border-box !important;
                box-shadow: 0 2px 10px rgba(0, 0, 0, .08) !important;
            }

                .mobile-top > .dropdown,
                .mobile-top-header > .dropdown,
                .mobile-profile-dropdown {
                    position: relative !important;
                    z-index: 3010 !important;
                }

                .mobile-logo,
                .mobile-top .mobile-logo,
                .mobile-top .logo,
                .mobile-top-header .mobile-logo {
                    width: 45px !important;
                    height: 45px !important;
                    min-width: 45px !important;
                    min-height: 45px !important;
                    object-fit: contain !important;
                    border-radius: 8px !important;
                    cursor: pointer !important;
                }
            /* Profile button */
            .mobile-profile-btn {
                width: 48px !important;
                height: 48px !important;
                min-width: 48px !important;
                min-height: 48px !important;
                padding: 0 !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                box-shadow: none !important;
            }

                .mobile-profile-btn .profile-thumb,
                .profile-thumb,
                .mobile-profile-trigger,
                .mobile-top .profile-thumb,
                .mobile-top-header .profile-thumb {
                    width: 44px !important;
                    height: 44px !important;
                    min-width: 44px !important;
                    min-height: 44px !important;
                    border-radius: 50% !important;
                    object-fit: cover !important;
                    display: block !important;
                    border: 0 !important;
                    background: #fff !important;
                }

            .mobile-profile-trigger {
                border: 2px solid #f0a43c !important;
            }
            /* Mobile dropdown */
            .mobile-profile-menu,
            .mobile-dropdown-menu,
            .customer-mobile-menu,
            .mobile-top .dropdown-menu,
            .mobile-top-header .dropdown-menu {
                width: 192px !important;
                min-width: 192px !important;
                max-width: 192px !important;
                margin-top: 8px !important;
                padding: 6px 0 !important;
                border: 1px solid #ddd !important;
                border-radius: 9px !important;
                background: #fff !important;
                box-shadow: 0 5px 16px rgba(0, 0, 0, .18) !important;
                overflow: hidden !important;
                box-sizing: border-box !important;
                z-index: 3020 !important;
            }

                .mobile-profile-menu .dropdown-item,
                .mobile-dropdown-menu .dropdown-item,
                .customer-mobile-menu .dropdown-item,
                .mobile-top .dropdown-menu .dropdown-item,
                .mobile-top-header .dropdown-menu .dropdown-item {
                    width: 100% !important;
                    min-height: 48px !important;
                    height: 48px !important;
                    padding: 10px 16px !important;
                    margin: 0 !important;
                    display: flex !important;
                    align-items: center !important;
                    gap: 12px !important;
                    border-radius: 0 !important;
                    font-size: 16px !important;
                    line-height: 1.2 !important;
                    font-weight: 700 !important;
                    white-space: nowrap !important;
                    color: #2f2f2f !important;
                    background: #fff !important;
                    box-sizing: border-box !important;
                }

                    .mobile-profile-menu .dropdown-item i,
                    .mobile-dropdown-menu .dropdown-item i,
                    .customer-mobile-menu .dropdown-item i,
                    .mobile-top .dropdown-menu .dropdown-item i,
                    .mobile-top-header .dropdown-menu .dropdown-item i {
                        width: 20px !important;
                        min-width: 20px !important;
                        margin: 0 !important;
                        text-align: center !important;
                        font-size: 18px !important;
                        color: #444 !important;
                    }

                    .mobile-profile-menu .dropdown-item:hover,
                    .mobile-dropdown-menu .dropdown-item:hover,
                    .customer-mobile-menu .dropdown-item:hover,
                    .mobile-top .dropdown-menu .dropdown-item:hover,
                    .mobile-top-header .dropdown-menu .dropdown-item:hover,
                    .mobile-profile-menu .dropdown-item.active,
                    .mobile-dropdown-menu .dropdown-item.active,
                    .customer-mobile-menu .dropdown-item.active,
                    .mobile-top .dropdown-menu .dropdown-item.active,
                    .mobile-top-header .dropdown-menu .dropdown-item.active {
                        background: #fff3e0 !important;
                        color: #d97600 !important;
                    }

                        .mobile-profile-menu .dropdown-item:hover i,
                        .mobile-dropdown-menu .dropdown-item:hover i,
                        .customer-mobile-menu .dropdown-item:hover i,
                        .mobile-top .dropdown-menu .dropdown-item:hover i,
                        .mobile-top-header .dropdown-menu .dropdown-item:hover i,
                        .mobile-profile-menu .dropdown-item.active i,
                        .mobile-dropdown-menu .dropdown-item.active i,
                        .customer-mobile-menu .dropdown-item.active i,
                        .mobile-top .dropdown-menu .dropdown-item.active i,
                        .mobile-top-header .dropdown-menu .dropdown-item.active i {
                            color: #d97600 !important;
                        }

                .mobile-profile-menu .dropdown-divider,
                .mobile-dropdown-menu .dropdown-divider,
                .customer-mobile-menu .dropdown-divider,
                .mobile-top .dropdown-menu .dropdown-divider,
                .mobile-top-header .dropdown-menu .dropdown-divider {
                    margin: 0 !important;
                    border-top: 1px solid #ddd !important;
                    opacity: 1 !important;
                }

                .mobile-profile-menu .logout-item,
                .mobile-dropdown-menu .text-danger,
                .customer-mobile-menu .logout-item,
                .mobile-top .dropdown-menu .text-danger,
                .mobile-top-header .dropdown-menu .text-danger,
                .mobile-profile-menu .logout-item i,
                .mobile-dropdown-menu .text-danger i,
                .customer-mobile-menu .logout-item i,
                .mobile-top .dropdown-menu .text-danger i,
                .mobile-top-header .dropdown-menu .text-danger i {
                    color: #dc3545 !important;
                }
            /* Mobile main content */

            .main {
                margin-left: 0 !important;
                width: 100% !important;
                max-width: 100% !important;
                min-height: 100vh;
                box-sizing: border-box !important;
                padding: 82px 12px 25px !important;
                overflow-x: hidden !important;
            }

            .sidebar:hover ~ .main,
            .sidebar:focus-within ~ .main {
                margin-left: 0 !important;
                width: 100% !important;
            }

            .page-container {
                width: 100% !important;
                max-width: 100% !important;
                margin-left: 0 !important;
                margin-right: 0 !important;
                box-sizing: border-box !important;
            }

            .page-title {
                font-size: 1.15rem;
                margin-bottom: 20px !important;
            }
            /* Full width cards */
            .page-container > .history-card,
            .page-container > .complaint-card,
            .page-container > .rating-card,
            .page-container > .request-card,
            .page-container > .profile-card,
            .notif-card {
                width: 100% !important;
                max-width: 100% !important;
                min-width: 0 !important;
                box-sizing: border-box !important;
            }
            /* Notification card mobile */
            .notif-card {
                display: flex !important;
                align-items: flex-start !important;
                padding: 14px !important;
                margin-bottom: 12px !important;
                border-radius: 12px !important;
                gap: 0 !important;
            }

                .notif-card .notif-icon {
                    flex: 0 0 34px !important;
                    width: 34px !important;
                    height: 34px !important;
                    min-width: 34px !important;
                    margin-right: 10px !important;
                    font-size: 1rem !important;
                    text-align: center;
                }

            .notif-text {
                flex: 1 1 auto !important;
                min-width: 0 !important;
            }

            .notif-title {
                font-size: .92rem;
            }

            .notif-text p {
                overflow-wrap: anywhere;
            }

            .notif-text .small {
                font-size: .84rem !important;
                line-height: 1.45;
            }

            footer {
                margin-top: 30px !important;
                font-size: .75rem;
                line-height: 1.45;
            }

            .mobile-top .dropdown-menu {
                min-width: 190px;
                margin-top: 6px !important;
            }
            /* Other customer-page shared elements */
            .history-card,
            .complaint-card,
            .rating-card,
            .request-card,
            .profile-card {
                min-width: 0 !important;
                box-sizing: border-box !important;
            }

            .info-grid,
            .complaint-grid {
                width: 100% !important;
                max-width: 100% !important;
                box-sizing: border-box !important;
            }

            img,
            video,
            iframe {
                max-width: 100%;
            }
        }

        /* Very small mobile */

        @@media (max-width: 420px) {

            .mobile-top,
