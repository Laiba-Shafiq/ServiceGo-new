                        <span>History</span>
                    </a>
                </li>

                <li>
                    <a class="dropdown-item"
                       href="@Url.Action("Messages", "Customer")">
                        <i class="bi bi-chat-dots"></i>
                        <span>Messages</span>
                    </a>
                </li>

                <li>
                    <a class="dropdown-item active"
                       href="@Url.Action("Notifications", "Customer")">
                        <i class="bi bi-bell"></i>
                        <span>Notifications</span>
                    </a>
                </li>

                <li>
                    <hr class="dropdown-divider">
                </li>

                <li>
                    <a class="dropdown-item text-danger"
                       href="@Url.Action("Logout", "Customer")">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>
                    </a>
                </li>

            </ul>
        </div>
    </div>

    <!-- Main content -->

    <main class="main">

        <div class="page-container">

            <div class="notification-header page-title">
                <div class="notification-heading">
                    <h4>
                        <i class="bi bi-bell-fill text-warning"></i>
                        Notifications
                    </h4>
                    <span class="notification-unread-pill">
                        <span class="count">@(ViewBag.UnreadNotificationCount as int? ?? 0)</span>
                        Unread
                    </span>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @if (Model != null && Model.Any(n => !n.IsRead))
                    {
                        <form method="post" action="@Url.Action("MarkAllNotificationsRead", "Customer")" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-light border fw-semibold">
                                <i class="bi bi-check2-all me-1"></i>
                                Mark all as read
                            </button>
                        </form>
                    }

                    @if (Model != null && Model.Any(n => n.IsRead))
                    {
                        <form method="post" action="@Url.Action("ClearReadNotifications", "Customer")" class="m-0"
                              onsubmit="return false;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary fw-semibold">
                                <i class="bi bi-trash3 me-1"></i>
                                Clear read
                            </button>
                        </form>
                    }
                </div>
            </div>

            <div class="notification-filters" role="tablist" aria-label="Notification filters">
                <button type="button" class="notification-filter active" data-filter="all" role="tab" aria-selected="true">
                    <span>All</span>
                    <span class="filter-count">@(ViewBag.TotalNotificationCount as int? ?? (Model?.Count ?? 0))</span>
                </button>
                <button type="button" class="notification-filter" data-filter="unread" role="tab" aria-selected="false">
                    <span>Unread</span>
                    <span class="filter-count">@(ViewBag.UnreadNotificationCount as int? ?? 0)</span>
                </button>
            </div>

            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    string statusDotClass = item.IsRead ? "read-dot" : string.Empty;
                    string readAttribute = item.IsRead ? "true" : "false";
                    string notificationType = item.NotificationType ?? string.Empty;

                    string iconClass = "bi-bell-fill";

                    string iconSource =
                    (item.IconClass ?? string.Empty).ToLowerInvariant();

                    string typeSource =
                    notificationType.ToLowerInvariant();

                    if (iconSource.Contains("microphone") ||
                    typeSource.Contains("voice"))
                    {
                        iconClass = "bi-mic-fill";
                    }
                    else if (iconSource.Contains("calendar-x") ||
                    typeSource.Contains("cancel"))
                    {
                        iconClass = "bi-calendar-x-fill";
                    }
                    else if (iconSource.Contains("calendar") ||
                    typeSource.Contains("reschedule") ||
                    typeSource.Contains("schedule"))
                    {
                        iconClass = "bi-calendar-event-fill";
                    }
                    else if (iconSource.Contains("check") ||
                    typeSource.Contains("accept") ||
                    typeSource.Contains("complete"))
                    {
                        iconClass = "bi-check-circle-fill";
                    }
                    else if (iconSource.Contains("xmark") ||
                    iconSource.Contains("times") ||
                    typeSource.Contains("reject"))
                    {
                        iconClass = "bi-x-circle-fill";
                    }
                    else if (iconSource.Contains("exclamation") ||
                    typeSource.Contains("warning") ||
                    typeSource.Contains("complaint"))
                    {
                        iconClass = "bi-exclamation-triangle-fill";
                    }
                    else if (iconSource.Contains("comment") ||
                    iconSource.Contains("message") ||
                    typeSource.Contains("message"))
                    {
                        iconClass = "bi-chat-dots-fill";
                    }
                    else if (iconSource.StartsWith("bi-"))
                    {
                        iconClass = iconSource;
                    }

                    var notificationTitleSource = (item.Title ?? string.Empty).ToLowerInvariant();
                    var notificationTypeSource = (item.NotificationType ?? string.Empty).ToLowerInvariant();

                    bool isMessageNotification =
                    notificationTypeSource.Contains("message") ||
                    notificationTitleSource.Contains("message") ||
                    notificationTitleSource.Contains("whatsapp");

                    var clickableNotificationIds =
                    ViewBag.ClickableNotificationIds as System.Collections.Generic.HashSet<int> ??
                    new System.Collections.Generic.HashSet<int>();

                    bool isClickableNotification =
                    clickableNotificationIds.Contains(item.NotificationId);

                    if (isClickableNotification)
                    {
                        <div class="notification-row notif-item" data-id="@item.NotificationId" data-read="@readAttribute">
                            <a href="@Url.Action("OpenNotification", "Customer", new { id = item.NotificationId })"
                               class="notification-main"
                               aria-label="Open notification">
                                <div class="notif-card shadow-sm p-3 bg-white rounded d-flex align-items-start @(!item.IsRead ? "unread" : "read")">
                                    <span class="notif-status-dot @statusDotClass" aria-hidden="true"></span>
                                    <div class="notif-icon fs-4 text-warning me-3">
                                        <i class="@iconClass"></i>
                                    </div>

                                    <div class="notif-text w-100">
                                        @if (!string.IsNullOrEmpty(item.Title))
                                        {
                                            <div class="notif-title text-dark">
                                                @item.Title
                                            </div>
                                        }

                                        <p class="mb-1 text-secondary small">
                                            @Html.Raw(item.Message)
                                        </p>

                                        <p class="notif-time text-muted extra-small mb-0"
                                           style="font-size: 0.75rem;">
                                            @item.Timestamp.ToString("dd MMM yyyy, hh:mm tt")
                                        </p>
                                    </div>
                                </div>
                            </a>

                            <form method="post"
                                  action="@Url.Action("DismissNotification", "Customer")"
                                  class="notification-dismiss-form m-0"
                                  onsubmit="return false;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.NotificationId" />
                                <button type="submit"
                                        class="notification-dismiss"
                                        title="Remove notification"
                                        aria-label="Remove notification">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="notification-row notif-item" data-id="@item.NotificationId" data-read="@readAttribute">
                            <div class="notification-view-only">
                                <div class="notif-card shadow-sm p-3 bg-white rounded d-flex align-items-start @(!item.IsRead ? "unread" : "read")">
                                    <span class="notif-status-dot @statusDotClass" aria-hidden="true"></span>
                                    <div class="notif-icon fs-4 text-warning me-3">
                                        <i class="@iconClass"></i>
                                    </div>
                                    <div class="notif-text w-100">
                                        @if (!string.IsNullOrEmpty(item.Title))
                                        {
                                            <div class="notif-title text-dark">@item.Title</div>
                                        }
                                        <p class="mb-1 text-secondary small">@Html.Raw(item.Message)</p>
                                        <p class="notif-time text-muted extra-small mb-0" style="font-size: 0.75rem;">@item.Timestamp.ToString("dd MMM yyyy, hh:mm tt")</p>
                                    </div>
                                </div>
                            </div>

                            <form method="post"
                                  action="@Url.Action("DismissNotification", "Customer")"
                                  class="notification-dismiss-form m-0"
                                  onsubmit="return false;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.NotificationId" />
                                <button type="submit"
                                        class="notification-dismiss"
                                        title="Remove notification"
                                        aria-label="Remove notification">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </form>
                        </div>
                    }
                }
            }
            else
            {
                <div class="alert alert-light text-center p-4 shadow-sm">

                    <i class="bi bi-bell-slash fs-2 text-muted"></i>

                    <p class="text-muted mt-2 mb-0">
                        No notifications found.
                    </p>

                </div>
            }

            <div id="notificationFilterEmpty" class="notification-empty-filter alert alert-light text-center p-4 shadow-sm">
                <i class="bi bi-check2-circle fs-2 text-muted"></i>
                <p class="text-muted mt-2 mb-0">No unread notifications.</p>
            </div>

            <!-- Load more -->
            <div class="text-center mt-3 mb-4"
                 id="notificationsLoadMoreWrap"
                 hidden
                 data-has-more="@(ViewBag.HasMoreNotifications == true ? "true" : "false")"
                 data-url="@Url.Action("Notifications", "Customer")">

                <button type="button"
                        id="notificationsLoadMore"
                        class="btn btn-outline-warning px-4 py-2 fw-semibold">
                    Load More
                </button>

            </div>

            <!-- Footer -->

            <footer class="mt-5 text-center text-muted">
                Stay updated with your latest service alerts —
                ServiceGo © @DateTime.Now.Year
            </footer>

        </div>
    </main>

    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Notification load more -->

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const filterButtons =
                document.querySelectorAll(".notification-filter");
            const getItems = function () {
                return Array.from(document.querySelectorAll(".notif-item"));
            };
            const loadMore =
                document.getElementById("notificationsLoadMore");
            const loadMoreWrap =
                document.getElementById("notificationsLoadMoreWrap");
            const emptyFilter =
                document.getElementById("notificationFilterEmpty");

            const pageSize = 15;
            let activeFilter = "all";
            let visibleCount = pageSize;

            // Server state: notifications are fetched 15 at a time.
            let serverTotal = @(ViewBag.TotalNotificationCount as int? ?? (Model?.Count ?? 0));
            let serverUnread = @(ViewBag.UnreadNotificationCount as int? ?? 0);
            let hasMoreOnServer =
                !!loadMoreWrap && loadMoreWrap.dataset.hasMore === "true";
            let isLoadingMore = false;

            function getFilteredItems() {
                return getItems().filter(function (item) {
                    return activeFilter === "all" ||
                           item.dataset.read !== "true";
                });
            }

            function updateNotifications() {
                const filtered = getFilteredItems();
                const currentVisibleCount =
                    Math.min(visibleCount, filtered.length);

                getItems().forEach(function (item) {
                    item.hidden = true;
                });

                filtered
                    .slice(0, currentVisibleCount)
                    .forEach(function (item) {
                        item.hidden = false;
                    });

                if (emptyFilter) {
                    emptyFilter.hidden =
                        !(activeFilter === "unread" &&
                          filtered.length === 0);
                }

                if (!loadMoreWrap || !loadMore) return;

                // Button is shown while there is anything left to show
                // either already-loaded rows that are still hidden,
                // or more notifications waiting on the server.
                const canRevealMore = filtered.length > currentVisibleCount;

                loadMoreWrap.hidden = !(canRevealMore || hasMoreOnServer);
                loadMore.disabled = isLoadingMore;
                loadMore.textContent = isLoadingMore ? "Loading..." : "Load More";
            }

            filterButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    activeFilter = button.dataset.filter || "all";
                    visibleCount = pageSize;

                    filterButtons.forEach(function (other) {
                        const active = other === button;

                        other.classList.toggle("active", active);
                        other.setAttribute(
                            "aria-selected",
                            active ? "true" : "false"
                        );
                    });

                    updateNotifications();
                });
            });

            if (loadMore) {
                loadMore.addEventListener("click", async function () {
                    if (isLoadingMore) return;

                    const filtered = getFilteredItems();

                    // 1) Rows already loaded but hidden -> reveal next 15.
                    if (filtered.length > visibleCount) {
                        visibleCount = Math.min(
                            visibleCount + pageSize,
                            filtered.length
                        );
                        updateNotifications();
                        return;
                    }

                    // 2) Nothing hidden -> fetch the next 15 from the server.
                    if (!hasMoreOnServer) return;

                    isLoadingMore = true;
                    updateNotifications();

                    try {
                        const existingIds = new Set(
                            getItems().map(function (row) { return row.dataset.id; })
                        );

                        const take = getItems().length + pageSize;

                        const response = await fetch(
                            loadMoreWrap.dataset.url + "?take=" + take,
                            {
                                method: "GET",
                                credentials: "same-origin",
                                cache: "no-store",
                                headers: { "X-Requested-With": "XMLHttpRequest" }
                            }
                        );

                        if (!response.ok) {
                            throw new Error("Unable to load more notifications.");
                        }

                        const doc = new DOMParser().parseFromString(
                            await response.text(),
                            "text/html"
                        );

                        const anchor =
                            document.getElementById("notificationFilterEmpty");

                        let added = 0;

                        doc.querySelectorAll(".notif-item").forEach(function (row) {
                            if (existingIds.has(row.dataset.id)) return;

                            anchor.parentNode.insertBefore(
                                document.importNode(row, true),
                                anchor
                            );
                            added++;
                        });

                        const newWrap =
                            doc.getElementById("notificationsLoadMoreWrap");

                        hasMoreOnServer =
                            added > 0 &&
                            !!newWrap &&
                            newWrap.dataset.hasMore === "true";

                        // Show everything that has been loaded so far.
                        visibleCount = Math.max(
                            visibleCount,
                            getFilteredItems().length
                        );
                    } catch (error) {
                        console.error(error);

                        if (window.Swal) {
                            Swal.fire(
                                "Error",
                                "Could not load more notifications. Please try again.",
                                "error"
                            );
                        }
                    } finally {
                        isLoadingMore = false;
                        updateNotifications();
                    }
                });
            }

            updateNotifications();
        });
    </script>


    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('form[onsubmit="return false;"]').forEach(function (form) {
                form.addEventListener('submit', async function (event) {
                    event.preventDefault();
                    const message = this.querySelector('button')?.innerText?.toLowerCase().includes('clear')
                        ? 'Read notifications ko notification list se remove karna hai?'
                        : 'Remove this notification from the list?';
                    const result = await Swal.fire({
                        icon: 'question',
                        title: 'Are you sure?',
                        text: message,
                        showCancelButton: true,
                        confirmButtonText: 'Yes',
                        cancelButtonText: 'Cancel',
                        confirmButtonColor: '#d97600',
                        cancelButtonColor: '#adb5bd',
                        reverseButtons: true,
                        width: '360px'
                    });
                    if (result.isConfirmed) this.submit();
                });
            });
        });
    </script>
</body>
</html>
