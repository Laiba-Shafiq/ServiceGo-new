    <script id="servicego-unified-ui-script">
        (function () {
            function ready(fn) {
                if (document.readyState !== "loading") fn();
                else document.addEventListener("DOMContentLoaded", fn);
            }

            ready(function () {

                /* 1. Highlight the current page in the sidebar and open its group */
                try {
                    var path = location.pathname.replace(/\/+$/, "").toLowerCase();
                    document.querySelectorAll(".sidebar ul li a[href]").forEach(function (a) {
                        var href = (a.getAttribute("href") || "").replace(/\/+$/, "").toLowerCase();
                        if (href && href === path) {
                            a.classList.add("sg-current");
                            var group = a.closest(".dropdown-item");
                            if (group) group.classList.add("open");
                        }
                    });
                } catch (e) { }

                /* 2. Give every table cell a label (needed for the phone card layout) */
                try {
                    document.querySelectorAll("table").forEach(function (table) {
                        var heads = table.querySelectorAll("thead th");
                        if (!heads.length) return;
                        table.querySelectorAll("tbody tr").forEach(function (row) {
                            Array.prototype.forEach.call(row.children, function (cell, i) {
                                if (cell.tagName === "TD" &&
                                    !cell.hasAttribute("data-label") &&
                                    !cell.hasAttribute("colspan") &&
                                    heads[i]) {
                                    cell.setAttribute("data-label", heads[i].textContent.trim());
                                }
                            });
                        });
                    });
                } catch (e) { }

                /* 3. Lock the page behind an open popup */
                try {
                    var SEL = ".modal, .complaint-details-overlay";
                    var syncLock = function () {
                        var open = Array.prototype.some.call(document.querySelectorAll(SEL), function (el) {
                            var cs = getComputedStyle(el);
                            return cs.display !== "none" && cs.visibility !== "hidden" && cs.opacity !== "0";
                        });
                        document.documentElement.classList.toggle("sg-modal-open", open);
                    };
                    new MutationObserver(function (list) {
                        for (var i = 0; i < list.length; i++) {
                            if (list[i].target.matches && list[i].target.matches(SEL)) { syncLock(); return; }
                        }
                    }).observe(document.body, { subtree: true, attributes: true, attributeFilter: ["style", "class"] });
                    syncLock();
                } catch (e) { }

                /* 4. Swipe left on the menu to close it (uses the page's own close button) */
                try {
                    var sidebar = document.querySelector(".sidebar");
                    var closeBtn = document.getElementById("sidebarCloseBtn");
                    var sx = null, sy = null;
                    if (sidebar && closeBtn) {
                        sidebar.addEventListener("touchstart", function (e) {
                            sx = e.touches[0].clientX; sy = e.touches[0].clientY;
                        }, { passive: true });
                        sidebar.addEventListener("touchend", function (e) {
                            if (sx === null) return;
                            var t = e.changedTouches[0];
                            var dx = t.clientX - sx, dy = Math.abs(t.clientY - sy);
                            sx = null;
                            if (dx < -70 && dy < 50 && getComputedStyle(closeBtn).display !== "none") closeBtn.click();
                        }, { passive: true });
                    }
                } catch (e) { }
            });
        })();
    </script>

    <div id="receiptViewer" class="rv" aria-hidden="true">
        <div class="rv-bar">
            <span class="rv-level" id="rvLevel">100%</span>
            <button type="button" class="rv-btn" id="rvOut" aria-label="Zoom out">&minus;</button>
            <button type="button" class="rv-btn" id="rvIn" aria-label="Zoom in">+</button>
            <button type="button" class="rv-btn" id="rvReset" aria-label="Reset" style="font-size:14px;">Reset</button>
            <button type="button" class="rv-btn" id="rvClose" aria-label="Close">&times;</button>
        </div>
        <div class="rv-stage" id="rvStage"><img id="rvImg" src="" alt="Receipt" draggable="false" /></div>
        <div class="rv-help">Scroll / pinch / + - to zoom &bull; drag to move &bull; double-click to zoom &bull; Esc to close</div>
    </div>
    <script id="sg-receipt-viewer-js">
        (function () {
            var viewer = document.getElementById("receiptViewer");
            var stage = document.getElementById("rvStage");
            var img = document.getElementById("rvImg");
            var level = document.getElementById("rvLevel");
            var MIN = 1, MAX = 8;
            var scale = 1, tx = 0, ty = 0;
            var pointers = {}, startDist = 0, startScale = 1, lastX = 0, lastY = 0, moved = false;

            function apply() {
                img.style.transform = "translate(" + tx + "px," + ty + "px) scale(" + scale + ")";
                level.textContent = Math.round(scale * 100) + "%";
            }
            function clampPan() {
                if (scale <= 1) { tx = 0; ty = 0; return; }
                var w = img.clientWidth * scale, h = img.clientHeight * scale;
                var maxX = Math.max(0, (w - window.innerWidth) / 2 + 60);
                var maxY = Math.max(0, (h - window.innerHeight) / 2 + 60);
                tx = Math.max(-maxX, Math.min(maxX, tx));
                ty = Math.max(-maxY, Math.min(maxY, ty));
            }
            function setScale(ns, cx, cy) {
                ns = Math.max(MIN, Math.min(MAX, ns));
                if (cx !== undefined) {
                    // keep the point under the cursor fixed
                    var r = stage.getBoundingClientRect();
                    var ox = cx - (r.left + r.width / 2), oy = cy - (r.top + r.height / 2);
                    tx = ox - (ox - tx) * (ns / scale);
                    ty = oy - (oy - ty) * (ns / scale);
                }
                scale = ns; clampPan(); apply();
            }
            function reset() { scale = 1; tx = 0; ty = 0; apply(); }

            window.openReceiptFull = function () {
                var src = document.getElementById("receiptImg").getAttribute("src");
                if (!src) return;
                img.src = src; reset();
                viewer.classList.add("show");
                viewer.setAttribute("aria-hidden", "false");
            };
            window.closeReceiptFull = function () {
                viewer.classList.remove("show");
                viewer.setAttribute("aria-hidden", "true");
                img.removeAttribute("src");
            };

            document.getElementById("receiptImg").addEventListener("click", window.openReceiptFull);
            document.getElementById("rvClose").addEventListener("click", window.closeReceiptFull);
            document.getElementById("rvIn").addEventListener("click", function () { setScale(scale * 1.5); });
            document.getElementById("rvOut").addEventListener("click", function () { setScale(scale / 1.5); });
            document.getElementById("rvReset").addEventListener("click", reset);

            document.addEventListener("keydown", function (e) {
                if (!viewer.classList.contains("show")) return;
                if (e.key === "Escape") window.closeReceiptFull();
                else if (e.key === "+" || e.key === "=") setScale(scale * 1.5);
                else if (e.key === "-") setScale(scale / 1.5);
            });

            // mouse wheel / trackpad
            stage.addEventListener("wheel", function (e) {
                e.preventDefault();
                setScale(scale * (e.deltaY < 0 ? 1.2 : 1 / 1.2), e.clientX, e.clientY);
            }, { passive: false });

            // double click / double tap
            stage.addEventListener("dblclick", function (e) {
                if (scale > 1.05) reset(); else setScale(2.5, e.clientX, e.clientY);
            });

            // drag + pinch (mouse, touch, pen)
            stage.addEventListener("pointerdown", function (e) {
                stage.setPointerCapture(e.pointerId);
                pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
                moved = false;
                var ids = Object.keys(pointers);
                if (ids.length === 2) {
                    var a = pointers[ids[0]], b = pointers[ids[1]];
                    startDist = Math.hypot(a.x - b.x, a.y - b.y); startScale = scale;
                } else { lastX = e.clientX; lastY = e.clientY; stage.classList.add("dragging"); }
            });
            stage.addEventListener("pointermove", function (e) {
                if (!pointers[e.pointerId]) return;
                pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
                var ids = Object.keys(pointers);
                if (ids.length === 2) {
                    var a = pointers[ids[0]], b = pointers[ids[1]];
                    var d = Math.hypot(a.x - b.x, a.y - b.y);
                    if (startDist) setScale(startScale * d / startDist, (a.x + b.x) / 2, (a.y + b.y) / 2);
                    moved = true;
                } else if (ids.length === 1 && scale > 1) {
                    tx += e.clientX - lastX; ty += e.clientY - lastY;
                    lastX = e.clientX; lastY = e.clientY;
                    clampPan(); apply(); moved = true;
                }
            });
            function endPointer(e) {
                delete pointers[e.pointerId];
                stage.classList.remove("dragging");
                var ids = Object.keys(pointers);
                if (ids.length === 1) { lastX = pointers[ids[0]].x; lastY = pointers[ids[0]].y; }
                startDist = 0;
            }
            stage.addEventListener("pointerup", endPointer);
            stage.addEventListener("pointercancel", endPointer);

            // click on the dark area (not the image) closes when not zoomed
            stage.addEventListener("click", function (e) {
                if (e.target === stage && !moved && scale <= 1) window.closeReceiptFull();
            });
        })();
    </script>
</body>
</html>