    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /* Dropdown toggle logic */

            const dropdownToggles =
                document.querySelectorAll(".dropdown-toggle");

            dropdownToggles.forEach(toggle => {

                toggle.addEventListener("click", function (e) {

                    const parentLi =
                        this.parentElement;

                    document
                        .querySelectorAll(".dropdown-item")
                        .forEach(item => {

                            if (item !== parentLi) {
                                item.classList.remove("open");
                            }

                        });

                    parentLi.classList.toggle("open");

                });

            });


            /* Mobile sidebar toggle */

            const menuToggle =
                document.getElementById("menuToggle");

            const sidebar =
                document.getElementById("sidebar");

            const sidebarOverlay =
                document.getElementById("sidebarOverlay");

            const sidebarCloseBtn =
                document.getElementById("sidebarCloseBtn");


            function openSidebar() {

                sidebar.classList.add("active");
                sidebarOverlay.classList.add("active");

            }


            function closeSidebar() {

                sidebar.classList.remove("active");
                sidebarOverlay.classList.remove("active");

            }


            function toggleSidebar() {

                if (sidebar.classList.contains("active")) {

                    closeSidebar();

                }
                else {

                    openSidebar();

                }

            }


            /* Hamburger */

            menuToggle.addEventListener("click", function () {

                toggleSidebar();

            });


            /* Cross */

            sidebarCloseBtn.addEventListener("click", function () {

                closeSidebar();

            });


            /* Overlay */

            sidebarOverlay.addEventListener("click", function () {

                closeSidebar();

            });


            /* Esc key */

            document.addEventListener("keydown", function (event) {

                if (event.key === "Escape") {

                    closeSidebar();

                }

            });

        });

    </script>


    <script id="servicego-admin-load-more">
        document.addEventListener("DOMContentLoaded", function () {
            const PAGE_SIZE = 15;
            const tables = Array.from(document.querySelectorAll("table tbody"));

            tables.forEach(function (tbody) {
                const rows = Array.from(tbody.children).filter(function (el) {
                    return el.tagName && el.tagName.toLowerCase() === "tr";
                });

                if (rows.length <= PAGE_SIZE) return;

                let visible = PAGE_SIZE;
                rows.forEach(function (row, index) {
                    if (index >= visible) row.style.display = "none";
                });

                const button = document.createElement("button");
                button.type = "button";
                button.className = "btn btn-outline-warning servicego-load-more";
                button.textContent = "Load More";
                button.style.cssText = "display:block;margin:18px auto 5px;min-width:130px;";

                const wrapper = tbody.closest("table");
                if (wrapper && wrapper.parentNode) {
                    wrapper.parentNode.insertBefore(button, wrapper.nextSibling);
                } else {
                    tbody.parentNode.appendChild(button);
                }

                button.addEventListener("click", function () {
                    const next = Math.min(visible + PAGE_SIZE, rows.length);
                    for (let i = visible; i < next; i++) rows[i].style.display = "";
                    visible = next;
                    if (visible >= rows.length) button.remove();
                });
            });
        });
    </script>

    <div id="servicegoLogoutModal" class="servicego-logout-modal" aria-hidden="true">
        <div class="servicego-logout-box" role="dialog" aria-modal="true" aria-labelledby="servicegoLogoutTitle">
            <h3 id="servicegoLogoutTitle">Logout</h3>
            <p>Are you sure you want to logout?</p>
            <div class="servicego-logout-actions">
                <button type="button" class="servicego-logout-cancel" id="servicegoLogoutCancel">Cancel</button>
                <button type="button" class="servicego-logout-confirm" id="servicegoLogoutConfirm">Yes, Logout</button>
            </div>
        </div>
    </div>


    <script id="servicego-admin-logout-script">
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".logout a").forEach(function (link) {
                link.addEventListener("click", async function (event) {
                    event.preventDefault();

                    const result = await Swal.fire({
                        title: "Logout?",
                        text: "Are you sure you want to logout?",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonText: "Yes, Logout",
                        cancelButtonText: "Cancel",
                        reverseButtons: true,
                        confirmButtonColor: "#d97600",
                        cancelButtonColor: "#6c757d"
                    });

                    if (result.isConfirmed) {
                        window.location.href = link.getAttribute("href");
                    }
                });
            });
        });
    </script>
    <script id="servicego-unified-ui-script">
        (function () {
            function ready(fn) {
                if (document.readyState !== "loading") fn();
                else document.addEventListener("DOMContentLoaded", fn);
            }

            ready(function () {

                /* 1. Highlight the current page in the sidebar and open its group */
                try {
                    var path = location.pathname.replace(/\/+$/, "").toLowerCase();
                    document.querySelectorAll(".sidebar ul li a[href]").forEach(function (a) {
                        var href = (a.getAttribute("href") || "").replace(/\/+$/, "").toLowerCase();
                        if (href && href === path) {
                            a.classList.add("sg-current");
                            var group = a.closest(".dropdown-item");
                            if (group) group.classList.add("open");
                        }
                    });
                } catch (e) { }

                /* 2. Give every table cell a label (needed for the phone card layout) */
                try {
                    document.querySelectorAll("table").forEach(function (table) {
                        var heads = table.querySelectorAll("thead th");
                        if (!heads.length) return;
                        table.querySelectorAll("tbody tr").forEach(function (row) {
                            Array.prototype.forEach.call(row.children, function (cell, i) {
                                if (cell.tagName === "TD" &&
                                    !cell.hasAttribute("data-label") &&
                                    !cell.hasAttribute("colspan") &&
                                    heads[i]) {
                                    cell.setAttribute("data-label", heads[i].textContent.trim());
                                }
                            });
                        });
                    });
                } catch (e) { }

                /* 3. Lock the page behind an open popup */
                try {
                    var SEL = ".modal, .complaint-details-overlay";
                    var syncLock = function () {
                        var open = Array.prototype.some.call(document.querySelectorAll(SEL), function (el) {
                            var cs = getComputedStyle(el);
                            return cs.display !== "none" && cs.visibility !== "hidden" && cs.opacity !== "0";
                        });
                        document.documentElement.classList.toggle("sg-modal-open", open);
                    };
                    new MutationObserver(function (list) {
                        for (var i = 0; i < list.length; i++) {
                            if (list[i].target.matches && list[i].target.matches(SEL)) { syncLock(); return; }
                        }
                    }).observe(document.body, { subtree: true, attributes: true, attributeFilter: ["style", "class"] });
                    syncLock();
                } catch (e) { }

                /* 4. Swipe left on the menu to close it (uses the page's own close button) */
                try {
                    var sidebar = document.querySelector(".sidebar");
                    var closeBtn = document.getElementById("sidebarCloseBtn");
                    var sx = null, sy = null;
                    if (sidebar && closeBtn) {
                        sidebar.addEventListener("touchstart", function (e) {
                            sx = e.touches[0].clientX; sy = e.touches[0].clientY;
                        }, { passive: true });
                        sidebar.addEventListener("touchend", function (e) {
                            if (sx === null) return;
                            var t = e.changedTouches[0];
                            var dx = t.clientX - sx, dy = Math.abs(t.clientY - sy);
                            sx = null;
                            if (dx < -70 && dy < 50 && getComputedStyle(closeBtn).display !== "none") closeBtn.click();
                        }, { passive: true });
                    }
                } catch (e) { }
            });
        })();
    </script>

</body>
