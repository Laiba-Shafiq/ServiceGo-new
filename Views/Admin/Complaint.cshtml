                    }
                    /* action cell = one full-width button */
                    .table-container tbody td[data-label="Actions"],
                    .table-container tbody td[data-label="Action"],
                    .table-container tbody td:has(.btn-view) {
                        display: block !important;
                        padding: 12px 0 8px !important;
                    }

                        .table-container tbody td[data-label="Actions"]::before,
                        .table-container tbody td[data-label="Action"]::before,
                        .table-container tbody td:has(.btn-view)::before {
                            display: none !important;
                        }

                    .table-container tbody td .btn-view {
                        width: 100% !important;
                        max-width: 100% !important;
                        justify-content: center;
                        padding: 11px 14px !important;
                        font-size: 13px !important;
                        border-radius: 12px !important;
                    }
                    /* empty row */
                    .table-container tbody td[colspan] {
                        display: block !important;
                        text-align: center !important;
                        padding: 26px 10px !important;
                    }

                        .table-container tbody td[colspan]::before {
                            display: none !important;
                        }

                .table-container .badge,
                .badge {
                    font-size: 11px !important;
                    padding: 5px 10px !important;
                    border-radius: 999px;
                }

            button.servicego-load-more {
                width: 100%;
                max-width: none;
            }
            /* complaints page: same card feel, readable sizes */
            #complaintsTable tbody td,
            #warningsTable tbody td {
                font-size: 12.5px !important;
            }

                #complaintsTable tbody td::before {
                    font-size: 11px !important;
                    font-weight: 600 !important;
                    text-transform: none !important;
                    letter-spacing: 0 !important;
                    color: var(--sg-muted) !important;
                    flex: 0 0 auto !important;
                }

            #warningsTable,
            #warningsTable tbody {
                display: block;
                width: 100%;
            }

                #warningsTable thead {
                    display: none;
                }

                #warningsTable tbody tr {
                    display: block;
                    background: #fff;
                    border: 1px solid var(--sg-line);
                    border-radius: 16px;
                    margin: 0 0 12px;
                    padding: 8px 12px;
                    box-shadow: 0 5px 16px rgba(16,24,40,.06);
                }

                #warningsTable tbody td {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 10px;
                    padding: 10px 4px;
                    border: 0;
                    border-bottom: 1px solid #f1f4f8;
                    text-align: right;
                }

                    #warningsTable tbody td:last-child {
                        border-bottom: 0;
                    }

                    #warningsTable tbody td::before {
                        content: attr(data-label);
                        color: var(--sg-muted);
                        font-size: 11px;
                        font-weight: 600;
                        flex: 0 0 auto;
                    }

                    #warningsTable tbody td:first-child::before {
                        display: none;
                    }

            .filter-btn {
                font-size: 12px !important;
            }
            /* popups become bottom sheets */
            .modal {
                align-items: flex-end !important;
                padding: 0 !important;
            }

            .modal-content {
                width: 100% !important;
                max-width: 100% !important;
                max-height: 92vh !important;
                border-radius: 24px 24px 0 0 !important;
                padding: 22px var(--sg-pad) var(--sg-pad) !important;
                animation: sgSheet .3s cubic-bezier(.2,.8,.2,1);
            }

                .modal-content::before {
                    content: "";
                    display: block;
                    width: 42px;
                    height: 4px;
                    border-radius: 4px;
                    background: #d0d5dd;
                    margin: -10px auto 16px;
                }

            .modal-close-x,
            .close-modal {
                top: 12px !important;
                right: 12px !important;
            }

            .pop-footer-buttons,
            .modal-actions {
                margin-top: 22px !important;
            }

                .pop-btn-block,
                .pop-btn-close,
                .pop-btn-approve,
                .pop-btn-reject,
                .modal-actions .btn {
                    flex: 1 1 0 !important;
                    max-width: none !important;
                    min-width: 0;
                    width: auto;
                }

            .modal-content .info-grid {
                grid-template-columns: repeat(2, 1fr) !important;
            }
        }

        @@media (max-width: 576px) {
            .modal-content .info-grid {
                grid-template-columns: 1fr !important;
            }
            /* SweetAlert2 also slides up from the bottom on phones */
            .swal2-container {
                padding: 0 !important;
            }

                .swal2-container.swal2-center > .swal2-popup {
                    grid-column: 1 / -1 !important;
                    place-self: end stretch !important;
                    width: 100% !important;
                    max-width: 100% !important;
                    margin: 0 !important;
                    border-radius: 24px 24px 0 0 !important;
                    padding-bottom: calc(20px + env(safe-area-inset-bottom)) !important;
                }
        }
    </style>

</head>

<body>

    <!-- Mobile header -->

    <div class="mobile-header">

        <button type="button"
                class="menu-toggle-btn"
                id="menuToggle">

            <i class="fa-solid fa-bars"></i>

        </button>

        <div class="mobile-brand">
            ServicesGo
        </div>

        <div style="width:22px"></div>

    </div>


    <!-- Sidebar overlay -->

    <div class="sidebar-overlay"
         id="sidebarOverlay">
    </div>


    <!-- Sidebar -->

    <aside class="sidebar"
           id="sidebar">

        <button type="button"
                class="sidebar-close-btn"
                id="sidebarCloseBtn"
                aria-label="Close Menu">

            <i class="fa-solid fa-xmark"></i>

        </button>


        <div>

            <div class="brand">

                <span class="servicego-home-logo">
                    <img src="/images/Logo.png"
                         alt="ServicesGo Logo" />
                </span>

                <span class="servicego-home-logo servicego-home-text" style="color:inherit;">
                    ServicesGo
                </span>

            </div>


            <ul>

                <li>

                    <a href="/Admin/Dashboard">

                        <span class="toggle-left">

                            <i class="fa-solid fa-house"></i>

                            <span>
                                Dashboard
                            </span>

                        </span>

                        <span></span>

                    </a>

                </li>


                <li class="dropdown-item">

                    <div class="dropdown-toggle">

                        <span class="toggle-left">

                            <i class="fa-solid fa-users"></i>

                            <span>
                                Customers
                            </span>

                        </span>

                        <i class="fa-solid fa-chevron-down arrow-icon"></i>

                    </div>


                    <ul class="submenu">

                        <li>
                            <a href="/Admin/ActiveCustomers">
                                Active
                            </a>
                        </li>

                        <li>
                            <a href="/Admin/BlockedCustomers">
                                Blocked
                            </a>
                        </li>

                    </ul>

                </li>


                <li class="dropdown-item">

                    <div class="dropdown-toggle">

                        <span class="toggle-left">

                            <i class="fa-solid fa-user-gear"></i>

                            <span>
                                Service Providers
                            </span>

                        </span>

                        <i class="fa-solid fa-chevron-down arrow-icon"></i>

                    </div>


                    <ul class="submenu">

                        <li>
                            <a href="/Admin/ActiveProviders">
                                Active
                            </a>
                        </li>

                        <li>
                            <a href="/Admin/PendingProviders">
                                Pending
                            </a>
                        </li>

                        <li>
                            <a href="/Admin/BlockedProviders">
                                Blocked
                            </a>
                        </li>

                    </ul>

                </li>


                <li class="active">

                    <a href="/Admin/Complaint">

                        <span class="toggle-left">

                            <i class="fa-solid fa-triangle-exclamation"></i>

                            <span>
                                Complaints
                            </span>

                        </span>

                        <span></span>

                    </a>

                </li>


                <li>

                    <a href="/Admin/WalletRequests">

                        <span class="toggle-left">

                            <i class="fa-solid fa-wallet"></i>

                            <span>
                                Wallet Requests
                            </span>

                        </span>

                        <span></span>

                    </a>

                </li>
            </ul>

        </div>


        <div class="logout">
            <a href="/Admin/Logout">

                <i class="fa-solid fa-right-from-bracket"></i>
                <span>Logout</span>
            </a>

        </div>

    </aside>


    <!-- Main content -->

    <main class="main-content">

        <div id="alertBox"
             class="alert alert-danger d-none alert-dismissible fade show rounded-4 shadow-sm"
             role="alert">

            <i class="fa-solid fa-circle-exclamation me-2"></i>

            <span id="alertMessage"></span>

            <button type="button"
                    class="btn-close"
                    onclick="hideAlert()">
            </button>

        </div>


        <div class="page-header">

            <div>

                <h1>
                    Complaints Management
                </h1>

                <p>
                    Review and manage customer &amp; provider complaints
                </p>

            </div>


            <div class="search-box">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input type="text"
                       id="searchInput"
                       placeholder="Search complaint or user..."
                       autocomplete="off" />

            </div>

        </div>


        <!-- All complaints -->

        <div class="filter-card">

            <div class="filter-list" id="complaintTabs">

                <button type="button"
                        class="filter-btn active"
                        id="allComplaintsTab">

                    <i class="fa-solid fa-layer-group me-1"></i>

                    All Complaints

                    <span class="tab-count" id="allComplaintsCount">0</span>

                </button>

                <button type="button"
                        class="filter-btn"
                        id="warningsTab">

                    <i class="fa-solid fa-triangle-exclamation me-1"></i>

                    Warnings Sent

                    <span class="tab-count" id="warningsCount">0</span>

                </button>

            </div>

        </div>


        <!-- Complaint table -->

        <div class="complaint-card">

            <div class="table-responsive">

                <table class="table table-hover align-middle"
                       id="complaintsTable">

                    <thead>

                        <tr>

                            <th class="ps-4">Complaint</th>

                            <th>Reported User</th>

                            <th>Issue</th>

                            <th>Date</th>

                            <th class="text-end pe-4">Action</th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                var targetName =
                                string.IsNullOrWhiteSpace(item.TargetUserName)
                                ? (item.ComplaintType == "Customer vs Provider"
                                ? item.ProviderName
                                : item.CustomerName)
                                : item.TargetUserName;

                                var targetId =
                                string.IsNullOrWhiteSpace(item.TargetUserId)
                                ? (item.ComplaintType == "Customer vs Provider"
                                ? item.ProviderId
                                : item.CustomerId)
                                : item.TargetUserId;

                                var targetRole =
                                string.IsNullOrWhiteSpace(item.TargetRole)
                                ? (item.ComplaintType == "Customer vs Provider"
                                ? "Provider"
                                : "Customer")
                                : item.TargetRole;

                                var safeName =
                                string.IsNullOrWhiteSpace(targetName)
                                ? "User"
                                : targetName;

                                <tr id="row-@item.Id"
                                    data-search="@($"{item.ComplaintId} {safeName} {targetId} {item.IssueCategory} {item.ComplaintType}")">

                                    <!-- Complaint -->

                                    <td class="ps-4"
                                        data-label="Complaint">

                                        <div class="complaint-id">
                                            #@item.ComplaintId
                                        </div>

                                        <div class="complaint-type">

                                            @(item.ComplaintType == "Customer vs Provider"
                                                                                ? "Customer → Provider"
                                                                                : "Provider → Customer")

                                        </div>

                                    </td>


                                    <!-- User -->

                                    <td data-label="User">

                                        <div class="user-mini">

                                            <div class="user-avatar">

                                                @(string.IsNullOrWhiteSpace(safeName)
                                                                                        ? "U"
                                                                                        : safeName.Substring(0, 1).ToUpper())

                                            </div>


                                            <div>

                                                <div class="fw-semibold text-dark"
                                                     style="font-size:13px">

                                                    @safeName

                                                </div>


                                                <div class="small text-muted">

                                                    <span class="role-pill">
                                                        @targetRole
                                                    </span>

                                                    <span class="ms-1">
                                                        @targetId
                                                    </span>

                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Issue -->

                                    <td data-label="Issue">

                                        <span class="issue-pill">

                                            @(string.IsNullOrWhiteSpace(item.IssueCategory) ||
                                                                                item.IssueCategory.Equals("General", StringComparison.OrdinalIgnoreCase)
                                                                                ? (string.IsNullOrWhiteSpace(item.OtherIssue) ? "Reported Issue" : item.OtherIssue)
                                                                                : item.IssueCategory)

                                </span>

                                    </td>


                                    <!-- Date -->

                                    <td class="small text-muted"
                                        data-label="Date">

                                        @item.CreatedAt.ToString("dd MMM yyyy")

                                    </td>


                                    <!-- Details -->

                                    <td class="text-end pe-4"
                                        data-label="Action">

                                        <button type="button"
                                                class="btn btn-details"
                                                data-id="@item.Id"
                                                data-complaint-id="@item.ComplaintId"
                                                data-type="@item.ComplaintType"
                                                data-role="@targetRole"
                                                data-target-id="@targetId"
                                                data-target-name="@safeName"
                                                data-issue="@(string.IsNullOrWhiteSpace(item.IssueCategory) || item.IssueCategory.Equals("General", StringComparison.OrdinalIgnoreCase) ? (string.IsNullOrWhiteSpace(item.OtherIssue) ? "Reported Issue" : item.OtherIssue) : item.IssueCategory)"
                                                data-details="@item.ComplaintDetails"
                                                data-prev-complaints="@item.PreviousComplaintsCount"
                                                data-prev-warnings="@item.PreviousWarningsCount"
                                                data-total-warnings="@(item.PreviousWarningsCount + (item.WarningSent ? 1 : 0))"
                                                data-prev-blocks="@item.PreviousBlockedCount"
                                                data-current-warning="@item.WarningSent.ToString().ToLowerInvariant()"
                                                data-target-blocked="@item.TargetIsBlocked.ToString().ToLowerInvariant()">

                                            <i class="fa-solid fa-circle-info me-1"></i>

                                            Details

                                        </button>

                                    </td>

                                </tr>
                                                }
                        }

                    </tbody>

                </table>

            </div>


            <div id="emptyState"
                 class="empty-state d-none">

                <div class="empty-icon">

                    <i class="fa-solid fa-inbox"></i>

                </div>

                <h5 class="mt-3 fw-bold">
                    No complaints found
                </h5>

                <p class="text-muted small">
                    Search by complaint ID, user, issue, or complaint type.
                </p>

            </div>

        </div>

        <!-- Warnings sent -->

        <div class="complaint-card d-none" id="warningsView">

            <div class="table-responsive">

                <table class="table table-hover align-middle"
                       id="warningsTable">

                    <thead>
                        <tr>
                            <th class="ps-4">Complaint</th>
                            <th>Reported User</th>
                            <th>Issue</th>
                            <th>Date</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            var warningComplaints =
                            ViewBag.WarningComplaints as IEnumerable<ServiceGo.Models.ComplaintModel>;
                        }

                        @if (warningComplaints != null)
                        {
                            foreach (var item in warningComplaints)
                            {
                                var warningTargetName =
                                string.IsNullOrWhiteSpace(item.TargetUserName)
                                ? (item.ComplaintType == "Customer vs Provider"
                                ? item.ProviderName
                                : item.CustomerName)
                                : item.TargetUserName;

                                var warningTargetId =
                                string.IsNullOrWhiteSpace(item.TargetUserId)
                                ? (item.ComplaintType == "Customer vs Provider"
                                ? item.ProviderId
                                : item.CustomerId)
                                : item.TargetUserId;

                                var warningTargetRole =
                                string.IsNullOrWhiteSpace(item.TargetRole)
                                ? (item.ComplaintType == "Customer vs Provider"
                                ? "Provider"
                                : "Customer")
                                : item.TargetRole;

                                var warningSafeName =
                                string.IsNullOrWhiteSpace(warningTargetName)
                                ? "User"
                                : warningTargetName;

                                <tr data-search="@($"{item.ComplaintId} {warningSafeName} {warningTargetId} {item.IssueCategory} {item.ComplaintType}")">

                                    <td class="ps-4">
                                        <div class="complaint-id">
                                            #@item.ComplaintId
                                        </div>

                                        <div class="complaint-type">
                                            @(item.ComplaintType == "Customer vs Provider"
                                                                                ? "Customer → Provider"
                                                                                : "Provider → Customer")
                                                                                                    </div>
                                                                                                </td>

                                    <td>
                                        <div class="user-mini">
                                            <div class="user-avatar">
                                                @(string.IsNullOrWhiteSpace(warningSafeName)
                                                                                        ? "U"
                                                                                        : warningSafeName.Substring(0, 1).ToUpper())
                                                                                                                                </div>

                                            <div>
                                                <div class="fw-semibold text-dark"
                                                     style="font-size:13px">
                                                    @warningSafeName
                                                </div>

                                                <div class="small text-muted">
                                                    <span class="role-pill">
                                                        @warningTargetRole
                                                    </span>

                                                    <span class="ms-1">
                                                        @warningTargetId
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="issue-pill">
                                            @(string.IsNullOrWhiteSpace(item.IssueCategory) ||
                                                                                item.IssueCategory.Equals("General", StringComparison.OrdinalIgnoreCase)
                                                                                ? (string.IsNullOrWhiteSpace(item.OtherIssue) ? "Reported Issue" : item.OtherIssue)
                                                                                : item.IssueCategory)
                                </span>
                            </td>

                                    <td class="small text-muted">
                                        @item.CreatedAt.ToString("dd MMM yyyy")
                                    </td>

                                </tr>
                                                }
                        }

                    </tbody>

                </table>

            </div>

            <div id="warningsEmptyState"
                 class="empty-state d-none">

                <div class="empty-icon">
                    <i class="fa-solid fa-inbox"></i>
                </div>

                <h5 class="mt-3 fw-bold">
                    No warnings found
                </h5>

                <p class="small mb-0">
                    No warning records match your search.
                </p>

            </div>

        </div>


    </main>


    <!-- Custom details popup -->

    <div id="complaintDetailsOverlay"
         class="complaint-details-overlay"
         aria-hidden="true">

        <div class="complaint-details-popup"
             role="dialog"
             aria-modal="true"
             aria-labelledby="modalPopupTitle">

            <div class="popup-header">

                <div>

                    <div class="popup-eyebrow">
                        COMPLAINT DETAILS
                    </div>

                    <h3 id="modalPopupTitle">
                        Review Complaint
                    </h3>

                </div>


                <button type="button"
                        class="popup-close"
                        id="closeComplaintPopup"
                        aria-label="Close">

                    <i class="fa-solid fa-xmark"></i>

                </button>

            </div>


            <div class="popup-body">

                <input type="hidden"
                       id="modalDbId" />

                <input type="hidden"
                       id="modalComplaintId" />

                <input type="hidden"
                       id="modalComplaintType" />

                <input type="hidden"
                       id="modalTargetUserId" />


                <div class="popup-user-card">

                    <div class="popup-avatar"
                         id="modalAvatar">
                        U
                    </div>


                    <div class="popup-user-info">

                        <div class="popup-user-name-row">

                            <h4 id="modalTargetNameText">
                                User
                            </h4>

                            <span class="popup-role"
                                  id="modalTargetRole">
                                User
                            </span>

                        </div>


                        <div class="popup-user-id">

                            <i class="fa-regular fa-id-card"></i>

                            User ID:

                            <strong id="modalTargetIdText">
                                -
                            </strong>

                        </div>

                    </div>
                </div>


                <div class="popup-section">

                    <div class="popup-section-title">

                        <i class="fa-solid fa-circle-info"></i>

                        Complaint Information

                    </div>


                    <div class="popup-info-grid">

                        <div class="popup-info-card">

                            <span>
                                Complaint ID
                            </span>

                            <strong id="modalComplaintIdText">
                                -
                            </strong>

                        </div>


                        <div class="popup-info-card">

                            <span>
                                Complaint Type
                            </span>

                            <strong id="modalComplaintTypeText">
                                -
                            </strong>

                        </div>


                        <div class="popup-info-card">

                            <span>
                                Issue Category
                            </span>

                            <strong id="modalIssueCategoryText">
                                -
                            </strong>

                        </div>

                    </div>

                </div>


                <div class="popup-section">

                    <div class="popup-section-title">

                        <i class="fa-solid fa-clock-rotate-left"></i>

                        User History

                    </div>


                    <div class="popup-history-grid">

                        <div class="popup-history-card complaints-history">

                            <div class="popup-history-icon">
                                <i class="fa-solid fa-file-circle-exclamation"></i>
                            </div>

                            <div class="popup-history-number" id="histComplaints">0</div>

                            <div class="popup-history-label">Previous Complaints</div>

                        </div>


                        <div class="popup-history-card warnings-history">

                            <div class="popup-history-icon">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </div>

                            <div class="popup-history-number" id="histWarnings">0</div>

                            <div class="popup-history-label">Previous Warnings</div>

                        </div>


                        <div class="popup-history-card blocks-history">

                            <div class="popup-history-icon">
                                <i class="fa-solid fa-ban"></i>
                            </div>

                            <div class="popup-history-number" id="histBlocks">0</div>

                            <div class="popup-history-label">Previous Blocks</div>

                        </div>

                    </div>

                </div>


                <div class="popup-section">

                    <div class="popup-section-title">

                        <i class="fa-solid fa-align-left"></i>

                        Complaint Details

                    </div>


                    <div class="popup-details-box"
                         id="modalDetailsText">

                        No details provided.

                    </div>

                </div>

            </div>


            <div class="popup-footer">

                <button type="button"
                        class="popup-close-btn"
                        id="popupCloseBottom">

                    Close

                </button>


                <div class="popup-actions">
                    <button type="button"
                            class="popup-action warning-action"
                            id="warningBtn">

                        <i class="fa-solid fa-triangle-exclamation"></i>

                        Send Warning

                    </button>


                    <button type="button"
                            class="popup-action block-action"
                            id="blockBtn">

                        <i class="fa-solid fa-ban"></i>

                        Block User

                    </button>

                </div>

            </div>

        </div>

    </div>


    <!-- Javascript -->

    <script>

        const $ = function (id) {
            return document.getElementById(id);
        };


        /* Alert */

        function showAlert(message) {

            $("alertMessage").innerText =
                message || "Something went wrong.";

            $("alertBox").classList.remove("d-none");

            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });
        }


        function hideAlert() {

            $("alertBox").classList.add("d-none");

        }


        /* Open details popup */

        function openDetailsModal(button) {

            if (!button) {
                return;
            }

            hideAlert();

            const d = button.dataset;

            const dbId =
                d.id || "";

            const complaintId =
                d.complaintId || "";

            const complaintType =
                d.type || "";

            const targetRole =
                d.role || "User";

            const targetUserId =
                d.targetId || "";

            const targetUserName =
                d.targetName || "User";

            const issue =
                (d.issue || "").trim();

            const exactIssue =
                (!issue || issue.toLowerCase() === "general")
                    ? "Reported Issue"
                    : issue;

            const details =
                d.details || "No details provided.";

            $("modalDbId").value =
                dbId;

            $("modalComplaintId").value =
                complaintId;

            $("modalComplaintType").value =
                complaintType;

            $("modalTargetUserId").value =
                targetUserId;


            $("modalTargetNameText").innerText =
                targetUserName;

            $("modalTargetRole").innerText =
                targetRole;

            $("modalTargetIdText").innerText =
                targetUserId || "-";


            const cleanName =
                (targetUserName || "").trim();


            $("modalAvatar").innerText =
                cleanName.length > 0
                    ? cleanName.charAt(0).toUpperCase()
                    : "U";


            $("modalComplaintIdText").innerText =
                complaintId
                    ? "#" + complaintId
                    : "-";


            $("modalComplaintTypeText").innerText =
                complaintType || "-";


            $("modalIssueCategoryText").innerText =
                exactIssue;


            $("modalDetailsText").innerText =
                details || "No details provided.";


            const previousComplaints =
                Number.parseInt(
                    d.prevComplaints || "0",
                    10
                ) || 0;


            const previousWarnings =
                Number.parseInt(
                    d.prevWarnings || "0",
                    10
                ) || 0;


            const previousBlocks =
                Number.parseInt(
                    d.prevBlocks || "0",
                    10
                ) || 0;


            $("histComplaints").innerText =
                String(previousComplaints);

            $("histWarnings").innerText =
                String(previousWarnings);

            $("histBlocks").innerText =
                String(previousBlocks);


            $("warningBtn").dataset.complaintId = dbId;

            $("blockBtn").dataset.complaintId = dbId;


            const overlay =
                $("complaintDetailsOverlay");


            if (!overlay) {
                return;
            }


            overlay.classList.add("open");


            overlay.setAttribute(
                "aria-hidden",
                "false"
            );


            document.body.style.overflow =
                "hidden";


            setTimeout(function () {

                if ($("closeComplaintPopup")) {

                    $("closeComplaintPopup").focus();

                }

            }, 50);
        }


        /* Close popup */

        function closeComplaintPopup() {

            const overlay =
                $("complaintDetailsOverlay");


            if (!overlay) {
                return;
            }


            overlay.classList.remove("open");

            overlay.setAttribute(
                "aria-hidden",
                "true"
            );


            document.body.style.overflow =
                "";
        }


        /*
         * Details button
         * Safe event delegation
         */

        document.addEventListener(
            "click",
            function (event) {

                const detailsButton =
                    event.target.closest(".btn-details");


                if (detailsButton) {

                    event.preventDefault();

                    event.stopPropagation();

                    openDetailsModal(
                        detailsButton
                    );

                    return;
                }

            }
        );


        /* X close */

        $("closeComplaintPopup")
            .addEventListener(
                "click",
                function (event) {

                    event.preventDefault();

                    event.stopPropagation();

                    closeComplaintPopup();

                }
            );


        /* Bottom close */

        $("popupCloseBottom")
            .addEventListener(
                "click",
                function (event) {

                    event.preventDefault();

                    event.stopPropagation();

                    closeComplaintPopup();

                }
            );


        /* Click outside popup */

        $("complaintDetailsOverlay")
            .addEventListener(
                "click",
                function (event) {

                    if (
                        event.target ===
                        event.currentTarget
                    ) {

                        closeComplaintPopup();

                    }

                }
            );


        /* Esc close popup */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    $("complaintDetailsOverlay")
                        .classList.contains("open")
                ) {

                    closeComplaintPopup();

                }

            }
        );


        /* Post JSON */

        async function postJson(
            url,
            payload
        ) {

            const response =
                await fetch(
                    url,
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json",

                            "Accept":
                                "application/json"
                        },

                        body:
                            JSON.stringify(
                                payload
                            )
                    }
                );


            let data;


            try {

                data =
                    await response.json();

            }
            catch {

                data = {
                    success: false,
                    message:
                        "Invalid server response."
                };

            }


            if (
                !response.ok ||
                !data.success
            ) {

                throw new Error(
                    data.message ||
                    "Request failed."
                );

            }


            return data;
        }


        /* Payload */

        function getPayload() {

            const dbId =
                Number.parseInt(
                    $("modalDbId").value,
                    10
                );


            return {

                id:
                    Number.isFinite(dbId)
                        ? dbId
                        : 0,

                complaintId:
                    $("modalComplaintId")
                        .value || ""

            };
        }


        /* Send warning */

        $("warningBtn").addEventListener(
            "click",
            async function () {
                const payload = getPayload();

                if (!payload.id && !payload.complaintId) {
                    showAlert("Invalid complaint ID.");
                    return;
                }

                const confirmResult = await Swal.fire({
                    title: "Send Official Warning?",
                    text: "Are you sure you want to send an official warning to this user?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Yes, Send Warning",
                    cancelButtonText: "Cancel",
                    reverseButtons: true,
                    confirmButtonColor: "#d97600",
                    cancelButtonColor: "#6c757d"
                });

                if (!confirmResult.isConfirmed) {
                    return;
                }

                try {
                    const data = await postJson(
                        "/Admin/SendWarning",
                        payload
                    );

                    closeComplaintPopup();

                    window.location.href =
                        data.nextPage || "/Admin/Complaint?view=warnings";
                }
                catch (error) {
                    showAlert(
                        error.message ||
                        "Warning could not be sent."
                    );
                }
            }
        );


        /* Block user */

        $("blockBtn").addEventListener(
            "click",
            async function () {
                const payload = getPayload();

                if (!payload.id && !payload.complaintId) {
                    showAlert("Invalid complaint ID.");
                    return;
                }

                const confirmResult = await Swal.fire({
                    title: "Block User?",
                    text: "Are you sure you want to block this user?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonText: "Yes, Block",
                    cancelButtonText: "Cancel",
                    reverseButtons: true,
                    confirmButtonColor: "#d97600",
                    cancelButtonColor: "#6c757d"
                });

                if (!confirmResult.isConfirmed) {
                    return;
                }

                try {
                    const data = await postJson(
                        "/Admin/BlockComplaintUser",
                        payload
                    );

                    closeComplaintPopup();

                    if (data.nextPage) {
                        window.location.href = data.nextPage;
                    }
                    else if (
                        String(data.blockedUserType || "").toLowerCase() === "provider"
                    ) {
                        window.location.href = "/Admin/BlockedProviders";
                    }
                    else {
                        window.location.href = "/Admin/BlockedCustomers";
                    }
                }
                catch (error) {
                    showAlert(
                        error.message ||
                        "User could not be blocked."
                    );
                }
            }
        );


        /* Search + tabs */

        let currentView = "all";

        function applySearch() {

            const search =
                ($("searchInput").value || "")
                    .trim()
                    .toLowerCase();

            const activeTableId =
                currentView === "warnings"
                    ? "#warningsTable tbody tr"
                    : "#complaintsTable tbody tr";

            const rows =
                document.querySelectorAll(activeTableId);

            let visible = 0;

            rows.forEach(function (row) {

                const text =
                    (row.dataset.search || "")
                        .toLowerCase();

                const show =
                    !search ||
                    text.includes(search);

                row.style.display =
                    show ? "" : "none";

                if (show) {
                    visible++;
                }

            });

            const emptyId =
                currentView === "warnings"
                    ? "warningsEmptyState"
                    : "emptyState";

            const empty =
                $(emptyId);

            if (empty) {
                empty.classList.toggle(
                    "d-none",
                    visible !== 0
                );
            }

            const count =
                currentView === "warnings"
                    ? $("warningsCount")
                    : $("allComplaintsCount");

            if (count) {
                count.innerText =
                    String(visible);
            }
        }


        function switchComplaintView(view) {

            currentView = view;

            const complaintsView =
                document.querySelector(
                    "#complaintsTable"
                )?.closest(".complaint-card");

            const warningsView =
                $("warningsView");

            const allTab =
                $("allComplaintsTab");

            const warningTab =
                $("warningsTab");

            if (view === "warnings") {

                complaintsView?.classList.add("d-none");
                warningsView?.classList.remove("d-none");

                allTab?.classList.remove("active");
                warningTab?.classList.add("active");

            }
            else {

                complaintsView?.classList.remove("d-none");
                warningsView?.classList.add("d-none");

                allTab?.classList.add("active");
                warningTab?.classList.remove("active");

            }

            applySearch();
        }


        $("allComplaintsTab")?.addEventListener(
            "click",
            function () {
                switchComplaintView("all");
            }
        );


        $("warningsTab")?.addEventListener(
            "click",
            function () {
                switchComplaintView("warnings");
            }
        );


        $("searchInput")
            .addEventListener(
                "input",
                applySearch
            );


        const warningRows =
            document.querySelectorAll(
                "#warningsTable tbody tr"
            );

        const warningCount =
            $("warningsCount");

        if (warningCount) {
            warningCount.innerText =
                String(warningRows.length);
        }

        const initialView =
            new URLSearchParams(
                window.location.search
            ).get("view");

        switchComplaintView(
            initialView === "warnings"
                ? "warnings"
                : "all"
        );


        /* Sidebar */

        document
            .querySelectorAll(
                ".dropdown-toggle"
            )
            .forEach(
                function (toggle) {

                    toggle.addEventListener(
                        "click",
                        function () {

                            const parent =
                                this.closest(
                                    ".dropdown-item"
                                );


                            document
                                .querySelectorAll(
                                    ".dropdown-item"
                                )
                                .forEach(
                                    function (item) {

                                        if (
                                            item !==
                                            parent
                                        ) {

                                            item.classList.remove(
                                                "open"
                                            );

                                        }

                                    }
                                );


                            parent.classList.toggle(
                                "open"
                            );

                        }
                    );

                }
            );


        const menuToggle =
            $("menuToggle");


        const sidebar =
            $("sidebar");


        const sidebarOverlay =
            $("sidebarOverlay");


        const sidebarCloseBtn =
            $("sidebarCloseBtn");


        /* Sidebar functions */

        function openSidebar() {

            sidebar.classList.add(
                "active"
            );

            sidebarOverlay.classList.add(
                "active"
            );

        }


        function closeSidebar() {

            sidebar.classList.remove(
                "active"
            );

            sidebarOverlay.classList.remove(
                "active"
            );

        }


        function toggleSidebar() {

            if (
                sidebar.classList.contains(
                    "active"
                )
            ) {

                closeSidebar();

            }
            else {

                openSidebar();

            }

        }


        /* Hamburger */

        menuToggle.addEventListener(
            "click",
            function () {

                toggleSidebar();

            }
        );


        /* Sidebar Cross */

        sidebarCloseBtn.addEventListener(
            "click",
            function () {

                closeSidebar();

            }
        );


        /* Overlay */

        sidebarOverlay.addEventListener(
            "click",
            function () {

                closeSidebar();

            }
        );


        /* Sidebar Links */

        document
            .querySelectorAll(
                ".sidebar a"
            )
            .forEach(
                function (link) {

                    link.addEventListener(
                        "click",
                        function () {

                            if (
                                window.innerWidth <=
                                992
                            ) {

                                closeSidebar();

                            }

                        }
                    );

                }
            );


        /* ESC closes sidebar */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    !(
                        $("complaintDetailsOverlay")
                            .classList.contains("open")
                    )
                ) {

                    closeSidebar();

                }

            }
        );


        /* Initial load */

        applySearch();

    </script>


    <script id="servicego-admin-load-more">
        document.addEventListener("DOMContentLoaded", function () {
            const PAGE_SIZE = 15;
            const tables = Array.from(document.querySelectorAll("table tbody"));

            tables.forEach(function (tbody) {
                const rows = Array.from(tbody.children).filter(function (el) {
                    return el.tagName && el.tagName.toLowerCase() === "tr";
                });

                if (rows.length <= PAGE_SIZE) return;

                let visible = PAGE_SIZE;
                rows.forEach(function (row, index) {
                    if (index >= visible) row.style.display = "none";
                });

                const button = document.createElement("button");
                button.type = "button";
                button.className = "btn btn-outline-warning servicego-load-more";
                button.textContent = "Load More";
                button.style.cssText = "display:block;margin:18px auto 5px;min-width:130px;";

                const wrapper = tbody.closest("table");
                if (wrapper && wrapper.parentNode) {
                    wrapper.parentNode.insertBefore(button, wrapper.nextSibling);
                } else {
                    tbody.parentNode.appendChild(button);
                }

                button.addEventListener("click", function () {
                    const next = Math.min(visible + PAGE_SIZE, rows.length);
                    for (let i = visible; i < next; i++) rows[i].style.display = "";
                    visible = next;
                    if (visible >= rows.length) button.remove();
                });
            });
        });
    </script>

    <div id="servicegoLogoutModal" class="servicego-logout-modal" aria-hidden="true">
        <div class="servicego-logout-box" role="dialog" aria-modal="true" aria-labelledby="servicegoLogoutTitle">
            <h3 id="servicegoLogoutTitle">Logout</h3>
            <p>Are you sure you want to logout?</p>
            <div class="servicego-logout-actions">
                <button type="button" class="servicego-logout-cancel" id="servicegoLogoutCancel">Cancel</button>
                <button type="button" class="servicego-logout-confirm" id="servicegoLogoutConfirm">Yes, Logout</button>
            </div>
        </div>
    </div>


    <script id="servicego-admin-logout-script">
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".logout a").forEach(function (link) {
                link.addEventListener("click", async function (event) {
                    event.preventDefault();

                    const result = await Swal.fire({
                        title: "Logout?",
                        text: "Are you sure you want to logout?",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonText: "Yes, Logout",
                        cancelButtonText: "Cancel",
                        reverseButtons: true,
                        confirmButtonColor: "#d97600",
                        cancelButtonColor: "#6c757d"
                    });

                    if (result.isConfirmed) {
                        window.location.href = link.getAttribute("href");
                    }
                });
            });
        });
    </script>

    <script id="servicego-unified-ui-script">
        (function () {
            function ready(fn) {
                if (document.readyState !== "loading") fn();
                else document.addEventListener("DOMContentLoaded", fn);
            }

            ready(function () {

                /* 1. Highlight the current page in the sidebar and open its group */
                try {
                    var path = location.pathname.replace(/\/+$/, "").toLowerCase();
                    document.querySelectorAll(".sidebar ul li a[href]").forEach(function (a) {
                        var href = (a.getAttribute("href") || "").replace(/\/+$/, "").toLowerCase();
                        if (href && href === path) {
                            a.classList.add("sg-current");
                            var group = a.closest(".dropdown-item");
                            if (group) group.classList.add("open");
                        }
                    });
                } catch (e) { }

                /* 2. Give every table cell a label (needed for the phone card layout) */
                try {
                    document.querySelectorAll("table").forEach(function (table) {
                        var heads = table.querySelectorAll("thead th");
                        if (!heads.length) return;
                        table.querySelectorAll("tbody tr").forEach(function (row) {
                            Array.prototype.forEach.call(row.children, function (cell, i) {
                                if (cell.tagName === "TD" &&
                                    !cell.hasAttribute("data-label") &&
                                    !cell.hasAttribute("colspan") &&
                                    heads[i]) {
                                    cell.setAttribute("data-label", heads[i].textContent.trim());
                                }
                            });
                        });
                    });
                } catch (e) { }

                /* 3. Lock the page behind an open popup */
                try {
                    var SEL = ".modal, .complaint-details-overlay";
                    var syncLock = function () {
                        var open = Array.prototype.some.call(document.querySelectorAll(SEL), function (el) {
                            var cs = getComputedStyle(el);
                            return cs.display !== "none" && cs.visibility !== "hidden" && cs.opacity !== "0";
                        });
                        document.documentElement.classList.toggle("sg-modal-open", open);
                    };
                    new MutationObserver(function (list) {
                        for (var i = 0; i < list.length; i++) {
                            if (list[i].target.matches && list[i].target.matches(SEL)) { syncLock(); return; }
                        }
                    }).observe(document.body, { subtree: true, attributes: true, attributeFilter: ["style", "class"] });
                    syncLock();
                } catch (e) { }

                /* 4. Swipe left on the menu to close it (uses the page's own close button) */
                try {
                    var sidebar = document.querySelector(".sidebar");
                    var closeBtn = document.getElementById("sidebarCloseBtn");
                    var sx = null, sy = null;
                    if (sidebar && closeBtn) {
                        sidebar.addEventListener("touchstart", function (e) {
                            sx = e.touches[0].clientX; sy = e.touches[0].clientY;
                        }, { passive: true });
                        sidebar.addEventListener("touchend", function (e) {
                            if (sx === null) return;
                            var t = e.changedTouches[0];
                            var dx = t.clientX - sx, dy = Math.abs(t.clientY - sy);
                            sx = null;
                            if (dx < -70 && dy < 50 && getComputedStyle(closeBtn).display !== "none") closeBtn.click();
                        }, { passive: true });
                    }
                } catch (e) { }
            });
        })();
    </script>

</body>
