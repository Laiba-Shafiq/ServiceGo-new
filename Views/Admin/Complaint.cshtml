@model IEnumerable<ServiceGo.Models.ComplaintModel>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ServicesGo - Complaints Management</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link rel="icon"
          href="@Url.Content("~/images/Logo.png")"
          type="image/x-icon" />
    <style>
        * {
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
            color: #222;
        }

        body {
            background: #f5f7fb;
            overflow-x: hidden;
        }

        /* Mobile header */

        .mobile-header {
            display: none;
            height: 60px;
            background: linear-gradient(135deg, #ffb45e, #ff7f36);
            position: fixed;
            inset: 0 0 auto;
            z-index: 1500;
            padding: 0 20px;
            align-items: center;
            justify-content: space-between;
            color: #fff;
            box-shadow: 0 2px 10px rgba(0,0,0,.12);
        }

        .menu-toggle-btn {
            background: transparent;
            border: 0;
            color: #fff;
            font-size: 22px;
            cursor: pointer;
        }

        .mobile-brand {
            font-size: 18px;
            font-weight: 700;
        }

        /* Sidebar */

        .sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: linear-gradient(180deg, #ffb45e, #ff7f36);
            color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 25px 0;
            z-index: 2000;
            transition: transform .3s ease;
            overflow-y: auto;
        }

        .sidebar-close-btn {
            display: none;
            position: absolute;
            top: 14px;
            right: 12px;
            width: 34px;
            height: 34px;
            border: none;
            border-radius: 50%;
            background: rgba(255,255,255,.18);
            color: #fff;
            font-size: 17px;
            cursor: pointer;
            align-items: center;
            justify-content: center;
            z-index: 10;
            transition: all .2s ease;
        }

            .sidebar-close-btn:hover {
                background: rgba(255,255,255,.30);
                transform: scale(1.05);
            }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 25px;
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 25px;
        }

            .brand img {
                width: 36px;
                height: 36px;
                object-fit: contain;
                border-radius: 4px;
            }

        .sidebar ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar li {
            width: 100%;
        }

            .sidebar li a,
            .sidebar .dropdown-toggle {
                display: flex !important;
                align-items: center;
                justify-content: space-between;
                width: 100%;
                padding: 14px 25px;
                color: #fff;
                text-decoration: none;
                font-size: 15px;
                opacity: .9;
                cursor: pointer;
                transition: .2s ease;
            }

                .sidebar li a:hover,
                .sidebar .dropdown-toggle:hover {
                    background: rgba(255,255,255,.15);
                    opacity: 1;
                }

            .sidebar li.active > a {
                background: rgba(255,255,255,.20);
                opacity: 1;
                font-weight: 600;
                border-left: 4px solid #fff;
                padding-left: 21px;
            }

        .toggle-left {
            display: flex;
            align-items: center;
        }

        .sidebar i {
            width: 20px;
            margin-right: 12px;
            text-align: center;
        }

        .arrow-icon {
            font-size: 12px;
            transition: .3s ease;
        }

        .dropdown-item.open .arrow-icon {
            transform: rotate(180deg);
        }

        .submenu {
            list-style: none;
            background: rgba(0,0,0,.08);
            max-height: 0;
            overflow: hidden;
            transition: max-height .3s ease;
            padding: 0;
        }

        .dropdown-item.open .submenu {
            max-height: 180px;
        }

        .submenu li a {
            display: block !important;
            padding: 10px 25px 10px 57px !important;
            font-size: 14px;
            opacity: .85;
        }

        .logout {
            padding-top: 20px;
            border-top: 1px solid rgba(255,255,255,.2);
        }

            .logout a {
                display: flex;
                align-items: center;
                padding: 0 25px;
                color: #fff;
                text-decoration: none;
                font-size: 15px;
            }

            .logout i {
                width: 20px;
                margin-right: 12px;
            }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.4);
            z-index: 1900;
        }

        /* Main content */

        .main-content {
            margin-left: 260px;
            padding: 40px;
            width: calc(100% - 260px);
            min-height: 100vh;
        }

        .page-header {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 25px;
        }

            .page-header h1 {
                font-size: 28px;
                font-weight: 600;
                margin: 0;
            }

            .page-header p {
                color: #666;
                margin: 5px 0 0;
                font-size: 14px;
            }

        /* Search */

        .search-box {
            width: 300px;
            position: relative;
        }

            .search-box i {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                color: #98a2b3;
                z-index: 2;
            }

            .search-box input {
                width: 100%;
                height: 44px;
                border: 1px solid #e4e7ec;
                background: #fff;
                border-radius: 12px;
                padding: 0 15px 0 45px;
                outline: 0;
                font-size: 13px;
            }

                .search-box input:focus {
                    border-color: #ff9b4a;
                    box-shadow: 0 0 0 3px rgba(255,155,74,.12);
                }

        /* Filters */

        .filter-card {
            background: #fff;
            border: 1px solid #e9edf3;
            border-radius: 16px;
            padding: 8px;
            margin-bottom: 18px;
            display: inline-block;
            max-width: 100%;
        }

        .filter-list {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }

        .filter-btn {
            border: 0;
            background: transparent;
            color: #667085;
            border-radius: 999px;
            padding: 9px 15px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: .2s ease;
            white-space: nowrap;
        }

            .filter-btn:hover {
                background: #f3f5f8;
            }

            .filter-btn.active {
                background: #111827;
                color: #fff;
                box-shadow: 0 4px 12px rgba(0,0,0,.10);
            }

        .tab-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 22px;
            height: 21px;
            padding: 0 6px;
            margin-left: 4px;
            border-radius: 999px;
            background: #eef2f6;
            color: #667085;
            font-size: 10px;
            font-weight: 800;
        }

        .filter-btn.active .tab-count {
            background: rgba(255,255,255,.18);
            color: #fff;
        }

        /* Table */

        .complaint-card {
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 5px 20px rgba(16,24,40,.05);
            overflow: hidden;
        }

        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }

        #complaintsTable {
            width: 100%;
            min-width: 760px;
            margin: 0;
        }

            #complaintsTable thead th {
                background: #f8fafc;
                color: #667085;
                border-bottom: 1px solid #e9edf3;
                padding: 15px 12px;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .05em;
                white-space: nowrap;
            }

            #complaintsTable tbody td {
                padding: 16px 12px;
                border-bottom: 1px solid #f0f2f5;
                vertical-align: middle;
            }

            #complaintsTable tbody tr:hover {
                background: #fcfcfd;
            }

        .complaint-id {
            color: #111827;
            font-size: 14px;
            font-weight: 800;
        }

        .complaint-type {
            color: #98a2b3;
            font-size: 10px;
            margin-top: 3px;
        }

        .user-mini {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 190px;
        }

        .user-avatar {
            width: 38px;
            height: 38px;
            flex: 0 0 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #eef2f6;
            border: 1px solid #e1e5ea;
            color: #344054;
            font-size: 14px;
            font-weight: 800;
        }

        .role-pill {
            display: inline-flex;
            padding: 3px 8px;
            border-radius: 999px;
            background: #f2f4f7;
            color: #667085;
            font-size: 9px;
            font-weight: 700;
        }

        .warning-count-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-width: 52px;
            padding: 7px 12px;
            border-radius: 999px;
            background: #fff8e8;
            border: 1px solid #ffe2a8;
            color: #9a6700;
            font-size: 11px;
            font-weight: 800;
        }

        /* Status */

        .status-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 6px 11px;
            border-radius: 999px;
            border: 1px solid transparent;
            font-size: 10px;
            font-weight: 800;
            white-space: nowrap;
        }

        .status-pending {
            background: #fff7e6;
            color: #9a6700;
            border-color: #ffe0a3;
        }

        .status-warning {
            background: #eef8ff;
            color: #1769aa;
            border-color: #b9e1ff;
        }

        .status-resolved {
            background: #ecfdf3;
            color: #087443;
            border-color: #abefc6;
        }

        .status-blocked {
            background: #fff1f3;
            color: #b42318;
            border-color: #fecdca;
        }

        .status-default {
            background: #f2f4f7;
            color: #475467;
            border-color: #eaecf0;
        }

        /* Details button */

        .btn-details {
            border: 1px solid #d0d5dd;
            background: #fff;
            color: #344054;
            border-radius: 10px !important;
            padding: 8px 14px;
            font-size: 11px;
            font-weight: 700;
            transition: all .2s ease;
            cursor: pointer;
            white-space: nowrap;
        }

            .btn-details:hover {
                background: #fff8f1;
                border-color: #ff9b4a;
                color: #e87520;
                transform: translateY(-1px);
            }

            .btn-details:active {
                transform: translateY(0);
            }

        /* Empty state */

        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }

        .empty-icon {
            width: 60px;
            height: 60px;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #f2f4f7;
            color: #98a2b3;
            font-size: 22px;
        }

        /* Details popup */

        .complaint-details-overlay {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            padding: 20px;
            background: rgba(15, 23, 42, .68);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 999999;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity .20s ease, visibility .20s ease;
        }

            .complaint-details-overlay.open {
                opacity: 1;
                visibility: visible;
                pointer-events: auto;
            }

        .complaint-details-popup {
            position: relative;
            z-index: 1000000;
            width: min(900px, 100%);
            max-height: calc(100vh - 40px);
            display: flex;
            flex-direction: column;
            background: #fff;
            border-radius: 22px;
            overflow: hidden;
            box-shadow: 0 30px 90px rgba(0,0,0,.30), 0 10px 30px rgba(0,0,0,.12);
            transform: translateY(15px) scale(.97);
            transition: transform .22s ease;
        }

        .complaint-details-overlay.open .complaint-details-popup {
            transform: translateY(0) scale(1);
        }

        @@keyframes popupIn {
            from {
                opacity: 0;
                transform: translateY(18px) scale(.97);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        /* Popup header */

        .popup-header {
            flex: 0 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding: 20px 25px;
            background: #fff;
            border-bottom: 1px solid #eef0f3;
        }

        .popup-eyebrow {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .12em;
            color: #ff8a3d;
            margin-bottom: 4px;
        }

        .popup-header h3 {
            margin: 0;
            color: #1d2939;
            font-size: 20px;
            font-weight: 700;
        }

        .popup-close {
            width: 40px;
            height: 40px;
            flex: 0 0 40px;
            border: 0;
            border-radius: 50%;
            background: #f2f4f7;
            color: #667085;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all .2s ease;
        }

            .popup-close:hover {
                background: #fff1e6;
                color: #ef7d32;
                transform: rotate(5deg);
            }

        /* Popup body */

        .popup-body {
            flex: 1 1 auto;
            min-height: 0;
            padding: 22px 25px;
            overflow-y: auto;
            overflow-x: hidden;
            background: #fff;
        }

            .popup-body::-webkit-scrollbar {
                width: 7px;
            }

            .popup-body::-webkit-scrollbar-track {
                background: #f5f7fa;
            }

            .popup-body::-webkit-scrollbar-thumb {
                background: #d0d5dd;
                border-radius: 20px;
            }

                .popup-body::-webkit-scrollbar-thumb:hover {
                    background: #98a2b3;
                }

        /* User card */

        .popup-user-card {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px;
            border: 1px solid #eaecf0;
            border-radius: 18px;
            background: #fafbfc;
        }

        .popup-avatar {
            width: 55px;
            height: 55px;
            flex: 0 0 55px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eef2f6;
            border: 1px solid #dfe4ea;
            color: #344054;
            font-size: 18px;
            font-weight: 800;
        }

        .popup-user-info {
            min-width: 0;
            flex: 1;
        }

        .popup-user-name-row {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

            .popup-user-name-row h4 {
                margin: 0;
                color: #1d2939;
                font-size: 16px;
                font-weight: 700;
                word-break: break-word;
            }

        .popup-role {
            display: inline-flex;
            padding: 4px 9px;
            border-radius: 999px;
            background: #f2f4f7;
            color: #667085;
            font-size: 10px;
            font-weight: 700;
        }

        .popup-user-id {
            margin-top: 5px;
            color: #98a2b3;
            font-size: 11px;
        }

            .popup-user-id strong {
                color: #475467;
            }

        .popup-status {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 7px 12px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 800;
            white-space: nowrap;
        }

        /* Popup sections */

        .popup-section {
            margin-top: 20px;
        }

        .popup-section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 10px;
            color: #344054;
            font-size: 12px;
            font-weight: 800;
        }

            .popup-section-title i {
                color: #ff8a3d;
            }

        /* Info grid */

        .popup-info-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }

        .popup-info-card {
            min-width: 0;
            padding: 13px 14px;
            border: 1px solid #eaecf0;
            border-radius: 14px;
            background: #fff;
        }

            .popup-info-card span {
                display: block;
                margin-bottom: 5px;
                color: #98a2b3;
                font-size: 9px;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: .05em;
            }

            .popup-info-card strong {
                display: block;
                color: #344054;
                font-size: 12px;
                word-break: break-word;
                overflow-wrap: anywhere;
            }

        /* History */

        .popup-history-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }

        .popup-history-card {
            text-align: center;
            padding: 15px 10px;
            border-radius: 16px;
            border: 1px solid #eaecf0;
        }

        .complaints-history {
            background: #f5f8ff;
        }

        .warnings-history {
            background: #fffaf0;
        }

        .blocks-history {
            background: #fff5f5;
        }

        .popup-history-icon {
            font-size: 15px;
            margin-bottom: 7px;
            color: #667085;
        }

        .complaints-history .popup-history-icon {
            color: #667eea;
        }

        .warnings-history .popup-history-icon {
            color: #d89000;
        }

        .blocks-history .popup-history-icon {
            color: #d92d20;
        }

        .popup-history-number {
            color: #344054;
            font-size: 24px;
            line-height: 1;
            font-weight: 900;
        }

        .popup-history-label {
            margin-top: 6px;
            color: #667085;
            font-size: 10px;
            font-weight: 700;
        }

        /* Complaint details */

        .popup-details-box {
            min-height: 120px;
            max-height: 260px;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 15px;
            border: 1px solid #eaecf0;
            border-radius: 15px;
            background: #f8fafc;
            color: #475467;
            font-size: 13px;
            line-height: 1.7;
            white-space: pre-wrap;
            word-break: break-word;
            overflow-wrap: anywhere;
        }

            .popup-details-box::-webkit-scrollbar {
                width: 6px;
            }

            .popup-details-box::-webkit-scrollbar-track {
                background: #eef2f6;
            }

            .popup-details-box::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 20px;
            }

        /* Popup footer */

        .popup-footer {
            flex: 0 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 16px 25px;
            background: #fff;
            border-top: 1px solid #eef0f3;
        }

        .popup-close-btn {
            border: 1px solid #d0d5dd;
            background: #fff;
            color: #475467;
            border-radius: 10px;
            padding: 9px 17px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            transition: .2s ease;
        }

            .popup-close-btn:hover {
                background: #f8fafc;
                border-color: #98a2b3;
            }

        .popup-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
            flex-wrap: wrap;
        }

        .popup-action {
            border: 0;
            border-radius: 10px;
            padding: 9px 14px;
            font-size: 11px;
            font-weight: 800;
            cursor: pointer;
            color: #fff;
            transition: all .2s ease;
        }

            .popup-action:hover {
                transform: translateY(-1px);
            }

        .resolve-action {
            background: #12b76a;
        }

            .resolve-action:hover {
                background: #039855;
            }

        .warning-action {
            background: #f79009;
        }

            .warning-action:hover {
                background: #dc6803;
            }

        .block-action {
            background: #f04438;
        }

            .block-action:hover {
                background: #d92d20;
            }

        .popup-action.d-none {
            display: none !important;
        }

        /* Responsive table */

        @@media(max-width:992px) {

            .mobile-header {
                display: flex;
            }

            .sidebar {
                transform: translateX(-100%);
                box-shadow: 5px 0 20px rgba(0,0,0,.15);
            }

                .sidebar.active {
                    transform: translateX(0);
                }

            .sidebar-close-btn {
                display: flex;
            }

            .sidebar-overlay.active {
                display: block;
            }

            .main-content {
                margin-left: 0;
                width: 100%;
                padding: 85px 20px 30px;
            }

            .page-header h1 {
                font-size: 24px;
            }

            .search-box {
                width: 100%;
            }
        }

        /* Mobile - no horizontal scroll */

        @@media(max-width:700px) {

            body {
                overflow-x: hidden;
            }

            .main-content {
                padding: 76px 10px 25px;
            }

            .page-header {
                gap: 12px;
                margin-bottom: 15px;
            }

                .page-header h1 {
                    font-size: 20px;
                    line-height: 1.25;
                }

                .page-header p {
                    font-size: 10px;
                    line-height: 1.5;
                    margin-top: 4px;
                }

            .search-box {
                width: 100%;
            }

                .search-box input {
                    height: 42px;
                    font-size: 11px;
                    border-radius: 11px;
                }
            /* Filter card */

            .filter-card {
                display: block;
                width: 100%;
                padding: 6px;
                margin-bottom: 12px;
                border-radius: 14px;
            }

            .filter-list {
                width: 100%;
                overflow-x: auto;
                flex-wrap: nowrap;
                gap: 3px;
                scrollbar-width: none;
            }

