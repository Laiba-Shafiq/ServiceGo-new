    <!-- Rejection modal -->
    <div id="rejectionModal"
         class="modal"
         style="z-index:3000; display:none;">

        <div class="modal-content"
             style="max-width:400px; position:relative;">

            <i class="fa-solid fa-xmark"
               onclick="document.getElementById('rejectionModal').style.display='none'"
               style="position:absolute; top:15px; right:20px; font-size:24px; color:#94a3b8; cursor:pointer;">
            </i>


            <h3 style="margin-bottom:15px; margin-top:10px;">
                Reject Provider
            </h3>


            <p style="margin:10px 0;">
                Select reason for rejection:
            </p>


            <select id="reasonDropdown"
                    style="width:100%; padding:10px; border-radius:6px; margin-bottom:10px;">

                <option value="Documents are blurry/unclear">
                    Documents are blurry/unclear
                </option>

                <option value="Information does not match CNIC">
                    Information does not match CNIC
                </option>

                <option value="Profile photo is not professional">
                    Profile photo is not professional
                </option>

                <option value="Certificate is expired or invalid">
                    Certificate is expired or invalid
                </option>

                <option value="Other">
                    Other (Type below)
                </option>

            </select>


            <textarea id="customReason"
                      placeholder="Type specific details here..."
                      style="width:100%; padding:10px; height:80px; display:none; border:1px solid #ddd; border-radius:6px;">
            </textarea>


            <button onclick="submitRejection()"
                    style="background:#dc2626; color:white; border:none; padding:12px; width:100%; border-radius:6px; margin-top:15px; cursor:pointer; font-weight:600;">

                Confirm Rejection

            </button>

        </div>

    </div>


    <script>

        // 1. Global variables

        let currentProviderId = "";


        // 2. Page load

        document.addEventListener("DOMContentLoaded", function () {

            // Sidebar dropdowns

            const dropdownToggles =
                document.querySelectorAll(".dropdown-toggle");


            dropdownToggles.forEach(toggle => {

                toggle.addEventListener("click", function () {

                    const parent = this.parentElement;


                    document
                        .querySelectorAll(".dropdown-item")
                        .forEach(item => {

                            if (item !== parent) {

                                item.classList.remove("open");

                            }

                        });


                    parent.classList.toggle("open");

                });

            });


            // Fixed review buttons

            document
                .querySelectorAll(".btn-view")
                .forEach(function (button) {

                    button.addEventListener("click", function (event) {

                        event.preventDefault();
                        event.stopPropagation();


                        openDeepReviewModal(

                            this.dataset.providerId || "",

                            this.dataset.name || "",

                            this.dataset.fatherName || "",

                            this.dataset.cnic || "",

                            this.dataset.phone || "",

                            this.dataset.city || "",

                            this.dataset.localAddress || "",

                            this.dataset.permanentAddress || "",

                            this.dataset.selectedServices || "",

                            this.dataset.selectedServiceTypes || "",

                            this.dataset.cnicFront || "",

                            this.dataset.cnicBack || "",

                            this.dataset.profilePic || "",

                            this.dataset.certificate || "",

                            this.dataset.affidavit || "",

                            this.dataset.availableDays || "",

                            this.dataset.timeWindow || "",

                            this.dataset.video || "",

                            this.dataset.homeAddress || "",

                            this.dataset.homeLat || "",

                            this.dataset.homeLng || "",

                            this.dataset.shopAddress || "",

                            this.dataset.shopLat || "",

                            this.dataset.shopLng || ""

                        );

                    });

                });


            // Rejection dropdown

            const reasonDropdown =
                document.getElementById("reasonDropdown");


            if (reasonDropdown) {

                reasonDropdown.onchange = function () {

                    document.getElementById("customReason").style.display =
                        (this.value === "Other")
                            ? "block"
                            : "none";

                };

            }


            // Modal initial state

            const deepModal =
                document.getElementById("deepReviewModal");


            if (deepModal) {

                deepModal.style.display = "none";

            }


            // Sidebar buttons

            const menuToggleBtn =
                document.getElementById("menuToggleBtn");


            const sidebar =
                document.getElementById("sidebarMenu");


            const sidebarOverlay =
                document.getElementById("sidebarOverlay");


            const sidebarCloseBtn =
                document.getElementById("sidebarCloseBtn");


            if (menuToggleBtn) {

                menuToggleBtn.addEventListener("click", function () {

                    toggleMobileMenu();

                });

            }


            if (sidebarCloseBtn) {

                sidebarCloseBtn.addEventListener("click", function () {

                    closeMobileMenu();

                });

            }


            if (sidebarOverlay) {

                sidebarOverlay.addEventListener("click", function () {

                    closeMobileMenu();

                });

            }


            // Sidebar links click -> mobile par close

            document
                .querySelectorAll(".sidebar a")
                .forEach(function (link) {

                    link.addEventListener("click", function () {

                        if (window.innerWidth <= 768) {

                            closeMobileMenu();

                        }

                    });

                });


            // Close the sidebar with the ESC key

            document.addEventListener("keydown", function (event) {

                if (event.key === "Escape") {

                    closeMobileMenu();

                }

            });

        });


        // 3. Sidebar open / close

        function openMobileMenu() {

            const menu =
                document.getElementById("sidebarMenu");


            const overlay =
                document.getElementById("sidebarOverlay");


            if (menu) {

                menu.classList.add("active");

            }


            if (overlay) {

                overlay.classList.add("active");

            }

        }


        function closeMobileMenu() {

            const menu =
                document.getElementById("sidebarMenu");


            const overlay =
                document.getElementById("sidebarOverlay");


            if (menu) {

                menu.classList.remove("active");

            }


            if (overlay) {

                overlay.classList.remove("active");

            }

        }


        function toggleMobileMenu() {

            const menu =
                document.getElementById("sidebarMenu");


            if (
                menu &&
                menu.classList.contains("active")
            ) {

                closeMobileMenu();

            }
            else {

                openMobileMenu();

            }

        }


        // 4. Open deep review modal

        function openDeepReviewModal(

            id,

            name,

            fatherName,

            cnic,

            phone,

            city,

            localAddr,

            permAddr,

            skills,

            type,

            cnicFrontSrc,

            cnicBackSrc,

            profileSrc,

            certificateSrc,

            affidavitSrc,

            activeDays,

            timeWindow,

            videoSrc,

            homeAddress,

            hLat,

            hLng,

            shopAddress,

            sLat,

            sLng

        ) {

            currentProviderId =
                String(id || "").startsWith("PRO-")
                    ? String(id).replace("PRO-", "")
                    : String(id || "");


            // Modal content

            document.getElementById("valId").innerText =
                "PRO-" + currentProviderId;


            document.getElementById("valName").innerText =
                name || "N/A";


            document.getElementById("valFatherName").innerText =
                fatherName || "N/A";


            document.getElementById("valCnic").innerText =
                cnic || "N/A";


            document.getElementById("valPhone").innerText =
                phone || "N/A";


            document.getElementById("valCity").innerText =
                city || "N/A";


            document.getElementById("valLocalAddress").innerText =
                localAddr || "N/A";


            document.getElementById("valPermanentAddress").innerText =
                permAddr || "N/A";


            document.getElementById("valSkills").innerText =
                skills || "N/A";


            document.getElementById("valType").innerText =
                type || "N/A";


            document.getElementById("valTime").innerText =
                timeWindow || "N/A";


            // Images

            document.getElementById("imgCnicFront").src =
                cnicFrontSrc || "";


            document.getElementById("imgCnicBack").src =
                cnicBackSrc || "";


            document.getElementById("imgProfilePhoto").src =
                profileSrc || "";


            sgSetDoc("imgCertificate", certificateSrc);


            sgSetDoc("imgAffidavit", affidavitSrc);


            // Video

            const videoElement =
                document.getElementById("providerWorkVideo");


            if (videoElement) {

                videoElement.src =
                    videoSrc || "";


                videoElement.load();

            }


            // Location logic - google maps

            const homeSection =
                document.getElementById("homeLocBlock");


            const shopSection =
                document.getElementById("shopLocBlock");


            const homeAddressElement =
                document.getElementById("valHomeAddress");


            const shopAddressElement =
                document.getElementById("valShopAddress");


            const homeMapElement =
                document.getElementById("homeMap");


            const shopMapElement =
                document.getElementById("shopMap");


            // Clear previous maps first

            if (homeMapElement) {

                homeMapElement.innerHTML = "";

            }


            if (shopMapElement) {

                shopMapElement.innerHTML = "";

            }


            // Home location

            const hasHomeAddress =
                homeAddress &&
                String(homeAddress).trim() !== "";


            const hasHomeCoordinates =
                isValidCoordinate(hLat) &&
                isValidCoordinate(hLng);


            if (
                hasHomeAddress ||
                hasHomeCoordinates
            ) {

                homeSection.style.display =
                    "block";


                homeAddressElement.innerText =
                    hasHomeAddress
                        ? homeAddress
                        : "Location selected on map";


                if (hasHomeCoordinates) {

                    loadGoogleMap(

                        "homeMap",

                        hLat,

                        hLng,

                        "Provider Home Location"

                    );

                }
                else {

                    homeMapElement.innerHTML =
                        '<div style="height:100%; display:flex; align-items:center; justify-content:center; color:#64748b; background:#f8fafc; font-size:13px;">' +
                        'Google Map coordinates are not available.' +
                        '</div>';

                }

            }
            else {

                homeSection.style.display =
                    "none";

            }


            // Shop location

            const hasShopAddress =
                shopAddress &&
                String(shopAddress).trim() !== "";


            const hasShopCoordinates =
                isValidCoordinate(sLat) &&
                isValidCoordinate(sLng);


            if (
                hasShopAddress ||
                hasShopCoordinates
            ) {

                shopSection.style.display =
                    "block";


                shopAddressElement.innerText =
                    hasShopAddress
                        ? shopAddress
                        : "Location selected on map";


                if (hasShopCoordinates) {

                    loadGoogleMap(

                        "shopMap",

                        sLat,

                        sLng,

                        "Provider Shop Location"

                    );

                }
                else {

                    shopMapElement.innerHTML =
                        '<div style="height:100%; display:flex; align-items:center; justify-content:center; color:#64748b; background:#f8fafc; font-size:13px;">' +
                        'Google Map coordinates are not available.' +
                        '</div>';

                }

            }
            else {

                shopSection.style.display =
                    "none";

            }


            // Days logic

            const daysArray =
                activeDays
                    ? activeDays
                        .split(',')
                        .map(day => day.trim())
                        .filter(Boolean)
                    : [];


            const allDays =
                [
                    'Mon',
                    'Tue',
                    'Wed',
                    'Thu',
                    'Fri',
                    'Sat',
                    'Sun'
                ];


            allDays.forEach(day => {

                const element =
                    document.getElementById("day-" + day);


                if (element) {

                    if (daysArray.includes(day)) {

                        element.classList.add("active");

                    }
                    else {

                        element.classList.remove("active");

                    }

                }

            });


            // Display modal

            document.getElementById("deepReviewModal").style.display =
                "flex";

        }


        // 5. Google map helper

        function isValidCoordinate(value) {

            if (

                value === null ||
                value === undefined ||
                value === "" ||
                value === "null" ||
                value === "undefined"

            ) {

                return false;

            }


            const number =
                parseFloat(value);


            return Number.isFinite(number) &&
                   number !== 0;

        }


        function loadGoogleMap(

            elementId,

            lat,

            lng,

            title

        ) {

            const mapElement =
                document.getElementById(elementId);


            if (!mapElement) {

                return;

            }


            const latitude =
                parseFloat(lat);


            const longitude =
                parseFloat(lng);


            if (

                !Number.isFinite(latitude) ||
                !Number.isFinite(longitude)

            ) {

                return;

            }


            mapElement.innerHTML = "";


            const iframe =
                document.createElement("iframe");


            iframe.className =
                "map-iframe-mock";


            iframe.title =
                title || "Google Map";


            iframe.loading =
                "lazy";


            iframe.referrerPolicy =
                "no-referrer-when-downgrade";


            iframe.allowFullscreen =
                true;


            iframe.src =
                "https://www.google.com/maps?q=" +
                encodeURIComponent(
                    latitude + "," + longitude
                ) +
                "&z=15&output=embed";


            mapElement.appendChild(iframe);

        }


        // 6. Approve provider

        document.getElementById("btnApprove").onclick =
            async function(e) {

                e.stopPropagation();

                const result = await Swal.fire({
                    title: "Approve Provider?",
                    text: "Are you sure you want to approve this provider?",
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonText: "Yes, Approve",
                    cancelButtonText: "Cancel",
                    reverseButtons: true,
                    confirmButtonColor: "#16a34a",
                    cancelButtonColor: "#6c757d"
                });

                if (!result.isConfirmed) {
                    return;
                }

                try {
                    const response = await fetch(
                        '/Admin/ApproveProvider?id=' +
                        encodeURIComponent(currentProviderId),
                        {
                            method: 'POST',
                            headers: {
                                'Accept': 'application/json'
                            }
                        }
                    );

                    const data = await response.json();

                    if (!response.ok || !data.success) {
                        throw new Error(
                            data.message ||
                            "Provider could not be approved."
                        );
                    }

                    await Swal.fire({
                        icon: "success",
                        title: "Approved",
                        text: data.message || "Provider approved successfully.",
                        confirmButtonColor: "#d97600"
                    });

                    removeRowFromTable();
                    closeDeepReviewModal();

                } catch (error) {
                    await Swal.fire({
                        icon: "error",
                        title: "Unable to Approve",
                        text: error.message ||
                            "Provider could not be approved.",
                        confirmButtonColor: "#d97600"
                    });
                }
            };


        // 7. Reject button

        document.getElementById("btnReject").onclick =
            function(e) {

                e.stopPropagation();


                document.getElementById("rejectionModal").style.display =
                    "flex";

            };


        // 8. Submit rejection

        let isRejecting = false;

        async function submitRejection() {

            if (isRejecting) {
                return;
            }

            let reason =
                document.getElementById("reasonDropdown").value;

            if (reason === "Other") {
                reason =
                    document.getElementById("customReason").value.trim();
            }

            if (!reason) {
                await Swal.fire({
                    icon: "warning",
                    title: "Reason Required",
                    text: "Please provide a rejection reason.",
                    confirmButtonColor: "#d97600"
                });
                return;
            }

            isRejecting = true;

            try {
                const response = await fetch(
                    '/Admin/RejectProvider?id=' +
                    encodeURIComponent(currentProviderId) +
                    '&reason=' +
                    encodeURIComponent(reason),
                    {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json'
                        }
                    }
                );

                let data = null;

                try {
                    data = await response.json();
                } catch (parseError) {
                    throw new Error("Server did not return a valid response.");
                }

                if (!response.ok || !data.success) {
                    throw new Error(
                        data.message ||
                        "Provider could not be rejected."
                    );
                }

                // Success popup is shown on top of the reason popup.
                await Swal.fire({
                    icon: "success",
                    title: "Rejected",
                    text: data.message || "Provider rejected successfully.",
                    confirmButtonText: "OK",
                    confirmButtonColor: "#d97600",
                    allowOutsideClick: false
                });

                // After OK: remove from list and close both popups.
                removeRowFromTable();

                document.getElementById('rejectionModal').style.display = 'none';
                document.getElementById('customReason').value = '';
                document.getElementById('customReason').style.display = 'none';
                document.getElementById('reasonDropdown').selectedIndex = 0;

                closeDeepReviewModal();

            } catch (error) {
                await Swal.fire({
                    icon: "error",
                    title: "Unable to Reject",
                    text: error.message || "Provider could not be rejected.",
                    confirmButtonColor: "#d97600"
                });
            } finally {
                isRejecting = false;
            }
        }


        // 9. Remove provider row

        function removeRowFromTable() {

            const row =
                document.querySelector(
                    'table tbody tr[data-row-id="' + currentProviderId + '"]'
                );

            if (row) {
                row.remove();
            }

        }


        // 10. Close deep review modal

        function closeDeepReviewModal() {

            const video =
                document.getElementById(
                    "providerWorkVideo"
                );


            if (video) {

                video.pause();

                video.src = "";

                video.load();

            }


            const homeMap =
                document.getElementById("homeMap");


            const shopMap =
                document.getElementById("shopMap");


            if (homeMap) {

                homeMap.innerHTML = "";

            }


            if (shopMap) {

                shopMap.innerHTML = "";

            }


            const homeSection =
                document.getElementById("homeLocBlock");


            const shopSection =
                document.getElementById("shopLocBlock");


            if (homeSection) {

                homeSection.style.display =
                    "none";

            }


            if (shopSection) {

                shopSection.style.display =
                    "none";

            }


            document.getElementById(
                "deepReviewModal"
            ).style.display =
                "none";

        }


        // 11. Image zoom

        function zoomImage(element) {

            const img =
                element.getElementsByTagName("img")[0];


            if (!img || !img.src) {

                return;

            }


            document.getElementById(
                "lightboxTargetImg"
            ).src =
                img.src;


            document.getElementById(
                "imageLightbox"
            ).style.display =
                "flex";


            setTimeout(() => {

                document.getElementById(
                    "imageLightbox"
                ).classList.add("show");

            }, 10);

        }


        // 12. Close lightbox

        function closeLightbox() {

            document.getElementById(
                "imageLightbox"
            ).classList.remove("show");


            setTimeout(() => {

                document.getElementById(
                    "imageLightbox"
                ).style.display =
                    "none";

            }, 200);

        }


        // 13. Modal outside click

        window.onclick =
            function(event) {

                const modal =
                    document.getElementById(
                        "deepReviewModal"
                    );


                const rejModal =
                    document.getElementById(
                        "rejectionModal"
                    );


                if (event.target == modal) {

                    closeDeepReviewModal();

                }


                if (event.target == rejModal) {

                    rejModal.style.display =
                        "none";

                }

            };


        // 14. Search filter

        function filterProvidersTable() {

            let input =
                document.getElementById(
                    "providerSearchInput"
                );


            let filter =
                input.value.toLowerCase();


            let rows =
                document.querySelectorAll(
                    "table tbody tr"
                );


            rows.forEach(row => {

                row.style.display =
                    row.textContent
                        .toLowerCase()
                        .includes(filter)
                        ? ""
                        : "none";

            });

        }

    </script>


    <script id="servicego-admin-load-more">

        document.addEventListener("DOMContentLoaded", function () {

            const PAGE_SIZE = 15;


            const tables =
                Array.from(
                    document.querySelectorAll("table tbody")
                );


            tables.forEach(function (tbody) {

                const rows =
                    Array.from(tbody.children)
                        .filter(function (el) {

                            return el.tagName &&
                                   el.tagName.toLowerCase() === "tr";

                        });


                if (rows.length <= PAGE_SIZE) {

                    return;

                }


                let visible = PAGE_SIZE;


                rows.forEach(function (row, index) {

                    if (index >= visible) {

                        row.style.display = "none";

                    }

                });


                const button =
                    document.createElement("button");


                button.type =
                    "button";


                button.className =
                    "btn btn-outline-warning servicego-load-more";


                button.textContent =
                    "Load More";


                button.style.cssText =
                    "display:block;margin:18px auto 5px;min-width:130px;";


                const wrapper =
                    tbody.closest("table");


                if (

                    wrapper &&
                    wrapper.parentNode

                ) {

                    wrapper.parentNode.insertBefore(

                        button,

                        wrapper.nextSibling

                    );

                }
                else {

                    tbody.parentNode.appendChild(button);

                }


                button.addEventListener("click", function () {

                    const next =
                        Math.min(

                            visible + PAGE_SIZE,

                            rows.length

                        );


                    for (

                        let i = visible;

                        i < next;

                        i++

                    ) {

                        rows[i].style.display = "";

                    }


                    visible = next;


                    if (

                        visible >= rows.length

                    ) {

                        button.remove();

                    }

                });

            });

        });

    </script>


