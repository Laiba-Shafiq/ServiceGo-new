    <script>

        const hamMenu =
            document.getElementById("hamMenu");

        const sidebar =
            document.getElementById("sidebar");

        const sidebarOverlay =
            document.getElementById("sidebarOverlay");

        const sidebarCloseBtn =
            document.getElementById("sidebarCloseBtn");


        // Mobile sidebar

        hamMenu.addEventListener("click", () => {

            sidebar.classList.toggle("active");

            sidebarOverlay.classList.toggle("active");

        });


        sidebarCloseBtn.addEventListener("click", () => {

            sidebar.classList.remove("active");

            sidebarOverlay.classList.remove("active");

        });


        sidebarOverlay.addEventListener("click", () => {

            sidebar.classList.remove("active");

            sidebarOverlay.classList.remove("active");

        });


        document.addEventListener("DOMContentLoaded", function () {

            const dropdownToggles =
                document.querySelectorAll(".dropdown-toggle");


            dropdownToggles.forEach(toggle => {

                toggle.addEventListener("click", function () {

                    this.parentElement.classList.toggle("open");

                });

            });


            // Unblock

            const unblockBtn =
                document.getElementById("btnUnBlock");

            if (unblockBtn) {
                unblockBtn.onclick = async function () {
                    let id =
                        document.getElementById("valId")
                            .innerText
                            .trim();

                    while (id.toUpperCase().startsWith("PRO-")) {
                        id = id.substring(4).trim();
                    }

                    const result = await Swal.fire({
                        title: "Unblock Provider?",
                        text: "Are you sure you want to UNBLOCK this provider?",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonText: "Yes, Unblock",
                        cancelButtonText: "Cancel",
                        reverseButtons: true,
                        confirmButtonColor: "#10b981",
                        cancelButtonColor: "#6c757d"
                    });

                    if (!result.isConfirmed) return;

                    try {
                        const response = await fetch(
                            '/Admin/UnblockProvider?id=' +
                            encodeURIComponent(id),
                            { method: 'POST' }
                        );

                        if (!response.ok) {
                            throw new Error("Server error");
                        }

                        const data = await response.json();

                        if (data.success) {
                            await Swal.fire({
                                icon: "success",
                                title: "Unblocked",
                                text: "Provider has been unblocked.",
                                confirmButtonColor: "#d97600"
                            });

                            closeDeepReviewModal();
                            location.reload();
                        } else {
                            await Swal.fire({
                                icon: "error",
                                title: "Unable to Unblock",
                                text: data.message || "Something went wrong!",
                                confirmButtonColor: "#d97600"
                            });
                        }
                    } catch (error) {
                        await Swal.fire({
                            icon: "error",
                            title: "Something went wrong",
                            text: "Something went wrong while unblocking the provider.",
                            confirmButtonColor: "#d97600"
                        });
                    }
                };
            }


            const checkModalGrid = () => {

                const localWrap =
                    document.getElementById("localAddrWrapper");

                const permWrap =
                    document.getElementById("permAddrWrapper");

                const schedGrid =
                    document.getElementById("scheduleGrid");


                if (window.innerWidth <= 768) {

                    if (localWrap)
                        localWrap.style.gridColumn = "auto";

                    if (permWrap)
                        permWrap.style.gridColumn = "auto";

                    if (schedGrid)
                        schedGrid.style.gridTemplateColumns = "1fr";

                } else {

                    if (localWrap)
                        localWrap.style.gridColumn = "auto";

                    if (permWrap)
                        permWrap.style.gridColumn = "span 2";

                    if (schedGrid)
                        schedGrid.style.gridTemplateColumns =
                            "2fr 1fr";

                }

            };


            window.addEventListener(
                'resize',
                checkModalGrid
            );


            checkModalGrid();

        });


        // Open deep review modal

        function openDeepReviewModal(
            id,
            name,
            fatherName,
            cnic,
            phone,
            city,
            localAddr,
            permAddr,
            skills,
            type,
            cnicFrontSrc,
            cnicBackSrc,
            profileSrc,
            certificateSrc,
            affidavitSrc,
            activeDays,
            timeWindow,
            videoSrc,
            homeAddress,
            hLat,
            hLng,
            shopAddress,
            sLat,
            sLng
        ) {

            /*
             * Final provider ID normalization
             * This is the important fix.
             * Whether JavaScript receives
             * 1
             * Pro-1
             * Pro-pro-1
             * it becomes
             * 1
             * and then we display
             * Pro-1
             */

            let currentProviderId =
                String(id ?? "").trim();


            while (
                currentProviderId
                    .toUpperCase()
                    .startsWith("PRO-")
            ) {

                currentProviderId =
                    currentProviderId
                        .substring(4)
                        .trim();

            }


            // Modal content

            document.getElementById("valId").innerText =
                "PRO-" + currentProviderId;


            document.getElementById("valName").innerText =
                name;


            document.getElementById("valFatherName").innerText =
                fatherName;


            document.getElementById("valCnic").innerText =
                cnic;


            document.getElementById("valPhone").innerText =
                phone;


            document.getElementById("valCity").innerText =
                city;


            document.getElementById("valLocalAddress").innerText =
                localAddr;


            document.getElementById("valPermanentAddress").innerText =
                permAddr;


            document.getElementById("valSkills").innerText =
                skills;


            document.getElementById("valType").innerText =
                type;


            document.getElementById("valTime").innerText =
                timeWindow;


            // Documents

            document.getElementById("imgCnicFront").src =
                cnicFrontSrc;


            document.getElementById("imgCnicBack").src =
                cnicBackSrc;


            document.getElementById("imgProfilePhoto").src =
                profileSrc;


            sgSetDoc("imgCertificate", certificateSrc);


            sgSetDoc("imgAffidavit", affidavitSrc);


            // Video

            const videoElement =
                document.getElementById("providerWorkVideo");


            if (videoElement) {

                if (videoSrc) {

                    videoElement.src =
                        videoSrc;

                    videoElement.load();

                } else {

                    videoElement.pause();

                    videoElement.src = "";

                    videoElement.load();

                }

            }


            // Home location

            const homeSection =
                document.getElementById("homeLocBlock");

            const homeAddressElement =
                document.getElementById("valHomeAddress");

            const homeMap =
                document.getElementById("homeMap");


            const hasHomeAddress =
                homeAddress &&
                String(homeAddress).trim() !== "" &&
                String(homeAddress).toLowerCase() !== "null";


            const hasHomeCoordinates =
                hLat &&
                hLng &&
                hLat !== "0" &&
                hLng !== "0" &&
                hLat !== "" &&
                hLng !== "" &&
                String(hLat).toLowerCase() !== "null" &&
                String(hLng).toLowerCase() !== "null";


            if (hasHomeAddress || hasHomeCoordinates) {

                homeSection.style.display =
                    "block";


                homeAddressElement.innerText =
                    hasHomeAddress
                        ? homeAddress
                        : "Location coordinates available";


                if (hasHomeCoordinates) {

                    loadGoogleMap(
                        "homeMap",
                        hLat,
                        hLng
                    );

                } else {

                    homeMap.innerHTML = "";

                }

            } else {

                homeSection.style.display =
                    "none";

                homeMap.innerHTML = "";

            }


            // Shop location

            const shopSection =
                document.getElementById("shopLocBlock");

            const shopAddressElement =
                document.getElementById("valShopAddress");

            const shopMap =
                document.getElementById("shopMap");


            const hasShopAddress =
                shopAddress &&
                String(shopAddress).trim() !== "" &&
                String(shopAddress).toLowerCase() !== "null";


            const hasShopCoordinates =
                sLat &&
                sLng &&
                sLat !== "0" &&
                sLng !== "0" &&
                sLat !== "" &&
                sLng !== "" &&
                String(sLat).toLowerCase() !== "null" &&
                String(sLng).toLowerCase() !== "null";


            if (hasShopAddress || hasShopCoordinates) {

                shopSection.style.display =
                    "block";


                shopAddressElement.innerText =
                    hasShopAddress
                        ? shopAddress
                        : "Location coordinates available";


                if (hasShopCoordinates) {

                    loadGoogleMap(
                        "shopMap",
                        sLat,
                        sLng
                    );

                } else {

                    shopMap.innerHTML = "";

                }

            } else {

                shopSection.style.display =
                    "none";

                shopMap.innerHTML = "";

            }


            // Available days

            const daysArray =
                (activeDays || "")
                    .split(',')
                    .map(day => day.trim());


            const allDays = [
                'Mon',
                'Tue',
                'Wed',
                'Thu',
                'Fri',
                'Sat',
                'Sun'
            ];


            allDays.forEach(day => {

                const element =
                    document.getElementById(
                        "day-" + day
                    );


                if (daysArray.includes(day)) {

                    element.classList.add("active");

                } else {

                    element.classList.remove("active");

                }

            });


            // Display modal

            document.getElementById(
                "deepReviewModal"
            ).style.display = "flex";

        }


        // Google map

        function loadGoogleMap(
            elementId,
            lat,
            lng
        ) {

            const mapContainer =
                document.getElementById(elementId);


            if (!mapContainer) {
                return;
            }


            const latitude =
                parseFloat(lat);

            const longitude =
                parseFloat(lng);


            if (
                Number.isNaN(latitude) ||
                Number.isNaN(longitude)
            ) {

                mapContainer.innerHTML = "";

                return;

            }


            mapContainer.style.display =
                "block";


            const parentBlock =
                mapContainer.parentElement;


            if (parentBlock) {

                parentBlock.style.display =
                    "block";

            }


            mapContainer.innerHTML = "";


            const iframe =
                document.createElement("iframe");


            iframe.className =
                "map-iframe-mock";


            iframe.title =
                "Google Map Location";


            iframe.loading =
                "lazy";


            iframe.referrerPolicy =
                "no-referrer-when-downgrade";


            iframe.style.width = "100%";
            iframe.style.height = "250px";
            iframe.style.border = "0";
            iframe.style.borderRadius = "8px";


            iframe.src =
                "https://www.google.com/maps?q=" +
                encodeURIComponent(
                    latitude + "," + longitude
                ) +
                "&z=15&output=embed";


            mapContainer.appendChild(
                iframe
            );

        }


        // Close deep review modal

        function closeDeepReviewModal() {

            const video =
                document.getElementById(
                    "providerWorkVideo"
                );


            if (video) {

                video.pause();

                video.src = "";

                video.load();

            }


            const homeMap =
                document.getElementById("homeMap");


            const shopMap =
                document.getElementById("shopMap");


            if (homeMap) {

                homeMap.innerHTML = "";

            }


            if (shopMap) {

                shopMap.innerHTML = "";

            }


            document.getElementById(
                "deepReviewModal"
            ).style.display = "none";

        }


        // Image zoom

        function zoomImage(element) {

            const img =
                element.getElementsByTagName("img")[0];


            if (!img || !img.src) {
                return;
            }


            const imgSrc =
                img.src;


            const lightbox =
                document.getElementById(
                    "imageLightbox"
                );


            const lightboxImg =
                document.getElementById(
                    "lightboxTargetImg"
                );


            lightboxImg.src =
                imgSrc;


            lightbox.style.display =
                "flex";


            setTimeout(() => {

                lightbox.classList.add("show");

            }, 10);

        }


        // Close lightbox

        function closeLightbox() {

            const lightbox =
                document.getElementById(
                    "imageLightbox"
                );


            lightbox.classList.remove("show");


            setTimeout(() => {

                lightbox.style.display =
                    "none";

            }, 200);

        }


        // Click outside modal

        window.onclick = function (event) {

            const modal =
                document.getElementById(
                    "deepReviewModal"
                );


            if (event.target == modal) {

                closeDeepReviewModal();

            }

        };


        // Search

        function filterProvidersTable() {

            let input =
                document.getElementById(
                    "providerSearchInput"
                );


            let filter =
                input.value.toLowerCase();


            let table =
                document.querySelector(
                    "table tbody"
                );


            let rows =
                table.getElementsByTagName("tr");


            for (
                let i = 0;
                i < rows.length;
                i++
            ) {

                let row =
                    rows[i];


                let rowText =
                    row.textContent ||
                    row.innerText;


                if (
                    rowText
                        .toLowerCase()
                        .indexOf(filter) > -1
                ) {

                    row.style.display = "";

                } else {

                    row.style.display = "none";

                }

            }

        }

    </script>


    <!-- Load more -->

    <script id="servicego-admin-load-more">

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const PAGE_SIZE = 15;


                const tables =
                    Array.from(
                        document.querySelectorAll(
                            "table tbody"
                        )
                    );


                tables.forEach(
                    function (tbody) {

                        const rows =
                            Array.from(
                                tbody.children
                            ).filter(
                                function (el) {

                                    return el.tagName &&
                                        el.tagName.toLowerCase() === "tr";

                                }
                            );


                        if (rows.length <= PAGE_SIZE)
                            return;


                        let visible =
                            PAGE_SIZE;


                        rows.forEach(
                            function (row, index) {

                                if (index >= visible)
                                    row.style.display = "none";

                            }
                        );


                        const button =
                            document.createElement("button");


                        button.type =
                            "button";


                        button.className =
                            "btn btn-outline-warning servicego-load-more";


                        button.textContent =
                            "Load More";


                        button.style.cssText =
                            "display:block;margin:18px auto 5px;min-width:130px;";


                        const wrapper =
                            tbody.closest("table");


                        if (
                            wrapper &&
                            wrapper.parentNode
                        ) {

                            wrapper.parentNode.insertBefore(
                                button,
                                wrapper.nextSibling
                            );

                        } else {

                            tbody.parentNode.appendChild(
                                button
                            );

                        }


                        button.addEventListener(
                            "click",
                            function () {

                                const next =
                                    Math.min(
                                        visible + PAGE_SIZE,
                                        rows.length
                                    );


                                for (
                                    let i = visible;
                                    i < next;
                                    i++
                                ) {

                                    rows[i].style.display = "";

                                }


                                visible =
                                    next;


                                if (
                                    visible >= rows.length
                                ) {

                                    button.remove();

                                }

                            }
                        );

                    }
                );

            }
        );

    </script>


    <!-- Logout modal -->

    <script id="servicego-admin-logout-script">
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".logout a").forEach(function (link) {
                link.addEventListener("click", async function (event) {
                    event.preventDefault();

                    const result = await Swal.fire({
                        title: "Logout?",
                        text: "Are you sure you want to logout?",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonText: "Yes, Logout",
                        cancelButtonText: "Cancel",
                        reverseButtons: true,
                        confirmButtonColor: "#d97600",
                        cancelButtonColor: "#6c757d"
                    });

                    if (result.isConfirmed) {
                        window.location.href = link.getAttribute("href");
                    }
                });
            });
        });
    </script>

    <script id="servicego-unified-ui-script">
        (function () {
            function ready(fn) {
                if (document.readyState !== "loading") fn();
                else document.addEventListener("DOMContentLoaded", fn);
            }

            ready(function () {

                /* 1. Highlight the current page in the sidebar and open its group */
                try {
                    var path = location.pathname.replace(/\/+$/, "").toLowerCase();
                    document.querySelectorAll(".sidebar ul li a[href]").forEach(function (a) {
                        var href = (a.getAttribute("href") || "").replace(/\/+$/, "").toLowerCase();
                        if (href && href === path) {
                            a.classList.add("sg-current");
                            var group = a.closest(".dropdown-item");
                            if (group) group.classList.add("open");
                        }
                    });
                } catch (e) { }

                /* 2. Give every table cell a label (needed for the phone card layout) */
                try {
                    document.querySelectorAll("table").forEach(function (table) {
                        var heads = table.querySelectorAll("thead th");
                        if (!heads.length) return;
                        table.querySelectorAll("tbody tr").forEach(function (row) {
                            Array.prototype.forEach.call(row.children, function (cell, i) {
                                if (cell.tagName === "TD" &&
                                    !cell.hasAttribute("data-label") &&
                                    !cell.hasAttribute("colspan") &&
                                    heads[i]) {
                                    cell.setAttribute("data-label", heads[i].textContent.trim());
                                }
                            });
                        });
                    });
                } catch (e) { }

                /* 3. Lock the page behind an open popup */
                try {
                    var SEL = ".modal, .complaint-details-overlay";
                    var syncLock = function () {
                        var open = Array.prototype.some.call(document.querySelectorAll(SEL), function (el) {
                            var cs = getComputedStyle(el);
                            return cs.display !== "none" && cs.visibility !== "hidden" && cs.opacity !== "0";
                        });
                        document.documentElement.classList.toggle("sg-modal-open", open);
                    };
                    new MutationObserver(function (list) {
                        for (var i = 0; i < list.length; i++) {
                            if (list[i].target.matches && list[i].target.matches(SEL)) { syncLock(); return; }
                        }
                    }).observe(document.body, { subtree: true, attributes: true, attributeFilter: ["style", "class"] });
                    syncLock();
                } catch (e) { }

                /* 4. Swipe left on the menu to close it (uses the page's own close button) */
                try {
                    var sidebar = document.querySelector(".sidebar");
                    var closeBtn = document.getElementById("sidebarCloseBtn");
                    var sx = null, sy = null;
                    if (sidebar && closeBtn) {
                        sidebar.addEventListener("touchstart", function (e) {
                            sx = e.touches[0].clientX; sy = e.touches[0].clientY;
                        }, { passive: true });
                        sidebar.addEventListener("touchend", function (e) {
                            if (sx === null) return;
                            var t = e.changedTouches[0];
                            var dx = t.clientX - sx, dy = Math.abs(t.clientY - sy);
                            sx = null;
                            if (dx < -70 && dy < 50 && getComputedStyle(closeBtn).display !== "none") closeBtn.click();
                        }, { passive: true });
                    }
                } catch (e) { }
            });
        })();
    </script>


    <script id="sg-optional-docs">
        /* Certificate / Affidavit optional: jo upload nahi hua uska card hide ho jata hai */
        window.sgSetDoc = function (imgId, src) {
            var img = document.getElementById(imgId);
            if (!img) return;
            var v = (src === null || src === undefined) ? "" : String(src).trim();
            if (v === "null" || v === "undefined") v = "";
            var card = img.closest(".media-card");
            if (v) {
                img.src = v;
                if (card) card.style.display = "";
            } else {
                img.removeAttribute("src");
                if (card) card.style.display = "none";
            }
        };
    </script>
