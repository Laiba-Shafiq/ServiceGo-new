            transform: scale(1.015);
        }

        /* Available days: fixed seven choices only */
        .available-days-picker {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            min-height: 42px;
        }

        .day-chip {
            border: 1px solid #dedede;
            background: #fff;
            color: #555;
            border-radius: 8px;
            padding: 8px 12px;
