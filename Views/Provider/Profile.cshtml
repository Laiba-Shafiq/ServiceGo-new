    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        // Profile picture: click to change + live preview
        document.addEventListener("DOMContentLoaded", function () {

            var profileImage = document.getElementById("profileImagePreview");
            var profileFile = document.getElementById("ProfilePicFile");

            if (profileImage && profileFile) {

                profileImage.addEventListener("click", function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    profileFile.click();
                });

                profileFile.addEventListener("change", function () {
                    var file = this.files && this.files[0];

                    if (!file) return;

                    if (!file.type || !file.type.startsWith("image/")) {
                        showProviderAlert("Please select an image file.");
                        this.value = "";
                        return;
                    }

                    var reader = new FileReader();

                    reader.onload = function (e) {
                        profileImage.src = e.target.result;
                    };

                    reader.readAsDataURL(file);
                });

                // Keep the pencil button from triggering any media-viewer behavior.
                var profileEdit = document.querySelector('label[for="ProfilePicFile"]');

                if (profileEdit) {
                    profileEdit.addEventListener("click", function (event) {
                        event.stopPropagation();
                    });
                }
            }


            // Available days: only monday-sunday
            var daysInput = document.getElementById("AvailableDays");
            var dayButtons = Array.from(
                document.querySelectorAll("#availableDaysPicker .day-chip")
            );

            if (daysInput && dayButtons.length) {

                var normalizeDay = function (value) {
                    return value.trim().toLowerCase();
                };

                var existingDays = (daysInput.value || "")
                    .split(",")
                    .map(normalizeDay)
                    .filter(Boolean);

                dayButtons.forEach(function (button) {
                    if (existingDays.indexOf(normalizeDay(button.dataset.day)) !== -1) {
                        button.classList.add("selected");
                    }

                    button.addEventListener("click", function () {
                        button.classList.toggle("selected");

                        var selectedDays = dayButtons
                            .filter(function (item) {
                                return item.classList.contains("selected");
                            })
                            .map(function (item) {
                                return item.dataset.day;
                            });

                        daysInput.value = selectedDays.join(", ");
                    });
                });
            }
        });


        // Media modal & zoom functionality

        var mediaModal =
            new bootstrap.Modal(
                document.getElementById('mediaViewerModal')
            );

        var modalImg =
            document.getElementById('modalImage');

        var modalVid =
            document.getElementById('modalVideo');

        var imgWrapper =
            document.getElementById('modalImageWrapper');


        document
            .querySelectorAll('.viewable-media')
            .forEach(function (element) {

                element.addEventListener('click', function () {

                    var type =
                        this.getAttribute('data-type');

                    if (type === 'image') {

                        modalImg.src = this.src;

                        modalImg.classList.remove('d-none');

                        imgWrapper.classList.remove('d-none');

                        modalVid.classList.add('d-none');

                        modalVid.pause();

                    }
                    else if (type === 'video') {

                        var srcUrl =
                            this.src ||
                            (
                                this.querySelector('source')
                                    ? this.querySelector('source').src
                                    : ''
                            );

                        if (!srcUrl)
                            return;

                        modalVid.src = srcUrl;

                        modalVid.classList.remove('d-none');

                        modalImg.classList.add('d-none');

                        imgWrapper.classList.add('d-none');

                        modalVid.load();

                        modalVid.play();
                    }

                    mediaModal.show();

                });

            });


        // Click to zoom image inside modal
        imgWrapper.addEventListener(
            'click',
            function () {

                this.classList.toggle('is-zoomed');

            }
        );


        document
            .getElementById('mediaViewerModal')
            .addEventListener(
                'hidden.bs.modal',
                function () {

                    modalVid.pause();

                    modalVid.src = "";

                    imgWrapper.classList.remove('is-zoomed');

                }
            );


        // Home + shop: use current location
        // type = "home"  => HomeLat / HomeLng + Home Map
        // type = "shop"  => ShopLat / ShopLng + Shop Map
        // Existing address text is NOT changed.

        function useEditProfileCurrentLocation(type) {

            var isHome = type === 'home';

            var button = document.getElementById(
                isHome ? 'homeCurrentLocationBtn' : 'shopCurrentLocationBtn'
            );

            var addressInput = document.getElementById(
                isHome ? 'HomeAddressInput' : 'ShopAddressInput'
            );

            var latInput = document.getElementById(
                isHome ? 'homeLatInput' : 'shopLatInput'
            );

            var lngInput = document.getElementById(
                isHome ? 'homeLngInput' : 'shopLngInput'
            );

            var mapFrame = document.getElementById(
                isHome ? 'homeGoogleMapIframe' : 'shopGoogleMapIframe'
            );

            var status = document.getElementById(
                isHome ? 'homeLocationStatus' : 'shopLocationStatus'
            );

            if (!navigator.geolocation) {
                showProviderAlert('Location services are not available in this browser.');
                return;
            }

            if (!button) return;

            button.disabled = true;
            button.innerHTML =
                '<i class="bi bi-hourglass-split me-1"></i> Getting Location...';

            if (status) {
                status.textContent = 'Reading your current location...';
            }

            navigator.geolocation.getCurrentPosition(
                async function (position) {

                    var lat = position.coords.latitude;
                    var lng = position.coords.longitude;

                    if (latInput) latInput.value = lat;
                    if (lngInput) lngInput.value = lng;

                    if (mapFrame) {
                        mapFrame.src =
                            'https://maps.google.com/maps?q=' +
                            encodeURIComponent(lat + ',' + lng) +
                            '&z=19&output=embed';
                    }

                    // Convert the new coordinates into a readable address.
                    try {
                        var response = await fetch(
                            'https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=' +
                            encodeURIComponent(lat) +
                            '&lon=' +
                            encodeURIComponent(lng) +
                            '&zoom=18&addressdetails=1',
                            {
                                headers: {
                                    'Accept': 'application/json'
                                }
                            }
                        );

                        if (!response.ok) {
                            throw new Error('Reverse geocoding failed.');
                        }

                        var data = await response.json();

                        if (addressInput && data && data.display_name) {
                            addressInput.value = data.display_name;

                            addressInput.dispatchEvent(
                                new Event('input', { bubbles: true })
                            );

                            addressInput.dispatchEvent(
                                new Event('change', { bubbles: true })
                            );

                            if (status) {
                                status.textContent =
                                    'Address updated from current location.';
                            }
                        } else if (status) {
                            status.textContent =
                                'Location updated, but an address could not be found.';
                        }

                    } catch (error) {
                        if (status) {
                            status.textContent =
                                'Location updated. Address lookup is temporarily unavailable.';
                        }
                    }

                    button.disabled = false;
                    button.innerHTML =
                        '<i class="bi bi-check-circle-fill me-1"></i> Location Updated';

                    setTimeout(function () {
                        button.innerHTML =
                            '<i class="bi bi-geo-alt-fill me-1"></i> Use Current Location';
                    }, 2200);
                },

                function (error) {

                    button.disabled = false;
                    button.innerHTML =
                        '<i class="bi bi-geo-alt-fill me-1"></i> Use Current Location';

                    if (status) {
                        status.textContent = '';
                    }

                    if (error.code === 1) {
                        showProviderAlert('Please allow location access in your browser.');
                    } else if (error.code === 2) {
                        showProviderAlert('Your current location could not be determined.');
                    } else if (error.code === 3) {
                        showProviderAlert('Location request timed out. Please try again.');
                    } else {
                        showProviderAlert('Unable to get your current location.');
                    }
                },
                {
                    enableHighAccuracy: true,
                    timeout: 15000,
                    maximumAge: 0
                }
            );
        }


    </script>


    <script id="servicego-load-more">

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const selectors = [
                    ".notification-item",
                    ".notification-card",
                    ".notification",
                    ".notif-item",
                    ".notif-card",
                    "[data-notification]"
                ];


                let items = [];


                for (const selector of selectors) {

                    const found =
                        Array.from(
                            document.querySelectorAll(selector)
                        );

                    if (found.length > items.length)
                        items = found;

                }


                if (items.length <= 15)
                    return;


                const pageSize = 15;

                let visible = pageSize;


                const button =
                    document.createElement("button");


                button.type = "button";

                button.id =
                    "servicego-load-more";

                button.className =
                    "btn btn-outline-warning mt-3";

                button.textContent =
                    "Load More";


                items.forEach(
                    (item, index) => {

                        if (index >= visible)
                            item.style.display = "none";

                    }
                );


                const last =
                    items[items.length - 1];


                last.parentNode.insertBefore(
                    button,
                    last.nextSibling
                );


                button.addEventListener(
                    "click",
                    function () {

                        const next =
                            Math.min(
                                visible + pageSize,
                                items.length
                            );


                        for (
                            let i = visible;
                            i < next;
                            i++
                        ) {

                            items[i].style.display = "";

                        }


                        visible = next;


                        if (visible >= items.length)
                            button.remove();

                    }
                );

            }
        );

    </script>

</body>
