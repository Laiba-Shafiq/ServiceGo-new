                box-shadow: 0 18px 50px rgba(33, 37, 41, .20) !important;
                font-family: inherit !important;
            }

        .swal2-icon {
            zoom: .72;
            margin: .2em auto .7em !important;
        }

        .swal2-title {
            font-size: 1.12rem !important;
            font-weight: 700 !important;
            color: #212529 !important;
            padding: 0 !important;
            margin: 0 0 .3rem !important;
        }

        .swal2-html-container {
            font-size: .9rem !important;
            line-height: 1.5 !important;
            color: #6c757d !important;
            margin: .2rem 0 0 !important;
            padding: 0 .2em !important;
        }

        .swal2-actions {
            margin-top: 1.1rem !important;
            gap: 8px;
        }

        .swal2-styled {
            border-radius: 12px !important;
            padding: .55rem 1.2rem !important;
            min-width: 92px;
            font-size: .9rem !important;
            font-weight: 600 !important;
            box-shadow: none !important;
        }

            .swal2-styled.swal2-confirm {
                background-color: #d97600 !important;
            }

            .swal2-styled.swal2-cancel {
                background-color: #e9ecef !important;
                color: #495057 !important;
            }

            .swal2-styled:focus {
                box-shadow: 0 0 0 3px rgba(217, 118, 0, .25) !important;
            }

        .swal2-popup.swal2-show {
            animation: sgPopIn .22s ease-out !important;
        }

        .swal2-popup.swal2-hide {
            animation: sgPopOut .15s ease-in !important;
        }

        @@keyframes sgPopIn {
            from {
                opacity: 0;
                transform: translateY(10px) scale(.96);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        @@keyframes sgPopOut {
            from {
                opacity: 1;
                transform: none;
            }

            to {
                opacity: 0;
                transform: translateY(6px) scale(.97);
            }
        }

        /* Bootstrap modals: smaller, rounded, smooth */
        .modal-content {
            border: 0 !important;
            border-radius: 18px !important;
            box-shadow: 0 18px 50px rgba(33, 37, 41, .20) !important;
            overflow: hidden;
        }

        .modal-header {
            padding: .85rem 1.1rem;
        }

        .modal-title {
            font-size: 1.05rem;
            font-weight: 700;
        }

        .modal-body {
            padding: 1rem 1.1rem;
        }

        .modal-footer {
            padding: .7rem 1.1rem;
            gap: 6px;
        }

        .modal-backdrop.show {
            opacity: .35;
        }

        .modal.fade .modal-dialog {
            transform: translateY(14px) scale(.97);
            transition: transform .22s ease-out;
        }

        .modal.show .modal-dialog {
            transform: none;
        }

        @@media (min-width: 576px) {
            .modal-dialog.modal-md {
                --bs-modal-width: 440px;
                max-width: 440px;
            }

            .modal-dialog.modal-lg {
                --bs-modal-width: 620px;
            }
        }

        .sg-rec-dot {
            display: inline-block;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #dc3545;
            margin-left: 4px;
            vertical-align: middle;
            animation: sgBlink 1s infinite;
        }

        @@keyframes sgBlink {
            50% {
                opacity: .25;
            }
        }
    </style>

    <style id="sg-provider-mobile-header">
        /* Mobile header: "Hi Provider" first, then the profile photo centered inside an orange round ring */
        @@media (max-width: 768px) {
