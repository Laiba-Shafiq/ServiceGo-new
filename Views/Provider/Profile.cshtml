    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function showProviderAlert(message, icon = "error", title = "") {
            if (window.Swal) {
                return Swal.fire({
                    icon: icon,
                    title: title || (icon === "success" ? "Done" : "Notice"),
                    text: String(message || ""),
                    confirmButtonText: "OK",
                    confirmButtonColor: "#d97600",
                    buttonsStyling: true,
                    customClass: { popup: "servicego-swal-popup" }
                });
            }
            return Promise.resolve();
        }
    </script>

    <style id="sg-popup-theme">
