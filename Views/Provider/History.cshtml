    <main class="main">
        <div class="page-container">
            <div class="page-header"><div class="page-icon"><i class="bi bi-clock-history"></i></div><h2>History</h2></div>
            <div class="history-tabs">
                <button type="button" class="history-tab active" data-target="jobHistory"><i class="bi bi-briefcase"></i><span>Job History</span><small>@jobHistoryCount</small></button>
                <button type="button" class="history-tab" data-target="complaintHistory"><i class="bi bi-exclamation-triangle"></i><span>Complaint History</span><small>@(Model.ComplaintHistory?.Count ?? 0)</small></button>
            </div>
            <section id="jobHistory" class="history-section active">
                <div class="section-heading"><div><h4>Job History</h4></div><span class="section-pill"><i class="bi bi-briefcase"></i> @jobHistoryCount Jobs</span></div>
                @if (jobHistoryItems != null && jobHistoryItems.Any())
                {
                    foreach (var item in jobHistoryItems)
                    {
                        var status = string.IsNullOrWhiteSpace(item.Status) ? "Unknown" : item.Status.Trim();
                        var statusClass = status.Equals("Completed", StringComparison.OrdinalIgnoreCase) ? "status-completed" : status.Equals("Accepted", StringComparison.OrdinalIgnoreCase) ? "status-accepted" : status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) ? "status-cancelled" : status.Equals("Rejected", StringComparison.OrdinalIgnoreCase) ? "status-rejected" : "status-expired";
                        var statusIcon = status.Equals("Completed", StringComparison.OrdinalIgnoreCase) ? "bi-check-circle-fill" : status.Equals("Accepted", StringComparison.OrdinalIgnoreCase) ? "bi-check2-circle" : status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) ? "bi-x-circle-fill" : status.Equals("Rejected", StringComparison.OrdinalIgnoreCase) ? "bi-slash-circle-fill" : "bi-clock-history";
                        DateTime historyEventDate = item.BookingDate;
                        if (status.Equals("Completed", StringComparison.OrdinalIgnoreCase) && item.CompletedAt.HasValue) { historyEventDate = item.CompletedAt.Value; }
                        else if (status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) && item.CancelledAt.HasValue) { historyEventDate = item.CancelledAt.Value; }
                        else if (status.Equals("Rejected", StringComparison.OrdinalIgnoreCase) && item.RejectedAt.HasValue) { historyEventDate = item.RejectedAt.Value; }
                        <article class="history-card" id="history-booking-@item.Id" data-booking-id="@item.Id">
                            <div class="history-card-top">
                                <div class="service-title">
                                    <div class="service-icon"><i class="bi bi-tools"></i></div>
                                    <div>
                                        <h5>@(string.IsNullOrWhiteSpace(item.ServiceName) ? "Service" : item.ServiceName)</h5>
                                    </div>
                                </div>
                                <div class="text-end"><span class="status-badge @statusClass"><i class="bi @statusIcon"></i> @status</span><div class="booking-ref">Booking: @item.BookingId</div></div>
                            </div>
                            <div class="history-summary">
                                <span><i class="bi bi-calendar3"></i>@historyEventDate.ToString("dd MMM yyyy")</span>
                                <span><i class="bi bi-clock"></i>@(string.IsNullOrWhiteSpace(item.BookingTime) ? "N/A" : item.BookingTime)</span>
                                <span><i class="bi bi-tools"></i>@(string.IsNullOrWhiteSpace(item.ServiceType) ? "Service" : item.ServiceType)</span>
                                @if (status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(item.CancelledBy))
                                {
                                    <span class="history-cancelled-by"><i class="bi bi-person-x"></i>Cancelled by @item.CancelledBy</span>
                                }
                                @if (item.HasRescheduleHistory && !string.IsNullOrWhiteSpace(item.RescheduledStatus))
                                {
                                    if (item.RescheduledStatus.Equals("Accepted", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span><i class="bi bi-calendar-check"></i>Reschedule Accepted</span>
                                    }
                                    else if (item.RescheduledStatus.Equals("Rejected", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span><i class="bi bi-calendar-x"></i>Reschedule Rejected</span>
                                    }
                                    else if (item.RescheduledStatus.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span><i class="bi bi-calendar-event"></i>Reschedule Pending</span>
                                    }

                                    if (!string.IsNullOrWhiteSpace(item.RescheduleRequestedBy))
                                    {
                                        <span><i class="bi bi-person"></i>Requested by @item.RescheduleRequestedBy</span>
                                    }
                                }
                            </div>
                        </article>
                    }
                }
                else
                {

                    <div class="empty-state"><i class="bi bi-briefcase"></i><h5>No Job History Found</h5><p>Your completed, cancelled and rejected bookings will appear here.</p></div>
                }
            </section>
            <section id="complaintHistory" class="history-section">

                <div class="section-heading">
                    <div>
                        <h4>Complaint History</h4>
                    </div>

                    <span class="section-pill">
                        <i class="bi bi-shield-exclamation"></i>
                        @(Model.ComplaintHistory?.Count ?? 0) Complaints
                    </span>
                </div>

                @if (Model.ComplaintHistory != null && Model.ComplaintHistory.Any())
                {
                    foreach (var complaint in Model.ComplaintHistory)
                    {
                        var complaintStatus = string.IsNullOrWhiteSpace(complaint.Status)
                        ? "Pending"
                        : complaint.Status.Trim();

                        var complaintStatusClass = complaintStatus.Equals("Resolved", StringComparison.OrdinalIgnoreCase)
                        ? "complaint-resolved"
                        : complaintStatus.Equals("Rejected", StringComparison.OrdinalIgnoreCase)
                        ? "complaint-rejected"
                        : "complaint-pending";

                        string historyIssue = string.Empty;

                        if (!string.IsNullOrWhiteSpace(complaint.OtherIssue) &&
                        !complaint.OtherIssue.Equals("Other", StringComparison.OrdinalIgnoreCase))
                        {
                            historyIssue = complaint.OtherIssue.Trim();
                        }
                        else if (!string.IsNullOrWhiteSpace(complaint.IssueCategory) &&
                        !complaint.IssueCategory.Equals("General", StringComparison.OrdinalIgnoreCase) &&
                        !complaint.IssueCategory.Equals("Other", StringComparison.OrdinalIgnoreCase))
                        {
                            historyIssue = complaint.IssueCategory.Trim();
                        }
                        else if (complaint.OtherIssue?.Equals("Other", StringComparison.OrdinalIgnoreCase) == true)
                        {
                            historyIssue = "Other";
                        }

                        <article class="complaint-card complaint-history-card">

                            <div class="complaint-top">
                                <div class="complaint-title">
                                    <div class="complaint-icon">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                    </div>
                                    <div>
                                        <h5>Complaint #@complaint.ComplaintId</h5>
                                        <span>@complaint.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                    </div>
                                </div>

                                <span class="complaint-status @complaintStatusClass">
                                    @complaintStatus
                                </span>
                            </div>

                            <div class="complaint-info-list">

                                <div class="complaint-info-row">
                                    <span>Customer ID</span>
                                    <strong>
                                        @(string.IsNullOrWhiteSpace(complaint.CustomerId) ? "N/A" : complaint.CustomerId)
                                    </strong>
                                </div>

                                <div class="complaint-info-row">
                                    <span>Customer Name</span>
                                    <strong>
                                        @(string.IsNullOrWhiteSpace(complaint.CustomerName) ? "N/A" : complaint.CustomerName)
                                    </strong>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(historyIssue))
                                {
                                    <div class="complaint-info-row">
                                        <span>Issue Category</span>
                                        <strong>@historyIssue</strong>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(complaint.ComplaintDetails))
                                {
                                    <div class="complaint-info-row complaint-details-row">
                                        <span>Complaint Details</span>
                                        <strong>@complaint.ComplaintDetails</strong>
                                    </div>
                                }

                            </div>

                        </article>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-shield-check"></i>
                        <h5>No Complaint History Found</h5>
                        <p>Complaints submitted by you will appear here.</p>
                    </div>
                }

            </section>
        </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tabs = document.querySelectorAll(".history-tab");
            const sections = document.querySelectorAll(".history-section");
            tabs.forEach(tab => tab.addEventListener("click", function () {
                const target = document.getElementById(this.getAttribute("data-target"));
                tabs.forEach(t => t.classList.remove("active")); sections.forEach(s => s.classList.remove("active")); this.classList.add("active"); if (target) target.classList.add("active");
            }));
        });
    </script>

    <script id="servicego-history-load-more">
        document.addEventListener("DOMContentLoaded", function () {
            const sections = [
                {
                    sectionId: "jobHistory",
                    cardSelector: ".history-card",
                    buttonId: "jobHistoryLoadMore"
                },
                {
                    sectionId: "complaintHistory",
                    cardSelector: ".complaint-card",
                    buttonId: "complaintHistoryLoadMore"
                }
            ];

            sections.forEach(function (config) {
                setupProviderHistoryLoadMore(config);
            });
        });

        function setupProviderHistoryLoadMore(config) {
            const section = document.getElementById(config.sectionId);
            if (!section) return;

            const cards = Array.from(
                section.querySelectorAll(config.cardSelector)
            );

            if (cards.length <= 15) {
                cards.forEach(function (card) {
                    card.hidden = false;
                });
                return;
            }

            const maxVisible = Math.min(cards.length, 30);
            let visibleCount = 15;

            const button = document.createElement("button");
            button.type = "button";
            button.id = config.buttonId;
            button.className =
                "btn btn-outline-warning d-block mx-auto mt-3 mb-4 px-4 py-2 fw-semibold";
            button.textContent = "Load More";
            button.setAttribute("aria-controls", config.sectionId);
            button.setAttribute("aria-expanded", "false");

            section.appendChild(button);

            function update() {
                cards.forEach(function (card, index) {
                    card.hidden = index >= visibleCount;
                });

                if (visibleCount >= maxVisible) {
                    button.textContent = "Show Less";
                    button.setAttribute("aria-expanded", "true");
                } else {
                    button.textContent = "Load More";
                    button.setAttribute("aria-expanded", "false");
                }
            }

            button.addEventListener("click", function () {
                if (visibleCount >= maxVisible) {
                    visibleCount = 15;
                } else {
                    visibleCount = Math.min(
                        visibleCount + 15,
                        maxVisible
                    );
                }

                update();
            });

            update();
        }
    </script>

    <script id="servicego-history-focus">
        // Scroll to and highlight the booking that was opened from a notification.
        window.addEventListener("load", function () {
            var params = new URLSearchParams(window.location.search);
            var bookingId = params.get("bookingId");
            if (!bookingId || !/^\d+$/.test(bookingId)) return;

            // Wait briefly so the "Load More" script has finished hiding cards.
            setTimeout(function () {
                var card = document.getElementById("history-booking-" + bookingId);
                if (!card) return;

                // Make sure the Job History tab is open and the card is visible.
                var section = card.closest(".history-section");
                if (section && !section.classList.contains("active")) {
                    var tab = document.querySelector('.history-tab[data-target="' + section.id + '"]');
                    if (tab) tab.click();
                }
                card.hidden = false;

                card.classList.add("sg-history-focus");

                var tag = document.createElement("span");
                tag.className = "sg-history-focus-tag";
                tag.textContent = "From your notification";
                card.appendChild(tag);

                card.scrollIntoView({ behavior: "smooth", block: "center" });

                // Remove the highlight after a few seconds.
                setTimeout(function () {
                    card.classList.remove("sg-history-focus");
                    if (tag.parentNode) tag.parentNode.removeChild(tag);
                }, 4500);

                // A refresh should not highlight the card again.
                if (window.history && window.history.replaceState) {
                    params.delete("bookingId");
                    var query = params.toString();
                    window.history.replaceState(
                        null, "",
                        window.location.pathname + (query ? "?" + query : ""));
                }
            }, 250);
        });
    </script>
</body>
</html>