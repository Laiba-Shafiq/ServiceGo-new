            }

            .section-heading {
                align-items: flex-start;
            }

            .section-pill {
                display: none;
            }

            .history-card-top, .complaint-top {
                flex-direction: column;
                align-items: flex-start;
            }

            .booking-ref, .status-badge, .complaint-status {
                align-self: flex-start;
            }

            .info-grid, .complaint-grid {
                grid-template-columns: 1fr;
            }

            .event-line {
                flex-direction: column;
                gap: 7px;
            }
        }

        /*
                                 * Mobile profile dropdown
                                 * Same style as provider dashboard / history
