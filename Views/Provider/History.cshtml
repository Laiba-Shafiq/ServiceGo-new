    <div class="sidebar">
        <a href="@Url.Action("Index", "Home")" aria-label="ServiceGo Home"><img src="@Url.Content("~/images/Logo.png")" class="logo" alt="ServiceGo" onclick="window.location.href='@Url.Action("Index", "Home")'" /></a>
        <div class="provider-greeting">Hi Provider</div>
        <div class="nav">
            <a href="@Url.Action("Dashboard", "Provider")"><i class="bi bi-house-door"></i><span>Dashboard</span></a><a href="@Url.Action("Profile", "Provider")"><i class="bi bi-person"></i><span>Profile</span></a><a href="@Url.Action("Messages", "Provider")"><i class="bi bi-chat-dots"></i><span>Messages</span></a><a href="@Url.Action("History", "Provider")" class="active"><i class="bi bi-clock-history"></i><span>History</span></a><a href="@Url.Action("Notifications", "Provider")">
