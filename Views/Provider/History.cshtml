                }
        }
        /* ServiceGo provider navigation: identical on every provider page */
        .sidebar .nav a.active,
        .sidebar .nav a:hover {
            background: #ffb74d !important;
            color: #fff !important;
        }

            .sidebar .nav a.active i,
            .sidebar .nav a:hover i {
                color: #fff !important;
            }

        @@media (max-width: 768px) {
            .mobile-top .dropdown-menu.mobile-dropdown-menu,
            .mobile-top .dropdown-menu {
