            font-size: 29px;
            font-weight: 800;
            color: #222;
        }

        .page-header p {
            margin: 6px 0 0;
            color: #777;
            font-size: 13px;
        }

        .history-tabs {
            display: grid;
            grid-template-columns: repeat(2,1fr);
            gap: 7px;
            padding: 7px;
            margin-bottom: 26px;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 16px;
            box-shadow: 0 4px 18px rgba(0,0,0,.05);
        }

        .history-tab {
            border: 0;
            border-radius: 11px;
            min-height: 58px;
            background: transparent;
            color: #666;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            transition: .2s ease;
        }

            .history-tab i {
                color: #d97600;
                font-size: 18px;
            }

            .history-tab small {
                min-width: 25px;
                padding: 3px 7px;
                border-radius: 20px;
                background: #f4f4f4;
                color: #777;
                font-size: 11px;
            }

            .history-tab.active {
                background: #fff3e0;
                color: #d97600;
                box-shadow: inset 0 0 0 1px rgba(217,118,0,.12);
            }

