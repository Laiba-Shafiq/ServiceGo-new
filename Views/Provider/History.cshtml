                        min-width: 22px;
                        color: #d97600;
                    }

                    .mobile-top .dropdown-item:hover {
                        background: #fff3df;
                        color: #d97600;
                    }

                    .mobile-top .dropdown-item.active {
                        background: #f7e6c8;
                        color: #d97600;
                        font-weight: 700;
                    }

            .main {
                margin-left: 0 !important;
                padding: 88px 14px 28px !important;
                width: 100%;
            }

            .page-header h2 {
                font-size: 24px;
            }

            .page-header p {
                font-size: 12px;
            }

            .history-tabs {
                grid-template-columns: 1fr;
            }

            .history-tab {
