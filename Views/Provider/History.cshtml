                    background: #d97600;
                    color: #fff;
                }

        .history-section {
            display: none;
        }

            .history-section.active {
                display: block;
            }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 14px;
        }

