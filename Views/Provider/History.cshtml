@model ServiceGo.Models.ProviderHistoryViewModel

@{
    // Job History shows only Completed, Cancelled and Rejected bookings.
    var jobHistoryItems = Model?.JobHistory?
        .Where(j =>
            string.Equals(j.Status?.Trim(), "Completed", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(j.Status?.Trim(), "Cancelled", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(j.Status?.Trim(), "Rejected", StringComparison.OrdinalIgnoreCase))
        .ToList();
    int jobHistoryCount = jobHistoryItems?.Count ?? 0;
}
@{
    Layout = null;
    var providerProfileImage = (ViewBag.ProviderProfileImage as string);
    providerProfileImage = string.IsNullOrWhiteSpace(providerProfileImage)
        ? Url.Content("~/images/Profile icon.png")
        : Url.Content(providerProfileImage);

    int providerUnreadCount = ViewBag.UnreadCount ?? 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ServiceGo - Provider History</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="icon" href="@Url.Content("~/images/Logo.png")" type="image/x-icon" />
    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            font-family: 'Poppins',Arial,sans-serif;
            background: #f7f7f7;
            color: #333;
            overflow-x: hidden;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 80px;
            height: 100vh;
            background: #d97600;
            display: flex;
            flex-direction: column;
            align-items: center;
            z-index: 1000;
            transition: width .3s ease;
        }

            .sidebar:hover {
                width: 240px;
                box-shadow: 4px 0 20px rgba(217,118,0,.18);
            }

            .sidebar .logo {
                width: 60px;
                height: 60px;
                margin: 20px 0;
                object-fit: contain;
                background: #fff;
                border-radius: 10%;
                cursor: pointer;
            }


        .provider-greeting {
            color: #fff;
            font-size: 15px;
            font-weight: 700;
            white-space: nowrap;
            text-align: center;
            margin: -6px 0 6px;
            opacity: 0;
            transition: opacity 0.2s ease;
        }

        .sidebar:hover .provider-greeting {
            opacity: 1;
        }

        @@media (max-width: 768px) {
            .provider-greeting {
                display: none;
            }
        }

        .sidebar .nav {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

            .sidebar .nav a {
                width: 90%;
                min-height: 48px;
                margin-bottom: 5px;
                padding: 12px 20px;
                display: flex;
                align-items: center;
                color: #fff;
                text-decoration: none;
                border-radius: 10px;
                overflow: hidden;
                transition: .2s ease;
            }

                .sidebar .nav a i {
                    min-width: 25px;
                    font-size: 1.35rem;
                    margin-right: 15px;
                }

            .sidebar .nav span {
                opacity: 0;
                white-space: nowrap;
                transition: opacity .2s ease;
            }

        .sidebar:hover .nav span {
            opacity: 1;
        }

        .sidebar .nav a.active, .sidebar .nav a:hover {
            background: #ffb74d;
            color: #fff;
            font-weight: 600;
        }

        .main {
            margin-left: 80px;
            min-height: 100vh;
            padding: 42px 42px 55px 52px;
            transition: margin-left .3s ease;
        }

        .sidebar:hover ~ .main {
            margin-left: 240px;
        }

        .page-container {
            width: 100%;
            max-width: 1120px;
            margin: 0 auto;
        }

        .page-header {
            text-align: center;
            margin-bottom: 28px;
        }

        .page-icon {
            width: 58px;
            height: 58px;
            margin: 0 auto 12px;
            border-radius: 17px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff3e0;
            color: #d97600;
            font-size: 25px;
        }

