                        <a class="dropdown-item" href="@Url.Action("Dashboard", "Provider")"><i class="bi bi-house-door"></i>Dashboard</a><a class="dropdown-item" href="@Url.Action("Profile", "Provider")"><i class="bi bi-person"></i>Profile</a><a class="dropdown-item" href="@Url.Action("Messages", "Provider")"><i class="bi bi-chat-dots"></i>Messages</a><a class="dropdown-item active" href="@Url.Action("History", "Provider")"><i class="bi bi-clock-history"></i>History</a><a class="dropdown-item" href="@Url.Action("Notifications", "Provider")">
