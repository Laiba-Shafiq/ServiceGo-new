        /* Compact history cards: layout-safe presentation override only. */
        .history-card {
            margin-bottom: 10px !important;
            border-radius: 10px !important;
            box-shadow: 0 2px 8px rgba(0,0,0,.04) !important;
        }

        .history-card-top {
            padding: 10px 14px !important;
