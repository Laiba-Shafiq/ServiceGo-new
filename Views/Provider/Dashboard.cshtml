                    // =========================================================
                    // PROVIDER RESCHEDULE FIELD VALIDATION
                    // =========================================================

                    function clearProviderRescheduleFieldErrors() {
                        const d = document.getElementById("pNewDateError");
                        const t = document.getElementById("pNewTimeError");
                        if (d) { d.textContent = ""; d.style.display = "none"; }
                        if (t) { t.textContent = ""; t.style.display = "none"; }
                        document.getElementById("pNewDate")?.classList.remove("is-invalid");
                        document.getElementById("pNewTime")?.classList.remove("is-invalid");
                    }

                    function showProviderRescheduleFieldError(field, message) {
                        const input = document.getElementById(field === "date" ? "pNewDate" : "pNewTime");
                        const error = document.getElementById(field === "date" ? "pNewDateError" : "pNewTimeError");
                        if (input) input.classList.add("is-invalid");
                        if (error) { error.textContent = message; error.style.display = "block"; }
                    }

                    function validateProviderRescheduleFields() {
                        clearProviderRescheduleFieldErrors();
                        const d = document.getElementById("pNewDate");
                        const t = document.getElementById("pNewTime");
                        let valid = true;
                        if (d && d.value) {
                            const selected = new Date(d.value + "T00:00:00");
                            const today = new Date();
                            today.setHours(0,0,0,0);
                            if (selected < today) { showProviderRescheduleFieldError("date", "This date is not available."); valid = false; }
                        }
                        if (t && t.value) {
                            const parts = t.value.split(":");
                            const h = Number(parts[0]), m = Number(parts[1]);
                            if (!Number.isFinite(h) || !Number.isFinite(m) || h < 0 || h > 23 || m < 0 || m > 59) { showProviderRescheduleFieldError("time", "This time is not available."); valid = false; }
                        }
                        return valid;
                    }

                    function wireProviderRescheduleFieldValidation() {
                        const d = document.getElementById("pNewDate");
                        const t = document.getElementById("pNewTime");
                        if (d && !d.dataset.validationWired) { d.dataset.validationWired = "1"; d.addEventListener("input", validateProviderRescheduleFields); d.addEventListener("change", validateProviderRescheduleFields); }
                        if (t && !t.dataset.validationWired) { t.dataset.validationWired = "1"; t.addEventListener("input", validateProviderRescheduleFields); t.addEventListener("change", validateProviderRescheduleFields); }
                    }

                    wireProviderRescheduleFieldValidation();

                    // =========================================================
                    // SUBMIT PROVIDER RESCHEDULE
                    // =========================================================

                    async function submitProviderReschedule() {

                        const dateInput =
                            document.getElementById(
                                "pNewDate"
                            );


                        const timeInput =
                            document.getElementById(
                                "pNewTime"
                            );

                        // pNewTime uses the browser's native clock/time picker.
                        // It returns 24-hour HH:mm and is converted below to
                        // the same 12-hour format used by the existing backend.



                        const newDate =
                            dateInput
                                ? dateInput.value.trim()
                                : "";

                        const clockValue =
                            timeInput
                                ? timeInput.value.trim()
                                : "";

                        let newTime = "";

                        const clockMatch = clockValue.match(/^(\d{2}):(\d{2})$/);
                        if (clockMatch) {
                            let h = Number(clockMatch[1]);
                            const m = Number(clockMatch[2]);

                            if (h >= 0 && h <= 23 && m >= 0 && m <= 59) {
                                const period = h >= 12 ? "PM" : "AM";
                                let displayHour = h % 12;
                                if (displayHour === 0) displayHour = 12;

                                newTime =
                                    `${String(displayHour).padStart(2, "0")}:${String(m).padStart(2, "0")} ${period}`;
                            }
                        }

                        if (timeInput) {
                            timeInput.dataset.serverTime = newTime;
                        }


                        const bookingId =
                            Number(activeJobIndexId);


                        if (
                            !Number.isFinite(bookingId) ||
                            bookingId <= 0
                        ) {

                            Swal.fire(
                                "Error",
                                "Booking not selected.",
                                "error"
                            );

                            return;
                        }


                        if (!newDate || !newTime) {

                            Swal.fire(
                                "Missing Information",
                                "Please select both New Date and New Time.",
                                "warning"
                            );

                            return;
                        }

                        if (!validateProviderRescheduleFields()) {
                            return;
                        }


                        let job =
                            null;


                        if (
                            activeJob &&
                            getJobId(activeJob) === bookingId
                        ) {

                            job =
                                activeJob;
                        }


                        if (!job) {

                            job =
                                acceptedJobs.find(
                                    j =>
                                        getJobId(j) ===
                                        bookingId
                                );
                        }


                        if (!job) {

                            job =
                                jobs.find(
                                    j =>
                                        getJobId(j) ===
                                        bookingId
                                );
                        }


                        if (!job) {

                            Swal.fire(
                                "Error",
                                "Booking not found.",
                                "error"
                            );

                            return;
                        }


                        activeJob =
                            job;

                        activeJobIndexId =
                            bookingId;


                        // =====================================================
                        // PENDING CHECK
                        // =====================================================

                        if (
                            getRescheduleStatus(job) ===
                            "pending"
                        ) {

                            Swal.fire(
                                "Request Pending",
                                "A reschedule request is already pending for this booking.",
                                "info"
                            );

                            return;
                        }


                        // =====================================================
                        // NEW DATE/TIME VALIDATION
                        // =====================================================

                        const requestedDateTime =
                            parseProviderDateTime(newDate, newTime);

                        if (!requestedDateTime) {
                            Swal.fire(
                                "Invalid Date/Time",
                                "Please select a valid date and time.",
                                "warning"
                            );
                            return;
                        }


                        if (
                            requestedDateTime <=
                            new Date()
                        ) {

                            Swal.fire(
                                "Invalid Date/Time",
                                "New date and time must be in the future.",
                                "warning"
                            );

                            return;
                        }


                        // =====================================================
                        // CONFIRMATION
                        // =====================================================

                        const result =
                            await Swal.fire({

                                title:
                                    "Send Reschedule Request?",

                                html:
                                    `New Date: <strong>${escapeHtml(newDate)}</strong><br>` +
                                    `New Time: <strong>${escapeHtml(newTime)}</strong>`,

                                icon:
                                    "question",

                                showCancelButton:
                                    true,

                                confirmButtonText:
                                    "Send Request",

                                cancelButtonText:
                                    "Cancel",

                                confirmButtonColor:
                                    "#f39c12",

                                cancelButtonColor:
                                    "#6c757d"
                            });


                        if (!result.isConfirmed) {
                            return;
                        }


                        const token =
                            getAntiForgeryToken();


                        try {

                            Swal.fire({

                                title:
                                    "Sending Request...",

                                text:
                                    "Please wait.",

                                allowOutsideClick:
                                    false,

                                allowEscapeKey:
                                    false,

                                didOpen: () => {

                                    Swal.showLoading();
                                }
                            });


                            const response =
                                await fetch(
                                    '@Url.Action("RequestReschedule", "Provider")',
                                    {
                                        method:
                                            "POST",

                                        headers: {

                                            "Content-Type":
                                                "application/json",

                                            "RequestVerificationToken":
                                                token,

                                            "Accept":
                                                "application/json"
                                        },

                                        body:
                                            JSON.stringify({

                                                bookingId:
                                                    bookingId,

                                                newDate:
                                                    newDate,

                                                newTime:
                                                    newTime,

                                                requestedBy:
                                                    "Provider"
                                            })
                                    }
                                );


                            const responseText =
                                await response.text();


                            let data =
                                null;


                            try {

                                data =
                                    responseText
                                        ? JSON.parse(responseText)
                                        : null;

                            } catch {

                                data =
                                    null;
                            }


                            Swal.close();


                            if (!response.ok) {

                                const errorMessage =
                                    data?.message ||
                                    data?.error ||
                                    responseText ||
                                    "Reschedule request could not be sent.";

                                const lowerError = String(errorMessage).toLowerCase();

                                if (lowerError.includes("not available on") || lowerError.includes("available day") || lowerError.includes("date")) {
                                    showProviderRescheduleFieldError("date", "This date is not available.");
                                }

                                if (lowerError.includes("available only between") || lowerError.includes("invalid time") || lowerError.includes("time")) {
                                    showProviderRescheduleFieldError("time", "This time is not available.");
                                }

                                if (!lowerError.includes("not available on") && !lowerError.includes("available day") && !lowerError.includes("available only between") && !lowerError.includes("invalid time") && !lowerError.includes("date") && !lowerError.includes("time")) {
                                    await Swal.fire("Error", errorMessage, "error");
                                }

                                return;
                            }


                            if (providerReschedModalObj) {

                                providerReschedModalObj.hide();
                            }


                            // =================================================
                            // LOCAL OBJECT UPDATE
                            // =================================================

                            job.rescheduleStatus =
                                "pending";

                            job.RescheduleStatus =
                                "pending";

                            job.rescheduledStatus =
                                "pending";

                            job.RescheduledStatus =
                                "pending";


                            job.requestedNewDate =
                                newDate;

                            job.RequestedNewDate =
                                newDate;


                            job.requestedNewTime =
                                newTime;

                            job.RequestedNewTime =
                                newTime;


                            // IMPORTANT:
                            // A provider request must not be treated as a customer request.
                            // mat banao.
                            //
                            // Therefore, hasCustomerRescheduleRequest is not
                            // set to TRUE here.

                            job.hasRescheduleRequest =
                                false;

                            job.HasRescheduleRequest =
                                false;


                            await Swal.fire({

                                title:
                                    "Reschedule Request Sent Successfully!",

                                html:
                                    `<div style="font-size:15px;">

                                        <p class="mb-2">

                                            Your reschedule request has been sent to the customer successfully.

                                        </p>


                                        <div
                                            class="alert alert-light border mb-0 text-start">

                                            <strong>Current:</strong>

                                            ${escapeHtml(
                                                formatDateForDisplay(
                                                    getJobDate(job)
                                                )
                                            )}

                                            -

                                            ${escapeHtml(
                                                formatTimeForDisplay(
                                                    getJobTime(job)
                                                )
                                            )}

                                            <br>

                                            <strong>Requested:</strong>

                                            ${escapeHtml(
                                                formatDateForDisplay(
                                                    newDate
                                                )
                                            )}

                                            -

                                            ${escapeHtml(
                                                formatTimeForDisplay(
                                                    newTime
                                                )
                                            )}

                                        </div>


                                        <small
                                            class="text-muted d-block mt-2">

                                            The current booking date and time will remain unchanged until the customer accepts your request.

                                        </small>

                                    </div>`,

                                icon:
                                    "success",

                                confirmButtonText:
                                    "OK",

                                confirmButtonColor:
                                    "#28a745",

                                allowOutsideClick:
                                    false

                            });


                            // =================================================
                            // IMPORTANT:
                            // Provider card:
                            //
                            // Reschedule Request: Pending
                            //
                            // The Reschedule button remains hidden.
                            // =================================================

                            renderCards();


                            activeJobIndexId =
                                null;

                            activeJob =
                                null;

                        }
                        catch (error) {

                            console.error(
                                "SERVICEGO - RESCHEDULE ERROR:",
                                error
                            );


                            Swal.close();


                            Swal.fire(
                                "Error",
                                "Something went wrong while sending the reschedule request.",
                                "error"
                            );
                        }
                    }


                    // =========================================================
                    // NORMALIZE DATE
                    // =========================================================

                    function normalizeDateValue(value) {

                        if (!value) {
                            return "";
                        }


                        let text =
                            String(value).trim();


                        if (
                            /^\d{4}-\d{2}-\d{2}$/.test(text)
                        ) {

                            return text;
                        }


                        if (text.includes("T")) {

                            return text.split("T")[0];
                        }


                        const date =
                            new Date(text);


                        if (Number.isNaN(date.getTime())) {

                            return text;
                        }


                        return `${date.getFullYear()}-${String(
                            date.getMonth() + 1
                        ).padStart(2, "0")}-${String(
                            date.getDate()
                        ).padStart(2, "0")}`;
                    }


                    // =========================================================
                    // NORMALIZE TIME
                    // =========================================================

                    function normalizeTimeValue(value) {

                        if (!value) {
                            return "";
                        }


                        let text =
                            String(value)
                                .trim()
                                .toLowerCase();


                        if (
                            /^\d{2}:\d{2}:\d{2}/.test(text)
                        ) {

                            text =
                                text.substring(0, 5);
                        }


                        const twelveHour =
                            text.match(
                                /^(\d{1,2}):(\d{2})\s*(am|pm)$/
                            );


                        if (twelveHour) {

                            let hours =
                                parseInt(
                                    twelveHour[1],
                                    10
                                );


                            const minutes =
                                twelveHour[2];


                            const period =
                                twelveHour[3];


                            if (
                                period === "pm" &&
                                hours !== 12
                            ) {

                                hours += 12;
                            }


                            if (
                                period === "am" &&
                                hours === 12
                            ) {

                                hours = 0;
                            }


                            return `${String(
                                hours
                            ).padStart(2, "0")}:${minutes}`;
                        }


                        const twentyFourHour =
                            text.match(
                                /^(\d{1,2}):(\d{2})$/
                            );


                        if (twentyFourHour) {

                            return `${String(
                                parseInt(
                                    twentyFourHour[1],
                                    10
                                )
                            ).padStart(
                                2,
                                "0"
                            )}:${twentyFourHour[2]}`;
                        }


                        return text;
                    }


                    // =========================================================
                    // OPEN CUSTOMER RESCHEDULE
                    // =========================================================

                    function openCustomerReschedule(jobId) {
                        if (isWalletZero()) {
                            showWalletZeroMessage();
                            return;
                        }


                        const numericJobId =
                            Number(jobId);


                        const job =
                            acceptedJobs.find(
                                j =>
                                    getJobId(j) ===
                                    numericJobId
                            )
                            ||
                            jobs.find(
                                j =>
                                    getJobId(j) ===
                                    numericJobId
                            );


                        if (!job) {

                            Swal.fire(
                                "Error",
                                "Booking not found.",
                                "error"
                            );

                            return;
                        }


                        // IMPORTANT:
                        // The popup opens only for an actual customer request.

                        if (!hasCustomerRescheduleRequest(job)) {

                            Swal.fire(
                                "No Customer Request",
                                "There is no customer reschedule request for this booking.",
                                "info"
                            );

                            return;
                        }


                        activeJobIndexId =
                            numericJobId;

                        activeJob =
                            job;


                        setText(
                            "rsOldDate",
                            formatDateForDisplay(
                                getJobDate(job)
                            )
                        );


                        setText(
                            "rsOldTime",
                            formatTimeForDisplay(
                                getJobTime(job)
                            )
                        );


                        setText(
                            "rsDate",
                            formatDateForDisplay(
                                getRequestedNewDate(job)
                            )
                        );


                        setText(
                            "rsTime",
                            formatTimeForDisplay(
                                getRequestedNewTime(job)
                            )
                        );


                        if (viewReschedModalObj) {

                            viewReschedModalObj.show();
                        }
                    }


                    // =========================================================
                    // ACCEPT CUSTOMER RESCHEDULE
                    // =========================================================

                    function acceptCustomerReschedule() {
                        if (isWalletZero()) {
                            showWalletZeroMessage();
                            return;
                        }


                        if (!activeJobIndexId) {

                            Swal.fire(
                                "Error",
                                "Booking not selected.",
                                "error"
                            );

                            return;
                        }


                        Swal.fire({

                            title:
                                "Accept Reschedule?",

                            text:
                                "The new date/time will replace the original booking date/time and the booking will be accepted.",

                            icon:
                                "question",

                            showCancelButton:
                                true,

                            confirmButtonColor:
                                "#28a745",

                            cancelButtonColor:
                                "#6c757d",

                            confirmButtonText:
                                "Yes, Accept",

                            cancelButtonText:
                                "Cancel"

                        }).then(result => {

                            if (!result.isConfirmed) {
                                return;
                            }


                            const button =
                                document.getElementById(
                                    "acceptReschedule"
                                );


                            if (button) {
                                button.disabled = true;
                            }


                            fetch(
                                '@Url.Action("AcceptReschedule", "Provider")?bookingId=' +
                                encodeURIComponent(
                                    activeJobIndexId
                                ),
                                {
                                    method:
                                        "POST",

                                    headers: {

                                        "RequestVerificationToken":
                                            getAntiForgeryToken()
                                    }
                                }
                            )
                            .then(async response => {

                                if (response.ok) {

                                    // Local UI state

                                    if (activeJob) {

                                        activeJob.rescheduleStatus =
                                            "accepted";

                                        activeJob.RescheduleStatus =
                                            "accepted";

                                        activeJob.rescheduledStatus =
                                            "accepted";

                                        activeJob.RescheduledStatus =
                                            "accepted";


                                        // The customer request is now complete.
                                        activeJob.hasRescheduleRequest =
                                            false;

                                        activeJob.HasRescheduleRequest =
                                            false;
                                    }


                                    if (viewReschedModalObj) {

                                        viewReschedModalObj.hide();
                                    }


                                    Swal.fire(
                                        "Accepted!",
                                        "Customer reschedule accepted. The new date/time has been applied and the booking is now accepted.",
                                        "success"
                                    ).then(() => {

                                        window.location.reload();
                                    });

                                } else {

                                    const message =
                                        await response.text();


                                    Swal.fire(
                                        "Error",
                                        message ||
                                        "Failed to accept reschedule request.",
                                        "error"
                                    );
                                }

                            })
                            .catch(error => {

                                console.error(
                                    "Accept reschedule error:",
                                    error
                                );


                                Swal.fire(
                                    "Error",
                                    "Something went wrong while accepting the reschedule request.",
                                    "error"
                                );

                            })
                            .finally(() => {

                                if (button) {

                                    button.disabled =
                                        false;
                                }
                            });
                        });
                    }


                    // =========================================================
                    // REJECT CUSTOMER RESCHEDULE
                    // =========================================================

                    function rejectCustomerReschedule() {
                        if (isWalletZero()) {
                            showWalletZeroMessage();
                            return;
                        }


                        if (!activeJobIndexId) {

                            Swal.fire(
                                "Error",
                                "Booking not selected.",
                                "error"
                            );

                            return;
                        }


                        Swal.fire({

                            title:
                                "Reject Reschedule?",

                            text:
                                "The original booking date and time will remain unchanged.",

                            icon:
                                "warning",

                            showCancelButton:
                                true,

                            confirmButtonColor:
                                "#6c757d",

                            cancelButtonColor:
                                "#d33",

                            confirmButtonText:
                                "Yes, Reject",

                            cancelButtonText:
                                "Cancel"

                        }).then(result => {

                            if (!result.isConfirmed) {
                                return;
                            }


                            const button =
                                document.getElementById(
                                    "rejectReschedule"
                                );


                            if (button) {
                                button.disabled = true;
                            }


                            fetch(
                                '@Url.Action("RejectReschedule", "Provider")?bookingId=' +
                                encodeURIComponent(
                                    activeJobIndexId
                                ),
                                {
                                    method:
                                        "POST",

                                    headers: {

                                        "RequestVerificationToken":
                                            getAntiForgeryToken()
                                    }
                                }
                            )
                            .then(async response => {

                                if (response.ok) {

                                    if (activeJob) {

                                        activeJob.rescheduleStatus =
                                            "rejected";

                                        activeJob.RescheduleStatus =
                                            "rejected";

                                        activeJob.rescheduledStatus =
                                            "rejected";

                                        activeJob.RescheduledStatus =
                                            "rejected";


                                        // The customer request is now complete.
                                        activeJob.hasRescheduleRequest =
                                            false;

                                        activeJob.HasRescheduleRequest =
                                            false;
                                    }


                                    if (viewReschedModalObj) {

                                        viewReschedModalObj.hide();
                                    }


                                    Swal.fire(
                                        "Rejected",
                                        "Customer reschedule request rejected. Original date and time remain unchanged.",
                                        "info"
                                    ).then(() => {

                                        fetchJobs();
                                    });

                                } else {

                                    const message =
                                        await response.text();


                                    Swal.fire(
                                        "Error",
                                        message ||
                                        "Failed to reject reschedule request.",
                                        "error"
                                    );
                                }

                            })
                            .catch(error => {

                                console.error(
                                    "Reject reschedule error:",
                                    error
                                );


                                Swal.fire(
                                    "Error",
                                    "Something went wrong while rejecting the reschedule request.",
                                    "error"
                                );

                            })
                            .finally(() => {

                                if (button) {

                                    button.disabled =
                                        false;
                                }
                            });
                        });
                    }


                    // =========================================================
                    // CUSTOMER CHAT
                    // =========================================================

                    function openCustomerChat(
                        formattedId,
                        encodedName
                    ) {

                        if (isWalletLocked()) {

                            showWalletLockedMessage();

                            return;
                        }


                        const cleanId =
                            cleanCustomerId(
                                formattedId
                            );


                        const decodedName =
                            decodeURIComponent(
                                encodedName || ""
                            );


                        const url =
                            '@Url.Action("Messages", "Provider")' +
                            "?customerCode=" +
                            encodeURIComponent(cleanId) +
                            "&customerName=" +
                            encodeURIComponent(decodedName);


                        window.location.href =
                            url;
                    }


                    // =========================================================
                    // COMPLAINT
                    // =========================================================

                    function hasProviderComplaintFiled(job) {
                        if (!job) {
                            return false;
                        }

                        const serverFlag =
                            job.hasProviderComplaint ??
                            job.HasProviderComplaint ??
                            job.providerComplaintFiled ??
                            job.ProviderComplaintFiled ??
                            job.hasComplaint ??
                            job.HasComplaint ??
                            job.isComplaintFiled ??
                            job.IsComplaintFiled;

                        if (serverFlag === true || String(serverFlag).toLowerCase() === "true") {
                            return true;
                        }

                        const jobId = getJobId(job);
                        if (!jobId) {
                            return false;
                        }

                        return localStorage.getItem(
                            `servicego_provider_complaint_${currentProviderId}_${jobId}`
                        ) === "1";
                    }

                    function markProviderComplaintFiled(jobId) {
                        if (!jobId) {
                            return;
                        }

                        localStorage.setItem(
                            `servicego_provider_complaint_${currentProviderId}_${jobId}`,
                            "1"
                        );

                        const all = [
                            jobs,
                            acceptedJobs,
                            completedJobs
                        ];

                        all.forEach(list => {
                            if (!Array.isArray(list)) return;

                            const found = list.find(
                                j => getJobId(j) === Number(jobId)
                            );

                            if (found) {
                                found.providerComplaintFiled = true;
                                found.hasProviderComplaint = true;
                            }
                        });
                    }

                    function openProviderComplaintById(jobId) {
                        const numericId = Number(jobId);

                        const job =
                            jobs.find(j => getJobId(j) === numericId) ||
                            acceptedJobs.find(j => getJobId(j) === numericId) ||
                            completedJobs.find(j => getJobId(j) === numericId);

                        if (!job) {
                            Swal.fire(
                                "Error",
                                "Booking not found.",
                                "error"
                            );
                            return;
                        }

                        if (hasProviderComplaintFiled(job)) {
                            Swal.fire(
                                "Complaint Already Filed",
                                "You can file only one complaint for this booking.",
                                "info"
                            );
                            return;
                        }

                        openProviderComplaint(job);
                    }


                    function openProviderComplaint(job) {
                        if (!job) {
                            Swal.fire("Error", "Booking not found.", "error");
                            return;
                        }

                        const modalElement = document.getElementById("providerComplaintModal");
                        const form = document.getElementById("providerComplaintForm");

                        if (!modalElement || !form) {
                            Swal.fire("Error", "Complaint form was not found.", "error");
                            return;
                        }

                        const jobId = getJobId(job);
                        const customerId = getCustomerFormattedId(job) || job.customerId || job.CustomerId || "";
                        const customerName = getCustomerName(job) || "Customer";
                        const customerEmail = job.customerEmail || job.CustomerEmail || "";

                        document.getElementById("providerComplaintBookingId").value = jobId || "";
                        document.getElementById("providerComplaintCustomerId").value = customerId;
                        document.getElementById("providerComplaintCustomerName").value = customerName;
                        document.getElementById("providerComplaintCustomerEmail").value = customerEmail;

                        document.getElementById("providerIssueTitle").value = "";
                        document.getElementById("providerOtherIssueText").value = "";
                        document.getElementById("providerComplaintDetails").value = "";
                        document.getElementById("providerOtherBox").style.display = "none";

                        const idInput = document.getElementById("providerComplaintId");
                        const idDisplay = document.getElementById("providerComplaintIdDisplay");
                        idDisplay.value = idInput.value || "COMP-1";

                        providerComplaintModalObj = bootstrap.Modal.getOrCreateInstance(modalElement);
                        providerComplaintModalObj.show();
                    }

                    function fileComplaintFromModal() {
                        const job =
                            activeJob ||
                            jobs.find(j => getJobId(j) === Number(activeJobIndexId)) ||
                            acceptedJobs.find(j => getJobId(j) === Number(activeJobIndexId)) ||
                            completedJobs.find(j => getJobId(j) === Number(activeJobIndexId));

                        if (!job) {
                            Swal.fire("Error", "Booking not found.", "error");
                            return;
                        }

                        if (detailsModalObj) {
                            detailsModalObj.hide();
                        }

                        openProviderComplaint(job);
                    }


                    // =========================================================
                    // CLEAN CUSTOMER ID
                    // =========================================================

                    function cleanCustomerId(id) {
                        if (id === null || id === undefined) {
                            return "";
                        }

                        let value = String(id).trim();

                        // Remove every existing CUS prefix first.
                        while (/^CUS(?:-)?/i.test(value)) {
                            value = value.replace(/^CUS(?:-)?/i, "").trim();
                        }

                        return value ? "CUS-" + value : "";
                    }


                    // =========================================================
                    // TODAY DATE
                    // =========================================================

                    function getTodayDate() {

                        const today =
                            new Date();


                        const year =
                            today.getFullYear();


                        const month =
                            String(
                                today.getMonth() + 1
                            ).padStart(
                                2,
                                "0"
                            );


                        const day =
                            String(
                                today.getDate()
                            ).padStart(
                                2,
                                "0"
                            );


                        return `${year}-${month}-${day}`;
                    }


                    // =========================================================
                    // ANTI FORGERY TOKEN
                    // =========================================================

                    function getAntiForgeryToken() {

                        const token =
                            document.querySelector(
                                'input[name="__RequestVerificationToken"]'
                            );


                        return token
                            ? token.value
                            : "";
                    }


                    // =========================================================
                    // SET TEXT
                    // =========================================================

                    function setText(
                        elementId,
                        value
                    ) {

                        const element =
                            document.getElementById(
                                elementId
                            );


                        if (element) {

                            element.innerText =
                                value ?? "";
                        }
                    }


                    // =========================================================
                    // HTML ESCAPE
                    // =========================================================

                    function escapeHtml(value) {

                        if (
                            value === null ||
                            value === undefined
                        ) {

                            return "";
                        }


                        return String(value)
                            .replace(
                                /&/g,
                                "&amp;"
                            )
                            .replace(
                                /</g,
                                "&lt;"
                            )
                            .replace(
                                />/g,
                                "&gt;"
                            )
                            .replace(
                                /"/g,
                                "&quot;"
                            )
                            .replace(
                                /'/g,
                                "&#039;"
                            );
                    }


                    // =========================================================
                    // JAVASCRIPT STRING ESCAPE
                    // =========================================================

                    function escapeJs(value) {

                        if (
                            value === null ||
                            value === undefined
                        ) {

                            return "";
                        }


                        return String(value)
                            .replace(
                                /\\/g,
                                "\\\\"
                            )
                            .replace(
                                /'/g,
                                "\\'"
                            )
                            .replace(
                                /\r/g,
                                "\\r"
                            )
                            .replace(
                                /\n/g,
                                "\\n"
                            );
                    }



                    // =========================================================
                    // PROVIDER COMPLAINT FORM
                    // =========================================================

                    document.addEventListener("DOMContentLoaded", function () {

                        const issueTitle = document.getElementById("providerIssueTitle");
                        const otherBox = document.getElementById("providerOtherBox");
                        const otherInput = document.getElementById("providerOtherIssueText");
                        const complaintDetailsBox = document.getElementById("providerComplaintDetailsBox");

                        function updateProviderComplaintFields() {
                            if (!issueTitle) return;

                            const hasIssueSelected = issueTitle.value.trim() !== "";
                            const isOther = issueTitle.value === "Other";

                            if (otherBox) {
                                otherBox.style.display = isOther ? "block" : "none";
                            }

                            if (otherInput) {
                                otherInput.required = isOther;
                            }

                            if (complaintDetailsBox) {
                                complaintDetailsBox.style.display =
                                    hasIssueSelected ? "block" : "none";
                            }
                        }

                        if (issueTitle) {
                            issueTitle.addEventListener("change", updateProviderComplaintFields);
                            updateProviderComplaintFields();
                        }

                        const complaintForm =
                            document.getElementById("providerComplaintForm");

                        if (!complaintForm) return;

                        complaintForm.addEventListener("submit", async function (event) {
                            event.preventDefault();

                            if (!complaintForm.checkValidity()) {
                                complaintForm.reportValidity();
                                return;
                            }

                            const submitBtn =
                                document.getElementById("providerSubmitComplaintBtn");

                            const originalText = submitBtn.innerHTML;
                            submitBtn.disabled = true;
                            submitBtn.innerHTML =
                                '<i class="bi bi-hourglass-split me-1"></i> Sending...';

                            try {
                                const response = await fetch(
                                    complaintForm.action,
                                    {
                                        method: "POST",
                                        headers: {
                                            "X-Requested-With": "XMLHttpRequest"
                                        },
                                        body: new FormData(complaintForm)
                                    }
                                );

                                let result = {};
                                try {
                                    result = await response.json();
                                } catch {
                                    result = {};
                                }

                                if (!response.ok || !result.success) {
                                    throw new Error(
                                        result.message ||
                                        "Unable to submit complaint."
                                    );
                                }

                                if (result.complaintId) {
                                    const number =
                                        parseInt(
                                            String(result.complaintId).replace(/\D/g, ""),
                                            10
                                        );

                                    if (!Number.isNaN(number)) {
                                        const nextId = "COMP-" + (number + 1);
                                        document.getElementById("providerComplaintId").value = nextId;
                                        document.getElementById("providerComplaintIdDisplay").value = nextId;
                                    }
                                }

                                const submittedBookingId =
                                    document.getElementById("providerComplaintBookingId").value;

                                markProviderComplaintFiled(submittedBookingId);

                                if (providerComplaintModalObj) {
                                    providerComplaintModalObj.hide();
                                }

                                // Remove the File Complaint button immediately.
                                renderCards();
                                applyProviderCompletedLoadMore();
                                updateProviderBookingTabs();

                                await Swal.fire({
                                    icon: "success",
                                    title: "Complaint Submitted Successfully!",
                                    text:
                                        result.message ||
                                        "Your complaint has been submitted successfully. Our support team will review it within 24 hours.",
                                    confirmButtonColor: "#e74c3c"
                                });

                            } catch (error) {
                                console.error("Provider complaint submit error:", error);

                                Swal.fire(
                                    "Complaint Submit Error",
                                    error.message ||
                                    "Something went wrong while submitting your complaint.",
                                    "error"
                                );
                            } finally {
                                submitBtn.disabled = false;
                                submitBtn.innerHTML = originalText;
                            }
                        });
                    });

    </script>




    <script id="servicego-provider-booking-tabs">
        document.addEventListener("DOMContentLoaded", function () {
            const tabs = document.querySelectorAll(".provider-booking-tab");
            const sections = document.querySelectorAll(".provider-booking-section");

            tabs.forEach(function (tab) {
                tab.addEventListener("click", function () {
                    const target = tab.dataset.bookingTab;

                    tabs.forEach(function (item) {
                        const active = item === tab;
                        item.classList.toggle("active", active);
                        item.setAttribute("aria-selected", active ? "true" : "false");
                    });

                    sections.forEach(function (section) {
                        section.classList.toggle(
                            "active",
                            section.dataset.bookingSection === target
                        );
                    });

                    if (target === "completed") {
                        applyProviderCompletedLoadMore();
                    }
                });
            });

            updateProviderBookingTabs();
        });

        function updateProviderBookingTabs() {
            const pendingCount = document.getElementById("providerPendingBookingCount");
            const acceptedCount = document.getElementById("providerAcceptedBookingCount");
            const completedCount = document.getElementById("providerCompletedBookingCount");

            if (pendingCount) pendingCount.textContent = Array.isArray(jobs) ? jobs.length : 0;
            if (acceptedCount) acceptedCount.textContent = Array.isArray(acceptedJobs) ? acceptedJobs.length : 0;
            if (completedCount) completedCount.textContent = Array.isArray(completedJobs) ? completedJobs.length : 0;

            const completedSection = document.getElementById("providerCompletedSection");
            if (completedSection) {
                applyProviderCompletedLoadMore();
            }
        }

        function applyProviderCompletedLoadMore() {
            const container = document.getElementById("completedContainer");
            const wrap = document.getElementById("providerCompletedLoadMoreWrap");

            if (!container || !wrap) return;

            const cards = Array.from(
                container.querySelectorAll(":scope > .col-12, :scope > .col-md-6, :scope > .col-lg-6")
            ).filter(function (item) {
                return item.querySelector(".job-card");
            });

            wrap.innerHTML = "";

            if (cards.length <= 15) {
                cards.forEach(function (card) {
                    card.hidden = false;
                });
                return;
            }

            const maxVisible = Math.min(cards.length, 30);
            let visibleCount = 15;

            const button = document.createElement("button");
            button.type = "button";
            button.className = "provider-load-more-btn";
            button.textContent = "Load More";
            button.setAttribute("aria-controls", "completedContainer");
            button.setAttribute("aria-expanded", "false");

            wrap.appendChild(button);

            function update() {
                cards.forEach(function (card, index) {
                    card.hidden = index >= visibleCount;
                });

                if (visibleCount >= maxVisible) {
                    button.textContent = "Show Less";
                    button.setAttribute("aria-expanded", "true");
                } else {
                    button.textContent = "Load More";
                    button.setAttribute("aria-expanded", "false");
                }
            }

            button.addEventListener("click", function () {
                if (visibleCount >= maxVisible) {
                    visibleCount = 15;
                } else {
                    visibleCount = Math.min(
                        visibleCount + 15,
                        maxVisible
                    );
                }

                update();
            });

            update();
        }
    </script>
    <script id="servicego-ampm-time-input-fix">
                document.addEventListener("input", function (event) {
                    const id = event.target && event.target.id;
                    if (["pNewHour","pNewMinute","newHourInput","newMinuteInput"].includes(id)) {
                        event.target.value = event.target.value.replace(/\D/g, "").slice(0, 2);
                    }
                });

        // =====================================================
        // OPEN BOOKING FROM NOTIFICATION
        // =====================================================
        document.addEventListener("DOMContentLoaded", function () {
            const params = new URLSearchParams(window.location.search);
            const notificationBookingId = Number(params.get("bookingId"));

            if (!Number.isFinite(notificationBookingId) || notificationBookingId <= 0) {
                return;
            }

            /*
             * IMPORTANT:
             * Notification clicks must open the real booking even when that
             * booking is not present in the already-loaded JS arrays.
             *
             * Previously showJobDetails(id) searched only jobs /
             * acceptedJobs / completedJobs. If the dashboard had not loaded
             * that booking into one of those arrays, it showed:
             * "Booking not found."
             *
             * Get the authoritative booking details from the server first,
             * insert the fresh booking into the correct array, then use the
             * existing View Details modal.
             */
            let attempts = 0;

            const openFromNotification = setInterval(async function () {
                attempts++;

                try {
                    if (typeof showJobDetails !== "function") {
                        if (attempts >= 40) {
                            clearInterval(openFromNotification);
                        }
                        return;
                    }

                    clearInterval(openFromNotification);

                    const response = await fetch(
                        '@Url.Action("GetBookingDetails", "Provider")?bookingId=' +
                        encodeURIComponent(notificationBookingId),
                        {
                            method: "GET",
                            headers: {
                                "Accept": "application/json"
                            }
                        }
                    );

                    if (!response.ok) {
                        throw new Error("Booking could not be loaded.");
                    }

                    const booking = await response.json();

                    if (!booking || booking.success === false || !booking.id) {
                        throw new Error("Booking could not be loaded.");
                    }

                    /*
                     * Remove any old copy first. This is important when the
                     * booking changed from Pending -> Accepted -> Completed.
                     * The modal must use the CURRENT server state.
                     */
                    const removeExistingBooking = function (list) {
                        if (!Array.isArray(list)) {
                            return;
                        }

                        for (let i = list.length - 1; i >= 0; i--) {
                            if (getJobId(list[i]) === notificationBookingId) {
                                list.splice(i, 1);
                            }
                        }
                    };

                    removeExistingBooking(jobs);
                    removeExistingBooking(acceptedJobs);
                    removeExistingBooking(completedJobs);

                    const currentStatus =
                        String(
                            booking.status ||
                            booking.Status ||
                            ""
                        ).trim().toLowerCase();

                    if (currentStatus === "completed") {
                        completedJobs.push(booking);
                    } else if (currentStatus === "accepted") {
                        acceptedJobs.push(booking);
                    } else {
                        jobs.push(booking);
                    }

                    /*
                     * Existing modal remains unchanged; it now receives the
                     * fresh server booking and opens View Details normally.
                     */
                    showJobDetails(notificationBookingId);

                    // Remove the query string after opening so refresh does not
                    // repeatedly reopen the same booking.
                    const cleanUrl =
                        window.location.pathname +
                        window.location.hash;

                    window.history.replaceState(
                        {},
                        document.title,
                        cleanUrl
                    );
                } catch (error) {
                    console.error(
                        "ServiceGo notification booking open error:",
                        error
                    );

                    Swal.fire(
                        "Error",
                        "Booking details could not be loaded. Please try again.",
                        "error"
                    );
                }
            }, 250);
        });

    </script>
