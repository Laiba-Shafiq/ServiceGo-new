            input[type="button"], input[type="submit"], input[type="reset"],
            input[type="checkbox"], input[type="radio"], input[type="file"], select {
                caret-color: transparent !important;
            }

        /* =========================================================
                                                                   PROVIDER MOBILE GREETING
                                                                   Same greeting as the Provider Dashboard.
                                                                   ========================================================= */
        .mobile-provider-area {
            display: flex !important;
            align-items: center !important;
            justify-content: flex-end !important;
            gap: 10px !important;
        }

        .mobile-provider-greeting {
            color: #d97600 !important;
            font-size: 15px !important;
            font-weight: 700 !important;
            white-space: nowrap !important;
            line-height: 1 !important;
        }

        @@media (max-width: 768px) {
            .mobile-provider-area {
                display: flex !important;
                align-items: center !important;
            }

            .mobile-provider-greeting {
                display: inline-flex !important;
                align-items: center !important;
            }
        }

        @@media (min-width: 769px) {
            .mobile-provider-area {
                display: none !important;
            }
        }</style>
</head>
<body>


    <div class="mobile-top">
        <a href="@Url.Action("Index", "Home")" aria-label="ServiceGo Home">
            <img src="@Url.Content("~/images/Logo.png")" class="logo" alt="ServiceGo" />
        </a>
        <div class="mobile-provider-area">
            <span class="mobile-provider-greeting">Hi Provider</span>
            <div class="dropdown">
                <img src="@providerProfileImage" class="profile-thumb dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" alt="Profile" />
                <ul class="dropdown-menu dropdown-menu-end mobile-dropdown-menu">
                    <li>
                        <a class="dropdown-item active" href="@Url.Action("Dashboard", "Provider")"><i class="bi bi-house-door"></i>Dashboard</a><a class="dropdown-item" href="@Url.Action("Profile", "Provider")"><i class="bi bi-person"></i>Profile</a><a class="dropdown-item" href="@Url.Action("Messages", "Provider")"><i class="bi bi-chat-dots"></i>Messages</a><a class="dropdown-item" href="@Url.Action("History", "Provider")"><i class="bi bi-clock-history"></i>History</a><a class="dropdown-item" href="@Url.Action("Notifications", "Provider")">
                            <i class="bi bi-bell"></i>
                            Notifications
                            @if (providerUnreadCount > 0)
                            {
                                <span class="provider-mobile-unread-badge">@providerUnreadCount</span>
                            }
                        </a><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Provider")"><i class="bi bi-box-arrow-right"></i>Logout</a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="sidebar">
        <a href="@Url.Action("Index", "Home")" aria-label="ServiceGo Home">
            <img src="@Url.Content("~/images/Logo.png")" class="logo" alt="ServiceGo" />
        </a>
        <div class="provider-nav-greeting">Hi Provider</div>
        <div class="nav">
            <a href="@Url.Action("Dashboard", "Provider")" class="active"><i class="bi bi-house-door"></i><span>Dashboard</span></a>
            <a href="@Url.Action("Profile", "Provider")"><i class="bi bi-person"></i><span>Profile</span></a>
            <a href="@Url.Action("Messages", "Provider")"><i class="bi bi-chat-dots"></i><span>Messages</span></a>
            <a href="@Url.Action("History", "Provider")"><i class="bi bi-clock-history"></i><span>History</span></a>
            <a href="@Url.Action("Notifications", "Provider")">
                <i class="bi bi-bell"></i>
                <span>Notifications</span>
                @if (providerUnreadCount > 0)
                {
                    <span class="sidebar-unread-badge">@providerUnreadCount</span>
                }
            </a>
            <a href="@Url.Action("Logout", "Provider")"><i class="bi bi-box-arrow-right"></i><span>Logout</span></a>
        </div>
    </div>

    <div class="main">
        <div class="row align-items-stretch g-4 mb-4">
            <div class="col-12 col-md-7 d-flex">
                <div class="profile-card w-100">
                    <img src="@providerProfileImage" alt="Profile">
                    <div>
                        <h3 class="provider-dashboard-name text-start mb-1 fw-bolder" style="color:#000; font-size:28px;"><span class="provider-dashboard-fullname">@Model.FullName</span> <span id="currentProviderIdDisplay" class="provider-dashboard-id">(@Model.ProviderId)</span></h3>
                        <p class="mb-1"><strong>Location:</strong> @Model.Location</p>
                        <p class="mb-1"><strong>Phone:</strong> @Model.Phone</p>
                        <p class="mb-1"><strong>Email:</strong> @Model.Email</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-5 d-flex">
                <div class="wallet-card w-100 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-2 text-dark"><i class="bi bi-wallet2 text-warning me-2"></i>My Provider Wallet</h5>
                        <p class="mb-1 text-muted">Current Balance</p>
                        <h2 class="fw-bold text-success mb-2">Rs. <span id="walletBalanceText">@Model.WalletBalance</span></h2>
                    </div>
                    <div>
                        <button type="button" class="btn-wallet-orange w-100 mb-2 py-2" onclick="openWalletModal()">
                            <i class="bi bi-plus-circle me-2"></i>Add Money / Send Visit Charges
                        </button>
                        <div class="text-muted" style="font-size: 11px;">
                            *Pending Approvals: <span id="pendingRequestsCount" class="fw-bold">@Model.PendingApprovalsCount</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>



        <!-- =========================================================
             PROVIDER BOOKING STATUS TABS
             ========================================================= -->
        <div class="provider-booking-tabs" role="tablist" aria-label="Booking status">
            <button type="button"
                    class="provider-booking-tab active"
                    data-booking-tab="pending"
                    role="tab"
                    aria-selected="true">
                <i class="bi bi-hourglass-split"></i>
                <span>Pending</span>
                <span class="provider-booking-count" id="providerPendingBookingCount">0</span>
            </button>

            <button type="button"
                    class="provider-booking-tab"
                    data-booking-tab="accepted"
                    role="tab"
                    aria-selected="false">
                <i class="bi bi-calendar-check"></i>
                <span>Accepted</span>
                <span class="provider-booking-count" id="providerAcceptedBookingCount">0</span>
            </button>

            <button type="button"
                    class="provider-booking-tab"
                    data-booking-tab="completed"
                    role="tab"
                    aria-selected="false">
                <i class="bi bi-check-circle"></i>
                <span>Completed</span>
                <span class="provider-booking-count" id="providerCompletedBookingCount">0</span>
            </button>
        </div>

        <section id="providerPendingSection"
                 class="provider-booking-section active"
                 data-booking-section="pending">
            <div class="provider-booking-section-heading">
                <div>
                    <h3>Current Job Requests</h3>

                </div>
            </div>
            <div class="row g-4 mb-4" id="requestContainer"></div>
        </section>

        <section id="providerAcceptedSection"
                 class="provider-booking-section"
                 data-booking-section="accepted">
            <div class="provider-booking-section-heading">
                <div>
                    <h3 class="text-success">Your Accepted Bookings</h3>

                </div>
            </div>
            <div class="row g-4 mb-4" id="acceptedContainer"></div>
        </section>

        <section id="providerCompletedSection"
                 class="provider-booking-section"
                 data-booking-section="completed">
            <div class="provider-booking-section-heading">
                <div>
                    <h3 class="text-primary">Completed Bookings</h3>

                </div>
            </div>
            <div class="row g-4 mb-2" id="completedContainer"></div>
            <div id="providerCompletedLoadMoreWrap" class="text-center"></div>
        </section>
    </div>

    <!-- Modals -->
    <div class="modal fade" id="walletModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-4 rounded-4">
                <h4 class="fw-bold mb-3 text-center">Send Visit Charges / Deposit</h4>
                <hr />
                <div class="modal-body">
                    <h5 class="fw-bold text-dark mb-3 text-center">Payment Methods</h5>
                    <div class="p-3 bg-light rounded-3 mb-3 border-start border-3 border-danger">
                        <p class="mb-1 fw-bold text-danger"><i class="bi bi-phone-fill"></i> EasyPaisa</p>
                        <p class="mb-0 fs-5 fw-bolder text-dark">03444241811</p>
                        <small class="text-muted">Account Title: HASIBA SHAUKAT</small>
                    </div>
                  

                    <form action="/Provider/SubmitWalletRequest" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-bold">Amount Sent (Rs.)</label>
                            <input type="number" name="Amount" class="form-control" placeholder="e.g. 500" min="1" step="1" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Upload Transaction Receipt</label>
                            <input type="file" name="receiptImage" class="form-control" accept="image/*" required />
                        </div>

                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <button type="submit" class="btn btn-modal-orange px-4">Submit to Admin</button>
                            <button type="button" class="btn btn-modal-mid-gray px-4" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="jobDetailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content p-4 rounded-4">
                <h4 class="fw-bold mb-3 text-center">Job Details</h4>
                <div class="modal-body">
                    <p><strong>Customer ID:</strong> <span id="custFormattedId"></span></p>
                    <p><strong>Customer Name:</strong> <span id="custName"></span></p>
                    <p><strong>Service:</strong> <span id="custService"></span></p>
                    <p><strong>Service Type:</strong> <span id="custServiceType" class="badge bg-info text-dark fw-bold"></span></p>
                    <p><strong>Written Address:</strong> <span id="custLocation"></span></p>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="fw-bold text-danger mb-0"><i class="bi bi-geo-alt-fill"></i> Live Location:</label>
                            <a id="custLiveLocationLink" href="#" target="_blank" class="btn btn-primary btn-sm fw-bold px-2 py-1" style="font-size: 12px;">
                                <i class="bi bi-map-fill me-1"></i> Open in Google Maps
                            </a>
                        </div>
                        <div id="googleMap" style="height: 250px; width: 100%; border-radius: 8px; border: 1px solid #ddd;"></div>
                    </div>

                    <p><strong>Date:</strong> <span id="custDate"></span></p>
                    <p><strong>Time:</strong> <span id="custTime"></span></p>

                    <div class="p-3 my-3 bg-light rounded-3 border-start border-3 border-warning">
                        <p class="mb-1"><strong><i class="bi bi-arrow-left-right text-warning me-1"></i> Distance:</strong> <span id="custDistance" class="fw-bold text-dark"></span> KM</p>
                        <p class="mb-1"><strong><i class="bi bi-cash-stack text-success me-1"></i> Visit Charges:</strong> Rs. <span id="custVisitCharge" class="fw-bold text-success"></span></p>
                        <p class="mb-0"><strong class="text-dark"><i class="bi bi-percent text-dark me-1"></i> Platform Commission: Rs. 10 per accepted booking</strong></p>
                    </div>

                    <p><strong>Problem:</strong> <span id="custIssue"></span></p>
                    <div class="mt-3">
                        <label class="fw-bold d-block mb-1">Issue Picture:</label>
                        <img id="custImg" class="img-fluid rounded border" alt="Problem image" style="max-height: 200px; width: 100%; object-fit: cover;" />
                    </div>
                    <div id="jobActionButtons" class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
                        <button id="acceptBtn" class="btn btn-modal-orange px-4" onclick="acceptCurrentJob()">Accept</button>
                        <button id="rescheduleBtn"
                                type="button"
                                class="btn btn-modal-mid-gray px-4">
                            Reschedule
                        </button>
                        <button id="rejectBtn" class="btn btn-modal-orange px-4" onclick="rejectCurrentJob()">Reject</button>
                        <button id="detailsMessageBtn"
                                type="button"
                                class="btn btn-modal-orange px-4"
                                style="display:none;"
                                onclick="messageCurrentJob()">
                            <i class="bi bi-chat-dots-fill me-1"></i> Message
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="providerRescheduleModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-4 rounded-4">

                <h4 class="fw-bold mb-3 text-center">
                    Reschedule Job
                </h4>

                <div class="modal-body">

                    <!-- ========================================= -->
                    <!-- CURRENT BOOKING -->
                    <!-- ========================================= -->

                    <div class="p-3 bg-light rounded-3 mb-3 border-start border-3 border-warning">

                        <h6 class="fw-bold mb-3">
                            <i class="bi bi-calendar-event me-2"></i>
                            Current Booking
                        </h6>

                        <div class="row">

                            <div class="col-md-6 mb-2 mb-md-0">

                                <strong>
                                    Current Date:
                                </strong>

                                <span id="pCurrentDate"
                                      class="text-dark">
                                    N/A
                                </span>

                            </div>

                            <div class="col-md-6">

                                <strong>
                                    Current Time:
                                </strong>

                                <span id="pCurrentTime"
                                      class="text-dark">
                                    N/A
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- ========================================= -->
                    <!-- NEW DATE -->
                    <!-- ========================================= -->

                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            New Date
                        </label>

                        <input type="date"
                               id="pNewDate"
                               min=""
                               class="form-control"
                               style="border: 2px solid #f0ad4e;"
                               required />

                        <div id="pNewDateError" class="text-danger small fw-semibold mt-1" style="display:none;"></div>

                    </div>


                    <!-- ========================================= -->
                    <!-- NEW TIME -->
                    <!-- ========================================= -->

                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            New Time
                        </label>

                        <input type="time"
                               id="pNewTime"
                               class="form-control"
                               aria-label="New Time"
                               step="60"
                               style="border:2px solid #f0ad4e;"
                               required />

                        <div id="pNewTimeError" class="text-danger small fw-semibold mt-1" style="display:none;"></div>

                    </div>


                    <!-- ========================================= -->
                    <!-- ACTION BUTTONS -->
                    <!-- ========================================= -->

                    <div class="d-flex justify-content-center gap-3 mt-4">

                        <button id="sendReschedRequest"
                                type="button"
                                class="btn btn-modal-orange px-4"
                                onclick="submitProviderReschedule()">

                            <i class="bi bi-send me-1"></i>
                            Send Reschedule Request

                        </button>


                        <button type="button"
                                class="btn btn-modal-mid-gray px-4"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                    </div>

                </div>

            </div>
        </div>
    </div>

    <div class="modal fade" id="viewRescheduleModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-4 rounded-4">

                <h4 class="fw-bold mb-3 text-center">
                    Customer Reschedule Request
                </h4>

                <div class="modal-body">

                    <div class="p-3 bg-light rounded-3 mb-3">
                        <p class="mb-2 fw-bold">
                            <i class="bi bi-calendar-x me-1"></i>
                            Old Date:
                            <span id="rsOldDate"></span>
                        </p>

                        <p class="mb-0 fw-bold">
                            <i class="bi bi-clock me-1"></i>
                            Old Time:
                            <span id="rsOldTime"></span>
                        </p>
                    </div>

                    <div class="p-3 bg-light rounded-3">
                        <p class="mb-2 fw-bold text-success">
                            <i class="bi bi-calendar-check me-1"></i>
                            New Date:
                            <span id="rsDate"></span>
                        </p>

                        <p class="mb-0 fw-bold text-success">
                            <i class="bi bi-clock me-1"></i>
                            New Time:
                            <span id="rsTime"></span>
                        </p>
                    </div>

                    <div class="d-flex justify-content-center gap-3 mt-4">

                        <button id="acceptReschedule"
                                class="btn btn-modal-orange px-4"
                                onclick="acceptCustomerReschedule()">
                            Accept
                        </button>

                        <button id="rejectReschedule"
                                class="btn btn-modal-mid-gray px-4"
                                onclick="rejectCustomerReschedule()">
                            Reject
                        </button>

                    </div>

                </div>
            </div>
        </div>
    </div>




    <!-- =========================================================
         PROVIDER COMPLAINT MODAL
         ========================================================= -->
    <div class="modal fade complaint-modal"
         id="providerComplaintModal"
         tabindex="-1"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold" style="color:#e74c3c;">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        Submit a Complaint
                    </h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <form id="providerComplaintForm"
                          method="post"
                          action="@Url.Action("Complaint", "Provider")">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Complaint ID</label>
                            <input type="text"
                                   id="providerComplaintIdDisplay"
                                   class="form-control"
                                   value="@(ViewBag.NextComplaintId ?? "COMP-1")"
                                   readonly
                                   style="background-color:#e9ecef; font-weight:600;" />
                            <input type="hidden"
                                   id="providerComplaintId"
                                   name="ComplaintId"
                                   value="@(ViewBag.NextComplaintId ?? "COMP-1")" />
                        </div>

                        <input type="hidden" name="ComplaintType"
                               value="Provider vs Customer" />
                        <input type="hidden" id="providerComplaintBookingId"
                               name="BookingId" value="" />

                        <div class="mb-3">
                            <label class="form-label">Provider ID</label>
                            <input type="text"
                                   name="ProviderId"
                                   class="form-control"
                                   value="@Model.ProviderId"
                                   readonly
                                   style="background-color:#e9ecef;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Provider Name</label>
                            <input type="text"
                                   name="ProviderName"
                                   class="form-control"
                                   value="@Model.FullName"
                                   readonly
                                   style="background-color:#e9ecef;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Customer ID</label>
                            <input type="text"
                                   id="providerComplaintCustomerId"
                                   name="CustomerId"
                                   class="form-control"
                                   value=""
                                   readonly
                                   style="background-color:#e9ecef;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Customer Name</label>
                            <input type="text"
                                   id="providerComplaintCustomerName"
                                   name="CustomerName"
                                   class="form-control"
                                   value=""
                                   readonly
                                   style="background-color:#e9ecef;" />
                        </div>

                        <input type="hidden"
                               id="providerComplaintCustomerEmail"
                               name="CustomerEmail" value="" />

                        <div class="mb-3">
                            <label for="providerIssueTitle" class="form-label">
                                Issue Category
                            </label>
                            <select class="form-select"
                                    id="providerIssueTitle"
                                    name="OtherIssue"
                                    required>
                                <option value="">Select issue</option>
                                <option value="Late Arrival">Late Arrival</option>
                                <option value="Customer Unavailable">Customer Unavailable</option>
                                <option value="Incorrect Information">Incorrect Information</option>
                                <option value="Unprofessional Behavior">Unprofessional Behavior</option>
                                <option value="Payment Issue">Payment Issue</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="mb-3" id="providerOtherBox" style="display:none;">
                            <label for="providerOtherIssueText" class="form-label">
                                Specify Other Issue
                            </label>
                            <input type="text"
                                   name="OtherIssueText"
                                   id="providerOtherIssueText"
                                   class="form-control" />
                        </div>

                        <div class="mb-3" id="providerComplaintDetailsBox" style="display:none;">
                            <label for="providerComplaintDetails" class="form-label">
                                Complaint Details <span class="text-muted">(Optional)</span>
                            </label>
                            <textarea class="form-control"
                                      id="providerComplaintDetails"
                                      name="ComplaintDetails"
                                      rows="4"
                                      maxlength="2000"
                                      placeholder="Describe your issue in detail..."></textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-secondary px-4"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>
                            <button type="submit"
                                    id="providerSubmitComplaintBtn"
                                    class="complaint-submit-btn">
                                <i class="bi bi-send me-1"></i>
                                Submit Complaint
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=@googleMapsApiKey"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["SuccessMessage"] != null)
    {
        <div id="dashboardSuccessMessage" class="d-none">
            @TempData["SuccessMessage"]
        </div>
    }

    <script>
                    // =========================================================
                    // GLOBAL VARIABLES
                    // =========================================================

                    let walletBalance = Number(@Model.WalletBalance) || 0;
                    const minimumWalletBalance = 0;
                    let pendingDeposits = 0;
                    const currentProviderId = "@Model.ProviderId";

                    let jobs = [];
                    let acceptedJobs = [];
                    let completedJobs = [];

                    let activeJobIndexId = null;
                    let activeJob = null;

                    let googleMapInstance = null;

                    let container = null;
                    let acceptedContainer = null;
                    let completedContainer = null;

                    let walletModalObj = null;
                    let detailsModalObj = null;
                    let viewReschedModalObj = null;
                    let providerReschedModalObj = null;


                                 let providerComplaintModalObj = null;
        // =========================================================
                    // PAGE LOAD
                    // =========================================================

                    document.addEventListener("DOMContentLoaded", function () {

                        container = document.getElementById("requestContainer");
                        acceptedContainer = document.getElementById("acceptedContainer");
                        completedContainer = document.getElementById("completedContainer");

                        const walletModal =
                            document.getElementById("walletModal");

                        const detailsModal =
                            document.getElementById("jobDetailsModal");

                        const viewRescheduleModal =
                            document.getElementById("viewRescheduleModal");

                        const providerRescheduleModal =
                            document.getElementById("providerRescheduleModal");


                        if (walletModal) {
                            walletModalObj = new bootstrap.Modal(walletModal);
                        }

                        if (detailsModal) {
                            detailsModalObj = new bootstrap.Modal(detailsModal);
                        }

                        if (viewRescheduleModal) {
                            viewReschedModalObj =
                                new bootstrap.Modal(viewRescheduleModal);
                        }

                        if (providerRescheduleModal) {
                            providerReschedModalObj =
                                new bootstrap.Modal(providerRescheduleModal);
                        }


                        // =====================================================
                        // IMPORTANT
                        // The View Details popup does not contain a Reschedule button.
                        // =====================================================

                        removeDetailsRescheduleButton();


                        updateWalletUI();
                        fetchJobs();
                        setInterval(updateProviderCancellationButtons, 1000);

                        // =====================================================
                        // LIVE REFRESH + AUTO-EXPIRY OF PENDING CARDS
                        // =====================================================
                        function isAnyPopupOpen() {
                            return !!document.querySelector(".modal.show") ||
                                (window.Swal && Swal.isVisible && Swal.isVisible());
                        }

                        // Customer accepted/rejected a reschedule -> card updates by itself.
                        setInterval(function () {
                            if (document.hidden || isAnyPopupOpen()) return;
                            fetchJobs();
                        }, 8000);

                        // Time passed without any action -> card disappears (expired).
                        setInterval(function () {
                            if (isAnyPopupOpen() || !Array.isArray(jobs) || !jobs.length) return;

                            const now = new Date();
                            const stillActive = jobs.filter(function (job) {
                                const when = getBookingDateTime(job);
                                return !when || when > now;
                            });

                            if (stillActive.length !== jobs.length) {
                                jobs = stillActive;
                                renderCards();
                                updateProviderBookingTabs();
                                fetchJobs(); // lets the server mark them Expired too
                            }
                        }, 1000);


