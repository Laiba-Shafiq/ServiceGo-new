                    }


                    function showJobDetails(jobId) {

                        if (isWalletLocked()) {

                            showWalletLockedMessage();
                            return;
                        }


                        const numericJobId =
                            Number(jobId);


                        let job =
                            jobs.find(
                                j => getJobId(j) === numericJobId
                            );


                        if (!job) {

                            job =
                                acceptedJobs.find(
                                    j => getJobId(j) === numericJobId
                                );
                        }

                        if (!job) {
                            job =
                                completedJobs.find(
                                    j => getJobId(j) === numericJobId
                                );
                        }


                        if (!job) {

                            Swal.fire(
                                "Error",
                                "Booking not found.",
                                "error"
                            );

                            return;
                        }


                        // Zero wallet balance: pending requests cannot be opened.
                        {
                            const st = getJobStatus(job);

                            if (isWalletZero() && st !== "accepted" && st !== "completed") {
                                showWalletZeroMessage();
                                return;
                            }
                        }


                        activeJobIndexId =
                            numericJobId;

                        activeJob =
