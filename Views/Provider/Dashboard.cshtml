                    }


                    // =========================================================
                    // GENERIC PROVIDER ACTION
                    // =========================================================

                    function postProviderAction(
                        url,
                        bookingId,
                        successTitle,
                        successMessage,
                        successIcon = "success"
                    ) {

                        fetch(
                            url +
                            "?bookingId=" +
                            encodeURIComponent(bookingId),
                            {
                                method:
                                    "POST",

                                headers: {

                                    "RequestVerificationToken":
                                        getAntiForgeryToken(),

                                    "Accept":
                                        "application/json"
                                }
                            }
                        )
                        .then(async response => {

                            let data =
                                null;


                            try {

                                data =
                                    await response.json();

                            }
                            catch {

                                data =
                                    null;
                            }


                            if (response.ok) {

                                if (
                                    data &&
                                    data.walletBalance !== undefined &&
                                    data.walletBalance !== null
                                ) {

                                    const newBalance =
                                        Number(
                                            data.walletBalance
                                        );


                                    if (
                                        Number.isFinite(
                                            newBalance
                                        )
                                    ) {

                                        walletBalance =
                                            newBalance;

                                        updateWalletUI();
                                    }
                                }


                                if (detailsModalObj) {

                                    detailsModalObj.hide();
                                }


                                Swal.fire(
                                    successTitle,

                                    data &&
                                    data.message
                                        ? data.message
                                        : successMessage,

                                    successIcon

                                ).then(() => {

                                    window.location.reload();
                                });

                            } else {

                                const message =
                                    data &&
                                    (
                                        data.message ||
                                        data.error
                                    )
                                        ? (
                                            data.message ||
                                            data.error
                                        )
                                        : "Operation could not be completed.";


                                Swal.fire(
                                    "Error",
                                    message,
                                    "error"
                                );
                            }

                        })
                        .catch(error => {

                            console.error(
                                "Provider action error:",
                                error
                            );


                            Swal.fire(
                                "Error",
                                "Something went wrong. Please try again.",
                                "error"
                            );
                        });
                    }


