                    // =========================================================
                    // OPEN PROVIDER RESCHEDULE
                    // =========================================================

                    function openProviderRescheduleForJob(jobId) {
                        if (isWalletZero()) {
                            showWalletZeroMessage();
                            return;
                        }


                        // Do not block the Reschedule form based on wallet balance.
                        // Wallet balance is checked server-side only when accepting.
                        const numericJobId =
                            Number(jobId);


                        let job =
                            null;


                        if (
                            activeJob &&
                            getJobId(activeJob) === numericJobId
                        ) {

                            job =
                                activeJob;
                        }


                        if (!job) {

                            job =
                                acceptedJobs.find(
                                    j =>
                                        getJobId(j) ===
                                        numericJobId
                                );
                        }


                        if (!job) {

                            job =
                                jobs.find(
                                    j =>
                                        getJobId(j) ===
                                        numericJobId
                                );
                        }


                        if (!job) {

                            Swal.fire(
