                            // If a booking arrives without a commission value (for
                            // example when opened from a notification) use the fixed
                            // platform commission of Rs. 10, so Accept is not blocked.
                            const selectedCommission = Number(
                                job?.commission ??
                                job?.Commission ??
                                job?.platformCommission ??
                                job?.PlatformCommission ??
                                0
