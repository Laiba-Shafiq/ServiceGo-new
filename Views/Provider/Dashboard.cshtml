                    // =========================================================
                    // FETCH JOBS
                    // =========================================================

                    function fetchJobs() {

                        const requestUrl =
                            '@Url.Action("GetActiveJobs", "Provider")';

                        console.log(
                            "SERVICEGO - Loading jobs from:",
                            requestUrl
                        );

                        fetch(requestUrl, {
                            method: "GET",
                            headers: {
                                "Accept": "application/json"
                            },
                            cache: "no-store",
                            credentials: "same-origin"
                        })
                        .then(async response => {

                            console.log(
                                "SERVICEGO - GetActiveJobs HTTP STATUS:",
                                response.status
                            );

                            if (!response.ok) {

                                const errorText =
                                    await response.text();

                                console.error(
                                    "SERVICEGO - GetActiveJobs ERROR RESPONSE:",
                                    errorText
                                );

                                throw new Error(
                                    errorText ||
                                    "Unable to load provider jobs."
                                );
                            }

                            const contentType =
                                response.headers.get("content-type") || "";

                            if (!contentType.includes("application/json")) {

                                const textResponse =
                                    await response.text();

                                console.error(
                                    "SERVICEGO - Expected JSON but received:",
                                    textResponse
                                );

                                throw new Error(
                                    "Server did not return booking data."
                                );
                            }

                            return response.json();

                        })
                        .then(data => {

                            console.log(
                                "SERVICEGO - GetActiveJobs RESPONSE:",
                                data
                            );

                            // ASP.NET Core normally returns an array.
                            // These fallbacks also support wrapped responses.
                            const allJobs =
                                Array.isArray(data)
                                    ? data
                                    : (
                                        Array.isArray(data?.data)
                                            ? data.data
                                            : (
                                                Array.isArray(data?.jobs)
                                                    ? data.jobs
                                                    : []
                                            )
                                    );

                            console.log(
                                "SERVICEGO - TOTAL JOBS:",
                                allJobs.length
                            );

                            // =================================================
                            // CURRENT REQUESTS
                            // =================================================

                            jobs =
                                allJobs.filter(job => {

                                    const status =
                                        getJobStatus(job);

                                    console.log(
                                        "SERVICEGO - JOB:",
                                        getJobId(job),
                                        "STATUS:",
                                        status
                                    );

                                    return (
                                        status !== "rejected" &&
                                        status !== "cancelled" &&
                                        status !== "expired" &&
                                        (
                                            status === "pending" ||
                                            status === "rescheduled" ||
                                            status === "reschedule requested" ||
                                            status === "pending reschedule" ||
                                            status === "request pending"
                                        )
                                    );
                                });

                            // =================================================
                            // ACCEPTED BOOKINGS
                            // =================================================

                            acceptedJobs =
                                allJobs.filter(job => {

                                    return (
                                        getJobStatus(job) === "accepted"
                                    );
                                });

                            // =================================================
                            // COMPLETED BOOKINGS
                            // =================================================

                            completedJobs =
                                allJobs.filter(job => {

                                    return (
                                        getJobStatus(job) === "completed"
                                    );
                                });

                            console.log(
                                "SERVICEGO - CURRENT REQUEST CARDS:",
                                jobs.length
                            );

                            console.log(
                                "SERVICEGO - ACCEPTED CARDS:",
                                acceptedJobs.length
                            );

                            console.log(
                                "SERVICEGO - COMPLETED CARDS:",
                                completedJobs.length
                            );

                            // Newest activity first.
                            // Pending: newest booking ID.
                            // Accepted: actual acceptance time when available.
                            // Completed: actual completion time when available.
                            const newestFirst = (a, b) =>
                                Number(getJobId(b) || 0) - Number(getJobId(a) || 0);

                            jobs.sort(newestFirst);

                            acceptedJobs.sort((a, b) => {
                                const aTime = Date.parse(a.acceptedAt ?? a.AcceptedAt ?? "");
                                const bTime = Date.parse(b.acceptedAt ?? b.AcceptedAt ?? "");

                                if (!Number.isNaN(aTime) && !Number.isNaN(bTime) && aTime !== bTime) {
                                    return bTime - aTime;
                                }

                                return newestFirst(a, b);
                            });

                            completedJobs.sort((a, b) => {
                                const aTime = Date.parse(a.completedAt ?? a.CompletedAt ?? "");
                                const bTime = Date.parse(b.completedAt ?? b.CompletedAt ?? "");

                                if (!Number.isNaN(aTime) && !Number.isNaN(bTime) && aTime !== bTime) {
                                    return bTime - aTime;
                                }

                                return newestFirst(a, b);
                            });

                            renderCards();
                            applyProviderCompletedLoadMore();
                            updateProviderBookingTabs();
                            updateProviderCancellationButtons();

                        })
                        .catch(error => {

                            console.error(
                                "SERVICEGO - FAILED TO LOAD JOBS:",
                                error
                            );

                            /*
                             * IMPORTANT:
                             * Do NOT clear jobs here.
                             *
                             * The previous code set all three arrays to []
                             * whenever fetch failed, which made all provider
                             * cards disappear from the page.
                             */

                            if (
                                (!jobs || jobs.length === 0) &&
                                (!acceptedJobs || acceptedJobs.length === 0) &&
                                (!completedJobs || completedJobs.length === 0)
                            ) {

                                if (container) {

                                    container.innerHTML = `
                                        <div class="col-12">
                                            <div class="alert alert-warning text-center mb-0">
                                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                                Unable to load job requests right now.
                                                Please refresh the page.
                                            </div>
                                        </div>
                                    `;
                                }

                                if (acceptedContainer) {

                                    acceptedContainer.innerHTML = `
                                        <div class="col-12">
                                            <div class="text-center text-muted py-4">
                                                <i class="bi bi-calendar-check fs-2 d-block mb-2"></i>
                                                <p class="mb-0">
                                                    Unable to load accepted bookings.
                                                </p>
                                            </div>
                                        </div>
                                    `;
                                }

                                if (completedContainer) {

                                    completedContainer.innerHTML = `
                                        <div class="col-12">
                                            <div class="text-center text-muted py-4">
                                                <i class="bi bi-check-circle fs-2 d-block mb-2"></i>
                                                <p class="mb-0">
                                                    Unable to load completed bookings.
                                                </p>
                                            </div>
                                        </div>
                                    `;
                                }
                            }
                        });
                    }


                    // =========================================================
                    // GET JOB STATUS
                    // =========================================================

                    function getJobStatus(job) {

                        if (!job) {
                            return "";
                        }

                        const rawStatus =
                            job.status ??
                            job.Status ??
                            job.bookingStatus ??
                            job.BookingStatus ??
                            job.jobStatus ??
                            job.JobStatus ??
                            job.state ??
                            job.State ??
                            "";

                        return normalizeStatus(rawStatus);
                    }


                    function normalizeStatus(status) {

                        if (
                            status === null ||
                            status === undefined
                        ) {
                            return "";
                        }

                        return String(status)
                            .trim()
                            .toLowerCase()
                            .replace(/-/g, " ")
                            .replace(/_/g, " ")
                            .replace(/\s+/g, " ");
                    }


                    // =========================================================
                    // GET JOB ID
                    // =========================================================

                    function getJobId(job) {

                        if (!job) {
                            return 0;
                        }


                        const rawId =
                            job.id ??
                            job.Id ??
                            job.databaseId ??
                            job.databaseID ??
                            job.bookingIndexId ??
                            job.BookingIndexId ??
                            job.indexId ??
                            job.IndexId ??
                            0;


                        const numericId =
                            Number(rawId);


                        return Number.isFinite(numericId) &&
                            numericId > 0
                            ? numericId
                            : 0;
                    }


                    // =========================================================
                    // CUSTOMER
                    // =========================================================

                    function getCustomerName(job) {

                        if (!job) {
                            return "N/A";
                        }


                        return (
                            job.customerName ??
                            job.CustomerName ??
                            job.fullName ??
                            job.FullName ??
                            "N/A"
                        );
                    }


                    function getCustomerFormattedId(job) {

                        if (!job) {
                            return "";
                        }


                        return cleanCustomerId(
                            job.customerFormattedId ??
                            job.CustomerFormattedId ??
                            job.customerCode ??
                            job.CustomerCode ??
                            job.customerId ??
                            job.CustomerId ??
                            ""
                        );
                    }


                    // =========================================================
                    // BOOKING DATA
                    // =========================================================

                    function getJobDate(job) {

                        if (!job) {
                            return "";
                        }


                        return (
                            job.date ??
                            job.Date ??
                            job.bookingDate ??
                            job.BookingDate ??
                            ""
                        );
                    }


                    function getJobTime(job) {

                        if (!job) {
                            return "";
                        }


                        return (
                            job.time ??
                            job.Time ??
                            job.bookingTime ??
                            job.BookingTime ??
                            ""
                        );
                    }


                    function getJobLocation(job) {

                        if (!job) {
                            return "N/A";
                        }


                        return (
                            job.location ??
                            job.Location ??
                            job.address ??
                            job.Address ??
                            "N/A"
                        );
                    }


                    function getServiceName(job) {

                        if (!job) {
                            return "N/A";
                        }


                        return (
                            job.serviceName ??
                            job.ServiceName ??
                            job.service ??
                            job.Service ??
                            "N/A"
                        );
                    }


                    function getServiceType(job) {

                        if (!job) {
                            return "Standard";
                        }


                        return (
                            job.serviceType ??
                            job.ServiceType ??
                            "Standard"
                        );
                    }


                    // =========================================================
                    // RESCHEDULE DATA
                    // =========================================================

                    function getRescheduleStatus(job) {

                        if (!job) {
                            return "";
                        }


                        return normalizeStatus(
                            job.rescheduledStatus ??
                            job.RescheduledStatus ??
                            job.rescheduleStatus ??
                            job.RescheduleStatus ??
                            ""
                        );
                    }


                    function hasCustomerRescheduleRequest(job) {

                        if (!job) {
                            return false;
                        }


                        const value =
                            job.hasRescheduleRequest ??
                            job.HasRescheduleRequest ??
                            false;


                        return (
                            value === true ||
                            value === "true" ||
                            value === 1 ||
                            value === "1"
                        );
                    }


                    function getRequestedNewDate(job) {

                        if (!job) {
                            return "";
                        }


                        return (
                            job.requestedNewDate ??
                            job.RequestedNewDate ??
                            job.newDate ??
                            job.NewDate ??
                            ""
                        );
                    }


                    function getRequestedNewTime(job) {

                        if (!job) {
                            return "";
                        }


                        return (
                            job.requestedNewTime ??
                            job.RequestedNewTime ??
                            job.newTime ??
                            job.NewTime ??
                            ""
                        );
                    }


                    // =========================================================
                    // CUSTOMER RESCHEDULE REQUEST
                    // =========================================================
                    // IMPORTANT:
                    // Only an actual customer request should
                    // display the "View Reschedule Request" link.
                    //
                    // This link should not appear for the provider's own pending request.

                    // =========================================================

                    function buildCustomerRescheduleAlert(job) {

                        if (!job) {
                            return "";
                        }


                        // IMPORTANT FIX:
                        // hasCustomerRescheduleRequest is the primary condition
                        // used here.
                        //
                        // A pending reschedule status alone must not
                        // be treated as a customer request.

                        const requestedBy = String(
                            job.rescheduleRequestedBy ??
                            job.RescheduleRequestedBy ??
                            job.requestedBy ??
                            job.RequestedBy ??
                            ""
                        ).trim().toLowerCase();

                        const hasRequest =
                            hasCustomerRescheduleRequest(job) &&
                            requestedBy === "customer";


                        if (!hasRequest) {
                            return "";
                        }


                        const jobId =
                            getJobId(job);


                        // If a customer request exists but the new date/time
                        // values are unavailable, the link should still appear,
                        // because the backend request state is authoritative.


                        return `
                            <div class="mt-2">

                                <a
                                    href="javascript:void(0);"
                                    class="text-primary fw-bold"
                                    style="font-size:13px;"
                                    onclick="openCustomerReschedule(${jobId})">

                                    <i class="bi bi-calendar2-week me-1"></i>

                                    View Reschedule Request

                                </a>

                            </div>
                        `;
                    }


                    // =========================================================
                    // PROVIDER RESCHEDULE STATUS FIELD
                    // =========================================================

                    function buildProviderRescheduleStatus(job) {

                        if (!job) {
                            return "";
                        }


                        const status =
                            getRescheduleStatus(job);


                        if (!status) {
                            return "";
                        }


                        // -----------------------------------------------------
                        // PENDING
                        // -----------------------------------------------------

                        const requestedBy = String(
                            job.rescheduleRequestedBy ??
                            job.RescheduleRequestedBy ??
                            job.requestedBy ??
                            job.RequestedBy ??
                            ""
                        ).trim().toLowerCase();

                        if (status === "pending" && requestedBy === "provider") {

                            return `
                                <p
                                    class="mb-2 text-dark"
                                    style="font-size:13px;">

                                    <i
                                        class="bi bi-calendar2-week text-warning me-1">
                                    </i>

                                    <strong>Reschedule Request:</strong>

                                    <span class="badge bg-dark text-white ms-1">
                                        Pending
                                    </span>

                                </p>
                            `;
                        }

                        // -----------------------------------------------------
                        // REJECTED
                        // -----------------------------------------------------

                        // A customer's request that THIS provider rejected must not show
                        // "Rejected" here - only the sender (customer) sees that.
                        if (status === "rejected" && requestedBy !== "customer") {

                            return `
                                <p
                                    class="mb-2 text-muted"
                                    style="font-size:13px;">

                                    <i
                                        class="bi bi-x-circle text-secondary me-1">
                                    </i>

                                    <strong>Reschedule Request:</strong>

                                    <span class="badge bg-secondary ms-1">
                                        Rejected
                                    </span>

                                </p>
                            `;
                        }


                        return "";
                    }


                    // =========================================================
                    // BOOKING DATETIME
                    // =========================================================

                    function getBookingDateTime(job) {

                        if (!job) {
                            return null;
                        }


                        const date =
                            getJobDate(job);

                        const time =
                            getJobTime(job);


                        if (!date || !time) {
                            return null;
                        }


                        let dateTime =
                            new Date(`${date}T${time}`);


                        if (Number.isNaN(dateTime.getTime())) {

                            dateTime =
                                new Date(`${date} ${time}`);
                        }


                        if (Number.isNaN(dateTime.getTime())) {
                            return null;
                        }


                        return dateTime;
                    }


                    // =========================================================
                    // RESCHEDULE ALLOWED
                    // =========================================================

                    function isRescheduleAllowed(job) {
                        if (!job) return false;

                        const status = getJobStatus(job);
                        const rescheduleStatus = getRescheduleStatus(job);
                        const used = job.rescheduleUsed ?? job.RescheduleUsed ?? false;
                        const serverAllowed =
                            job.rescheduleAllowed ??
                            job.RescheduleAllowed ??
                            false;

                        if (status !== 'pending' && status !== 'accepted') return false;
                        if (rescheduleStatus === 'pending') return false;
                        if (used === true || String(used).toLowerCase() === 'true') return false;
                        if (job.rescheduledDate || job.RescheduledDate) return false;
                        if (rescheduleStatus === 'rejected') return false;

                        return serverAllowed === true ||
                               String(serverAllowed).toLowerCase() === 'true';
                    }


                    // =========================================================
                    // FUTURE DATE/TIME
                    // =========================================================

                    function parseProviderDateTime(date, time) {

                        if (!date || !time) return null;

                        const match = String(time).trim().match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i);
                        if (!match) return null;

                        let hour = Number(match[1]);
                        const minute = Number(match[2]);
                        const period = match[3].toUpperCase();

                        if (hour < 1 || hour > 12 || minute < 0 || minute > 59) return null;

                        if (period === "AM" && hour === 12) hour = 0;
                        if (period === "PM" && hour !== 12) hour += 12;

                        const selected = new Date(`${date}T${String(hour).padStart(2, "0")}:${String(minute).padStart(2, "0")}:00`);
                        return Number.isNaN(selected.getTime()) ? null : selected;
                    }


                    function isFutureDateTime(date, time) {
                        const selected = parseProviderDateTime(date, time);
                        return selected !== null && selected.getTime() > Date.now();
                    }


                    // =========================================================
                    // DATE / TIME FORMAT
                    // =========================================================

                    function formatDateForDisplay(dateValue) {

                        if (!dateValue) {
                            return "N/A";
                        }


                        const date =
                            new Date(dateValue);


                        if (Number.isNaN(date.getTime())) {
                            return String(dateValue);
                        }


                        return date.toLocaleDateString(
                            "en-GB",
                            {
                                day: "2-digit",
                                month: "2-digit",
                                year: "numeric"
                            }
                        );
                    }


                    function formatTimeForDisplay(timeValue) {

                        if (!timeValue) {
                            return "N/A";
                        }


                        const value =
                            String(timeValue).trim();


                        if (
                            value.toLowerCase().includes("am") ||
                            value.toLowerCase().includes("pm")
                        ) {
                            return value;
                        }


                        const parts =
                            value.split(":");


                        if (parts.length < 2) {
                            return value;
                        }


                        let hours =
                            parseInt(parts[0], 10);

                        const minutes =
                            parts[1];


                        if (Number.isNaN(hours)) {
                            return value;
                        }


                        const suffix =
                            hours >= 12
                                ? "PM"
                                : "AM";


                        hours =
                            hours % 12 || 12;


                        return `${String(hours).padStart(2, "0")}:${minutes} ${suffix}`;
                    }


                    // =========================================================
                    // PROVIDER RESCHEDULE BUTTON
                    // =========================================================
                    // IMPORTANT:
                    // This is not rendered inside the View Details popup.
                    //
                    // This is rendered only on the booking card.
                    // =========================================================

                    function buildProviderRescheduleButton(job) {
                        if (!job) {
                            return "";
                        }

                        const status =
                            getJobStatus(job);

                        const rescheduleStatus =
                            getRescheduleStatus(job);

                        // -----------------------------------------------------
                        // COMPLETED BOOKINGS
                        // Completed bookings cannot be rescheduled.
                        // -----------------------------------------------------
                        if (status === "completed") {
                            return "";
                        }

                        // -----------------------------------------------------
                        // ANY PENDING RESCHEDULE REQUEST
                        // No second reschedule request is allowed.
                        // -----------------------------------------------------
                        if (rescheduleStatus === "pending") {
                            return "";
                        }

                        // -----------------------------------------------------
                        // PENDING BOOKINGS ONLY
                        // -----------------------------------------------------
                        if (status === "pending" &&
                            isRescheduleAllowed(job)) {
                            const jobId =
                                getJobId(job);

                            return `
                                <button
                                    type="button"
                                    class="btn-card-orange"
                                    onclick="openProviderRescheduleForJob(${jobId})">
                                    <i class="bi bi-clock me-1"></i>
                                    Reschedule
                                </button>
                            `;
                        }

                        return "";
                    }

                    // =========================================================
                    // LIVE CANCELLATION VISIBILITY
                    // =========================================================

                    function updateProviderCancellationButtons() {
                        document.querySelectorAll('.cancel-provider-booking-btn').forEach(button => {
                            const start = parseProviderBookingStart(
                                button.dataset.bookingDate,
                                button.dataset.bookingTime
                            );
                            button.style.display = start && new Date() < new Date(start.getTime() - 2 * 60 * 60 * 1000)
                                ? ''
                                : 'none';
                        });
                    }

                    function parseProviderBookingStart(dateText, timeText) {
                        if (!dateText || !timeText) return null;
                        const value = String(timeText).trim();
                        const match = value.match(/^(\d{1,2}):(\d{2})(?::\d{2})?\s*([AaPp][Mm])?$/);
                        if (!match) return null;
                        let h = Number(match[1]);
                        const m = Number(match[2]);
                        const ap = (match[3] || '').toUpperCase();
                        if (ap === 'PM' && h < 12) h += 12;
                        if (ap === 'AM' && h === 12) h = 0;
                        if (h > 23 || m > 59) return null;
                        const d = new Date(`${dateText}T00:00:00`);
                        if (Number.isNaN(d.getTime())) return null;
                        d.setHours(h, m, 0, 0);
                        return d;
                    }

