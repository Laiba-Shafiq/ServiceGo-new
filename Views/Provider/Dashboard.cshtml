                    // =========================================================
                    // GOOGLE MAPS
                    // =========================================================

                    let googleMapMarker = null;

                    function initializeJobMap(job) {

                        const mapContainer =
                            document.getElementById(
                                "googleMap"
                            );

                        if (!mapContainer) {
                            return;
                        }

                        const lat =
                            Number(
                                job.lat ??
                                job.Lat ??
                                job.latitude ??
                                job.Latitude
                            );

                        const lng =
                            Number(
                                job.lng ??
                                job.Lng ??
                                job.longitude ??
                                job.Longitude
                            );

                        const defaultLat = 33.6844;
                        const defaultLng = 73.0479;

                        if (
                            !window.google ||
                            !google.maps
                        ) {
                            mapContainer.innerHTML =
                                '<div class="alert alert-warning mb-0">Google Maps could not be loaded. Please check the Google Maps API key.</div>';
                            return;
                        }

                        const hasValidCoordinates =
                            Number.isFinite(lat) &&
                            Number.isFinite(lng);

                        const center = hasValidCoordinates
                            ? { lat: lat, lng: lng }
                            : { lat: defaultLat, lng: defaultLng };

                        googleMapInstance =
                            new google.maps.Map(
                                mapContainer,
                                {
                                    center: center,
                                    zoom: hasValidCoordinates ? 15 : 12,
                                    mapTypeControl: true,
                                    streetViewControl: true,
                                    fullscreenControl: true,
                                    zoomControl: true
                                }
                            );

                        if (googleMapMarker) {
                            googleMapMarker.setMap(null);
                            googleMapMarker = null;
                        }

                        googleMapMarker =
                            new google.maps.Marker(
                                {
                                    position: center,
                                    map: googleMapInstance,
                                    title: hasValidCoordinates
                                        ? (getJobLocation(job) || "Customer Location")
                                        : "Customer Location"
                                }
                            );

                        const infoWindow =
                            new google.maps.InfoWindow(
                                {
                                    content:
                                        hasValidCoordinates
                                            ? (getJobLocation(job) || "Customer Location")
                                            : "Customer live location not available."
                                }
                            );

                        googleMapMarker.addListener(
                            "click",
                            function () {
                                infoWindow.open({
                                    anchor: googleMapMarker,
                                    map: googleMapInstance
                                });
                            }
                        );

                        infoWindow.open({
                            anchor: googleMapMarker,
                            map: googleMapInstance
                        });

                        setTimeout(function () {

                            if (
                                googleMapInstance &&
                                window.google &&
                                google.maps
                            ) {
                                google.maps.event.trigger(
                                    googleMapInstance,
                                    "resize"
                                );

                                googleMapInstance.setCenter(
                                    center
                                );
                            }

                        }, 200);
                    }


                    // =========================================================
                    // ACCEPT JOB
                    // =========================================================

                    function acceptCurrentJob() {
                        if (isWalletZero()) {
                            showWalletZeroMessage();
                            return;
                        }


                        if (!activeJobIndexId) {

                            Swal.fire(
                                "Error",
                                "Booking not selected.",
                                "error"
                            );

                            return;
                        }




                        const job =
                            activeJob ||
                            jobs.find(
                                j =>
                                    getJobId(j) ===
                                    Number(activeJobIndexId)
                            );


                        if (!job) {

                            Swal.fire(
                                "Error",
                                "Booking not found.",
                                "error"
                            );

                            return;
                        }


                        const commission =
                            Number(
                                job.commission ??
                                job.Commission ??
                                0
                            );


                        if (
                            commission > 0 &&
                            walletBalance < commission
                        ) {

                            Swal.fire({

                                title:
                                    "Insufficient Wallet Balance",

                                html:
                                    `Your wallet balance is <strong>Rs. ${Number(walletBalance).toLocaleString()}</strong>.<br>` +
                                    `Required commission is <strong>Rs. ${Number(commission).toLocaleString()}</strong>.`,

                                icon:
                                    "warning",

                                confirmButtonText:
                                    "Add Money",

                                confirmButtonColor:
                                    "#d97600"

                            }).then(result => {

                                if (result.isConfirmed) {

                                    openWalletModal();
                                }

                            });

                            return;
                        }


                        Swal.fire({

                            title:
                                "Accept Job?",

                            text:
                                commission > 0
                                    ? `Commission of Rs. ${commission.toLocaleString()} will be deducted from your wallet.`
                                    : "Are you sure you want to accept this booking?",

                            icon:
                                "question",

                            showCancelButton:
                                true,

                            confirmButtonColor:
                                "#28a745",

                            cancelButtonColor:
                                "#6c757d",

                            confirmButtonText:
                                "Yes, Accept",

                            cancelButtonText:
                                "Cancel"

                        }).then(result => {

                            if (!result.isConfirmed) {
                                return;
                            }


                            postProviderAction(
                                '@Url.Action("AcceptJob", "Provider")',
                                activeJobIndexId,
                                "Job Accepted",
                                "Booking accepted successfully.",
                                "success"
                            );
                        });
                    }


