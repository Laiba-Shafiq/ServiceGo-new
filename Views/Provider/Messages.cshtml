@model List<ServiceGo.Models.Message>

@using System
@using System.Linq
@using System.Text.Json
@using System.Collections.Generic
@{
    Layout = null;

    var chatsList = ViewBag.Chats as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var activeCustomerId = ViewBag.ActiveCustomerCode as string ?? string.Empty;
    var activeCustomerName = ViewBag.ActiveCustomerName as string ?? "Select a chat";
    var activeCustomerProfileImage = ViewBag.ActiveCustomerProfileImage as string ?? string.Empty;

    var providerProfileImage = ViewBag.ProviderProfileImage as string ?? string.Empty;
    var providerUnreadCount = ViewBag.UnreadCount ?? 0;
    var providerProfileImageUrl = string.IsNullOrWhiteSpace(providerProfileImage)
        ? Url.Content("~/images/Profile icon.png")
        : Url.Content(providerProfileImage);

    var providerChats = new List<object>();

    foreach (var c in chatsList)
    {
        var customerId = Convert.ToString(c.CustomerId) ?? string.Empty;
        var customerName = Convert.ToString(c.CustomerName) ?? "Customer";
        var customerImage = Convert.ToString(c.CustomerProfileImage);

        var customerImageUrl = string.IsNullOrWhiteSpace(customerImage)
            ? Url.Content("~/images/Profile icon.png")
            : (customerImage.StartsWith("~")
                ? Url.Content(customerImage)
                : customerImage.StartsWith("/")
                    ? customerImage
                    : Url.Content("~/" + customerImage.TrimStart('/')));

        var messages = new List<object>();

        // Treat CUS-1, CUS1, 1 and the stored CustomerId as the same customer.
        // This prevents the active chat from looking empty after reopening it.
        string NormalizeCustomerId(string value)
        {
            value = (value ?? string.Empty).Trim();
            if (value.StartsWith("CUS-", StringComparison.OrdinalIgnoreCase))
                return value.Substring(4).Trim();
            if (value.StartsWith("CUS", StringComparison.OrdinalIgnoreCase))
                return value.Substring(3).Trim();
            return value;
        }

        if (string.Equals(
                NormalizeCustomerId(activeCustomerId),
                NormalizeCustomerId(customerId),
                StringComparison.OrdinalIgnoreCase) && Model != null)
        {
            foreach (var m in Model)
            {
                messages.Add(new
                {
                    id = m.MessageId,
                    type = m.IsFromCustomer ? "received" : "sent",
                    text = m.TextContent ?? string.Empty,
                    time = m.Timestamp.ToString("hh:mm tt")
                });
            }
        }

        providerChats.Add(new
        {
            customerId,
            name = customerName,
            img = customerImageUrl,
            messages
        });
    }

    var providerMessagesConfig = new
    {
        chats = providerChats,
        activeId = activeCustomerId,
        activeName = activeCustomerName,
        activeProfileImageUrl = string.IsNullOrWhiteSpace(activeCustomerProfileImage)
            ? Url.Content("~/images/Profile icon.png")
            : (activeCustomerProfileImage.StartsWith("~")
                ? Url.Content(activeCustomerProfileImage)
                : activeCustomerProfileImage.StartsWith("/")
                    ? activeCustomerProfileImage
                    : Url.Content("~/" + activeCustomerProfileImage.TrimStart('/'))),
        walletLocked = ViewBag.WalletLocked is bool locked && locked,
        defaultProfileImageUrl = Url.Content("~/images/Profile icon.png"),
        messagesUrl = Url.Action("Messages", "Provider"),
        sendMessageUrl = Url.Action("SendMessage", "Provider"),
        sendAudioMessageUrl = Url.Action("SendAudioMessage", "Provider"),
        deleteMessageUrl = Url.Action("DeleteMessage", "Provider"),
        deleteChatUrl = Url.Action("DeleteChat", "Provider")
    };
}

<!DOCTYPE html>
<html lang="en">
